---
// 再利用可能な FAQ コンポーネント。
// 可視の Q&A（<details>）を描画し、同時に FAQPage 構造化データ(JSON-LD)を出力する。
// items は [{ q, a }] の配列（a はプレーンテキスト）。内容は静的なので scoped CSS が効く。
const { items = [], title = 'よくある質問' } = Astro.props;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---
{items.length > 0 && (
  <section class="faq">
    <h2>{title}</h2>
    {items.map((it) => (
      <details class="faq-item">
        <summary>{it.q}</summary>
        <p>{it.a}</p>
      </details>
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </section>
)}

<style>
  .faq {
    max-width: 880px;
    width: 100%;
    margin: 36px auto 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .faq > h2 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .faq > h2::before {
    content: '';
    width: 6px;
    height: 1.1em;
    background: var(--cat-color);
    border-radius: 3px;
  }
  .faq-item {
    border: 1.5px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--surface);
  }
  .faq-item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px;
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
  }
  .faq-item summary:hover { background: var(--bg); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '＋';
    flex: none;
    width: 28px;
    text-align: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--cat-color) 62%, #000);
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item[open] summary { border-bottom: 1px solid var(--border-2); }
  .faq-item p {
    margin: 0;
    padding: 16px 20px 20px;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-3);
    background: var(--bg);
  }
</style>
