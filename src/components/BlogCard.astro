---
import { getBlogCategory } from '../data/blog.js';
const { post } = Astro.props;
const { id: slug, data } = post;
const cat = getBlogCategory(data.category);
const pubDate = new Date(data.pubDate);
const dateStr = pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<a href={`/blog/${slug}/`} class="blog-card">
  <div class="blog-card__meta">
    <span class="blog-card__cat">
      <span class="blog-card__cat-ic" aria-hidden="true">{cat?.icon || '📄'}</span>
      {cat?.name || data.category}
    </span>
    <time class="blog-card__date" datetime={pubDate.toISOString()}>{dateStr}</time>
  </div>
  <h3 class="blog-card__title">{data.title}</h3>
  <p class="blog-card__desc">{data.description}</p>
  {data.tags.length > 0 && (
    <div class="blog-card__tags">
      {data.tags.slice(0, 3).map((t) => (
        <span class="blog-card__tag">#{t}</span>
      ))}
    </div>
  )}
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
    background: var(--surface);
    border: 1.5px solid var(--border-2);
    border-radius: var(--r-2xl);
    color: var(--text);
    transition: all var(--ease);
  }
  .blog-card:hover {
    transform: translateY(-3px);
    border-color: var(--cat-color);
    box-shadow: 0 18px 32px -18px color-mix(in srgb, var(--cat-color) 50%, transparent);
  }
  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .blog-card__cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: var(--cat-tint);
    color: color-mix(in srgb, var(--cat-color) 62%, #000);
    font-size: .75rem;
    font-weight: var(--fw-bold);
    border-radius: var(--r-pill);
  }
  .blog-card__cat-ic { font-size: .9rem; line-height: 1; }
  .blog-card__date {
    font-size: .78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .blog-card__title {
    font-size: 1.05rem;
    font-weight: var(--fw-black);
    color: var(--text);
    line-height: 1.4;
    letter-spacing: -.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card__desc {
    font-size: .86rem;
    color: var(--text-3);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }
  .blog-card__tag {
    font-size: .72rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
</style>
