---
import { getRelated } from '../data/tools.js';
import Icon from './Icon.astro';
const { current } = Astro.props;
const related = getRelated(current, 4);
---
<section class="related">
  <h3>関連ツール</h3>
  <div class="related-grid">
    {related.map((t) => (
      <a href={`/${t.slug}/`} class="related-link">
        <span class="ic" aria-hidden="true"><Icon name={t.slug} size={20} /></span>{t.name}
      </a>
    ))}
  </div>
</section>
