---
import ToolLayout from '../layouts/ToolLayout.astro';
import '../styles/rokusei-topic.css';
const { title, description, slug, heading = title, tool = false, sources = [] } = Astro.props;
const url = new URL(`/${slug}/`, Astro.site).href;
const jsonld = tool ? { '@context': 'https://schema.org', '@type':'WebApplication', name:heading, description, url, applicationCategory:'EntertainmentApplication', operatingSystem:'Web', offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'} } : { '@context':'https://schema.org','@type':'WebPage',name:heading,description,url };
const breadcrumb = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'ホーム',item:new URL('/',Astro.site).href},{'@type':'ListItem',position:2,name:'六星占術',item:new URL('/rokusei/',Astro.site).href},{'@type':'ListItem',position:3,name:heading,item:url}]};
---
<ToolLayout title={title} description={description} slug={slug} current="rokusei" jsonld={jsonld} breadcrumb={breadcrumb} wide>
  <div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/rokusei/">六星占術</a> ／ {heading}</div><h1>{heading}</h1><p>{description}</p></div>
  <slot />
  <section class="howto rk-reading-note"><h2>参考資料と読み方</h2>
    <ul>{sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
    <p>資料確認：2026年11月7日。六星占術は文化・娯楽としての占いです。性格や将来を確定するものではありません。本サイトは細木数子氏・細木かおり氏の公式サービスではありません。</p>
  </section>
  <nav class="rk-topic-nav" aria-label="六星占術の関連ページ">
    <a href="/rokusei/" data-track-context>生年月日で運命星を調べる</a>
    <a href="/rokusei/daisakkai/" data-track-context>大殺界はいつ？</a>
    <a href="/rokusei/hayamihyou/" data-track-context>年運早見表</a>
    <a href="/rokusei-aisho/" data-track-context>ふたりの相性</a>
    <a href="/rokusei/reigou/" data-track-context>霊合星人を調べる</a>
    <a href="/rokusei/daisakkai-2027/" data-track-context>2027年の運勢</a>
  </nav>
</ToolLayout>
