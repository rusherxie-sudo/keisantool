---
// 六曜カレンダーの月間グリッド（/rokuyo/ ハブと /rokuyo/<year>-<month>/ スポークで共有）。
// rows は rokuyoMonthTable(year, month) の返り値そのまま。
const { year, month, rows } = Astro.props;

const now = new Date();
const todayDay = year === now.getFullYear() && month === now.getMonth() + 1 ? now.getDate() : null;

const firstWeekday = new Date(Date.UTC(year, month - 1, 1)).getUTCDay(); // 0=日〜6=土
const leadingBlanks = Array.from({ length: firstWeekday });
const taianDays = rows.filter((r) => r.rokuyo === '大安').map((r) => r.day);
const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
---
<div class="rk-taian-list">
  <span class="rk-taian-label">この月の大安</span>
  {taianDays.length > 0 ? (
    <span class="rk-taian-days">{taianDays.map((d) => `${d}日`).join('・')}</span>
  ) : (
    <span class="rk-taian-none">この月は大安がありません</span>
  )}
</div>

<div class="rk-grid">
  {WEEKDAYS.map((w, i) => (
    <div class={`rk-head ${i === 0 ? 'is-sun' : ''} ${i === 6 ? 'is-sat' : ''}`}>{w}</div>
  ))}
  {leadingBlanks.map(() => <div class="rk-cell is-blank"></div>)}
  {rows.map((r) => (
    <div class={`rk-cell rk-${r.rokuyo} ${r.day === todayDay ? 'is-today' : ''}`}>
      <span class="rk-day">{r.day}</span>
      <span class="rk-name">{r.rokuyo}</span>
    </div>
  ))}
</div>

<style>
  .rk-taian-list {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    background: var(--surface-sub);
    border: 1.5px solid var(--border-2);
    border-radius: var(--r-md);
    padding: 12px 16px;
    margin-bottom: 14px;
  }
  .rk-taian-label { font-size: .78rem; font-weight: var(--fw-bold); color: var(--text-muted); flex: none; }
  .rk-taian-days { font-weight: var(--fw-bold); color: var(--success); }
  .rk-taian-none { font-size: .85rem; color: var(--text-muted); }

  .rk-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }
  .rk-head {
    text-align: center;
    font-size: .72rem;
    font-weight: var(--fw-bold);
    color: var(--text-muted);
    padding: 4px 0 8px;
  }
  .rk-head.is-sun { color: var(--danger); }
  .rk-head.is-sat { color: var(--cat-color); }
  .rk-cell {
    aspect-ratio: 1 / 0.85;
    border: 1.5px solid var(--border-2);
    border-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    background: var(--surface);
  }
  .rk-cell.is-blank { border: none; background: none; }
  .rk-day { font-family: var(--font-mono); font-weight: var(--fw-bold); font-size: .9rem; color: var(--text); }
  .rk-name { font-size: .62rem; color: var(--text-muted); }
  .rk-cell.rk-大安 { background: color-mix(in srgb, var(--success) 10%, var(--surface)); border-color: color-mix(in srgb, var(--success) 40%, var(--border-2)); }
  .rk-cell.rk-大安 .rk-name { color: var(--success); font-weight: var(--fw-bold); }
  .rk-cell.rk-仏滅 .rk-name { color: var(--danger); }
  .rk-cell.is-today { border-color: var(--cat-color); border-width: 2px; box-shadow: inset 0 0 0 1px var(--cat-color); }

  @media (max-width: 480px) {
    .rk-name { font-size: .56rem; }
    .rk-day { font-size: .8rem; }
  }
</style>
