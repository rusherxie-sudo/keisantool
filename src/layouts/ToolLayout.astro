---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingShare from '../components/FloatingShare.astro';
import { getColorBySlug, getColorByCategorySlug } from '../data/tools.js';

const { title, description, slug, current, jsonld, wide } = Astro.props;
const canonical = new URL(slug ? `/${slug}/` : '/', Astro.site).href;

// ページ所属カテゴリのテーマ色を解決：ツールslug優先 → カテゴリslug → ブランド色
const _toolColor = getColorBySlug(current);
const _catColor = getColorByCategorySlug(current);
const theme = _toolColor.id ? _toolColor : (_catColor.id ? _catColor : { accent: '#2563eb', tint: '#eef4ff' });
const themeStyle = `--cat-color:${theme.accent};--cat-tint:${theme.tint}`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Google tag (gtag.js) — GA4 全站计测。is:inline 必须保留，否则 Astro 会处理脚本导致 GA 失效 -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-XM8LC5MPHT"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XM8LC5MPHT');
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="計算ツール" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&family=IBM+Plex+Mono:wght@400;600;700&display=swap"
    rel="stylesheet"
  />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <SiteHeader current={current} />
  <slot name="hero" />
  <main class={wide ? 'page-wrapper wide' : 'page-wrapper'} style={themeStyle}>
    <slot />
  </main>
  <SiteFooter />
  <FloatingShare title={title} url={canonical} />
</body>
</html>
