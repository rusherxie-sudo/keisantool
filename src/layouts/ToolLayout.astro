---
import '../styles/global.css';
import { join } from 'node:path';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingShare from '../components/FloatingShare.astro';
import { getColorBySlug, getColorByCategorySlug, getTool, getCategorySlug } from '../data/tools.js';
import { lastModifiedISO, sourceFileForUrl } from '../lib/lastmod.js';

const { title, description, slug, current, jsonld, wide, breadcrumb, robots = 'index,follow' } = Astro.props;
const canonical = new URL(slug ? `/${slug}/` : '/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// WebApplication に url が無ければ canonical を補完（各ページの frontmatter を触らず一括対応）
const jsonldWithUrl =
  jsonld && jsonld['@type'] === 'WebApplication' && !jsonld.url
    ? { ...jsonld, url: canonical }
    : jsonld;

// 無料・ブラウザ完結のツールであることを明示する。レビュー数や評価は実在しないため
// 付与しない（構造化データに架空の aggregateRating を追加しない）。
const jsonldWithAppDetails =
  jsonldWithUrl && jsonldWithUrl['@type'] === 'WebApplication'
    ? {
        ...jsonldWithUrl,
        '@id': jsonldWithUrl['@id'] || `${canonical}#webapplication`,
        isAccessibleForFree: jsonldWithUrl.isAccessibleForFree ?? true,
        browserRequirements: jsonldWithUrl.browserRequirements || 'JavaScript対応の最新ブラウザ',
        featureList: jsonldWithUrl.featureList || ['無料で利用可能', '登録不要', 'ブラウザ上で計算'],
      }
    : jsonldWithUrl;

// dateModified を一括注入：sitemap の lastmod（astro.config.mjs）と同じ git コミット日時ロジックを共有。
// AIクローラーがページ本体からも鮮度を読み取れるようにする（GEO監査 2026-07-04 指摘）。
// Astro のビルドは .astro を dist/.prerender/chunks/ にバンドルするため import.meta.url は使えない
// （バンドル後のパスになり src/pages を指せない）。process.cwd() はビルド実行時のプロジェクトルート。
const pagesDir = join(process.cwd(), 'src/pages');
const sourceFile = sourceFileForUrl(pagesDir, slug ?? '');
const dateModified = sourceFile ? lastModifiedISO(sourceFile) : null;
const dateModifiedLabel = dateModified
  ? new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(dateModified))
  : null;
const jsonldFinal =
  jsonldWithAppDetails && dateModified && !jsonldWithAppDetails.dateModified
    ? { ...jsonldWithAppDetails, dateModified }
    : jsonldWithAppDetails;

// 各ページの主題（アプリ・記事・カテゴリ）とは別に、ページ自体の正規 URL と言語を
// WebPage として公開する。検索エンジンが canonical と構造化データを突き合わせやすくなる。
const webPageJsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${new URL('/', Astro.site).href}#website`,
    name: '計算ツール',
    url: new URL('/', Astro.site).href,
  },
  ...(dateModified ? { dateModified } : {}),
};

// ツールページには BreadcrumbList を一括注入（ホーム ／ カテゴリ ／ ツール名）。
// カテゴリページは自前で BreadcrumbList を持つため getTool が undefined → 注入しない。
// breadcrumb prop が渡された場合はそれを優先する（星座相性の144組ページなど4階層のページ用）。
const _tool = getTool(current);
const _crumbCat = _tool ? getCategorySlug(_tool.category) : '';
const breadcrumbJsonld =
  breadcrumb ??
  (_tool && _crumbCat
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: _tool.category, item: new URL(`/category/${_crumbCat}/`, Astro.site).href },
          { '@type': 'ListItem', position: 3, name: _tool.name, item: canonical },
        ],
      }
    : null);

// ページ所属カテゴリのテーマ色を解決：ツールslug優先 → カテゴリslug → ブランド色
const _toolColor = getColorBySlug(current);
const _catColor = getColorByCategorySlug(current);
const theme = _toolColor.id ? _toolColor : (_catColor.id ? _catColor : { accent: '#2563eb', tint: '#eef4ff' });
const themeStyle = `--cat-color:${theme.accent};--cat-tint:${theme.tint}`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Google tag (gtag.js) — GA4 全站计测。is:inline 必须保留，否则 Astro 会处理脚本导致 GA 失效 -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-XM8LC5MPHT"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XM8LC5MPHT');
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="計算ツール" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- 非同期読み込み（PageSpeed「渲染阻塞请求」対策）：print媒体で読み込ませてから
       onloadでallに切り替えることで、初期レンダリングをこのCSSでブロックしない。
       noscriptはJS無効環境向けのフォールバック。 -->
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&family=IBM+Plex+Mono:wght@400;600;700&display=swap"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&family=IBM+Plex+Mono:wght@400;600;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&family=IBM+Plex+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </noscript>
  {jsonldFinal && <script type="application/ld+json" set:html={JSON.stringify(jsonldFinal)} />}
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonld)} />
  {breadcrumbJsonld && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonld)} />}
  <!-- 百度统计代码 -->
  <script is:inline>
    var _hmt = _hmt || [];
    (function() {
      var hm = document.createElement("script");
      hm.src = "https://hm.baidu.com/hm.js?d84361ca34153f1c434c38b9cb0e0bb5";
      var s = document.getElementsByTagName("script")[0];
      s.parentNode.insertBefore(hm, s);
    })();
  </script>
</head>
<body data-tool-slug={current ?? ''}>
  <SiteHeader current={current} />
  <slot name="hero" />
  <main class={wide ? 'page-wrapper wide' : 'page-wrapper'} style={themeStyle}>
    <slot />
  </main>
  {dateModifiedLabel && (
    <aside class="content-verification" aria-label="コンテンツの確認情報">
      <span>最終確認日：<time datetime={dateModified}>{dateModifiedLabel}</time></span>
      <a href="/editorial-policy/">制作・検証方針</a>
    </aside>
  )}
  <SiteFooter />
  <FloatingShare title={title} url={canonical} />
  <script is:inline>
    // 計算器の「結果表示」と関連ツール遷移を、入力値を送らずに計測する。
    // 自動計算は入力のたびに再描画されるため、各ページ側で初回表示だけを送信する。
    window.trackCalculatorResult = function(resultType) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'calculator_result_view', {
        tool_slug: document.body.dataset.toolSlug || 'unknown',
        result_type: resultType || 'default',
      });
    };

    document.addEventListener('click', function(event) {
      var link = event.target.closest('.related-link, .related-articles__item');
      if (!link || typeof window.gtag !== 'function') return;
      window.gtag('event', 'related_content_click', {
        tool_slug: document.body.dataset.toolSlug || 'unknown',
        destination: link.getAttribute('href') || '',
      });
    });
  </script>
</body>
</html>
