---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'kyuyo';
const title = '時給・残業代計算器 - 給与・手取り額を簡単に計算 | 計算ツール';
const description =
  '時給計算・残業代計算・手取り額の概算をその場で行える無料ツール。時給と労働時間から給与を、残業時間と割増率（通常1.25・深夜1.5・休日1.35）から残業代を計算し、月収から手取りの目安まで簡単に確認できます。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '時給・残業代計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 給与計算</div>
    <h1>時給・残業代計算器</h1>
    <p>時給・残業代・手取り額を、入力するだけで瞬時に計算します。割増率（通常・深夜・休日）にも対応。</p>
  </div>

  <div class="calc-card">
    <div class="calc-tabs" role="tablist">
      <button class="calc-tab active" data-tab="wage" type="button">時給計算</button>
      <button class="calc-tab" data-tab="ot" type="button">残業代計算</button>
      <button class="calc-tab" data-tab="net" type="button">手取り概算</button>
    </div>

    <div class="calc-panel active" id="panel-wage">
      <div class="field-group">
        <div class="field-group__title"><span class="field-group__title-text">給与の計算</span></div>
        <div class="field-grid">
          <div class="field">
            <label class="field__label" for="wage-rate">時給</label>
            <div class="field__box">
              <input type="number" id="wage-rate" inputmode="numeric" placeholder="例：1100" />
              <span class="field__suffix">円</span>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="wage-hours">労働時間</label>
            <div class="field__box">
              <input type="number" id="wage-hours" inputmode="decimal" placeholder="例：8" />
              <span class="field__suffix">時間</span>
            </div>
          </div>
        </div>
      </div>
      <div class="result-box" id="wage-result">
        <div class="result-label">給与（額面）</div>
        <div class="result-main" id="wage-pay">¥0</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">時給</span><span class="value" id="wage-disp-rate">¥0</span></div>
          <div class="result-row"><span class="label">労働時間</span><span class="value" id="wage-disp-hours">0 時間</span></div>
        </div>
      </div>
    </div>

    <div class="calc-panel" id="panel-ot">
      <details class="mini-tool" id="from-monthly">
        <summary>基本給から時給を計算する</summary>
        <p class="mini-note">時給が分からない場合は、基本給（月額）と1か月の平均所定労働時間から時給を求められます。</p>
        <div class="field-grid">
          <div class="field">
            <label class="field__label" for="fm-basic">基本給（月額）</label>
            <div class="field__box">
              <input type="number" id="fm-basic" inputmode="numeric" placeholder="例：250000" />
              <span class="field__suffix">円</span>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="fm-hours">月平均所定労働時間</label>
            <div class="field__box">
              <input type="number" id="fm-hours" inputmode="decimal" placeholder="例：160" />
              <span class="field__suffix">時間</span>
            </div>
          </div>
        </div>
        <div class="mini-result" id="fm-result">
          <span>計算した時給：<strong id="fm-wage">¥0</strong></span>
          <button type="button" id="fm-apply">この時給を使う</button>
        </div>
      </details>

      <div class="field-group">
        <div class="field-group__title"><span class="field-group__title-text">時給</span></div>
        <div class="field-grid">
          <div class="field field--full">
            <label class="field__label" for="ot-rate">時給</label>
            <div class="field__box">
              <input type="number" id="ot-rate" inputmode="numeric" placeholder="例：1100" />
              <span class="field__suffix">円</span>
            </div>
          </div>
        </div>
      </div>

      <div class="field-group">
        <div class="field-group__title"><span class="field-group__title-text">残業時間を区分ごとに入力（割増率は自動適用）</span></div>
        <div class="field-grid">
          <div class="field">
            <label class="field__label" for="ot-h-normal">通常残業（×1.25）</label>
            <div class="field__box">
              <input type="number" id="ot-h-normal" inputmode="decimal" placeholder="0" />
              <span class="field__suffix">時間</span>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="ot-h-night">深夜 22-5時（×1.5）</label>
            <div class="field__box">
              <input type="number" id="ot-h-night" inputmode="decimal" placeholder="0" />
              <span class="field__suffix">時間</span>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="ot-h-holiday">休日（×1.35）</label>
            <div class="field__box">
              <input type="number" id="ot-h-holiday" inputmode="decimal" placeholder="0" />
              <span class="field__suffix">時間</span>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="ot-h-over60">月60時間超（×1.5）</label>
            <div class="field__box">
              <input type="number" id="ot-h-over60" inputmode="decimal" placeholder="0" />
              <span class="field__suffix">時間</span>
            </div>
          </div>
        </div>
      </div>

      <div class="result-box" id="ot-result">
        <div class="result-label">残業代の合計</div>
        <div class="result-main" id="ot-pay">¥0</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">通常残業（×1.25）</span><span class="value" id="ot-r-normal">¥0</span></div>
          <div class="result-row"><span class="label">深夜（×1.5）</span><span class="value" id="ot-r-night">¥0</span></div>
          <div class="result-row"><span class="label">休日（×1.35）</span><span class="value" id="ot-r-holiday">¥0</span></div>
          <div class="result-row"><span class="label">月60時間超（×1.5）</span><span class="value" id="ot-r-over60">¥0</span></div>
        </div>
      </div>
    </div>

    <div class="calc-panel" id="panel-net">
      <div class="field-group">
        <div class="field-group__title"><span class="field-group__title-text">手取りの計算</span></div>
        <div class="field-grid">
          <div class="field field--full">
            <label class="field__label" for="net-income">月収（額面）</label>
            <div class="field__box">
              <input type="number" id="net-income" inputmode="numeric" placeholder="例：300000" />
              <span class="field__suffix">円</span>
            </div>
          </div>
        </div>
      </div>
      <div class="result-box" id="net-result">
        <div class="result-label">手取り額（概算）</div>
        <div class="result-main" id="net-take">¥0</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">月収（額面）</span><span class="value" id="net-gross">¥0</span></div>
          <div class="result-row"><span class="label">控除合計（概算 約22%）</span><span class="value red" id="net-ded">¥0</span></div>
        </div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>上のタブから計算したい種類を選び、金額を入力すると自動で結果が表示されます。ボタンを押す必要はありません。</p>

    <h2>給与の基礎知識</h2>
    <p>
      給与は、労働に対する対価として企業から支払われるお金です。給与は様々な要素から構成されており、額面給与から各種控除を差し引いた額が手取り額となります。
    </p>

    <h3>給与の構成要素</h3>
    <ul>
      <li><strong>基本給</strong>：定められた労働時間に対する基本的な給与</li>
      <li><strong>残業代</strong>：所定労働時間を超えて働いた場合の割増賃金</li>
      <li><strong>手当</strong>：通勤手当・住宅手当・家族手当・役職手当など</li>
      <li><strong>賞与</strong>：業績に応じて支払われる一時的な給与</li>
    </ul>

    <h3>残業代の割増率</h3>
    <p>
      残業代は労働基準法によって割増率が定められています。法定の最低割増率は以下の通りです。
    </p>
    <ul>
      <li><strong>通常残業</strong>：所定労働時間超えての労働 → 時給 × 1.25倍</li>
      <li><strong>深夜残業（22時〜5時）</strong>：深夜帯の労働 → 時給 × 1.5倍</li>
      <li><strong>休日労働</strong>：休日の労働 → 時給 × 1.35倍</li>
      <li><strong>月60時間超残業</strong>：1カ月の残業時間が60時間を超えた部分 → 時給 × 1.5倍</li>
    </ul>

    <h3>月60時間超割増の背景</h3>
    <p>
      月60時間を超える長時間労働は労働者の健康に悪影響を与えるとされ、2010年4月から大企業を対象に、2023年4月からは中小企業を対象に、月60時間を超える残業について50%以上の割増賃金（1.5倍）が義務付けられました。これは過労死対策の一環として導入されました。
    </p>

    <h3>基本給から時給を計算する方法</h3>
    <p>
      基本給（月額）から時給を求めるには、「基本給 ÷ 月平均所定労働時間」で計算します。例えば基本給25万円、月平均所定労働時間160時間の場合、時給は250,000 ÷ 160 = 1,562.5円となります。本ツールではこの計算を自動で行ってくれます。
    </p>
    <p>
      開始・終了時刻と休憩から実際の勤務時間を求める場合は、<a href="/jikan/">時間計算ツール</a>で時間・分と小数時間を計算してから入力できます。
    </p>

    <h3>手取り額の計算</h3>
    <p>
      手取り額は、額面給与から各種控除を差し引いた額です。主な控除項目は以下の通りです。
    </p>
    <ul>
      <li><strong>社会保険料</strong>：健康保険料（加入支部により異なる）、厚生年金保険料（9.15%）、雇用保険料（一般事業は0.5%）など</li>
      <li><strong>所得税</strong>：源泉徴収税額</li>
      <li><strong>住民税</strong>：都道府県民税と市町村民税（約10%）</li>
      <li><strong>その他</strong>：退職金拠出金、生命保険料、住宅ローン返済など</li>
    </ul>
    <p>
      <strong>手取り概算について：</strong>本ツールは令和8年度の給与所得控除・基礎控除、一般事業の雇用保険料率、全国平均の健康保険料率を用いた概算です。扶養・加入支部・住民税の自治体差・賞与などは完全には反映できないため、実際の給与明細とは異なる場合があります。金額の端数は<strong>切り捨て</strong>で計算しています。
    </p>

    <h3>給与明細の読み方</h3>
    <p>
      給与明細は以下のように構成されています。
    </p>
    <ol>
      <li><strong>支給項目</strong>：基本給、残業代、各種手当など</li>
      <li><strong>控除項目</strong>：社会保険料、所得税、住民税など</li>
      <li><strong>支給合計</strong>：支給項目の合計</li>
      <li><strong>控除合計</strong>：控除項目の合計</li>
      <li><strong>差引支給額</strong>：支給合計 − 控除合計（手取り額）</li>
    </ol>

    <div class="disclaimer">※ 計算結果はあくまで参考値です。特に手取り額は概算であり、実際の支給額とは異なります。正確な金額は勤務先・給与明細にてご確認ください。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '残業代はどう計算しますか？', a: '時給×割増率×残業時間で計算します。通常残業は1.25倍、深夜は1.5倍、休日は1.35倍などが基本です。本ツールで区分ごとに自動計算できます。' },
    { q: '月給から時給を求めるには？', a: '月給÷1か月の平均所定労働時間で求めます。本ツールは基本給と労働時間から時給を逆算できます。' },
    { q: '手取りも分かりますか？', a: '額面から社会保険料・税の概算を引いた手取りの目安を表示します（概算値です）。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { hourlyWage, takeHomePay, hourlyFromMonthly, overtimeBreakdown } from '../../lib/kyuyo.js';

  const yen = (n) => '¥' + Math.round(n).toLocaleString('ja-JP');
  const $ = (id) => document.getElementById(id);

  document.querySelectorAll('.calc-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.calc-tab').forEach((t) => t.classList.remove('active'));
      document.querySelectorAll('.calc-panel').forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      $('panel-' + tab.dataset.tab).classList.add('active');
      window.hideResultShare?.();
    });
  });

  function renderWage() {
    const rate = $('wage-rate').value;
    const hours = $('wage-hours').value;
    const { pay } = hourlyWage(rate, hours);
    const box = $('wage-result');
    if (pay <= 0) { box.classList.remove('visible'); window.hideResultShare?.(); return; }
    box.classList.add('visible');
    $('wage-pay').textContent = yen(pay);
    $('wage-disp-rate').textContent = yen(Number(rate));
    $('wage-disp-hours').textContent = Number(hours).toLocaleString('ja-JP') + ' 時間';
    window.setResultShare?.(
      `時給・残業代計算器\n給与（額面）：${$('wage-pay').textContent}\n時給：${$('wage-disp-rate').textContent}\n労働時間：${$('wage-disp-hours').textContent}`
    );
  }

  function renderOt() {
    const rate = $('ot-rate').value;
    const hours = {
      normal: $('ot-h-normal').value,
      night: $('ot-h-night').value,
      holiday: $('ot-h-holiday').value,
      over60: $('ot-h-over60').value,
    };
    const { normal, night, holiday, over60, total } = overtimeBreakdown(rate, hours);
    const box = $('ot-result');
    if (total <= 0) { box.classList.remove('visible'); window.hideResultShare?.(); return; }
    box.classList.add('visible');
    $('ot-pay').textContent = yen(total);
    $('ot-r-normal').textContent = yen(normal);
    $('ot-r-night').textContent = yen(night);
    $('ot-r-holiday').textContent = yen(holiday);
    $('ot-r-over60').textContent = yen(over60);
    window.setResultShare?.(
      `時給・残業代計算器\n残業代の合計：${$('ot-pay').textContent}\n通常残業（×1.25）：${$('ot-r-normal').textContent}\n深夜（×1.5）：${$('ot-r-night').textContent}\n休日（×1.35）：${$('ot-r-holiday').textContent}`
    );
  }

  // 基本給から時給を計算する小ツール
  let fmComputed = null;
  function renderFromMonthly() {
    const basic = $('fm-basic').value;
    const hours = $('fm-hours').value;
    fmComputed = hourlyFromMonthly(basic, hours);
    const box = $('fm-result');
    if (fmComputed === null || fmComputed <= 0) {
      box.classList.remove('visible');
      return;
    }
    box.classList.add('visible');
    $('fm-wage').textContent = yen(fmComputed);
  }

  function renderNet() {
    const income = $('net-income').value;
    const { takeHome, deduction } = takeHomePay(income);
    const box = $('net-result');
    if (takeHome <= 0) { box.classList.remove('visible'); window.hideResultShare?.(); return; }
    box.classList.add('visible');
    $('net-take').textContent = yen(takeHome);
    $('net-gross').textContent = yen(Number(income));
    $('net-ded').textContent = yen(deduction);
    window.setResultShare?.(
      `時給・残業代計算器\n手取り額（概算）：${$('net-take').textContent}\n月収（額面）：${$('net-gross').textContent}\n控除合計（概算 約22%）：${$('net-ded').textContent}`
    );
  }

  ['wage-rate', 'wage-hours'].forEach((id) => $(id).addEventListener('input', renderWage));
  ['ot-rate', 'ot-h-normal', 'ot-h-night', 'ot-h-holiday', 'ot-h-over60'].forEach((id) =>
    $(id).addEventListener('input', renderOt)
  );
  ['fm-basic', 'fm-hours'].forEach((id) => $(id).addEventListener('input', renderFromMonthly));
  $('fm-apply').addEventListener('click', () => {
    if (fmComputed === null || fmComputed <= 0) return;
    $('ot-rate').value = fmComputed;
    renderOt();
  });
  ['net-income'].forEach((id) => $(id).addEventListener('input', renderNet));
</script>

<style>
  .mini-tool {
    border: 1.5px solid var(--border-input);
    border-radius: var(--r-md);
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    background: var(--surface-sub);
  }
  .mini-tool > summary {
    cursor: pointer;
    font-weight: var(--fw-bold);
    color: var(--text);
    list-style: none;
    user-select: none;
  }
  .mini-tool > summary::-webkit-details-marker { display: none; }
  .mini-tool > summary::before {
    content: '＋ ';
    font-weight: var(--fw-black);
  }
  .mini-tool[open] > summary::before { content: '－ '; }
  .mini-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0.6rem 0;
  }
  .mini-result {
    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--border-input);
  }
  .mini-result.visible { display: flex; }
  .mini-result strong { font-size: 1.15rem; color: var(--text); }
  .mini-result button {
    border: none;
    border-radius: var(--r-md);
    min-height: 44px;
    padding: 0.4rem 1rem;
    background: var(--cat-color);
    color: #fff;
    font-size: 0.85rem;
    font-weight: var(--fw-bold);
    font-family: var(--font-sans);
    cursor: pointer;
  }
  .mini-result button:hover { opacity: 0.9; }
</style>
