---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import { SIGNS, ELEMENTS, signBySlug, seizaAisho, allPairs, pairPageCopy } from '../../lib/seiza-aisho.js';

export function getStaticPaths() {
  return allPairs().map((p) => ({
    params: { pair: `${p.slug1}-${p.slug2}` },
    props: p,
  }));
}

const { slug1, slug2 } = Astro.props;
const s1 = signBySlug(slug1);
const s2 = signBySlug(slug2);
const r = seizaAisho(slug1, slug2);
const same = slug1 === slug2;
const copy = pairPageCopy(slug1, slug2);
const pairLabel = same ? `${s1.name}同士` : `${s1.name}と${s2.name}`;

const pageSlug = `seiza-aisho/${slug1}-${slug2}`;
const RANK_LABELS = { '◎': 'とても良い相性', '○': '良い相性', '△': '工夫しだいの相性', '▲': '刺激し合う相性' };
const { title, description } = copy;

const base = 'https://keisantool.com';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.h1,
  description,
  url: `${base}/${pageSlug}/`,
  isPartOf: { '@type': 'WebApplication', name: '星座相性診断', url: `${base}/seiza-aisho/` },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${base}/` },
    { '@type': 'ListItem', position: 2, name: '占い・文化', item: `${base}/category/uranai/` },
    { '@type': 'ListItem', position: 3, name: '星座相性診断', item: `${base}/seiza-aisho/` },
    { '@type': 'ListItem', position: 4, name: `${s1.name}×${s2.name}`, item: `${base}/${pageSlug}/` },
  ],
};

// 「あなたが◯◯座」で相手を変えた12リンク（同組み合わせは除く）
const others = SIGNS.filter((s) => s.slug !== slug2).map((s) => ({
  href: `/seiza-aisho/${slug1}-${s.slug}/`,
  label: `${s1.name}×${s.name}`,
}));
---
<ToolLayout title={title} description={description} slug={pageSlug} current="seiza-aisho" jsonld={jsonld} breadcrumb={breadcrumb} robots="noindex,follow">
  <div class="page-hero">
    <div class="crumb">
      <a href="/">ホーム</a> ／ <a href="/category/uranai/">占い・文化</a> ／ <a href="/seiza-aisho/">星座相性</a> ／ {s1.name}×{s2.name}
    </div>
    <h1>{copy.h1}</h1>
    <p>{copy.intro}</p>
  </div>

  <div class="calc-card">
    <div class="sp-head">
      <div class="sp-sign">
        <span class="sp-symbol">{s1.symbol}</span>
        <span class="sp-name">{s1.name}</span>
        <span class="sp-role">あなた</span>
      </div>
      <div class="sp-x" aria-hidden="true">×</div>
      <div class="sp-sign">
        <span class="sp-symbol">{s2.symbol}</span>
        <span class="sp-name">{s2.name}</span>
        <span class="sp-role">相手</span>
      </div>
    </div>

    <div class="result-box visible sp-result">
      <div class="result-label">ふたりの相性度</div>
      <div class="result-main">{r.score}<span class="sp-unit">点</span></div>
      <div class="sp-rank">{r.rank} {RANK_LABELS[r.rank]}</div>
      <div class="sp-meter" aria-hidden="true"><span style={`width:${r.score}%`}></span></div>
      <div class="result-rows">
        <div class="result-row"><span class="label">アスペクト（角度の関係）</span><span class="value">{r.aspect.name}</span></div>
        <div class="result-row"><span class="label">エレメント</span><span class="value">{r.element1} × {r.element2}</span></div>
      </div>
      <p class="sp-comment">{r.comment}</p>
      <div class="sp-advice">
        <span class="sp-advice-label">うまく付き合うコツ</span>
        <p>{r.advice}</p>
      </div>
    </div>
  </div>

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>{s1.name}と{s2.name}、それぞれの性格</h2>
    {same ? (
      <p>ふたりとも{s1.name}の組み合わせです。長所も短所も共有する「鏡」のような関係なので、下の性格はそのままふたりに当てはまります。</p>
    ) : (
      <p>相性は「違い」を知ることから。まずはお互いの基本的な気質を見てみましょう。</p>
    )}
    <div class="sp-profiles">
      <div class="sp-profile">
        <div class="sp-profile-head">
          <span class="sp-profile-symbol">{s1.symbol}</span>
          <div>
            <div class="sp-profile-name">{s1.name}（{s1.kana}）<span class="sp-profile-role">あなた</span></div>
            <div class="sp-profile-meta">{s1.period}生まれ ／ {ELEMENTS[s1.element].label}</div>
          </div>
        </div>
        <div class="sp-traits">{s1.traits.map((t) => <span class="sp-trait">{t}</span>)}</div>
        <p>{s1.desc}</p>
      </div>
      <div class="sp-profile">
        <div class="sp-profile-head">
          <span class="sp-profile-symbol">{s2.symbol}</span>
          <div>
            <div class="sp-profile-name">{s2.name}（{s2.kana}）<span class="sp-profile-role">相手</span></div>
            <div class="sp-profile-meta">{s2.period}生まれ ／ {ELEMENTS[s2.element].label}</div>
          </div>
        </div>
        <div class="sp-traits">{s2.traits.map((t) => <span class="sp-trait">{t}</span>)}</div>
        <p>{s2.desc}</p>
      </div>
    </div>

    <h2 class="sp-h2">{pairLabel}の恋愛・友達・仕事の相性</h2>
    <p>総合点だけでは分かりにくい、関係別の長所と注意点をまとめました。</p>
    <div class="sp-relationships">
      <article class="sp-relationship">
        <h3><span aria-hidden="true">♡</span> 恋愛・結婚</h3>
        <p>{r.relationships.love}</p>
      </article>
      <article class="sp-relationship">
        <h3><span aria-hidden="true">♧</span> 友達・友情</h3>
        <p>{r.relationships.friendship}</p>
      </article>
      <article class="sp-relationship">
        <h3><span aria-hidden="true">◇</span> 仕事・職場</h3>
        <p>{r.relationships.work}</p>
      </article>
    </div>

    <h2 class="sp-h2">この相性度の根拠（計算方法）</h2>
    <p>
      本ツールの相性は、黄道十二宮で{s1.name}から{s2.name}が<strong>{r.aspect.distance}個離れた位置</strong>にあること（アスペクト：{r.aspect.name}）と、
      {same
        ? `ふたりが同じ${ELEMENTS[s1.element].label}のエレメントに属すること`
        : `${s1.name}が${ELEMENTS[s1.element].label}、${s2.name}が${ELEMENTS[s2.element].label}のエレメントに属すること`}
      から機械的に算出しています。トライン（120度・同エレメント）が92点で最高、スクエア（90度）が48点という7段階の判定基準は<a href="/seiza-aisho/">星座相性診断のトップページ</a>で公開しています。
    </p>
    <p>
      同じ誕生日の組み合わせなら結果は常に同じです。星座がわからない場合は<a href="/seiza/">星座調べ（誕生日から星座）</a>で確認できます。
    </p>
    <div class="disclaimer">
      ※ 星座占い・相性占いは娯楽・文化的慣習に基づくものであり、科学的根拠はありません。計算結果はあくまで参考値です。人間関係の大切な判断は、結果に頼らずご自身の責任でお決めください。
    </div>
  </section>

  <Faq items={[
    {
      q: `${s1.name}と${s2.name}の相性は何点ですか？`,
      a: `${s1.name}と${s2.name}の相性は${r.score}点で、${RANK_LABELS[r.rank]}です。西洋占星術のアスペクト（${r.aspect.name}）と、${same ? `ふたりとも${ELEMENTS[s1.element].label}のエレメント` : `${ELEMENTS[s1.element].label}×${ELEMENTS[s2.element].label}のエレメントの組み合わせ`}から機械的に算出しています。`,
    },
    {
      q: `${s1.name}×${s2.name}と${s2.name}×${s1.name}で相性度は変わりますか？`,
      a: same
        ? `${s1.name}同士の組み合わせのため、順番を入れ替えても同じ相性になります。`
        : `変わりません。エレメントとアスペクトの関係は対称なので、あなたが${s1.name}でも${s2.name}でも相性度は同じ${r.score}点です。`,
    },
    {
      q: `${pairLabel}の恋愛相性を良くするコツは？`,
      a: r.relationships.love,
    },
    {
      q: '星座相性の結果はどこまで信用できますか？',
      a: '星座占い・相性占いは娯楽・文化的慣習に基づくものであり、科学的根拠はありません。判定基準は星座相性診断のトップページで公開していますが、人間関係の大切な判断はご自身の責任でお決めください。',
    },
  ]} />

  <section class="sp-links">
    <h2>ほかの組み合わせも見る</h2>
    {!same && (
      <p class="sp-reverse">
        逆から見た相性はこちら：<a href={`/seiza-aisho/${slug2}-${slug1}/`}>{s2.name}×{s1.name}の相性（あなたが{s2.name}の場合）</a>
      </p>
    )}
    <div class="sp-links-grid">
      {others.map((o) => <a href={o.href}>{o.label}</a>)}
      <a href="/seiza-aisho/" class="sp-links-hub">相性表にもどる</a>
    </div>
  </section>

  <RelatedTools current="seiza-aisho" />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .sp-head { display: flex; align-items: center; justify-content: center; gap: 22px; padding-bottom: 18px; }
  .sp-sign { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .sp-symbol { font-size: 2.2rem; line-height: 1.2; color: var(--cat-color); }
  .sp-name { font-size: 1rem; font-weight: var(--fw-bold); color: var(--text); }
  .sp-role { font-size: .7rem; font-weight: var(--fw-bold); color: var(--text-muted); background: var(--surface-sub); border-radius: var(--r-pill); padding: 2px 10px; margin-top: 2px; }
  .sp-x { font-size: 1.3rem; font-weight: var(--fw-black); color: var(--text-faint); }
  .sp-unit { font-size: 1.2rem; font-weight: var(--fw-bold); margin-left: 4px; }
  .sp-rank { font-size: 1rem; font-weight: var(--fw-bold); color: color-mix(in srgb, var(--cat-color) 62%, #000); margin-top: 4px; }
  .sp-meter { height: 10px; border-radius: var(--r-pill); background: color-mix(in srgb, var(--cat-color) 14%, #fff); margin-top: 12px; overflow: hidden; }
  .sp-meter span { display: block; height: 100%; border-radius: var(--r-pill); background: var(--cat-color); }
  .sp-comment { font-size: .88rem; color: var(--text); line-height: 1.85; margin: 16px 0 0; }
  .sp-advice { margin-top: 14px; background: var(--surface); border-radius: var(--r-md); padding: 12px 14px; }
  .sp-advice-label { display: inline-block; font-size: .74rem; font-weight: var(--fw-bold); color: var(--cat-color); margin-bottom: 4px; }
  .sp-advice p { font-size: .84rem; color: var(--text-3); line-height: 1.75; margin: 0; }

  .sp-profiles { display: grid; gap: 12px; margin: 14px 0 6px; }
  @media (min-width: 640px) { .sp-profiles { grid-template-columns: 1fr 1fr; } }
  .sp-profile { border: 1.5px solid var(--border-2); border-radius: var(--r-md); padding: 14px 16px; background: var(--surface); }
  .sp-profile-head { display: flex; align-items: center; gap: 10px; }
  .sp-profile-symbol { font-size: 1.6rem; color: var(--cat-color); }
  .sp-profile-name { font-size: .95rem; font-weight: var(--fw-bold); color: var(--text); }
  .sp-profile-role { font-size: .68rem; font-weight: var(--fw-bold); color: var(--cat-color); background: var(--cat-tint); border-radius: var(--r-pill); padding: 2px 8px; margin-left: 6px; }
  .sp-profile-meta { font-size: .76rem; color: var(--text-muted); margin-top: 2px; }
  .sp-traits { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
  .sp-trait { font-size: .72rem; font-weight: var(--fw-bold); color: color-mix(in srgb, var(--cat-color) 62%, #000); background: var(--cat-tint); border-radius: var(--r-pill); padding: 3px 10px; }
  .sp-profile p { font-size: .84rem; color: var(--text-3); line-height: 1.8; margin: 0; }
  .sp-h2 { margin-top: 24px; }
  .sp-relationships { display: grid; gap: 10px; margin-top: 14px; }
  .sp-relationship { border: 1.5px solid var(--border-2); border-radius: var(--r-md); background: var(--surface); padding: 14px 16px; }
  .sp-relationship h3 { font-size: .9rem; color: var(--text); margin: 0 0 7px; }
  .sp-relationship h3 span { color: var(--cat-color); margin-right: 4px; }
  .sp-relationship p { font-size: .84rem; color: var(--text-3); line-height: 1.8; margin: 0; }
  @media (min-width: 760px) { .sp-relationships { grid-template-columns: repeat(3, 1fr); } }

  .sp-links { max-width: 880px; width: 100%; margin: 32px auto 0; }
  .sp-links h2 { font-size: 1.05rem; font-weight: var(--fw-black); color: var(--text); margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
  .sp-links h2::before { content: ''; width: 6px; height: 1.1em; background: var(--cat-color); border-radius: 3px; }
  .sp-reverse { font-size: .86rem; color: var(--text-3); margin-bottom: 12px; }
  .sp-reverse a { color: var(--cat-color); font-weight: var(--fw-bold); }
  .sp-links-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .sp-links-grid a {
    display: inline-block; padding: 8px 13px; border: 1.5px solid var(--border-2); border-radius: var(--r-pill);
    font-size: .8rem; color: var(--text-3); text-decoration: none; background: var(--surface); transition: all var(--ease);
  }
  .sp-links-grid a:hover { background: var(--cat-tint); border-color: var(--cat-color); color: var(--text); }
  .sp-links-grid .sp-links-hub { border-color: var(--cat-color); color: var(--cat-color); font-weight: var(--fw-bold); }
</style>
