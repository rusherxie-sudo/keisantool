---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'shotokuzei';
const title = '所得税計算器 - 年収から所得税を概算 | 計算ツール';
const description =
  '年収から所得税の目安を計算。給与所得控除・基礎控除・復興特別所得税を反映し、月額換算まで確認できる無料ツールです。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '所得税計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/zeikin/">税金・お金</a> ／ 所得税</div>
    <h1>所得税計算器</h1>
    <p>年収から所得税の目安を計算します。給与所得控除・基礎控除・復興特別所得税を反映します。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="yearly-salary">年間給与収入（円）</label>
      <input type="number" id="yearly-salary" inputmode="numeric" placeholder="例：3600000" />
    </div>

    <div class="form-group"><label for="extra-deductions">基礎控除以外の所得控除合計（円）</label><input type="number" id="extra-deductions" min="0" inputmode="numeric" placeholder="例：540000" /><p>社会保険料・扶養・保険料控除等の計算済み額。給与所得控除・基礎控除は入力不要。住宅ローン控除等の税額控除は含めません。</p></div>
    <div class="result-box" id="result-box">
      <div class="result-label">所得税＋復興特別所得税（年額の目安）</div>
      <div class="result-main" id="result-tax">¥0</div>
      <div class="result-rows">
        <div class="result-row"><span class="label">年間給与収入</span><span class="value" id="row-salary">¥0</span></div>
        <div class="result-row"><span class="label">給与所得控除</span><span class="value" id="row-deduction">¥0</span></div>
        <div class="result-row"><span class="label">基礎控除</span><span class="value" id="row-basic">¥0</span></div>
        <div class="result-row"><span class="label">課税所得</span><span class="value" id="row-taxable">¥0</span></div>
        <div class="result-row"><span class="label">年額 ÷ 12（源泉徴収額とは別）</span><span class="value" id="row-monthly">¥0</span></div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>2026年分の年税額を計算する手順</h2>
    <p>給与収入から給与所得控除を差し引き、給与所得を求めます。そこから基礎控除と入力した所得控除を差し引き、1,000円未満を切り捨てた課税所得に税率を適用します。最後に所得税本税の2.1%の復興特別所得税を加算します。</p>
    <p>2026年分は給与所得控除の最低保障額74万円、合計所得489万円以下の基礎控除104万円を反映しています。合計所得がそれを超える場合は対応する控除額に切り替えます。改正は2026年12月1日施行で年末精算に適用されるため、それ以前の毎月の源泉徴収表による金額とは一致しません。</p>
    <h3>給与360万円・追加控除54万円の例</h3>
    <p>給与所得244万円 − 基礎控除104万円 − 追加控除54万円 ＝ 課税所得86万円。所得税43,000円と復興特別所得税903円を合わせて43,903円です。追加控除を0円にすると71,470円となるため、支払った社会保険料等を確認して入力してください。</p>
    <h3>対象と限界</h3>
    <p>給与以外の所得がない居住者の概算です。所得金額調整控除、住宅ローン控除等の税額控除、外国税額控除、申告時の最終納付額の100円未満処理は反映しません。年額÷12は平均額で、給与から天引きする税額ではありません。年末調整の100円単位の精算は<a href="/nematsu/">年末調整計算</a>で確認できます。</p>
    <h3>根拠（2026年10月10日照合）</h3>
    <p><a href="https://www.nta.go.jp/taxes/shiraberu/taxanswer/shotoku/1410.htm">国税庁・給与所得控除</a>、<a href="https://www.nta.go.jp/taxes/shiraberu/taxanswer/shotoku/1199.htm">基礎控除</a>、<a href="https://www.nta.go.jp/taxes/shiraberu/taxanswer/shotoku/2260.htm">所得税の税率</a>。確認範囲は給与所得表・控除額・税率・上記算例です。</p>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[{ q: '基礎控除も入力しますか？', a: '給与所得控除と基礎控除は自動計算するため入力しません。それ以外の所得控除の合計だけを入力します。' }, { q: '住民税も含まれますか？', a: '含みません。住民税は前年の所得と異なる控除額を使うため、住民税計算器をご利用ください。' }]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { calcShotokuzei } from '../../lib/shotokuzei.js';

  const $ = (id) => document.getElementById(id);
  const yen = (n) => '¥' + Math.floor(n).toLocaleString('ja-JP');

  function show(box) { box.classList.add('visible'); }
  function hide(box) { box.classList.remove('visible'); window.hideResultShare?.(); }

  function render() {
    const box = $('result-box');
    const salary = $('yearly-salary').value;
    const result = calcShotokuzei(salary, $('extra-deductions').value);
    
    if (result.yearlySalary === 0) return hide(box);
    
    show(box);
    $('result-tax').textContent = yen(result.incomeTax);
    $('row-salary').textContent = yen(result.yearlySalary);
    $('row-deduction').textContent = yen(result.salaryDeduction);
    $('row-basic').textContent = yen(result.basicDeduction);
    $('row-taxable').textContent = yen(result.taxableIncome);
    $('row-monthly').textContent = yen(result.monthlyTax);

    window.setResultShare?.(
      '所得税計算器\n年間給与収入：' + $('row-salary').textContent +
      '\n課税所得：' + $('row-taxable').textContent +
      '\n所得税：' + $('result-tax').textContent +
      '\n月額換算：' + $('row-monthly').textContent
    );
  }

  ['yearly-salary', 'extra-deductions'].forEach(id => $(id).addEventListener('input', render));
</script>
