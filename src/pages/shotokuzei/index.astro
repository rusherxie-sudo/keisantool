---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'shotokuzei';
const title = '所得税計算器 - 年収から所得税を概算 | 計算ツール';
const description =
  '年収から所得税の目安を計算。給与所得控除・基礎控除・復興特別所得税を反映し、月額換算まで確認できる無料ツールです。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '所得税計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/zeikin/">税金・お金</a> ／ 所得税</div>
    <h1>所得税計算器</h1>
    <p>年収から所得税の目安を計算します。給与所得控除・基礎控除・復興特別所得税を反映します。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="yearly-salary">年間給与収入（円）</label>
      <input type="number" id="yearly-salary" inputmode="numeric" placeholder="例：3600000" />
    </div>

    <div class="result-box" id="result-box">
      <div class="result-label">所得税（年額）</div>
      <div class="result-main" id="result-tax">¥0</div>
      <div class="result-rows">
        <div class="result-row"><span class="label">年間給与収入</span><span class="value" id="row-salary">¥0</span></div>
        <div class="result-row"><span class="label">給与所得控除</span><span class="value" id="row-deduction">¥0</span></div>
        <div class="result-row"><span class="label">課税所得</span><span class="value" id="row-taxable">¥0</span></div>
        <div class="result-row"><span class="label">所得税（月額）</span><span class="value" id="row-monthly">¥0</span></div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>年間給与収入を入力すると、給与所得控除・基礎控除を反映した所得税の目安を計算します。</p>

    <h2>所得税の基礎知識</h2>
    <p>
      所得税は、一年間の所得に対して納める税金です。会社員の場合は毎月給与から源泉徴収され、年末に年末調整で精算されます。個人事業主の場合は確定申告で自分で計算して納めます。
    </p>

    <h3>計算の流れ</h3>
    <p>所得税は以下のステップで計算されます：</p>
    <ol>
      <li>年間給与収入を確認する</li>
      <li>給与所得控除を差し引いて給与所得を求める</li>
      <li>基礎控除や社会保険料控除など各種控除を差し引いて課税所得を求める</li>
      <li>課税所得に応じた税率をかけて税額を計算する</li>
      <li>復興特別所得税を加える</li>
    </ol>

    <h3>給与所得控除（令和7年税制改正後）</h3>
    <p>給与所得控除は、給与所得者の必要経費として認められる控除額です。年収に応じて次のように計算されます。</p>
    <ul>
      <li>年収190万円以下：最低控除65万円</li>
      <li>年収190万円超〜360万円：控除 = 収入×30%+8万円</li>
      <li>年収360万円超〜660万円：控除 = 収入×20%+44万円</li>
      <li>年収660万円超〜850万円：控除 = 収入×10%+110万円</li>
      <li>年収850万円超：控除上限195万円</li>
    </ul>

    <h3>所得税税率（令和8年度）</h3>
    <p>所得税は累進課税で、課税所得が多くなるほど税率が高くなります。速算控除は、累進課税の計算を簡単にするための控除額です。</p>
    <ul>
      <li>課税所得195万円以下：5%</li>
      <li>課税所得195万円超〜330万円：10%（速算控除97,500円）</li>
      <li>課税所得330万円超〜695万円：20%（速算控除427,500円）</li>
      <li>課税所得695万円超〜900万円：23%（速算控除636,000円）</li>
      <li>課税所得900万円超〜1,800万円：33%（速算控除1,536,000円）</li>
      <li>課税所得1,800万円超〜4,000万円：40%（速算控除2,796,000円）</li>
      <li>課税所得4,000万円超：45%（速算控除4,796,000円）</li>
    </ul>

    <h3>復興特別所得税</h3>
    <p>
      東日本大震災の復興費用を賄うために導入された特別な所得税です。所得税額の2.1%が追加されます（所得税額 × 1.021）。本ツールの計算結果には復興特別所得税は含まれておりません。
    </p>

    <h3>よくある控除項目</h3>
    <ul>
      <li><strong>基礎控除</strong>：すべての人が受けられる48万円の控除</li>
      <li><strong>社会保険料控除</strong>：健康保険料・厚生年金保険料などの支払額</li>
      <li><strong>生命保険料控除</strong>：生命保険料の一部が控除される（最高12万円）</li>
      <li><strong>扶養控除</strong>：扶養家族がいる場合に受けられる控除（1人につき38万〜63万円）</li>
      <li><strong>配偶者控除</strong>：配偶者がいる場合の控除（最高38万円）</li>
      <li><strong>ふるさと納税控除</strong>：ふるさと納税の寄付額が控除される</li>
    </ul>

    <div class="disclaimer">※ 計算結果はあくまで参考値です。社会保険料控除・扶養控除・生命保険料控除などは入力できないため、実際の税額とは異なります。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '所得税はどう計算されますか？', a: '所得税は「給与所得 − 給与所得控除 = 課税所得」を計算し、課税所得に応じた税率で計算されます。本ツールでは令和7年税制改正後の給与所得控除と令和8年度の税率を適用しています。' },
    { q: '給与所得控除とは何ですか？', a: '給与所得控除は、給与所得から差し引かれる一定額で、給与生活者の生活費などを考慮して設けられた制度です。年収に応じて控除額が変わります。' },
    { q: '計算結果は実際の税額と同じですか？', a: '本ツールは一般的な計算式を用いていますが、扶養控除やその他の控除、源泉徴収のタイミングなどにより実際の税額とは異なる場合があります。年末調整時に最終的な税額が確定します。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { calcShotokuzei } from '../../lib/shotokuzei.js';

  const $ = (id) => document.getElementById(id);
  const yen = (n) => '¥' + Math.floor(n).toLocaleString('ja-JP');

  function show(box) { box.classList.add('visible'); }
  function hide(box) { box.classList.remove('visible'); window.hideResultShare?.(); }

  function render() {
    const box = $('result-box');
    const salary = $('yearly-salary').value;
    const result = calcShotokuzei(salary);
    
    if (result.yearlySalary === 0) return hide(box);
    
    show(box);
    $('result-tax').textContent = yen(result.incomeTax);
    $('row-salary').textContent = yen(result.yearlySalary);
    $('row-deduction').textContent = yen(result.salaryDeduction);
    $('row-taxable').textContent = yen(result.taxableIncome);
    $('row-monthly').textContent = yen(result.monthlyTax);

    window.setResultShare?.(
      '所得税計算器\n年間給与所得：' + $('row-salary').textContent +
      '\n課税所得：' + $('row-taxable').textContent +
      '\n所得税：' + $('result-tax').textContent +
      '\n月額換算：' + $('row-monthly').textContent
    );
  }

  $('yearly-salary').addEventListener('input', render);
</script>
