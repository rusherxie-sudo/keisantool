---
import ToolLayout from '../layouts/ToolLayout.astro';
import Icon from '../components/Icon.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { tools, categories, categoryMeta, categoryColors, getTool } from '../data/tools.js';

const catSlug = (name) => categoryMeta.find((c) => c.name === name)?.slug;
const catId = (name) => categoryColors[name]?.id;
const catStyle = (name) => {
  const c = categoryColors[name];
  return c ? `--cat-color:${c.accent};--cat-tint:${c.tint}` : '';
};

const title = '無料計算ツール一覧 - 税金・健康・占い・給与・日付の計算 | 計算ツール';
const description =
  '消費税・BMI・厄年・出産予定日・給与・偏差値・国民健康保険料など、日常で使える計算ツールを無料でまとめました。すべてブラウザ上でその場で計算できます。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '計算ツール',
  url: 'https://keisantool.com/',
  description,
};

// サイト全体を代表する Organization を明示（GEO監査 2026-07-04 指摘：エンティティ認識の手がかりが無かった）。
// sameAs は今後、外部プロフィール（X等）を開設した際にここへ追記する。
const organizationJsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '計算ツール',
  url: 'https://keisantool.com/',
  description,
};

// 高頻ツール（首页ローカルの固定 slug リスト。tools.js のメタ構造は変えない）
// rokusei は GSC 実測で全站クリックの 2/3 を占めるトップページ（2026-07 レビュー）。
const FEATURED = ['rokusei', 'zeizei', 'nenrei', 'bmi', 'color-code', 'kyuyo'];
const featured = FEATURED.map(getTool).filter(Boolean);

const byCategory = categories
  .map((c) => ({ name: c, items: tools.filter((t) => t.category === c && t.live !== false) }))
  .filter((c) => c.items.length > 0);

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);
---
<ToolLayout title={title} description={description} slug="" current="" jsonld={jsonld} wide={true}>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonld)} />
  <div slot="hero" class="home-hero">
    <div class="home-hero__inner">
      <h1>無料計算ツール一覧</h1>
      <p>税金・健康・日付・変換を、ブラウザですぐ計算。</p>
    </div>
  </div>

  <!-- よく使われるツール -->
  <section class="home-featured">
    <div class="home-h2-row">
      <h2 class="home-h2">よく使われるツール</h2>
    </div>
    <div class="featured-grid">
      {featured.map((t) => (
        <a href={`/${t.slug}/`} class="featured-card" style={catStyle(t.category)}>
          <span class="featured-card__ic"><Icon name={t.slug} size={22} /></span>
          <span class="featured-card__body">
            <span class="featured-card__name">{t.nav}</span>
            <span class="featured-card__desc">{t.short}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 工作台：左 rail + 右 矩阵 -->
  <div class="workbench" id="all-tools">
    <aside class="cat-rail" aria-label="カテゴリ">
      <a href="#all-tools" class="rail-item is-active" data-rail="all-tools"><Icon name="grid" size={18} />すべて</a>
      {byCategory.map((cat) => (
        <a href={`#cat-${catId(cat.name)}`} class="rail-item" data-rail={`cat-${catId(cat.name)}`} style={catStyle(cat.name)}>
          <span class="rail-item__ic"><Icon name={catId(cat.name)} size={18} /></span>{cat.name}
        </a>
      ))}
    </aside>

    <div class="cat-matrix">
      {byCategory.map((cat) => (
        <section class="cat-block" id={`cat-${catId(cat.name)}`} style={catStyle(cat.name)}>
          <div class="cat-block__head">
            <h2 class="cat-block__title">{cat.name}</h2>
            {catSlug(cat.name) && (
              <a href={`/category/${catSlug(cat.name)}/`} class="cat-block__all">一覧を見る<Icon name="arrow" size={15} /></a>
            )}
          </div>
          <div class="tool-cards">
            {cat.items.map((t) => (
              <a href={`/${t.slug}/`} class="tool-card2">
                <span class="tool-card2__ic"><Icon name={t.slug} size={22} /></span>
                <span class="tool-card2__body">
                  <span class="tool-card2__name">{t.name}</span>
                  <span class="tool-card2__desc">{t.short}</span>
                </span>
                <span class="tool-card2__chev"><Icon name="chevron" size={18} /></span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <!-- 最新ブログ記事 -->
  <section class="home-blog">
    <div class="home-h2-row">
      <h2 class="home-h2">最新コラム</h2>
      <a href="/blog/" class="cat-block__all">一覧を見る<Icon name="arrow" size={15} /></a>
    </div>
    <div class="blog-grid">
      {recentPosts.map((p) => (
        <BlogCard post={p} />
      ))}
    </div>
  </section>

  <section class="home-value" aria-labelledby="home-value-title">
    <div class="home-value__intro">
      <p class="home-value__eyebrow">計算ツールについて</p>
      <h2 id="home-value-title">答えだけでなく、計算の根拠まで確認できます</h2>
      <p>
        keisantool.com は、日常で迷いやすい数字をその場で確かめるための無料ツール集です。税金・社会保険・健康・日付などの計算では、入力欄と結果だけを置くのではなく、計算式、対象となる条件、端数処理、具体例、結果を使う際の注意点をできる限り同じページに掲載しています。
      </p>
      <p>
        入力内容は原則としてブラウザ内で処理され、計算のために当サイトのサーバーへ送信されません。制度や料率を扱うページは国税庁、厚生労働省、自治体などの一次情報を優先し、改正時に見直します。詳しい確認手順は<a href="/editorial-policy/">制作・検証方針</a>で公開しています。
      </p>
    </div>
    <div class="home-value__grid">
      <article>
        <span aria-hidden="true">01</span>
        <h3>用途から選べる</h3>
        <p>税金・健康・生活・日付・変換など、目的別のカテゴリと関連記事から必要なツールを探せます。</p>
      </article>
      <article>
        <span aria-hidden="true">02</span>
        <h3>計算過程がわかる</h3>
        <p>式や内訳、入力例を示し、「なぜその結果になるか」を自分で確かめられる構成にしています。</p>
      </article>
      <article>
        <span aria-hidden="true">03</span>
        <h3>限界も明記する</h3>
        <p>概算に含まれない条件や個人差、確認すべき公的窓口を示し、結果だけで判断しないための注意点を掲載します。</p>
      </article>
    </div>
  </section>
</ToolLayout>

<script>
  // rail スクロールスパイ（現在見えているカテゴリをハイライト）
  const railItems = Array.from(document.querySelectorAll('.rail-item'));
  const blocks = Array.from(document.querySelectorAll('.cat-block'));
  const byId = new Map(railItems.map((el) => [el.getAttribute('data-rail'), el]));
  if ('IntersectionObserver' in window && blocks.length) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            railItems.forEach((r) => r.classList.remove('is-active'));
            byId.get(e.target.id)?.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    blocks.forEach((b) => obs.observe(b));
  }
</script>

<style>
  .home-value {
    margin: 42px 0 10px;
    padding: 32px;
    border: 1.5px solid var(--border);
    border-radius: var(--r-3xl);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .home-value__intro { max-width: 760px; }
  .home-value__eyebrow {
    margin: 0 0 7px;
    color: var(--brand);
    font-size: .76rem;
    font-weight: var(--fw-black);
    letter-spacing: .08em;
  }
  .home-value h2 { margin: 0 0 14px; font-size: clamp(1.25rem, 2.5vw, 1.65rem); }
  .home-value__intro > p:not(.home-value__eyebrow) { margin: 0 0 12px; color: var(--text-2); line-height: 1.9; }
  .home-value a { color: var(--brand); font-weight: var(--fw-bold); }
  .home-value__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 22px; }
  .home-value__grid article { padding: 18px; border-radius: var(--r-xl); background: var(--surface-sub); }
  .home-value__grid span { color: var(--brand); font-family: var(--font-mono); font-size: .75rem; font-weight: var(--fw-bold); }
  .home-value__grid h3 { margin: 7px 0; font-size: .98rem; }
  .home-value__grid p { margin: 0; color: var(--text-3); font-size: .84rem; line-height: 1.75; }
  @media (max-width: 680px) {
    .home-value { margin-top: 30px; padding: 24px 18px; }
    .home-value__grid { grid-template-columns: 1fr; }
  }
</style>
