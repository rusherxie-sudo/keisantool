---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import {
  warekiLabels,
  etoYomi,
  rokuseiSegments,
  yakudoshiSeirekiYears,
  ageYearTable,
  UMAREDOSHI_FROM,
  UMAREDOSHI_TO,
} from '../../lib/hayami.js';
import { kazoedoshi } from '../../lib/nenrei.js';
import { polarity } from '../../lib/rokusei.js';
import { getColorByCategory } from '../../data/tools.js';
import { japanDateParts } from '../../lib/japanDate.js';

export function getStaticPaths() {
  // 範囲は src/lib/hayami.js の UMAREDOSHI_FROM/TO（ハブ表のリンク範囲と共通）
  const paths = [];
  for (let y = UMAREDOSHI_FROM; y <= UMAREDOSHI_TO; y++) paths.push({ params: { year: String(y) } });
  return paths;
}

const year = Number(Astro.params.year);

// 基準年はビルド時に固定（毎年1月1日の再ビルドで自動更新される）。
const { year: BASE_YEAR } = japanDateParts();
const BASE_WAREKI = warekiLabels(BASE_YEAR); // 例：令和8年

const wareki = warekiLabels(year);
const e = etoYomi(year);
const age = BASE_YEAR - year; // 誕生日を迎えた後の満年齢
const kazoe = kazoedoshi(year, BASE_YEAR);
const ageRows = ageYearTable(year, BASE_YEAR - 5, BASE_YEAR + 5);
const pol = polarity(year); // 六星占術の陽陰（年支で決まる＝同年生まれは全員同じ）
const polMark = pol === 'プラス' ? '（＋）' : '（−）';
const segs = rokuseiSegments(year);
const segsFirstHalf = segs.filter((s) => s.from.month <= 6);
const segsSecondHalf = segs.filter((s) => s.from.month >= 7);
const yakuM = yakudoshiSeirekiYears(year, 'male');
const yakuF = yakudoshiSeirekiYears(year, 'female');
const hitM = yakuM.filter((r) => r.year === BASE_YEAR);
const hitF = yakuF.filter((r) => r.year === BASE_YEAR);
const honyakuListM = yakuM.filter((r) => r.kind === '本厄');
const honyakuListF = yakuF.filter((r) => r.kind === '本厄');

const prevYear = year > UMAREDOSHI_FROM ? year - 1 : null;
const nextYear = year < UMAREDOSHI_TO ? year + 1 : null;

const slug = `umaredoshi/${year}`;
const canonicalUrl = new URL(`/umaredoshi/${year}/`, Astro.site).href;
const usageCopy = age >= 100
  ? '家族史・人物年譜などで、生年と出来事の年から当時の年齢を確認できます。'
  : age >= 65
    ? '家族の年齢確認や長寿祝いの準備に、満年齢と数え年を区別して使えます。'
    : age >= 18
      ? '履歴書の年齢確認や、過去の出来事が何歳のころだったかを調べる際に使えます。'
      : '学校・進学の予定を確認する際に使えます。学年は誕生日の4月1日・4月2日の境界も確認してください。';
const milestoneAges = [20, 40, 60, 80].filter((value) => year + value <= BASE_YEAR);

const title = `${year}年生まれは何歳？${BASE_YEAR}年は${age - 1}歳・${age}歳｜年齢早見表・干支・厄年 | 計算ツール`;
const description = `${year}年（${wareki}）生まれは、${BASE_YEAR}年の誕生日前なら満${age - 1}歳、誕生日を迎えると満${age}歳です。数え年は${kazoe}歳、干支は${e.kanji}（${e.yomi}）。${usageCopy}`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
};

// ハブ配下のページとして手動でパンくずを出す（tools.js 未登録のため ToolLayout の自動注入は効かない）
const breadcrumbJsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: '年齢早見表', item: new URL('/nenrei-hayami/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: `${year}年生まれ`, item: canonicalUrl },
  ],
};

// テーマ色：未登録slugのため ToolLayout はブランド色にフォールバックする。
// ハブ（生活・日常）と同族に見せたいので、ページ側でカテゴリ色を上書きする。
const color = getColorByCategory('生活・日常');
---
<ToolLayout title={title} description={description} slug={slug} current="umaredoshi" jsonld={jsonld}>
  <div class="um-root" style={`--cat-color:${color.accent};--cat-tint:${color.tint}`}>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonld)} />

    <div class="page-hero">
      <div class="crumb"><a href="/">ホーム</a> ／ <a href="/nenrei-hayami/">年齢早見表</a> ／ {year}年生まれ</div>
      <h1>{year}年生まれは何歳？{BASE_YEAR}年の年齢早見表</h1>
      <p>
        {year}年（{wareki}）生まれの場合、<strong>{BASE_YEAR}年（{BASE_WAREKI}）の誕生日前は満{age - 1}歳、誕生日を迎えると満{age}歳</strong>です。{usageCopy}
      </p>
    </div>

    <div class="calc-card">
      <div class="um-summary">
        <div class="um-main">
          <div class="um-main-label">{BASE_YEAR}年の誕生日で</div>
          <div class="um-main-num">満{age}歳</div>
          <div class="um-main-sub">誕生日前は {age - 1}歳</div>
        </div>
        <dl class="um-facts">
          <div class="um-fact"><dt>数え年</dt><dd>{kazoe}歳</dd></div>
          <div class="um-fact"><dt>和暦</dt><dd>{wareki}</dd></div>
          <div class="um-fact"><dt>干支</dt><dd>{e.kanji}（{e.yomi}）年</dd></div>
          <div class="um-fact"><dt>六星占術の陽陰</dt><dd>{pol}{polMark}</dd></div>
        </dl>
      </div>
      <div class="um-exact-age">
        <div class="form-group">
          <label for="birth-date">誕生日を入力して今日の満年齢を確認</label>
          <input type="date" id="birth-date" min={`${year}-01-01`} max={`${year}-12-31`} data-birth-year={year} />
        </div>
        <p id="exact-age-result" class="um-exact-result" aria-live="polite">月日まで入力すると、今日時点の正確な年齢を表示します。</p>
      </div>
    </div>

    <section class="howto um-section">
      <h2>{year}年生まれの年齢早見表（{BASE_YEAR - 5}〜{BASE_YEAR + 5}年）</h2>
      <p>
        満年齢は誕生日を迎えると1歳増えます。{year}年生まれは今年（{BASE_YEAR}年）の<strong>誕生日前が満{age - 1}歳、誕生日後が満{age}歳</strong>です。前後5年の年齢は次の表で確認できます。
      </p>
      <div class="data-table-wrap">
        <div class="data-table-scroll">
          <table class="data-table um-table um-age-table">
            <thead><tr><th>西暦（和暦）</th><th>誕生日前</th><th>誕生日後</th><th>数え年</th></tr></thead>
            <tbody>
              {ageRows.map((r) => (
                <tr class={r.year === BASE_YEAR ? 'is-hit' : undefined}>
                  <td>{r.year}年<br /><span class="num--sub">（{r.wareki}）</span>{r.year === BASE_YEAR && <span class="data-table__badge">今年</span>}</td>
                  <td class="num">満{r.beforeBirthday}歳</td>
                  <td class="num">満{r.afterBirthday}歳</td>
                  <td class="num">{r.kazoe}歳</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="um-note">生まれた月日まで入力して今日時点の正確な年齢を求める場合は、<a href="/nenrei/">年齢計算器</a>をご利用ください。</p>
    </section>

    <div class="ad-slot"></div>

    <section class="howto um-section">
      <h2>{year}年生まれの厄年はいつ？</h2>
      <p>
        厄年は<strong>数え年</strong>（生まれた年を1歳とし、1月1日ごとに1歳加算）で数えます。{year}年生まれの方が厄年に当たる年は次のとおりです。
        {hitM.length > 0 ? (
          <strong>男性は{BASE_YEAR}年が数え{hitM[0].kazoe}歳の{hitM[0].kind}{hitM[0].isTaiyaku ? '（大厄）' : ''}に当たります。</strong>
        ) : (
          <span>男性は{BASE_YEAR}年は厄年に当たりません。</span>
        )}
        {hitF.length > 0 ? (
          <strong>女性は{BASE_YEAR}年が数え{hitF[0].kazoe}歳の{hitF[0].kind}{hitF[0].isTaiyaku ? '（大厄）' : ''}に当たります。</strong>
        ) : (
          <span>女性は{BASE_YEAR}年は厄年に当たりません。</span>
        )}
      </p>

      <div class="um-yaku-grid">
        <div>
          <h3 class="um-h3">男性の厄年（{year}年生まれ）</h3>
          <div class="data-table-wrap">
            <div class="data-table-scroll">
              <table class="data-table um-table">
                <thead><tr><th>区分</th><th>数え年</th><th>西暦</th></tr></thead>
                <tbody>
                  {yakuM.map((r) => (
                    <tr class={r.year === BASE_YEAR ? 'is-hit' : undefined}>
                      <td>{r.kind}{r.isTaiyaku && <span class="data-table__badge um-badge--taiyaku">大厄</span>}</td>
                      <td class="num">{r.kazoe}歳</td>
                      <td class="num">{r.year}年</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div>
          <h3 class="um-h3">女性の厄年（{year}年生まれ）</h3>
          <div class="data-table-wrap">
            <div class="data-table-scroll">
              <table class="data-table um-table">
                <thead><tr><th>区分</th><th>数え年</th><th>西暦</th></tr></thead>
                <tbody>
                  {yakuF.map((r) => (
                    <tr class={r.year === BASE_YEAR ? 'is-hit' : undefined}>
                      <td>{r.kind}{r.isTaiyaku && <span class="data-table__badge um-badge--taiyaku">大厄</span>}</td>
                      <td class="num">{r.kazoe}歳</td>
                      <td class="num">{r.year}年</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      <p class="um-note">
        ※ 厄年の数え方は地域・神社により異なる場合があります。今年の判定や次の厄年までの年数は<a href="/yakudoshi/">厄年チェッカー</a>で確認できます。計算結果はあくまで参考値です。
      </p>
    </section>

    <section class="howto um-section">
      <h2>{year}年生まれの六星占術（運命星）</h2>
      <p>
        六星占術の<strong>運命星</strong>は生年月日から決まり、同じ{year}年生まれでも誕生日によって異なります。いっぽう陽陰（プラス／マイナス）は生まれ年で決まるため、<strong>{year}年生まれは全員「{pol}{polMark}」</strong>です。下の表で自分の誕生日の区間を探し、「運命星＋{pol}」があなたのタイプになります（例：{segs[0].star}{pol}）。
      </p>
      <div class="um-rokusei-grid">
        <div class="data-table-wrap">
          <div class="data-table-scroll">
            <table class="data-table um-table">
              <thead><tr><th>誕生日（1〜6月）</th><th>運命星</th></tr></thead>
              <tbody>
                {segsFirstHalf.map((s) => (
                  <tr>
                    <td class="num--sub">{s.from.month}/{s.from.day}〜{s.to.month}/{s.to.day}</td>
                    <td>{s.star}{pol}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="data-table-wrap">
          <div class="data-table-scroll">
            <table class="data-table um-table">
              <thead><tr><th>誕生日（7〜12月）</th><th>運命星</th></tr></thead>
              <tbody>
                {segsSecondHalf.map((s) => (
                  <tr>
                    <td class="num--sub">{s.from.month}/{s.from.day}〜{s.to.month}/{s.to.day}</td>
                    <td>{s.star}{pol}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <p class="um-note">
        ※ 六星占術は文化的な慣習（娯楽）に基づくもので、科学的根拠を保証するものではありません。今年の大殺界の判定は<a href="/rokusei/">六星占術・大殺界計算器</a>でできます。
      </p>
    </section>

    <section class="howto um-section">
      <h2>星座は出生年ではなく誕生日で確認</h2>
      <p>星座の区間表は出生年ごとに同じ内容なので、<a href="/seiza/">星座早見表・誕生日からの星座調べ</a>にまとめています。境界日付近では、出生年・時刻によって一般的な区間表と異なる場合があります。</p>
    </section>

    <section class="howto um-section">
      <h2>{year}年生まれの年齢の数え方</h2>
      <p>
        <strong>満年齢</strong>は誕生日ごとに1歳増える数え方で、{year}年生まれなら{BASE_YEAR}年の誕生日で<strong>満{age}歳</strong>に相当します（誕生日前は{age - 1}歳）。<strong>数え年</strong>は生まれた年を1歳として1月1日ごとに1歳増える数え方で、{BASE_YEAR}年は<strong>{kazoe}歳</strong>です。長寿祝い・厄年などで使う年齢は地域や家庭によって異なるため、案内の基準を先に確認してください。
      </p>
      <h3>西暦の差だけで年齢を決めない</h3>
      <p>{BASE_YEAR} − {year} ＝ {age}は、その年に迎える誕生日での年齢です。誕生日より前の時点では1を引きます。たとえば{BASE_YEAR}年4月1日時点の年齢を調べる場合、誕生日が3月なら満{age}歳、5月なら満{age - 1}歳になります。年だけがわかる資料では、ひとつの年齢に断定せず「{age - 1}〜{age}歳」と記すと、月日が不明であることを表せます。</p>
      {age >= 100 ? (
        <p>このページの年齢は、生年をもとにした暦上の換算です。個人の存命や実際の経歴を示すものではありません。故人の享年・行年を確認する場合は、現在の年ではなく亡くなった年月日を基準にし、資料が満年齢と数え年のどちらを使っているかも確認してください。</p>
      ) : age >= 65 ? (
        <p>長寿祝いは、満年齢で行う家庭と数え年で行う家庭があります。同じ{year}年生まれでも、祝いの日付と数え方で準備する年が変わるため、本人の希望や家族の予定を優先してください。年金や医療制度の資格は生年だけでは決まらず、加入歴や判定日など別の条件があります。</p>
      ) : age >= 18 ? (
        <p>履歴書などで「現在の年齢」を求められた場合は、提出先が指定する基準日の満年齢を確認します。生年の差から勤務年数や加入期間まで推定することはできません。入社日・加入日が必要な計算は、それぞれの記録をもとに別に行ってください。</p>
      ) : (
        <p>同じ生年でも、早生まれかどうかで学年が分かれます。学校の学年は4月2日から翌年4月1日までをひとつの区切りとするため、この年齢表だけでは入学・卒業年を確定できません。月日を入力できる<a href="/gakureki/">入学・卒業年度計算器</a>も確認してください。</p>
      )}
      {milestoneAges.length > 0 && (
        <>
          <h3>{year}年生まれの過去の年齢を調べる</h3>
          <p>年譜や写真に記された年から当時の年齢を確認するには、「出来事の西暦 − {year}」を計算し、その日の誕生日を迎えていなければ1を引きます。次の表は、その年の誕生日に迎える年齢です。</p>
          <div class="data-table-wrap"><div class="data-table-scroll"><table class="data-table">
            <thead><tr><th>出来事の年</th><th>誕生日前</th><th>誕生日以降</th></tr></thead>
            <tbody>{milestoneAges.map((value) => <tr><td>{year + value}年（{warekiLabels(year + value)}）</td><td>満{value - 1}歳</td><td>満{value}歳</td></tr>)}</tbody>
          </table></div></div>
        </>
      )}
      <p>月日を含めた年齢は<a href="/nenrei/">年齢計算器</a>、ほかの生年との比較は<a href="/nenrei-hayami/">年齢早見表</a>で確認できます。</p>
      <div class="disclaimer">※ 計算結果はあくまで参考値です。</div>
    </section>

    <Faq items={[
      { q: `${year}年（${wareki}）生まれは今年（${BASE_YEAR}年）何歳ですか？`, a: `${BASE_YEAR}年の誕生日を迎えると満${age}歳、誕生日前は満${age - 1}歳です。数え年では${kazoe}歳になります。` },
      { q: `${year}年生まれの今日時点の正確な年齢は？`, a: `誕生日を迎えたかどうかで満${age - 1}歳または満${age}歳です。ページ上部で生まれた月日を入力すると、今日時点の満年齢を自動計算できます。` },
      { q: `${year}年生まれの厄年はいつですか？`, a: `数え年で数えて、男性の本厄は${honyakuListM.map((r) => `${r.year}年（${r.kazoe}歳${r.isTaiyaku ? '・大厄' : ''}）`).join('、')}、女性の本厄は${honyakuListF.map((r) => `${r.year}年（${r.kazoe}歳${r.isTaiyaku ? '・大厄' : ''}）`).join('、')}です。それぞれ前年が前厄、翌年が後厄になります。` },
      { q: `${year}年の干支は何ですか？`, a: `${year}年（${wareki}）の干支（十二支）は${e.kanji}（${e.yomi}）です。干支は12年周期なので、${year - 12}年や${year + 12}年生まれの方と同じ干支になります。` },
    ]} />

    <nav class="um-nav" aria-label="前後の生まれ年">
      {prevYear ? <a class="um-nav-link" href={`/umaredoshi/${prevYear}/`}>← {prevYear}年生まれ</a> : <span />}
      {nextYear ? <a class="um-nav-link" href={`/umaredoshi/${nextYear}/`}>{nextYear}年生まれ →</a> : <span />}
    </nav>

    <section class="related">
      <h3>関連ツール</h3>
      <div class="related-grid">
        <a href="/nenrei-hayami/" class="related-link"><span class="ic" aria-hidden="true"><Icon name="nenrei-hayami" size={20} /></span>年齢早見表（全年一覧）</a>
        <a href="/nenrei/" class="related-link"><span class="ic" aria-hidden="true"><Icon name="nenrei" size={20} /></span>年齢計算器</a>
        <a href="/wareki/" class="related-link"><span class="ic" aria-hidden="true"><Icon name="wareki" size={20} /></span>和暦・西暦変換器</a>
        <a href="/yakudoshi/" class="related-link"><span class="ic" aria-hidden="true"><Icon name="yakudoshi" size={20} /></span>厄年チェッカー</a>
        <a href="/seiza/" class="related-link"><span class="ic" aria-hidden="true"><Icon name="seiza" size={20} /></span>星座調べ</a>
        <a href="/rokusei/" class="related-link"><span class="ic" aria-hidden="true"><Icon name="rokusei" size={20} /></span>六星占術・大殺界計算器</a>
      </div>
    </section>

    <div class="ad-slot"></div>
  </div>
</ToolLayout>

<script>
  import { mannenrei } from '../../lib/nenrei.js';

  const birthInput = document.getElementById('birth-date');
  const exactResult = document.getElementById('exact-age-result');

  function localToday() {
    const now = new Date();
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  }

  birthInput?.addEventListener('change', () => {
    const birth = birthInput.value;
    const expectedYear = Number(birthInput.dataset.birthYear);
    if (!birth || Number(birth.slice(0, 4)) !== expectedYear) {
      exactResult.textContent = `${expectedYear}年の誕生日を入力してください。`;
      exactResult.classList.remove('has-result');
      return;
    }
    const exactAge = mannenrei(birth, localToday());
    if (exactAge == null) {
      exactResult.textContent = '今日時点の年齢を計算できませんでした。';
      exactResult.classList.remove('has-result');
      return;
    }
    const [, month, day] = birth.split('-').map(Number);
    exactResult.textContent = `今日時点：満${exactAge}歳（${month}月${day}日生まれ）`;
    exactResult.classList.add('has-result');
    window.trackCalculatorResult?.('exact-age');
  });
</script>

<style>
  /* ラッパー div は幅に影響させない（各セクションの max-width は global 側で制御） */
  .um-root { display: contents; }

  /* サマリーカード */
  .um-summary {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .um-main { flex: 0 1 auto; text-align: center; padding: 8px 18px; }
