---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';
import { eras } from '../../lib/wareki.js';
import { hayamiTable } from '../../lib/hayami.js';

const slug = 'wareki';
const title =
  '和暦・西暦変換器【令和8年=2026年】元号⇔西暦をかんたん変換 | 計算ツール';
const description =
  '和暦と西暦をどちらの向きでも瞬時に変換。「令和8年は西暦何年？」「2026年は令和何年？」がすぐわかります。明治・大正・昭和・平成・令和に対応し、改元年も正しく元年表示。明治元年〜今年まで全年分の西暦和暦早見表付き、無料変換ツールです。';

// SSR 用の静的早見表データ（明治元年〜今年の全年、西暦昇順）。
// 改元年の併記（昭和64年／平成元年など）は hayami.js の warekiLabels() が
// 一括で正しく処理するため、ここでは年ごとの分岐ロジックを持たない。
const CURRENT_YEAR = new Date().getFullYear();
const TABLE_YEARS = hayamiTable(1868, CURRENT_YEAR, CURRENT_YEAR).map((r) => ({
  seireki: r.seireki,
  label: r.wareki,
}));

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '和暦・西暦変換器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/henkan/">変換・ツール</a> ／ 和暦・西暦変換</div>
    <h1>和暦・西暦変換器（令和8年＝2026年）</h1>
    <p>西暦から和暦（元号）へ、和暦から西暦へ、どちらの向きでもその場で変換します。明治・大正・昭和・平成・令和に対応し、改元のあった年も「元年」で正しく表示します。</p>
  </div>

  <div class="calc-card wide-input">
    <!-- 西暦 → 和暦 -->
    <div class="conv-block">
      <div class="conv-head">西暦 → 和暦</div>
      <div class="form-group">
        <label for="s-year">西暦（年）</label>
        <input type="number" id="s-year" inputmode="numeric" placeholder="例：2026" />
      </div>
      <div class="conv-optional">
        <div class="form-group">
          <label for="s-month">月（任意）</label>
          <input type="number" id="s-month" inputmode="numeric" min="1" max="12" placeholder="例：5" />
        </div>
        <div class="form-group">
          <label for="s-day">日（任意）</label>
          <input type="number" id="s-day" inputmode="numeric" min="1" max="31" placeholder="例：1" />
        </div>
      </div>
      <p class="conv-note">月・日は改元のあった年（昭和64年/平成元年など）を正確に判定したい場合のみ入力してください。</p>
      <div class="result-box" id="s-result">
        <div class="result-label">和暦</div>
        <div class="result-main" id="s-out">―</div>
      </div>
    </div>

    <hr class="conv-divider" />

    <!-- 和暦 → 西暦 -->
    <div class="conv-block">
      <div class="conv-head">和暦 → 西暦</div>
      <div class="conv-optional">
        <div class="form-group">
          <label for="w-era">元号</label>
          <select id="w-era">
            {eras.map((e) => <option value={e.name}>{e.name}</option>)}
          </select>
        </div>
        <div class="form-group">
          <label for="w-year">年（元年は「1」）</label>
          <input type="number" id="w-year" inputmode="numeric" min="1" placeholder="例：8" />
        </div>
      </div>
      <div class="result-box" id="w-result">
        <div class="result-label">西暦</div>
        <div class="result-main" id="w-out">―</div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>上段「西暦→和暦」では西暦の年を入力すると、対応する元号と年が表示されます。改元のあった年（1989年・2019年など）を正確に判定したいときは、月と日も入力してください。下段「和暦→西暦」では元号を選んで年を入力すると、西暦の年が表示されます。元年は「1」と入力してください。</p>
    <ul>
      <li><strong>令和8年は西暦2026年</strong>です（令和元年＝2019年、令和n年＝2018＋n年）。</li>
      <li><strong>平成元年は1989年</strong>、平成31年は2019年です。1989年は1月7日までが昭和64年、1月8日からが平成元年です。</li>
      <li><strong>2019年</strong>は4月30日までが平成31年、5月1日からが令和元年です。</li>
      <li><strong>昭和元年は1926年</strong>（12月25日改元）、<strong>大正元年は1912年</strong>（7月30日改元）、<strong>明治元年は1868年</strong>です。</li>
    </ul>
    <p>明治より前（1868年10月22日以前）には対応していません。下の早見表では明治元年から今年までの全年分を一覧できます。</p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。</div>
  </section>

  <section class="howto">
    <h2>元号と西暦の対応・換算方法</h2>
    <p>和暦と西暦の変換は、各元号の「元年（＝1年）が西暦何年か」を覚えておけば暗算でも計算できます。元号の年から元年の前年の西暦を足すと西暦になり、逆に西暦から元年の前年を引くと元号の年になります。たとえば令和の元年は2019年なので、令和の西暦変換は「令和n年＝2018＋n」、昭和の西暦変換は「昭和n年＝1925＋n」で求められます。</p>
    <ul>
      <li><strong>令和</strong>：元年＝西暦2019年（2019年5月1日改元）。換算式は <strong>令和n年＝2018＋n</strong>（例：令和6年＝2024年、令和8年＝2026年）。逆は「西暦−2018」。</li>
      <li><strong>平成</strong>：元年＝西暦1989年（1989年1月8日改元）。換算式は <strong>平成n年＝1988＋n</strong>（例：平成30年＝2018年、平成31年＝2019年）。逆は「西暦−1988」。</li>
      <li><strong>昭和</strong>：元年＝西暦1926年（1926年12月25日改元）。換算式は <strong>昭和n年＝1925＋n</strong>（例：昭和50年＝1975年、昭和64年＝1989年）。逆は「西暦−1925」。</li>
      <li><strong>大正</strong>：元年＝西暦1912年（1912年7月30日改元）。換算式は <strong>大正n年＝1911＋n</strong>（例：大正10年＝1921年、大正15年＝1926年）。逆は「西暦−1911」。</li>
      <li><strong>明治</strong>：元年＝西暦1868年（1868年10月23日改元）。換算式は <strong>明治n年＝1867＋n</strong>（例：明治33年＝1900年、明治45年＝1912年）。逆は「西暦−1867」。</li>
    </ul>
    <h3>改元の境目に注意</h3>
    <p>改元のあった年は、同じ西暦に2つの元号が並びます。境目の前後で和暦の表記が変わるため、月日まで確認するのが確実です。</p>
    <ul>
      <li><strong>昭和64年と平成元年は同じ1989年</strong>です。1989年1月7日までが昭和64年、1月8日からが平成元年になります。</li>
      <li><strong>平成31年と令和元年は同じ2019年</strong>です。2019年4月30日までが平成31年、5月1日からが令和元年になります。</li>
      <li><strong>大正15年と昭和元年は同じ1926年</strong>、<strong>明治45年と大正元年は同じ1912年</strong>です。</li>
    </ul>
    <p>このツールは月・日を入力すれば、こうした改元の境目も自動で正しく判定します。</p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。</div>
  </section>

  <section class="howto">
    <h2>西暦和暦早見表（明治元年〜{CURRENT_YEAR}年・全年分）</h2>
    <div class="data-table-wrap">
      <div class="data-table-scroll">
        <table class="data-table">
          <thead>
            <tr><th>西暦</th><th>和暦</th></tr>
          </thead>
          <tbody>
            {TABLE_YEARS.map((row) => (
              <tr class={row.seireki === CURRENT_YEAR ? 'is-hit' : undefined}>
                <td class="num">{row.seireki}年</td>
                <td>{row.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p>年齢・数え年・干支まで含めた全年分（明治元年〜今年）の一覧は「<a href="/nenrei-hayami/">年齢早見表</a>」をご覧ください。</p>
    <div class="disclaimer">※ 改元のあった年は和暦が2つ並ぶ場合があります。計算結果はあくまで参考値です。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '令和は西暦何年ですか？', a: '令和元年は西暦2019年です。令和n年は「2018＋n」年で求められます（例：令和6年＝2024年、令和8年＝2026年）。逆に西暦から令和を求めるときは「西暦−2018」で計算します。' },
    { q: '昭和64年は西暦何年ですか？', a: '昭和64年は西暦1989年です。ただし昭和64年は1989年1月7日まで（実質7日間）で、1月8日からは平成元年になります。昭和は元年＝1926年なので「昭和n年＝1925＋n」で換算できます。' },
    { q: '平成は西暦何年からですか？', a: '平成元年は西暦1989年（1989年1月8日改元）です。平成n年は「1988＋n」で求められ、平成31年＝2019年です。2019年4月30日までが平成31年、5月1日からが令和元年になります。' },
    { q: '改元の年はどう扱いますか？', a: '改元のあった年（昭和64年/平成元年、平成31年/令和元年など）は同じ西暦に2つの元号が並びます。月日まで入力すると、本ツールが改元の境目を正確に判定して変換します。' },
    { q: '明治・大正・昭和も変換できますか？', a: '明治・大正・昭和・平成・令和すべてに対応し、和暦⇔西暦を相互変換できます。明治元年＝1868年、大正元年＝1912年、昭和元年＝1926年です。明治より前（1868年10月22日以前）には対応していません。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { seirekiToWareki, warekiToSeireki } from '../../lib/wareki.js';

  const $ = (id) => document.getElementById(id);
  const show = (box) => box.classList.add('visible');
  const hide = (box) => box.classList.remove('visible');

  // 2 つの変換ブロックの有効な結果を集めてシェアサマリーを更新する。
  // 表示中かつ「変換できません」でない結果だけを採用。どちらも無ければ非表示。
  function syncShare() {
    const lines = [];
    const sBox = $('s-result');
    const wBox = $('w-result');
    if (sBox.classList.contains('visible')) {
      const v = $('s-out').textContent;
      if (v && v !== '変換できません') lines.push('西暦' + $('s-year').value + '年 → ' + v);
    }
    if (wBox.classList.contains('visible')) {
      const v = $('w-out').textContent;
      if (v && v !== '変換できません') lines.push($('w-era').value + $('w-year').value + '年 → 西暦' + v);
    }
    if (lines.length) window.setResultShare?.('和暦・西暦変換\n' + lines.join('\n'));
    else window.hideResultShare?.();
  }

  function renderSeireki() {
    const box = $('s-result');
    const year = $('s-year').value;
    if (year === '') { hide(box); return syncShare(); }
    const month = $('s-month').value;
    const day = $('s-day').value;
    const r = seirekiToWareki(
      Number(year),
      month === '' ? undefined : Number(month),
      day === '' ? undefined : Number(day)
    );
    if (r === null) {
      show(box);
      $('s-out').textContent = '変換できません';
      return syncShare();
    }
    show(box);
    $('s-out').textContent = r.label;
    syncShare();
  }

  function renderWareki() {
    const box = $('w-result');
    const era = $('w-era').value;
    const yr = $('w-year').value;
    if (yr === '') { hide(box); return syncShare(); }
    const r = warekiToSeireki(era, Number(yr));
    if (r === null) {
      show(box);
      $('w-out').textContent = '変換できません';
      return syncShare();
    }
    show(box);
    $('w-out').textContent = r + '年';
    syncShare();
  }

  ['s-year', 's-month', 's-day'].forEach((id) => $(id).addEventListener('input', renderSeireki));
  $('w-era').addEventListener('change', renderWareki);
  $('w-year').addEventListener('input', renderWareki);
</script>

<style>
  /* .wide-input は flex 横並びコンテナ。2 つの変換ブロックを左右 2 カラムにし、
     画面が狭ければ flex-wrap で縦積みになる。区切り線は不要なので非表示。 */
  .conv-block {
    flex: 1 1 320px;
    min-width: 0;
    margin-bottom: 0;
    align-self: stretch;
  }
  .conv-divider { display: none; }
  .conv-head {
    font-weight: var(--fw-bold);
    margin-bottom: 0.8rem;
    font-size: 1.05rem;
    color: var(--text);
  }
  .conv-optional {
    display: flex;
    gap: 0.75rem;
  }
  .conv-optional .form-group { flex: 1; min-width: 0; }
  .conv-optional input,
  .conv-optional select { width: 100%; min-width: 0; }
  .conv-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.4rem 0 0.2rem;
  }
</style>
