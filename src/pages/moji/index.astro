---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const slug = 'moji';
const title = '文字化け・全角半角変換ツール - コピペで即座に文字を変換 | 計算ツール';
const description =
  '全角半角変換・ひらがなカタカナ変換・文字数カウントがコピペで瞬時に行える無料の文字変換ツール。文字化けの修正や全角半角の統一、フォント変換に対応し、ボタンを押さなくても自動で結果が表示されます。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '文字化け・全角半角変換ツール',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ 文字変換</div>
    <h1>文字化け・全角半角変換ツール</h1>
    <p>全角半角・ひらがなカタカナの変換、文字数カウントをコピペで瞬時に。ボタン操作は不要です。</p>
  </div>

  <div class="calc-card">
    <div class="calc-tabs" role="tablist">
      <button class="calc-tab active" data-tab="width" type="button">全角半角</button>
      <button class="calc-tab" data-tab="kana" type="button">ひらがなカタカナ</button>
      <button class="calc-tab" data-tab="count" type="button">文字数カウント</button>
    </div>

    <!-- 全角半角 -->
    <div class="calc-panel active" id="panel-width">
      <div class="form-group">
        <label for="width-input">変換したい文字を入力</label>
        <textarea id="width-input" rows="4" placeholder="例：ＡＢＣ１２３ ｶﾀｶﾅ"></textarea>
      </div>
      <div class="radio-group">
        <input type="radio" name="width-mode" id="w-half" value="half" checked />
        <label for="w-half">半角に変換</label>
        <input type="radio" name="width-mode" id="w-full" value="full" />
        <label for="w-full">全角に変換</label>
      </div>
      <div class="form-group">
        <label for="width-output">変換結果</label>
        <textarea id="width-output" class="output" rows="4" readonly placeholder="ここに結果が表示されます"></textarea>
      </div>
      <button class="copy-btn" type="button" data-target="width-output">結果をコピー</button>
    </div>

    <!-- ひらがなカタカナ -->
    <div class="calc-panel" id="panel-kana">
      <div class="form-group">
        <label for="kana-input">変換したい文字を入力</label>
        <textarea id="kana-input" rows="4" placeholder="例：ひらがな カタカナ"></textarea>
      </div>
      <div class="radio-group">
        <input type="radio" name="kana-mode" id="k-kata" value="kata" checked />
        <label for="k-kata">カタカナに変換</label>
        <input type="radio" name="kana-mode" id="k-hira" value="hira" />
        <label for="k-hira">ひらがなに変換</label>
      </div>
      <div class="form-group">
        <label for="kana-output">変換結果</label>
        <textarea id="kana-output" class="output" rows="4" readonly placeholder="ここに結果が表示されます"></textarea>
      </div>
      <button class="copy-btn" type="button" data-target="kana-output">結果をコピー</button>
    </div>

    <!-- 文字数カウント -->
    <div class="calc-panel" id="panel-count">
      <div class="form-group">
        <label for="count-input">カウントしたい文字を入力</label>
        <textarea id="count-input" rows="6" placeholder="ここに文章を貼り付けてください"></textarea>
      </div>
      <div class="result-box visible" id="count-result">
        <div class="result-label">文字数（空白含む）</div>
        <div class="result-main" id="count-chars">0</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">空白を除いた文字数</span><span class="value" id="count-nospace">0</span></div>
          <div class="result-row"><span class="label">行数</span><span class="value" id="count-lines">0</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="ad-slot">広告枠（結果直下）</div>

  <section class="howto">
    <h2>使い方と各変換について</h2>
    <p>上のタブから目的の変換を選び、テキストエリアに文字を貼り付けるだけで、自動的に結果が表示されます。「結果をコピー」ボタンを押すと、変換後の文字をそのままクリップボードにコピーできます。</p>
    <ul>
      <li><strong>全角半角変換</strong>：英数字や記号、カタカナの全角・半角を相互に変換します。住所やフォーム入力で「半角で入力してください」と求められた時や、表記を統一したい時に便利です。</li>
      <li><strong>ひらがなカタカナ変換</strong>：ひらがなとカタカナを相互に変換します。ふりがなの作成や、データの表記揺れを直す際に役立ちます。</li>
      <li><strong>文字数カウント</strong>：空白を含む文字数・空白を除いた文字数・行数を表示します。原稿やSNS投稿の文字数チェックに使えます。</li>
    </ul>
    <p>
      <strong>文字化けとは</strong>、本来表示されるはずの文字が「□」や記号の羅列など、意味の読み取れない別の文字に化けてしまう現象のことです。多くは、文字コード（UTF-8・Shift_JISなど）の食い違いや、全角・半角の混在、半角カタカナの扱いの違いが原因で発生します。本ツールで全角半角やカタカナの表記を整えることで、文字化けの予防や、化けてしまったデータの整形に役立てられます。半角カタカナの濁音（ｶﾞ→ガ）・半濁音（ﾊﾟ→パ）も正しく合成・分解して変換します。
    </p>
    <div class="disclaimer">※ 変換はお使いのブラウザ内だけで行われ、入力した文字がサーバーへ送信されることはありません。</div>
  </section>

  <RelatedTools current={slug} />

  <div class="ad-slot">広告枠（コンテンツ下部）</div>
</ToolLayout>

<style>
  textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 1rem;
    font-family: var(--font-jp);
    color: var(--text);
    background: var(--bg);
    line-height: 1.7;
    resize: vertical;
    transition: 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }
  textarea:focus {
    outline: none;
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
  }
  textarea::placeholder {
    color: #cbd5e1;
  }
  textarea.output {
    background: var(--bg-result);
    border-color: #bfdbfe;
    color: var(--navy);
  }
  .copy-btn {
    width: 100%;
    height: 46px;
    border: none;
    border-radius: 6px;
    background: var(--navy);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-jp);
    cursor: pointer;
    transition: 0.15s;
  }
  .copy-btn:hover {
    background: var(--navy-dark);
  }
  .copy-btn.copied {
    background: var(--success);
  }
</style>

<script>
  import {
    toHalfWidth,
    toFullWidth,
    kanaToHalf,
    kanaToFull,
    hiraToKata,
    kataToHira,
    countChars,
  } from '../../lib/moji.js';

  const $ = (id) => document.getElementById(id);

  // タブ切り替え
  document.querySelectorAll('.calc-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.calc-tab').forEach((t) => t.classList.remove('active'));
      document.querySelectorAll('.calc-panel').forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      $('panel-' + tab.dataset.tab).classList.add('active');
    });
  });

  const mode = (name) =>
    document.querySelector(`input[name="${name}"]:checked`).value;

  // 全角半角
  function renderWidth() {
    const text = $('width-input').value;
    const m = mode('width-mode');
    let out;
    if (m === 'half') {
      out = kanaToHalf(toHalfWidth(text));
    } else {
      out = kanaToFull(toFullWidth(text));
    }
    $('width-output').value = out;
  }

  // ひらがなカタカナ
  function renderKana() {
    const text = $('kana-input').value;
    const out = mode('kana-mode') === 'kata' ? hiraToKata(text) : kataToHira(text);
    $('kana-output').value = out;
  }

  // 文字数カウント
  function renderCount() {
    const { chars, charsNoSpace, lines } = countChars($('count-input').value);
    $('count-chars').textContent = chars.toLocaleString('ja-JP');
    $('count-nospace').textContent = charsNoSpace.toLocaleString('ja-JP');
    $('count-lines').textContent = lines.toLocaleString('ja-JP');
  }

  $('width-input').addEventListener('input', renderWidth);
  document.querySelectorAll('input[name="width-mode"]').forEach((r) => r.addEventListener('change', renderWidth));
  $('kana-input').addEventListener('input', renderKana);
  document.querySelectorAll('input[name="kana-mode"]').forEach((r) => r.addEventListener('change', renderKana));
  $('count-input').addEventListener('input', renderCount);

  // コピー
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = $(btn.dataset.target).value;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'コピーしました';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('copied');
        }, 1500);
      } catch (e) {
        // クリップボードが使えない環境では何もしない
      }
    });
  });
</script>
