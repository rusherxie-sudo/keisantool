---
import ToolLayout from '../../layouts/ToolLayout.astro';import RelatedTools from '../../components/RelatedTools.astro';import Faq from '../../components/Faq.astro';import ResultShare from '../../components/ResultShare.astro';
const slug='bane-teisuu',title='ばね定数・荷重計算ツール｜F=kx・直列・並列ばね',description='フックの法則F=kxでばね定数、荷重、伸び・たわみを相互計算。弾性エネルギーと複数ばねの直列・並列合成ばね定数も無料計算できます。';const jsonld={'@context':'https://schema.org','@type':'WebApplication',name:'ばね定数・荷重計算ツール',description,applicationCategory:'UtilityApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'},featureList:['F=kxの相互計算','弾性エネルギー','直列・並列の合成ばね定数']};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide><div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ ばね定数</div><h1>ばね定数・荷重計算ツール</h1><p>フックの法則から荷重、ばね定数、伸び・たわみと弾性エネルギーを計算します。</p><div class="chips"><span>F＝kx</span><span>N/m・N/mm</span><span>直列・並列</span></div></div>
<div class="calc-card tool-card"><div class="tabs"><button class="tab active" data-mode="hooke">F＝kx</button><button class="tab" data-mode="combine">合成ばね定数</button></div>
<section class="calc-panel panel active" data-panel="hooke"><h2>荷重・ばね定数・変位を相互計算</h2><label>求める値<select id="h-target"><option value="force">荷重</option><option value="springConstant">ばね定数</option><option value="extension">伸び・たわみ</option></select></label><div class="grid"><label id="h-force-wrap" hidden>荷重（N）<input id="h-force" value="10" type="number" min="0"></label><label id="h-k-wrap">ばね定数（N/m）<input id="h-k" value="200" type="number" min="0"></label><label id="h-x-wrap">伸び・たわみ<div><input id="h-x" value="50" type="number" min="0"><select id="h-x-unit"><option>mm</option><option>cm</option><option>m</option></select></div></label></div><p class="error" id="h-error" hidden>表示中の2項目に0より大きい値を入力してください。</p><div class="cards" id="h-result"><div><span>荷重</span><strong id="h-force-out">10 N</strong></div><div><span>ばね定数</span><strong id="h-k-out">200 N/m</strong></div><div><span>変位</span><strong id="h-x-out">50 mm</strong></div><div><span>弾性エネルギー</span><strong id="h-energy">0.25 J</strong></div></div></section>
<section class="calc-panel panel" data-panel="combine"><h2>直列・並列ばねの合成定数</h2><label>接続方法<select id="c-mode"><option value="series">直列</option><option value="parallel">並列</option></select></label><label>各ばね定数（N/m、改行・カンマ区切り）<textarea id="c-values" rows="4">100
200</textarea></label><p class="error" id="c-error" hidden>0より大きいばね定数を1つ以上入力してください。</p><div class="result" id="c-result"><span>合成ばね定数</span><strong id="c-main">66.6667 N/m</strong></div></section></div><ResultShare/><div class="ad-slot"></div>
<section class="howto"><h2>ばね定数の計算式 F＝kx</h2><p>弾性範囲内では荷重F、ばね定数k、変位xの間に<strong>F＝kx</strong>が成り立ちます。200N/mのばねを50mm（0.05m）伸ばすと10Nです。蓄えられる弾性エネルギーは1/2kx²です。力やトルクの換算は<a href="/toruku/">トルク計算ツール</a>も利用できます。</p></section>
<section class="howto source-box"><h2>直列・並列と適用範囲</h2><p>並列はk₁＋k₂＋…、直列は1/k＝1/k₁＋1/k₂＋…です。実ばねは許容たわみを超えると比例関係から外れ、座屈、疲労、初張力、取付条件の影響も受けます。</p><ul><li><a href="https://syllabus.kosen-k.go.jp/Pages/PublicSyllabus?department_id=12&from=curriculum&lang=ja&school_id=50&subject_id=0110&year=2016" target="_blank" rel="noopener noreferrer">国立高等専門学校機構シラバス「フックの法則・ばね定数」</a></li></ul><div class="disclaimer">※ 計算結果はあくまで参考値です。安全に関わる選定ではメーカー荷重特性、許容たわみ、疲労寿命と安全率を確認してください。</div></section><RelatedTools current={slug}/><Faq items={[{q:'ばね定数の計算式は？',a:'k＝荷重F÷変位xです。単位をNとmにそろえます。'},{q:'N/mmをN/mへ直すには？',a:'1N/mm＝1,000N/mです。'},{q:'直列ばねの合成定数は？',a:'各ばねの逆数を足し、その逆数を取ります。'},{q:'並列ばねの合成定数は？',a:'各ばね定数を足します。'},{q:'どんなばねにもフックの法則が使えますか？',a:'弾性範囲の近似です。許容たわみや初張力などは仕様書を確認してください。'}]}/><div class="ad-slot"></div></ToolLayout>
<style>.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips span{padding:5px 10px;border-radius:999px;background:var(--cat-tint);color:var(--cat-color);font-size:.75rem;font-weight:700}.tool-card{overflow:hidden}.tabs{display:grid;grid-template-columns:repeat(2,1fr);background:var(--surface-sub)}.tab{padding:15px;border:0;border-bottom:3px solid transparent;background:none;font-weight:700}.tab.active{background:var(--surface);color:var(--cat-color);border-color:var(--cat-color)}.panel{padding:24px}.panel:not(.active){display:none}.panel h2{margin-top:0;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}.grid label{display:flex;flex-direction:column;gap:7px;font-size:.8rem;font-weight:700}.grid label>div{display:grid;grid-template-columns:1fr 90px;gap:7px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.cards div,.result{display:flex;flex-direction:column;align-items:center;gap:5px;padding:17px;background:var(--cat-tint);border-radius:var(--r-md)}.cards strong,.result strong{font:700 clamp(1.2rem,4vw,1.8rem) var(--font-mono);color:var(--cat-color)}.cards span{color:var(--text-muted)}textarea{width:100%;margin:8px 0;font-family:var(--font-mono)}.error{padding:10px;background:var(--danger-bg);color:var(--danger)}@media(max-width:700px){.grid,.cards{grid-template-columns:1fr 1fr}}@media(max-width:480px){.panel{padding:18px}.grid,.cards{grid-template-columns:1fr}}</style>
<script>import{solveHooke,springEnergy,combineSprings}from'../../lib/bane-teisuu.js';const $=id=>document.getElementById(id),fmt=n=>Number(n.toPrecision(8)).toLocaleString('ja-JP',{maximumFractionDigits:10});let mode='hooke';function rh(){const t=$('h-target').value;$('h-force-wrap').hidden=t==='force';$('h-k-wrap').hidden=t==='springConstant';$('h-x-wrap').hidden=t==='extension';const r=solveHooke({target:t,force:$('h-force').value,springConstant:$('h-k').value,extension:$('h-x').value,extensionUnit:$('h-x-unit').value});$('h-error').hidden=!!r;$('h-result').hidden=!r;if(!r)return;$('h-force-out').textContent=`${fmt(r.forceN)} N`;$('h-k-out').textContent=`${fmt(r.springConstantNm)} N/m`;$('h-x-out').textContent=`${fmt(r.extensionM*1000)} mm`;$('h-energy').textContent=`${fmt(springEnergy({springConstant:r.springConstantNm,extension:r.extensionM}))} J`;if(mode==='hooke')window.setResultShare?.(`ばね計算\n荷重 ${fmt(r.forceN)}N・ばね定数 ${fmt(r.springConstantNm)}N/m`)}function rc(){const vals=$('c-values').value.split(/[\s,、]+/).filter(Boolean),r=combineSprings(vals,$('c-mode').value);$('c-error').hidden=!!r;$('c-result').hidden=!r;if(r)$('c-main').textContent=`${fmt(r)} N/m`;}document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.dataset.panel===mode));({hooke:rh,combine:rc})[mode]()}));document.querySelectorAll('input,select,textarea').forEach(x=>x.addEventListener('input',()=>{rh();rc()}));rh();rc();</script>
