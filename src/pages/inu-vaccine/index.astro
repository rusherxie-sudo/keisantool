---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'inu-vaccine';
const title = '犬のワクチン接種スケジュール計算器 - 生年月日から接種時期の目安を表示 | 計算ツール';
const description =
  '子犬の生年月日を入力すると、混合ワクチン（初年度3回の目安）と狂犬病ワクチン（生後91日〜）の接種時期の目安を表示する無料ツール。WSAVA・狂犬病予防法に基づく一般的な目安です。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '犬のワクチン接種スケジュール計算器',
  description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/pet/">ペット・動物</a> ／ 犬のワクチン接種スケジュール</div>
    <h1>犬のワクチン接種スケジュール計算器</h1>
    <p>子犬の生年月日を入力するだけで、混合ワクチンと狂犬病ワクチンの接種時期の目安をその場で表示します。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="birth">子犬の生年月日</label>
      <input type="date" id="birth" />
    </div>

    <div class="result-box" id="result">
      <div class="result-label">8・12・16週齢の日付（接種計画の相談用）</div>

      <div class="iv-section">
        <h3 class="iv-h">① 混合ワクチン（8・12・16週の例）</h3>
        <div id="iv-core"></div>
      </div>

      <div class="iv-section">
        <h3 class="iv-h">② 狂犬病ワクチン（生後91日〜）</h3>
        <div id="iv-rabies"></div>
      </div>

      <div class="iv-section">
        <h3 class="iv-h">③ その後の追加接種を相談</h3>
        <p class="iv-note" id="iv-adult">―</p>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方と接種スケジュールの考え方</h2>
    <p>
      子犬の生年月日を選ぶだけで、混合ワクチン（初年度）と狂犬病ワクチンの接種時期の目安をその場で表示します。ボタンを押す必要はありません。表示されるのは<strong>あくまで一般的な目安のカレンダー</strong>で、医療上のアドバイスではありません。実際の接種時期・回数・ワクチンの種類は、必ずかかりつけの獣医師にご相談ください。
    </p>

    <h3>混合ワクチン（初年度）の目安</h3>
    <p>
      子犬は母犬からの移行抗体が残っているあいだはワクチンが効きにくいとされ、世界小動物獣医師会（WSAVA）のガイドラインでは、移行抗体が消える時期に確実に免疫をつけるため、<strong>生後6〜8週ごろに開始し、3〜4週ごとに、最後の接種が16週齢以降になるよう複数回</strong>接種する考え方が一般的です。本ツールでは目安として<strong>生後8週・12週・16週ごろの3回</strong>を表示しています。開始時期や回数・間隔は動物病院の方針や子犬の状態によって異なります。
    </p>

    <h3>狂犬病ワクチン（生後91日〜）</h3>
    <p>
      日本では<strong>狂犬病予防法</strong>により、<strong>生後91日以上の犬</strong>の飼い主には、市区町村への登録と、<strong>年1回の狂犬病予防注射</strong>が義務づけられています（違反した場合は罰則の対象になります）。本ツールでは生後91日にあたる日を「1回目を受けられる時期の目安」として表示し、以降は毎年1回の接種が必要です。
    </p>
<p class="iv-callout">狂犬病の予防注射の時期と登録は、<a href="https://www.mhlw.go.jp/bunya/kenkou/kekkaku-kansenshou10/" target="_blank" rel="noopener noreferrer">厚生労働省の狂犬病案内</a>と自治体の最新案内で確認してください。混合ワクチンとの順番や間隔は獣医師に相談してください。</p>

    <h3>16週の表示だけで接種完了とは判断できません</h3>
    <p>WSAVA 2024では幼齢期の最終接種を16週齢以降とし、26週齢以降の再接種も検討する考え方を示しています。高リスクの環境では追加の接種が必要になる場合があります。この画面の3つの日付は、すべての犬に必要な回数や完了日を決めるものではありません。</p>
    <h3>成犬の追加接種は種類・リスクごとに判断</h3>
    <p>「混合ワクチンなら一律に毎年」や「すべて3年ごと」とは決められません。製品の添付文書、接種歴、健康状態、生活環境を獣医師と確認してください。レプトスピラなどは製品・地域のリスクにより接種間隔が異なります。狂犬病の予防注射は日本の法令に従ってください。施設の利用条件と、医療上必要な接種計画も分けて確認します。</p>
    <h3>相談に持っていく情報</h3>
    <ul><li>これまでの接種証明書（製品名・接種日）</li><li>副反応歴、治療中の病気と薬</li><li>外出・他の動物との接触・預かり施設の利用予定</li></ul>
    <p>出典：<a href="https://wsava.org/global-guidelines/vaccination-guidelines/" target="_blank" rel="noopener noreferrer">WSAVA 2024 Vaccination Guidelines</a>。2026年10月10日に幼齢期と追加接種の説明を確認しました。日付の表示は診断や接種指示ではありません。</p>
    <div class="disclaimer">※ これは一般的な目安です。計算結果はあくまで参考値であり、実際の接種スケジュール・ワクチンの種類は子犬の体調や生活環境、動物病院の方針で異なります。必ずかかりつけの獣医師にご相談ください。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '子犬の混合ワクチンはいつから何回打ちますか？', a: '一般的な目安として、生後6〜8週ごろに始め、3〜4週ごとに、最後が16週齢以降になるよう複数回（本ツールでは8週・12週・16週ごろの3回）接種する考え方が知られています。実際の時期・回数は獣医師にご相談ください。' },
    { q: '狂犬病ワクチンはいつから必要ですか？', a: '日本では狂犬病予防法により、生後91日以上の犬の飼い主に市区町村への登録と年1回の狂犬病予防注射が義務づけられています。生後91日にあたる日以降、できるだけ早く1回目を受けるのが目安です。' },
    { q: '成犬になっても毎年ワクチンが必要ですか？', a: '狂犬病は日本の法令に従う必要があります。混合ワクチンの追加間隔は種類・製品・接種歴・感染リスクごとに獣医師と相談してください。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { coreSchedule, rabiesFirstDate } from '../../lib/pet-vaccine.js';

  const $ = (id) => document.getElementById(id);

  // ISO（YYYY-MM-DD）→ 「〇年〇月〇日」
  const fmtJP = (iso) => {
    const [y, m, d] = iso.split('-');
    return `${Number(y)}年${Number(m)}月${Number(d)}日`;
  };

  function render() {
    const birth = $('birth').value;
    const box = $('result');

    const core = coreSchedule(birth);
    if (!core) {
      box.classList.remove('visible');
      window.hideResultShare?.();
      return;
    }
    box.classList.add('visible');

    // ① 混合ワクチン（3回）— 動的テーブル
    const rows = core
      .map(
        (r) =>
          `<tr><td class="iv-td-times">${r.times}回目</td><td class="iv-td-weeks">生後${r.weeks}週ごろ</td><td class="iv-td-date">${fmtJP(r.date)}ごろ</td></tr>`
      )
      .join('');
    $('iv-core').innerHTML =
      `<table class="iv-table"><thead><tr><th>回</th><th>時期</th><th>目安日</th></tr></thead><tbody>${rows}</tbody></table>`;

    // ② 狂犬病ワクチン
    const rabies = rabiesFirstDate(birth);
    $('iv-rabies').innerHTML = rabies
      ? `<p class="iv-note">生後91日＝<strong>${fmtJP(rabies)}ごろ</strong>以降に、できるだけ早く1回目を受けるのが目安です。以降は毎年1回の接種が必要です（狂犬病予防法による義務）。</p>`
      : '<p class="iv-note">―</p>';

    // ③ 成犬の追加（両論併記）
    $('iv-adult').innerHTML =
      '追加接種は製品・接種歴・感染リスクで異なります。16週齢の表示で完了とは判断せず、26週齢以降の再接種も含めて獣医師に相談してください。';

    // 結果サマリー：DOM の表示値から組み立て（再計算しない）。
    const lines = [
      '犬のワクチン週齢カレンダー（獣医師との相談用）',
      `混合 1回目：生後${core[0].weeks}週ごろ・${fmtJP(core[0].date)}ごろ`,
      `混合 3回目：生後${core[2].weeks}週ごろ・${fmtJP(core[2].date)}ごろ`,
    ];
    if (rabies) {
      lines.push(`狂犬病 1回目：${fmtJP(rabies)}ごろ以降`);
    }
    window.setResultShare?.(lines.join('\n'));
  }

  $('birth').addEventListener('input', render);
  $('birth').addEventListener('change', render);
</script>

<!-- 動的 innerHTML で生成する表・段落のスタイルは scoped CSS が効かないため、
     ページ唯一 id 前缀（#iv-core / #iv-rabies / #iv-adult）で is:global に書く。 -->
<style is:global>
  #result .iv-section { margin-top: 18px; }
  #result .iv-section:first-of-type { margin-top: 0; }
  #result .iv-h {
    font-size: 0.92rem;
    font-weight: var(--fw-black);
    color: color-mix(in srgb, var(--cat-color) 62%, #000);
    margin: 0 0 10px;
  }
  #result .iv-note {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--text-3);
  }
  #iv-core .iv-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  #iv-core .iv-table th,
  #iv-core .iv-table td {
    padding: 9px 10px;
    text-align: left;
    border-bottom: 1.5px solid color-mix(in srgb, var(--cat-color) 15%, transparent);
  }
  #iv-core .iv-table th {
    font-size: 0.74rem;
    font-weight: var(--fw-bold);
    color: var(--text-muted);
  }
  #iv-core .iv-table tbody tr:last-child td { border-bottom: none; }
  #iv-core .iv-td-times { font-weight: var(--fw-bold); color: var(--text); white-space: nowrap; }
  #iv-core .iv-td-weeks { color: var(--text-3); white-space: nowrap; }
  #iv-core .iv-td-date {
    font-family: var(--font-mono);
    font-weight: var(--fw-bold);
    color: var(--text);
  }
</style>

<style>
  /* 注意喚起の囲み（接種時期の通年化・同日接種しない 等） */
  .iv-callout {
    margin-top: 6px;
    padding: 14px 16px;
    background: var(--cat-tint);
    border-left: 4px solid var(--cat-color);
    border-radius: var(--r-md);
    font-size: 0.88rem;
    line-height: 1.8;
  }
</style>
