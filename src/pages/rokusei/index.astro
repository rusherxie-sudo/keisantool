---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';
import { fortuneTable } from '../../lib/rokusei.js';

const slug = 'rokusei';
const CURRENT_YEAR = new Date().getFullYear();
const yearlyFortunes = fortuneTable(CURRENT_YEAR);
const daisakkaiTypes = yearlyFortunes.filter((item) => item.category === '大殺界');
const title =
  `六星占術 自動計算【${CURRENT_YEAR}年】｜大殺界・運命星の早見表`;
const description =
  `生年月日から六星占術の運命星・プラス／マイナスと${CURRENT_YEAR}年の大殺界を無料で自動計算。12タイプ早見表と今後9年の運勢も確認できる登録不要の診断ツールです。`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '六星占術・大殺界計算器',
  description,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};

// ── 6運命星のタイプ別 性格・特徴 解説 ──────────────────────
// 公開されている六星占術の解説（spicomi.net / senjutsu.jp / 6sei.net / feely.jp 等）を
// 参照して、各星の共通特徴とプラス・マイナスの傾向差をまとめた参考情報。
// ※占い（娯楽）であり科学的根拠はありません。表現は「〜とされる」等の参考的記述にしています。
type StarProfile = {
  star: string;
  catch: string;
  base: string;
  plus: string;
  minus: string;
};
const STAR_PROFILES: StarProfile[] = [
  {
    star: '土星人',
    catch: '理想を追い求める、頑固な努力家',
    base: '土星人は、まじめで責任感が強く、自分の理想に向かってコツコツ努力を積み重ねるタイプとされています。プライドが高く妥協を嫌う一方、寡黙で本心を見せにくく、芯の強い頑固さを持つといわれます。情に厚く面倒見がよい反面、束縛を嫌い、自分のペースを大切にする傾向があるとされます。',
    plus: 'プラスは行動的で、思い立つとすぐ動く積極派とされます。サバサバとして人当たりがよく社交的ですが、やや飽きっぽい一面もあるといわれます。',
    minus: 'マイナスは慎重で控えめ。石橋を叩いて渡るように熟考してから動くタイプとされ、一度決めるとじっくり取り組む粘り強さがあるといわれます。ミステリアスな魅力を感じさせる人が多いとも。',
  },
  {
    star: '金星人',
    catch: '感性ゆたかで、愛されるロマンチスト',
    base: '金星人は、感覚や直感を大切にし、フィーリングで動く感性豊かなタイプとされています。明るく社交的で人を惹きつける魅力があり、好きなものには情熱的に向かっていくといわれます。おおらかで自由を愛する一方、気分屋で熱しやすく冷めやすい面もあるとされます。',
    plus: 'プラスは陽気で開放的、行動力があり目立つ存在になりやすいとされます。好奇心旺盛でフットワークが軽く、人付き合いの輪を広げるのが得意といわれます。',
    minus: 'マイナスは穏やかで思いやり深く、内面の感受性が豊かなタイプとされます。落ち着いた雰囲気で、身近な人を大切にする家庭的な一面があるといわれます。',
  },
  {
    star: '火星人',
    catch: '直感で動く、情熱と行動の星',
    base: '火星人は、頭の回転が速く、どんな仕事もそつなくこなす器用な実力派とされています。クールで冷静に物事を観察する一方、内に熱い情熱を秘め、ここぞという場面では大胆に動くといわれます。感情を表に出すのが苦手で、ミステリアスに見られやすい傾向があるとされます。',
    plus: 'プラスは積極的で負けず嫌い。目標を定めると一気に突き進むパワフルな行動派とされ、リーダー役を任されやすいといわれます。',
    minus: 'マイナスは思慮深く慎重で、じっくり相手を見極めてから動くタイプとされます。ツンデレ気質といわれることもあり、内面はとても感受性が豊かとされます。',
  },
  {
    star: '天王星人',
    catch: '人情に厚く、自由を愛する現実主義者',
    base: '天王星人は、人付き合いが上手で情に厚く、集団の中心にいることが多い愛されキャラとされています。現実的でモノやお金を大切にする堅実さと、人情味あふれる温かさを併せ持つ、やや二面性のある星といわれます。独立心が強く、自分の価値観を大事にする自由人ともされます。',
    plus: 'プラスは社交的で行動力にあふれ、人脈を広げるのが得意とされます。明るく面倒見がよく、周囲を引っ張る存在になりやすいといわれます。',
    minus: 'マイナスは堅実で計画的、現実をよく見て手堅く動くタイプとされます。落ち着いた判断力があり、信頼を集めやすいといわれます。',
  },
  {
    star: '木星人',
    catch: '面倒見がよく、平和を好む包容力の人',
    base: '木星人は、面倒見がよく親分肌・姉御肌で、頼られると放っておけない情の深いタイプとされています。争いを好まず調和を大切にする平和主義で、周囲に安心感を与えるといわれます。一方で奥手で慎重なところがあり、自分のことになると考え込みやすい面もあるとされます。',
    plus: 'プラスは面倒見のよさが前に出る、頼れるリーダータイプとされます。社交的で人をまとめる力があり、周囲から慕われやすいといわれます。',
    minus: 'マイナスは穏やかで聞き上手、縁の下で人を支えるタイプとされます。控えめながら芯が強く、誠実さで信頼を得るといわれます。',
  },
  {
    star: '水星人',
    catch: '柔らかな物腰に、冷静な現実感覚',
    base: '水星人は、見た目はソフトで人当たりがよい一方、内面はクールで現実的なタイプとされています。状況を冷静に見極めて要領よく立ち回る器用さがあり、損得勘定にも長けているといわれます。順応性が高く、どんな環境にもうまく馴染む柔軟さを持つとされます。',
    plus: 'プラスは社交的で行動的、人当たりのよさを活かして幅広く活躍するとされます。明るくフットワークが軽いといわれます。',
    minus: 'マイナスは慎重で現実的、計算をしっかりしてから動く堅実派とされます。物静かに見えて内に強い意志を秘めているといわれます。',
  },
];
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/uranai/">占い・文化</a> ／ 六星占術</div>
    <h1>六星占術 自動計算（{CURRENT_YEAR}年の大殺界・運命星）</h1>
    <p>生年月日を入力するだけで、運命星（6星）とプラス・マイナス、{CURRENT_YEAR}年の大殺界を自動判定。今後9年の早見表も無料で確認できます。</p>
  </div>

  <div class="calc-card">
    <div class="wide-input">
      <div class="form-group">
        <label for="rk-date">生年月日</label>
        <input type="date" id="rk-date" min="1900-01-01" max="2099-12-31" />
      </div>
    </div>

    <div class="result-box" id="rk-result">
      <div class="result-label">あなたの運命星</div>
      <div class="result-main" id="rk-type">―</div>
      <div class="result-rows">
        <div class="result-row"><span class="label">運命星</span><span class="value" id="rk-star">―</span></div>
        <div class="result-row"><span class="label">陽陰</span><span class="value" id="rk-pol">―</span></div>
        <div class="result-row"><span class="label">生まれた日の干支</span><span class="value" id="rk-kanshi">―</span></div>
        <div class="result-row"><span class="label" id="rk-year-label">今年（―年）の運勢</span><span class="value" id="rk-zone">―</span></div>
      </div>
      <div class="rk-note" id="rk-zone-desc"></div>

      <div class="rk-forecast">
        <div class="result-label">今後数年の大殺界カレンダー（運勢の目安）</div>
        <div class="data-table-wrap">
          <div class="data-table-scroll">
            <table class="data-table">
              <thead>
                <tr><th>西暦</th><th>運勢ゾーン</th><th>区分</th></tr>
              </thead>
              <tbody id="rk-forecast"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>六星占術・大殺界の調べ方</h2>
    <p>
      六星占術は、占術研究家の細木数子氏が考案し、現在は細木かおり氏に受け継がれている運命学です。生年月日をもとに、土星人・金星人・火星人・天王星人・木星人・水星人という6つの「運命星」と、生まれ年の干支による陽（プラス）／陰（マイナス）を組み合わせた12タイプで運命の流れを読み解きます。
    </p>
    <p>
      上の欄に生年月日を入力すると、ボタンを押さずに自動で運命星と陽陰を判定し、今年の運勢ゾーン（種子・緑生・立花・健弱・達成・乱気・再会・財成・安定・陰影・停止・減退）と、今後数年間の大殺界カレンダーを表示します。
    </p>
    <ul>
      <li><strong>大殺界</strong>：陰影・停止・減退の3年間。大きな決断や新しい挑戦を控え、慎重に過ごすとよいとされる時期です。</li>
      <li><strong>小殺界（健弱）・中殺界（乱気）</strong>：体調や気持ちが乱れやすいとされる年です。</li>
      <li><strong>好調期</strong>：上記以外の年。特に種子〜立花、達成、安定などは運気が伸びやすいとされます。</li>
    </ul>
    <p>
      本ツールの運命星は「生まれた日の干支から空亡を求める」方式で算出しています。運勢ゾーンは生まれ年の干支と運命星から12年周期で判定します。算法の出典は<a href="https://www.senjutsu.jp/labo_6sei" rel="nofollow noopener" target="_blank">大久保占い研究室</a>、<a href="https://daisakkai.net/nenun" rel="nofollow noopener" target="_blank">大殺界早見表</a>などを参照しています。書籍や提供元により計算法に細部の差異がある場合があります。
    </p>
    <div class="disclaimer">
      ※ 六星占術は娯楽・参考を目的とした占いであり、科学的根拠はありません。表示される結果はあくまで目安です。健康・お金・人生の重要な判断は、結果に頼らずご自身の責任でお決めください。
    </div>
  </section>

  <section class="rk-year-table">
    <h2>{CURRENT_YEAR}年 六星占術・大殺界早見表（12タイプ）</h2>
    <p>
      {CURRENT_YEAR}年に大殺界なのは、
      <strong>{daisakkaiTypes.map((item) => `${item.type}（${item.zone}）`).join('・')}</strong>
      です。12タイプすべての年運を一覧で確認できます。
    </p>
    <div class="data-table-wrap">
      <div class="data-table-scroll">
        <table class="data-table">
          <thead>
            <tr><th>運命星タイプ</th><th>{CURRENT_YEAR}年の運気</th><th>区分</th></tr>
          </thead>
          <tbody>
            {yearlyFortunes.map((item) => (
              <tr class={item.category === '大殺界' ? 'is-daisakkai' : ''}>
                <th scope="row">{item.type}</th>
                <td>{item.zone}</td>
                <td><span class={`rk-year-badge rk-year-${item.category}`}>{item.category}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="rk-year-note">
      ※ この表は1年ごとに巡る「年運」の大殺界です。人生の特定期間を扱う「宿命大殺界」とは異なります。本ツールは年運の大殺界を計算します。
    </p>
  </section>

  <section class="rk-guide">
    <h2>六星占術を調べたあとに役立つ計算</h2>
    <p>六星占術の大殺界と、厄年・干支・星座は別の考え方です。生まれ年や年齢をあわせて確認したいときは、次の無料ツールもご利用ください。</p>
    <ul>
      <li><a href="/yakudoshi/">厄年計算器</a>：男女別の前厄・本厄・後厄を数え年で確認</li>
      <li><a href="/nenrei-hayami/">年齢早見表</a>：西暦・和暦から現在の年齢を確認</li>
      <li><a href="/seiza/">星座早見表</a>：誕生日から12星座を確認</li>
    </ul>
  </section>

  <section class="rk-types">
    <h2>運命星（6星）タイプ別の性格・特徴</h2>
    <p>
      あなたの運命星を計算すると、下のタイプが自動でハイライトされます。各星の基本的な性格と、プラス（陽）・マイナス（陰）の傾向の違いを参考にご覧ください。
    </p>
    <div class="rk-type-list">
      {STAR_PROFILES.map((p) => (
        <details class="rk-type-card" data-star={p.star}>
          <summary>
            <span class="rk-type-star">{p.star}</span>
            <span class="rk-type-catch">{p.catch}</span>
            <span class="rk-type-you">あなたの星</span>
          </summary>
          <div class="rk-type-body">
            <p class="rk-type-base">{p.base}</p>
            <div class="rk-type-pm">
              <div class="rk-pm rk-pm-plus">
                <span class="rk-pm-label">プラス（陽）</span>
                <p>{p.plus}</p>
              </div>
              <div class="rk-pm rk-pm-minus">
                <span class="rk-pm-label">マイナス（陰）</span>
                <p>{p.minus}</p>
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
    <p class="rk-types-note">
      ※ 性格・特徴は公開されている六星占術の解説（spicomi.net・大久保占い研究室・公式サイト 6sei.net 等）をもとにまとめた参考情報です。占い（娯楽）であり科学的根拠はありません。あくまで目安としてお楽しみください。
    </p>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '自分の運命星はどう調べますか？', a: '生年月日を入力すると、土星人・金星人・火星人・天王星人・木星人・水星人の6つの運命星と、陽（＋）／陰（−）を自動判定します。' },
    { q: `${CURRENT_YEAR}年に大殺界なのは何星人ですか？`, a: `${CURRENT_YEAR}年に大殺界なのは、${daisakkaiTypes.map((item) => `${item.type}（${item.zone}）`).join('・')}です。年運は12年周期で巡ります。` },
    { q: '大殺界と宿命大殺界は同じですか？', a: '異なります。大殺界は12年周期の年運のうち陰影・停止・減退の3年間を指します。宿命大殺界は人生の特定期間を扱う別の考え方で、本ツールの計算対象外です。' },
    { q: '大殺界とは何ですか？', a: '六星占術で運気が低調とされる「陰影・停止・減退」の3年間のことです。本ツールで今後の運勢ゾーンの目安を表示します。' },
    { q: '結果は信頼できますか？', a: '占いは文化的な慣習・娯楽を目的としたもので、科学的根拠を保証するものではありません。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<!-- innerHTML で注入される badge は scoped style が効かないため global で定義（CLAUDE.md の罠） -->
<style is:global>
  #rk-zone .rk-badge, #rk-forecast .rk-badge { display: inline-block; font-size: .72rem; font-weight: var(--fw-bold); padding: 2px 10px; border-radius: var(--r-pill); }
  #rk-zone .rk-badge { margin-left: 6px; }
  #rk-zone .rk-badge.daisakkai, #rk-forecast .rk-badge.daisakkai { background: var(--danger-bg); color: var(--danger); }
  #rk-zone .rk-badge.chusakkai, #rk-forecast .rk-badge.chusakkai { background: var(--warning-bg); color: var(--warning-text); }
  #rk-zone .rk-badge.shosakkai, #rk-forecast .rk-badge.shosakkai { background: var(--warning-bg); color: var(--warning-text); }
  #rk-zone .rk-badge.kouchou, #rk-forecast .rk-badge.kouchou { background: var(--cat-tint); color: color-mix(in srgb, var(--cat-color) 62%, #000); }
</style>

<style>
  .rk-note { font-size: .8rem; color: var(--text-muted); margin-top: 12px; line-height: 1.7; }
  .rk-forecast { margin-top: 18px; padding-top: 16px; border-top: 1.5px solid var(--border-2); }
  .rk-forecast .result-label { margin-bottom: 10px; }
  .result-main.daisakkai { color: var(--danger); }

  /* タイプ別 性格・特徴 */
  .rk-types { margin-top: 28px; }
  .rk-type-list { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
  .rk-type-card { border: 1.5px solid var(--border-2); border-radius: var(--r-md); overflow: hidden; background: var(--surface); transition: border-color var(--ease), box-shadow var(--ease); }
  .rk-type-card > summary {
    list-style: none; cursor: pointer; padding: 14px 16px;
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 12px;
  }
  .rk-type-card > summary::-webkit-details-marker { display: none; }
  .rk-type-star { font-size: 1.05rem; font-weight: var(--fw-bold); color: var(--text); }
  .rk-type-catch { font-size: .86rem; color: var(--text-muted); }
  .rk-type-you {
    display: none; margin-left: auto; font-size: .72rem; font-weight: var(--fw-bold);
    padding: 2px 9px; border-radius: var(--r-pill); background: var(--cat-color); color: #fff;
  }
  .rk-type-card.is-you { border-color: var(--cat-color); box-shadow: 0 0 0 2px var(--cat-tint); }
  .rk-type-card.is-you .rk-type-you { display: inline-block; }
  .rk-type-body { padding: 0 16px 16px; }
  .rk-type-base { font-size: .9rem; line-height: 1.8; color: var(--text); margin: 0 0 12px; }
  .rk-type-pm { display: grid; gap: 10px; }
  @media (min-width: 560px) { .rk-type-pm { grid-template-columns: 1fr 1fr; } }
  .rk-pm { border-radius: var(--r-md); padding: 10px 12px; }
  .rk-pm-plus { background: var(--cat-tint); }
  .rk-pm-minus { background: var(--surface-sub); }
  .rk-pm-label { display: inline-block; font-size: .74rem; font-weight: var(--fw-bold); margin-bottom: 4px; }
  .rk-pm-plus .rk-pm-label { color: color-mix(in srgb, var(--cat-color) 62%, #000); }
  .rk-pm-minus .rk-pm-label { color: var(--text-3); }
  .rk-pm p { font-size: .84rem; line-height: 1.75; margin: 0; color: var(--text); }
  .rk-types-note { font-size: .78rem; color: var(--text-muted); margin-top: 14px; line-height: 1.7; }
  .rk-year-table { margin-top: 28px; }
  .rk-year-table .data-table-wrap { margin-top: 14px; }
  .rk-year-table .data-table th[scope="row"] { text-align: left; white-space: nowrap; }
  .rk-year-table tr.is-daisakkai { background: var(--danger-bg); }
  .rk-year-badge { display: inline-block; padding: 3px 9px; border-radius: var(--r-pill); font-size: .72rem; font-weight: var(--fw-bold); white-space: nowrap; }
  .rk-year-大殺界 { color: var(--danger); background: color-mix(in srgb, var(--danger) 12%, #fff); }
  .rk-year-中殺界, .rk-year-小殺界 { color: var(--warning-text); background: var(--warning-bg); }
  .rk-year-好調 { color: color-mix(in srgb, var(--cat-color) 62%, #000); background: var(--cat-tint); }
  .rk-year-note { margin-top: 10px; font-size: .78rem; line-height: 1.7; color: var(--text-muted); }
  .rk-guide { margin-top: 28px; padding: 20px; border-radius: var(--r-md); background: var(--cat-tint); }
  .rk-guide h2 { margin-top: 0; }
  .rk-guide p, .rk-guide li { font-size: .9rem; line-height: 1.8; }
  .rk-guide ul { margin-bottom: 0; }
</style>

<script>
  import { rokusei, fortuneZone, forecast } from '../../lib/rokusei.js';

  const $ = (id) => document.getElementById(id);
  const CAT_CLASS = { 大殺界: 'daisakkai', 中殺界: 'chusakkai', 小殺界: 'shosakkai', 好調: 'kouchou' };
  let hasTrackedResult = false;

  function badge(category) {
    return `<span class="rk-badge ${CAT_CLASS[category] || 'kouchou'}">${category}</span>`;
  }

  function render() {
    const v = $('rk-date').value;
    const box = $('rk-result');
    if (!v) { box.classList.remove('visible'); window.hideResultShare?.(); return; }
    const [y, m, d] = v.split('-').map(Number);
    const r = rokusei(y, m, d);
    if (!r) { box.classList.remove('visible'); window.hideResultShare?.(); return; }
    box.classList.add('visible');
    if (!hasTrackedResult) {
      window.trackCalculatorResult?.('fortune');
      hasTrackedResult = true;
    }

    $('rk-type').textContent = r.type;
    $('rk-star').textContent = r.star;
    $('rk-pol').textContent = r.polarity + '（' + r.yearBranch + '年）';
    $('rk-kanshi').textContent = r.kanshi + '（空亡：' + r.kuubou + '）';

    const thisYear = new Date().getFullYear();
    const z = fortuneZone(r.type, thisYear);
    $('rk-year-label').textContent = `今年（${thisYear}年）の運勢`;
    $('rk-zone').innerHTML = z.zone + badge(z.category);
    $('rk-zone-desc').textContent = z.desc;

    const isDai = z.category === '大殺界';
    $('rk-type').classList.toggle('daisakkai', isDai);

    // 該当する運命星のタイプ解説カードをハイライト＆展開
    document.querySelectorAll('.rk-type-card').forEach((card) => {
      const match = card.getAttribute('data-star') === r.star;
      card.classList.toggle('is-you', match);
      if (match) card.setAttribute('open', '');
    });

    const fc = forecast(r.type, thisYear, 9);
    $('rk-forecast').innerHTML = fc
      .map((f) => {
        const hit = f.year === thisYear || f.category === '大殺界';
        return `<tr class="${hit ? 'is-hit' : ''}"><td class="num">${f.year}年${f.year === thisYear ? '<span class="num--sub">（今年）</span>' : ''}</td><td>${f.zone}</td><td>${badge(f.category)}</td></tr>`;
      })
      .join('');

    // 結果シェア用サマリー（描画済み DOM の textContent から組み立てる）
    window.setResultShare?.(
      '六星占術・大殺界\n' +
        '運命星：' + $('rk-type').textContent + '\n' +
        '陽陰：' + $('rk-pol').textContent + '\n' +
        $('rk-year-label').textContent + '：' + $('rk-zone').textContent
    );
  }

  $('rk-date').addEventListener('input', render);
  $('rk-date').addEventListener('change', render);
</script>
