---
import ToolLayout from '../../layouts/ToolLayout.astro';import RelatedTools from '../../components/RelatedTools.astro';import Faq from '../../components/Faq.astro';import ResultShare from '../../components/ResultShare.astro';
const slug='kasokudo',title='加速度計算ツール｜速度・時間・G・等加速度の距離',description='初速度・終速度・時間から加速度m/s²とGを計算。等加速度運動の終速度・移動距離、km/hとm/s、GとGalの換算にも対応します。';
const jsonld={'@context':'https://schema.org','@type':'WebApplication',name:'加速度計算ツール',description,applicationCategory:'UtilityApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'},featureList:['速度変化と時間から加速度計算','m/s²・G・Gal換算','等加速度運動の速度と距離']};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide><div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 加速度計算</div><h1>加速度計算ツール</h1><p>速度の変化量と時間から加速度を求め、m/s²・G・Galで表示します。</p><div class="chips"><span>a＝(v−v₀)÷t</span><span>m/s²・G</span><span>等加速度運動</span></div></div>
<div class="calc-card tool-card"><div class="tabs"><button class="tab active" data-mode="basic">加速度</button><button class="tab" data-mode="motion">速度・距離</button><button class="tab" data-mode="convert">単位換算</button></div>
<section class="calc-panel panel active" data-panel="basic"><h2>速度変化と時間から加速度を計算</h2><div class="grid"><label>初速度<input id="b-initial" type="number" value="0" step="any"></label><label>終速度<input id="b-final" type="number" value="100" step="any"></label><label>速度の単位<select id="b-unit"><option value="km/h">km/h</option><option value="m/s">m/s</option><option>mph</option></select></label><label>経過時間（秒）<input id="b-time" type="number" value="10" min="0" step="any"></label></div><p class="error" id="b-error" hidden>速度と0より大きい時間を入力してください。</p><div class="result" id="b-result"><span>平均加速度</span><strong id="b-main">—</strong><small id="b-sub"></small></div></section>
<section class="calc-panel panel" data-panel="motion"><h2>等加速度運動の終速度・移動距離</h2><div class="grid"><label>初速度<input id="m-speed" type="number" value="0" step="any"></label><label>速度単位<select id="m-speed-unit"><option value="m/s">m/s</option><option value="km/h">km/h</option><option>mph</option></select></label><label>加速度<input id="m-accel" type="number" value="2" step="any"></label><label>加速度単位<select id="m-accel-unit"><option value="m/s2">m/s²</option><option>G</option><option>Gal</option></select></label><label>時間（秒）<input id="m-time" type="number" value="10" min="0" step="any"></label></div><p class="error" id="m-error" hidden>数値と0より大きい時間を入力してください。</p><div class="result" id="m-result"><span>終速度</span><strong id="m-main">—</strong><small id="m-sub"></small></div></section>
<section class="calc-panel panel" data-panel="convert"><h2>加速度単位を換算</h2><div class="grid"><label>加速度<input id="c-value" type="number" value="1" step="any"></label><label>変換元<select id="c-unit"><option value="m/s2">m/s²</option><option>G</option><option>Gal</option></select></label></div><div class="values" id="c-values"></div></section></div><ResultShare/><div class="ad-slot"></div>
<section class="howto"><h2>加速度の計算式</h2><p>平均加速度aは速度の変化量v−v₀を時間tで割り、<strong>a＝(v−v₀)÷t</strong>で求めます。停止状態から100km/hまで10秒なら、100km/h＝約27.7778m/sなので約2.7778m/s²、約0.2833Gです。速度の単位だけを変換する場合は<a href="/hayasa/">速度・時速換算ツール</a>をご利用ください。</p></section>
<section class="howto"><h2>等加速度運動の速度と距離</h2><div class="formula"><div><strong>v＝v₀＋at</strong><span>終速度</span></div><div><strong>x＝v₀t＋at²÷2</strong><span>移動距離</span></div><div><strong>1G＝9.80665m/s²</strong><span>標準重力加速度</span></div></div><p>この式は加速度が一定で直線運動する理想条件です。空気抵抗、路面勾配、タイヤの滑り、反応時間は含みません。制動距離や安全距離の判断には使わないでください。</p></section>
<section class="howto source-box"><h2>単位と計算根拠</h2><ul><li><a href="https://unit.aist.go.jp/nmij/library/si-units/" target="_blank" rel="noopener noreferrer">産業技術総合研究所 NMIJ「国際単位系（SI）」</a>：m、sとSI組立単位。</li><li><a href="https://unit.aist.go.jp/riem/pv-std/information.html" target="_blank" rel="noopener noreferrer">産業技術総合研究所「圧力真空標準」</a>：標準重力加速度9.80665m/s²。</li></ul><div class="disclaimer">※ 計算結果はあくまで参考値です。車両性能、安全距離、機械設計、耐震判断には実測値と適用規格を使用してください。</div></section><RelatedTools current={slug}/><Faq items={[{q:'加速度の計算式は？',a:'平均加速度は（終速度−初速度）÷時間です。'},{q:'1Gは何m/s²ですか？',a:'標準重力加速度では1G＝9.80665m/s²です。'},{q:'100km/hまで10秒の加速度は？',a:'停止状態から一定に変化した平均なら約2.7778m/s²、約0.2833Gです。'},{q:'減速すると加速度はマイナスですか？',a:'進行方向を正とした場合、速度が下がれば負の加速度になります。'},{q:'Galとは何ですか？',a:'1Gal＝0.01m/s²です。地震や重力の分野で使われます。'}]}/><div class="ad-slot"></div></ToolLayout>
<style>.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips span{padding:5px 10px;background:var(--cat-tint);color:var(--cat-color);border-radius:999px;font-size:.75rem;font-weight:700}.tool-card{overflow:hidden}.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface-sub)}.tab{padding:15px;border:0;border-bottom:3px solid transparent;background:none;font-weight:700}.tab.active{background:var(--surface);color:var(--cat-color);border-color:var(--cat-color)}.panel{padding:24px}.panel:not(.active){display:none}.panel h2{margin-top:0;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.grid label{display:flex;flex-direction:column;gap:7px;font-size:.8rem;font-weight:700}.grid input,.grid select{width:100%;min-width:0}.result{display:flex;flex-direction:column;align-items:center;gap:5px;margin-top:20px;padding:20px;background:var(--cat-tint);border-radius:var(--r-md)}.result strong{font:700 clamp(1.8rem,6vw,2.8rem) var(--font-mono);color:var(--cat-color)}.result small{color:var(--text-muted)}.error{padding:10px;background:var(--danger-bg);color:var(--danger)}.values,.formula{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.values div,.formula div{display:flex;flex-direction:column;padding:13px;border:1px solid var(--border-2);background:var(--surface-sub);border-radius:var(--r-md)}.values strong,.formula strong{font-family:var(--font-mono);color:var(--cat-color)}@media(max-width:650px){.grid,.values,.formula{grid-template-columns:1fr 1fr}}@media(max-width:480px){.panel{padding:18px}.grid,.values,.formula{grid-template-columns:1fr}.tab{font-size:.75rem}}</style>
<script>import{convertSpeed,convertAcceleration,solveAcceleration,solveConstantAcceleration}from'../../lib/kasokudo.js';const $=id=>document.getElementById(id),fmt=n=>Number(n.toPrecision(8)).toLocaleString('ja-JP',{maximumFractionDigits:12});let mode='basic';function rb(){const r=solveAcceleration({initialSpeed:$('b-initial').value,finalSpeed:$('b-final').value,speedUnit:$('b-unit').value,time:$('b-time').value});$('b-error').hidden=!!r;$('b-result').hidden=!r;if(!r)return;$('b-main').textContent=`${fmt(r.accelerationMs2)} m/s²`;$('b-sub').textContent=`${fmt(r.accelerationG)} G・${fmt(r.accelerationMs2*100)} Gal`;if(mode==='basic')window.setResultShare?.(`加速度計算\n${$('b-main').textContent}`)}function rm(){const r=solveConstantAcceleration({initialSpeed:$('m-speed').value,speedUnit:$('m-speed-unit').value,acceleration:$('m-accel').value,accelerationUnit:$('m-accel-unit').value,time:$('m-time').value});$('m-error').hidden=!!r;$('m-result').hidden=!r;if(!r)return;$('m-main').textContent=`${fmt(r.finalSpeedMs)} m/s`;$('m-sub').textContent=`${fmt(convertSpeed(r.finalSpeedMs,'m/s','km/h'))} km/h・移動距離 ${fmt(r.distanceM)} m`;if(mode==='motion')window.setResultShare?.(`等加速度運動\n終速度 ${$('m-main').textContent}・距離 ${fmt(r.distanceM)}m`)}function rc(){const units=['m/s2','G','Gal'],labels={'m/s2':'m/s²'},v=$('c-value').value,u=$('c-unit').value;$('c-values').innerHTML=units.map(x=>`<div><span>${labels[x]||x}</span><strong>${convertAcceleration(v,u,x)===null?'—':fmt(convertAcceleration(v,u,x))}</strong></div>`).join('')}document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.dataset.panel===mode));({basic:rb,motion:rm,convert:rc})[mode]()}));document.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',()=>{rb();rm();rc()}));rb();rm();rc();</script>
