---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'suisui';
const title = '水分摂取量計算器 - 体重と係数から水分量の目安を試算 | 計算ツール';
const description =
  '体重に25・30・40mL/kgの仮の係数を掛けた比較用の目安。個人の必要量や飲むべき水の量を診断するものではありません。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '水分摂取量計算器',
  description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/kenko/">健康・身体</a> ／ 水分摂取量計算</div>
    <h1>水分摂取量計算器</h1>
    <p>体重に係数を掛けた参考値を表示します。飲み物だけで摂るべき量や医学的な必要量を指示するものではありません。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="weight">体重（kg）</label>
      <input type="number" id="weight" inputmode="numeric" placeholder="例：60" />
    </div>

    <div class="form-group">
      <label id="activity-label">比較する活動区分・仮の係数</label>
      <div class="radio-group radio-group-wrap" role="radiogroup" aria-labelledby="activity-label">
        <input type="radio" id="activity-normal" name="activity" value="normal" checked /><label for="activity-normal">普通（30mL/kg）</label>
        <input type="radio" id="activity-active" name="activity" value="active" /><label for="activity-active">多い（40mL/kg）</label>
        <input type="radio" id="activity-sedentary" name="activity" value="sedentary" /><label for="activity-sedentary">少ない（25mL/kg）</label>
      </div>
    </div>

    <div class="result-box" id="result">
      <div class="result-label">係数による参考値（飲水のノルマではありません）</div>
      <div class="result-main" id="recommended">0ml</div>
      <div class="result-rows" id="details"></div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>計算の前提</h2><p>本ツールは体重×係数（少ない25・普通30・多い40mL/kg）という簡略モデルです。60kgなら1,500・1,800・2,400mLとなります。これらの活動区分と係数は、公的機関が全員に定めた飲水基準ではありません。</p>
    <h3>飲み物だけの目標にしない</h3><p>体に入る水分には食事に含まれるものもあります。発汗、気温、食事、年齢、病気や服薬によって必要量は変わります。本ツールはそれらを測定せず、乳幼児・妊娠授乳期・高齢者などの個別の必要量を算出できません。</p>
    <p>心臓・腎臓などの病気で水分制限がある方は主治医の指示を優先してください。減量のために大量に水を飲んだり、脱水を我慢したりするためには使わないでください。</p>
    <h3>暑さ・体調不良がある場合</h3><p>熱中症が疑われる場合は涼しい場所へ移動し、体を冷やします。自力で飲めない、意識がはっきりしない場合は救急車を呼び、無理に飲ませないでください。計算値に達したかどうかで判断しません。</p>
    <p>2026年10月10日に利用上の注意を確認：<a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/0000212502.html">厚生労働省・熱中症予防</a>。この資料が上記の体重別係数を推奨しているわけではありません。詳しい違いは<a href="/blog/suisui-ryou-no-kakikata/">水分量の目安の読み方</a>へ。</p>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '表示された量を水だけで飲みますか？', a: 'いいえ。食事由来の水分や個人の状態を反映していないため、飲み物だけの目標量にしないでください。' },
    { q: '病気があっても使えますか？', a: '治療上の水分管理には使えません。水分制限や服薬がある場合は主治医の指示を優先してください。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { calcSuisui } from '../../lib/suisui.js';

  const $ = (id) => document.getElementById(id);

  function show(box) { box.classList.add('visible'); }
  function hide(box) { box.classList.remove('visible'); window.hideResultShare?.(); }

  function render() {
    const box = $('result');
    const weight = $('weight').value;
    const activity = document.querySelector('input[name="activity"]:checked')?.value || 'normal';

    const r = calcSuisui(weight, activity);
    if (r.recommended === 0) return hide(box);

    show(box);
    $('recommended').textContent = r.recommended.toLocaleString('ja-JP') + 'ml';

    const details = $('details');
    details.innerHTML = `
      <div class="result-row"><span class="label">150mL換算（参考）</span><span class="value">${r.glasses}杯</span></div>
    `;

    window.setResultShare?.('水分摂取量計算器\n係数による参考値：' + $('recommended').textContent);
  }

  $('weight').addEventListener('input', render);
  document.querySelectorAll('input[name="activity"]').forEach((el) => {
    el.addEventListener('change', render);
  });
</script>