---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import { hayamiTable, UMAREDOSHI_FROM, UMAREDOSHI_TO } from '../../lib/hayami.js';
import { seirekiToWareki } from '../../lib/wareki.js';
import { japanDateParts } from '../../lib/japanDate.js';

const slug = 'nenrei-hayami';

// 基準年はビルド時に固定（毎年1月1日の再ビルドで自動更新される）。
const { year: BASE_YEAR } = japanDateParts();
const BASE_WAREKI = seirekiToWareki(BASE_YEAR).label; // 例：令和8年
const FROM_YEAR = 1868; // 明治元年
// 生まれ年の個別ページ（/umaredoshi/<year>/）がある範囲
const SPOKE_FROM = UMAREDOSHI_FROM;
const SPOKE_TO = UMAREDOSHI_TO;

// 新しい年が上（今年 → 明治元年）の表データ
const rows = hayamiTable(FROM_YEAR, BASE_YEAR, BASE_YEAR).reverse();

const title = `年齢早見表【${BASE_YEAR}年（${BASE_WAREKI}）版】西暦・和暦・満年齢・数え年・干支 | 計算ツール`;
const description = `${BASE_YEAR}年（${BASE_WAREKI}）版の年齢早見表。明治・大正・昭和・平成・令和の生まれ年ごとに、西暦・和暦・満年齢・数え年・干支をひと目で確認できます。印刷にも対応し、確定申告や履歴書など書類記入時の年齢確認にそのまま使えます。`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '年齢早見表',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};

const canonicalUrl = new URL(`/${slug}/`, Astro.site).href;

// 年表（明治元年〜今年の159行）を Dataset としてマークアップする。
// 行データは ItemList で列挙せず（159行は重すぎる）、カバー範囲・列構成・無料性だけを宣言する。
const datasetJsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonicalUrl}#dataset`,
  name: `${BASE_YEAR}年（${BASE_WAREKI}）版 年齢早見表データ（西暦・和暦・満年齢・数え年・干支）`,
  description: `明治元年（1868年）から${BASE_YEAR}年（${BASE_WAREKI}）までの生まれ年 ${rows.length} 行ぶんについて、西暦・和暦・満年齢（${BASE_YEAR}年の誕生日を迎えた後）・数え年・干支をまとめた年齢早見表のデータです。`,
  url: canonicalUrl,
  inLanguage: 'ja',
  isAccessibleForFree: true,
  license: 'https://keisantool.com/terms/',
  temporalCoverage: `${FROM_YEAR}/${BASE_YEAR}`,
  keywords: ['年齢早見表', '満年齢', '数え年', '和暦', '干支'],
  variableMeasured: [
    { '@type': 'PropertyValue', name: '西暦', description: '生まれ年の西暦', unitText: '年' },
    { '@type': 'PropertyValue', name: '和暦', description: '生まれ年の和暦表記（改元の年は旧元号／新元号を併記）' },
    { '@type': 'PropertyValue', name: '満年齢', description: `${BASE_YEAR}年の誕生日を迎えた後の満年齢`, unitText: '歳' },
    { '@type': 'PropertyValue', name: '数え年', description: '生まれた年を1歳とし、1月1日ごとに1歳加える数え方', unitText: '歳' },
    { '@type': 'PropertyValue', name: '干支', description: '生まれ年の十二支（子・丑・寅など）' },
  ],
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 年齢早見表</div>
    <h1>年齢早見表【{BASE_YEAR}年・{BASE_WAREKI}版】</h1>
    <p>
      生まれ年から<strong>西暦・和暦・満年齢・数え年・干支</strong>を確認できます。
    </p>
  </div>

  <section class="hayami-main">
    <!-- 年表を Dataset として構造化データで宣言（行データは列挙しない） -->
    <script type="application/ld+json" set:html={JSON.stringify(datasetJsonld)} />
    <nav class="hayami-actions" aria-label="年齢表の切り替え・保存">
      <a href="/nenrei-hayami/2027/">2027年版を見る</a>
      <a href="#age-downloads">PDF・印刷</a>
    </nav>
    <div class="hayami-lookup" hidden>
      <label for="birth-year-search">生まれ年を探す（西暦・和暦）</label>
      <div class="hayami-search-controls">
        <input id="birth-year-search" type="search" placeholder="例：1988、昭和63、平成元年" autocomplete="off" aria-controls="age-table-body" aria-describedby="age-search-status" />
        <button id="clear-year-search" type="button">全件表示</button>
      </div>
      <p id="age-search-status" role="status">{rows.length}年分を表示</p>
    </div>
    <p class="hayami-note">
      満年齢は<strong>{BASE_YEAR}年の誕生日を迎えた後</strong>の年齢です。誕生日前は<strong>1歳引いて</strong>ください。生まれる前は対象外です。
    </p>

    <div class="data-table-wrap">
      <div class="data-table-scroll">
        <table class="data-table hayami-table">
          <thead>
            <tr><th>西暦</th><th>和暦</th><th>満年齢</th><th>数え年</th><th>干支</th></tr>
          </thead>
          <tbody id="age-table-body">
            {rows.map((r) => (
              <tr data-birth-year={r.seireki} data-year-label={`${r.seireki}年 ${r.wareki} ${r.wareki.replaceAll('元年', '1年')}`}>
                <td class="num">
                  {r.seireki >= SPOKE_FROM && r.seireki <= SPOKE_TO ? (
                    <a href={`/umaredoshi/${r.seireki}/`} title={`${r.seireki}年生まれの年齢・干支・厄年`}>{r.seireki}年</a>
                  ) : (
                    `${r.seireki}年`
                  )}
                </td>
                <td class="num--sub">{r.wareki}</td>
                <td class="num">{r.age}歳</td>
                <td class="num--sub">{r.kazoe}歳</td>
                <td class="num--sub">{r.eto}（{r.etoYomi}）</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="hayami-note">
      ※ 満年齢は誕生日を迎えた後の年齢（誕生日前は−1歳）。改元のあった年は和暦を「旧元号／新元号」で併記しています。西暦のリンクから、各生まれ年の<strong>干支・厄年・星座・六星占術</strong>までまとめた個別ページを開けます。計算結果はあくまで参考値です。
    </p>
  </section>

  <div class="ad-slot"></div>

  <section class="howto" id="age-downloads" aria-label="年齢早見表の保存">
      <div class="pdf-downloads">
        <strong>年齢早見表PDF（A4横・1枚／0〜100歳）</strong>
        <p>各年の誕生日後の年齢です。誕生日前は1歳引いてください。未出生の方は対象外です。</p>
        <a href="/downloads/nenrei-hayami-2026.pdf" download data-pdf-year="2026">2026年版PDFをダウンロード</a>
        <a href="/downloads/nenrei-hayami-2027.pdf" download data-pdf-year="2027">2027年版PDFをダウンロード</a>
      </div>
    <button id="print-btn" class="print-btn" type="button">この早見表を印刷する</button>
    <p class="hayami-intent-note">
      生まれ年を指定して確認したい場合は、<a href="/umaredoshi/1988/">1988年生まれは何歳？</a>のような個別ページをご利用ください。今日の年齢を生年月日から正確に求める場合は<a href="/nenrei/">年齢計算器</a>、入学年度や学年を確認する場合は<a href="/gakunen-hayami/">学年早見表</a>が便利です。
    </p>

  </section>

  <section class="howto">
    <h2>年齢早見表の見方</h2>
    <p>
      この早見表は<strong>{BASE_YEAR}年（{BASE_WAREKI}）時点</strong>の年齢をまとめたものです。「満年齢」の列は、今年の誕生日を迎えた後の年齢を表示しています。誕生日がまだの方は表の年齢から1を引いてください。たとえば履歴書や公的書類には満年齢を記入するのが原則です。
    </p>
    <ul>
      <li><strong>満年齢</strong>：生まれた日を0歳とし、誕生日ごとに1歳加える数え方。書類記入は原則こちら。生年月日から正確に計算したいときは<a href="/nenrei/">年齢計算器</a>が便利です。</li>
      <li><strong>数え年</strong>：生まれた年を1歳とし、1月1日（元日）ごとに1歳加える数え方。厄年・七五三・長寿祝いなど伝統行事で使われます。</li>
      <li><strong>和暦</strong>：昭和64年／平成元年のように改元のあった年は2つの元号を併記しています。細かい換算は<a href="/wareki/">和暦・西暦変換器</a>で確認できます。</li>
      <li><strong>干支（十二支）</strong>：子・丑・寅…の12年周期。年賀状や厄年の話題でよく使われます。</li>
    </ul>
    <p>
      なお、厄年（数え年で男性25・42・61歳、女性19・33・37・61歳）に当たるかどうかは<a href="/yakudoshi/">厄年チェッカー</a>で自動判定できます。お子さまの学年を知りたい場合は<a href="/gakunen-hayami/">学年早見表</a>もあわせてご利用ください。
    </p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '年齢早見表の満年齢はいつ時点の年齢ですか？', a: `${BASE_YEAR}年（${BASE_WAREKI}）の誕生日を迎えた後の満年齢です。まだ誕生日が来ていない方は、表の年齢から1歳引いてください。` },
    { q: '満年齢と数え年はどう違いますか？', a: '満年齢は生まれた日を0歳とし誕生日ごとに1歳増える数え方で、履歴書や公的書類は原則こちらを使います。数え年は生まれた年を1歳とし、1月1日ごとに1歳増える数え方で、厄年や長寿祝いなどの伝統行事で使われます。' },
    { q: '昭和64年と平成元年のように、同じ西暦に和暦が2つあるのはなぜですか？', a: '年の途中で改元があったためです。1989年は1月7日までが昭和64年、1月8日からが平成元年です。本早見表では改元のあった年は両方の元号を併記しています。' },
    { q: 'この早見表は印刷できますか？', a: 'はい。「この早見表を印刷する」ボタン（またはブラウザの印刷機能）で、表だけをきれいに印刷できるレイアウトになっています。確定申告など書類記入時の手元資料としてご利用ください。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  const search = document.querySelector('#birth-year-search');
  const tableRows = [...document.querySelectorAll('#age-table-body tr')];
  const status = document.querySelector('#age-search-status');
  const normalize = value => value.normalize('NFKC').replace(/\s+/g, '');
  let trackedLookup = false;
  function filterYears() {
    const query = normalize(search.value);
    let count = 0;
    for (const row of tableRows) {
      row.hidden = !normalize(row.dataset.yearLabel).includes(query);
      if (!row.hidden) count++;
    }
    status.textContent = count ? `${count}年分を表示` : '該当する生まれ年がありません。西暦または和暦で入力してください。';
    // Only record successful use; never send the entered birth year.
    if (query && count === 1 && !trackedLookup) {
      window.gtag?.('event', 'age_table_lookup', { tool_slug: 'nenrei-hayami' });
      trackedLookup = true;
    }
  }
  search.addEventListener('input', filterYears);
  document.querySelector('#clear-year-search').addEventListener('click', () => {
    search.value = '';
    filterYears();
    search.focus();
  });
  document.querySelector('.hayami-lookup').hidden = false;
  document.querySelectorAll('[data-pdf-year]').forEach(link => link.addEventListener('click', () => {
    window.gtag?.('event', 'age_table_pdf_download', { tool_slug: 'nenrei-hayami', year: link.dataset.pdfYear });
  }));
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>

<style>
  .pdf-downloads { margin: 16px 0; padding: 16px; background: var(--surface-sub); border-radius: 10px; }
  .pdf-downloads p { font-size: .8rem; }
  .pdf-downloads a { display: inline-block; margin: 8px 16px 0 0; color: var(--cat-color); text-decoration: underline; }
  @media print { .pdf-downloads { display: none; } }

  .hayami-main { max-width: 880px; width: 100%; margin: 0 auto; }
  .hayami-actions { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 12px; font-size: .85rem; }
  .hayami-actions a, .hayami-intent-note a { color: var(--cat-color); text-decoration: underline; text-underline-offset: 2px; }
  .hayami-lookup { margin-bottom: 10px; }
  .hayami-lookup label { display: block; margin-bottom: 6px; font-size: .85rem; font-weight: var(--fw-bold); }
  .hayami-search-controls { display: flex; gap: 8px; }
  .hayami-search-controls input { min-width: 0; flex: 1; padding: 10px; border: 1px solid var(--border); border-radius: var(--r-md); font-size: 16px; color: var(--text); background: var(--surface); }
  .hayami-search-controls button { flex: none; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface); color: var(--text); cursor: pointer; }
  #age-search-status { font-size: .78rem; color: var(--text-muted); margin: 4px 0 0; }
  .hayami-note { font-size: .82rem; color: var(--text-muted); margin: 8px 0 12px; line-height: 1.7; }
  .hayami-intent-note { margin: 12px 0; font-size: .82rem; line-height: 1.7; color: var(--text-muted); }

  .print-btn {
    flex: none;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-weight: var(--fw-bold);
    font-size: .82rem;
    padding: 9px 16px;
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  .print-btn:hover { border-color: var(--cat-color); color: var(--cat-color); }
  /* 5列を880pxに収める：paddingを詰め、最小幅を下げる（375pxでは横スクロール） */
  .hayami-table { min-width: 480px; }
  .hayami-table th, .hayami-table td { padding: 9px 12px; }
  .hayami-table td a { color: var(--cat-color); text-decoration: underline; text-underline-offset: 2px; }
  .hayami-table td a:hover { opacity: .75; }
</style>

<!-- 印刷用：表以外を隠し、159行の長表をインク節約レイアウトで出す。
     site-footer / fshare などレイアウト側の要素も隠すため is:global（header/ad は global.css 側で対応済み） -->
<style is:global>
  @media print {
    .site-footer, .fshare, .print-btn, .hayami-lookup, .hayami-actions, .howto, .faq, .related, .ad-slot,
    .page-hero .crumb, .page-hero p { display: none !important; }
    .page-hero { margin-bottom: 6px; }
    .page-hero h1 { font-size: 14pt; }
    .hayami-main .data-table-wrap { border: none; border-radius: 0; }
    .hayami-main .data-table-scroll { overflow: visible; }
    .hayami-main .hayami-table { min-width: 0; font-size: 8.5pt; }
    .hayami-main .hayami-table th, .hayami-main .hayami-table td { padding: 2px 8px; }
    .hayami-main .hayami-table td a { color: inherit; text-decoration: none; }
    .hayami-main .hayami-table thead { display: table-header-group; }
    .hayami-main .hayami-table tr { break-inside: avoid; }
    .hayami-main .hayami-table tr[hidden] { display: table-row !important; }
  }
</style>
