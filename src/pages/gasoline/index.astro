---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'gasoline';
const title = 'ガソリン代計算器 — 走行距離・燃費から交通費を計算 | 計算ツール';
const description =
  '走行距離・燃費・ガソリン単価を入力するだけで、片道・往復のガソリン代と月額交通費を自動計算する無料ツール。通勤・旅行・ドライブの交通費計算に。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ガソリン代計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---

<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ ガソリン代計算</div>
    <h1>ガソリン代計算器</h1>
    <p>走行距離・燃費・ガソリン価格を入力すると、片道・往復・月額の交通費を自動計算します。</p>
  </div>

  <div class="calc-card">
    <div class="calc-panel active" style="padding:24px">
      <div class="form-group">
        <label for="distance">走行距離（km）</label>
        <input type="number" id="distance" inputmode="decimal" placeholder="例：30" min="0" step="0.1" />
      </div>
      <div class="form-group">
        <label for="fuel-eff">燃費（km/L）</label>
        <input type="number" id="fuel-eff" inputmode="decimal" placeholder="例：15" min="0" step="0.1" />
      </div>
      <div class="form-group">
        <label for="gas-price">ガソリン価格（円/L）</label>
        <input type="number" id="gas-price" inputmode="numeric" placeholder="例：170" min="0" />
      </div>
      <div class="form-group">
        <label for="workdays">月の出勤日数（日）<span class="optional-label">— 月額を計算する場合</span></label>
        <input type="number" id="workdays" inputmode="numeric" placeholder="例：20" min="0" max="31" />
      </div>

      <div class="warikan-fields">
        <div class="warikan-title">割り勘（人数で分ける）<span class="optional-label">— 任意</span></div>
        <div class="form-group">
          <label for="people">乗車人数（人）</label>
          <input type="number" id="people" inputmode="numeric" placeholder="例：3" min="1" max="99" step="1" value="1" />
        </div>
        <div class="form-group">
          <label for="toll">高速料金（円・往復合計）<span class="optional-label">— 任意</span></label>
          <input type="number" id="toll" inputmode="numeric" placeholder="例：2000" min="0" step="1" />
        </div>
      </div>

      <div class="result-box" id="result">
        <div class="result-label">計算結果</div>
        <div class="result-rows">
          <div class="result-row">
            <span class="label">片道ガソリン代</span>
            <span class="value" id="one-way">¥0</span>
          </div>
          <div class="result-row">
            <span class="label">往復ガソリン代</span>
            <span class="value" id="round-trip">¥0</span>
          </div>
          <div class="result-row">
            <span class="label">消費量（片道）</span>
            <span class="value" id="liters">0 L</span>
          </div>
        </div>
        <div id="monthly-section" style="display:none">
          <div class="result-rows" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border-2)">
            <div class="result-row">
              <span class="label">月額交通費（往復×出勤日数）</span>
              <span class="value" id="monthly">¥0</span>
            </div>
          </div>
        </div>
        <div id="warikan-section" style="display:none">
          <div class="result-rows" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border-2)">
            <div class="result-row">
              <span class="label">合計（往復ガソリン代＋高速料金）</span>
              <span class="value" id="total-cost">¥0</span>
            </div>
            <div class="result-row warikan-highlight">
              <span class="label">1人あたり（<span id="people-label">2</span>人で割り勘）</span>
              <span class="value" id="per-person">¥0</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>上の入力欄に値を入力すると自動で計算されます。ボタンは不要です。</p>
    <ul>
      <li><strong>走行距離</strong>：片道の距離（km）を入力してください。往復の場合は往復ガソリン代の行をご覧ください。</li>
      <li><strong>燃費</strong>：車のカタログ値または実燃費（km/L）を入力します。わからない場合は「15」程度が一般的なガソリン車の目安です。</li>
      <li><strong>ガソリン価格</strong>：近くのガソリンスタンドの単価（円/L）を入力します。レギュラーは現在 160〜175 円前後が目安です。</li>
      <li><strong>月額</strong>：出勤日数を入力すると、1ヶ月あたりの交通費（往復×日数）を計算します。</li>
      <li><strong>割り勘</strong>：乗車人数を2人以上にすると、往復ガソリン代と高速料金（往復合計）を合算し、1人あたりの金額を計算します。ドライブや旅行の費用分担にお使いください。</li>
    </ul>
    <p>計算式：ガソリン代 ＝ 走行距離（km）÷ 燃費（km/L）× ガソリン価格（円/L）。金額の端数は切り捨てで計算しています。</p>

    <h3>計算式と計算例</h3>
    <p>
      ガソリン代は「<strong>走行距離（km）÷ 燃費（km/L）× ガソリン単価（円/L）</strong>」で求まります。「距離 ÷ 燃費」でまずガソリンの消費量（L）を出し、それに単価を掛けるという考え方です。たとえば片道500km（東京〜大阪くらいの距離）を、燃費15km/L・単価170円/Lの車で走る場合、消費量は約33.3Lで、片道のガソリン代は 500 ÷ 15 × 170 ＝ <strong>約5,666円</strong>、往復では<strong>約11,333円</strong>になります。3人で割り勘にすれば1人あたり4千円弱です。
    </p>

    <h3>車種別の実燃費の目安</h3>
    <p>自分の車の燃費がすぐに分からないときは、次の表から近いタイプの値を入力してください。いずれも一般的な実燃費のおおよその目安で、車種・年式・運転条件によって大きく変わります。</p>
    <div class="data-table-wrap">
      <div class="data-table-scroll">
        <table class="data-table">
          <thead><tr><th>車のタイプ</th><th>実燃費の目安</th></tr></thead>
          <tbody>
            <tr><td>軽自動車</td><td class="num">約20〜25 km/L</td></tr>
            <tr><td>コンパクトカー</td><td class="num">約15〜20 km/L</td></tr>
            <tr><td>ハイブリッド車</td><td class="num">約20〜28 km/L</td></tr>
            <tr><td>ミニバン</td><td class="num">約10〜14 km/L</td></tr>
            <tr><td>SUV</td><td class="num">約8〜12 km/L</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <h3>カタログ燃費（WLTCモード）と実燃費の差</h3>
    <p>
      カタログに記載されている燃費は、市街地・郊外・高速道路の走行を組み合わせた試験条件で測ったWLTCモードの値です。実際の燃費は、渋滞・エアコンの使用・短距離走行・荷物や乗員の重さなどの影響で、<strong>カタログ値の7〜9割程度</strong>になることが多いといわれます。交通費を見積もるときは、カタログ値より実燃費に近い値を入力したほうが実態に合います。実燃費は「満タン法」（満タンにしてから次に満タンにするまでの走行距離 ÷ 給油量）でかんたんに測れます。
    </p>

    <h3>ガソリン単価の調べ方</h3>
    <p>
      ガソリン価格は地域や店舗によって1Lあたり数円〜十数円の差があります。全国・都道府県別の平均価格は、資源エネルギー庁の「<a href="https://www.enecho.meti.go.jp/statistics/petroleum_and_lpgas/pl007/" target="_blank" rel="noopener">石油製品価格調査</a>」で毎週公表されているため、単価に迷ったらこの平均値を入れるのが手軽です。ふだん利用するスタンドの店頭価格や、ガソリン価格比較サイト・アプリの値を使えば、より実際に近い金額を計算できます。
    </p>

    <h3>この計算に含まれないもの</h3>
    <p>
      計算結果のガソリン代には、高速道路料金・駐車場代・オイルやタイヤなどの消耗品費・車検や保険といった維持費は含まれません。高速道路を使う場合は、「割り勘」欄の高速料金（往復合計）に入力すると、合計金額と1人あたりの負担額に反映できます。また、通勤交通費を勤務先に申請する場合は、会社ごとにガソリン単価や燃費のみなし値が規定されていることがあるため、勤務先のルールもあわせて確認してください。
    </p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。実際のガソリン代は道路状況・エアコン使用・走行パターンなどにより異なります。</div>
  </section>

  <RelatedTools current={slug} />

  <Faq items={[
    { q: 'ガソリン代はどう計算しますか？', a: '走行距離÷燃費×ガソリン単価で求めます。例えば300km・燃費15km/L・170円/Lなら約3,400円です。' },
    { q: '1か月の交通費も出せますか？', a: '月の出勤日数を入力すると、往復・月額の概算を計算できます。' },
    { q: '割り勘もできますか？', a: '乗車人数や高速料金を入力して、1人あたりの金額を計算できます。' },
    { q: '実際の燃費はカタログ値より悪くなりますか？', a: '多くの場合、実燃費はカタログ燃費（WLTCモード）の7〜9割程度になります。渋滞・エアコンの使用・短距離走行などが主な要因です。正確に見積もりたいときは、満タン法で測った実燃費を入力してください。' },
    { q: 'ハイオクとレギュラーで計算は変わりますか？', a: '計算式は同じで、入力するガソリン単価が変わるだけです。ハイオクはレギュラーより1Lあたりおおむね10円前後高いため、ハイオク指定車の場合はハイオクの単価を入力してください。' },
    { q: '軽油（ディーゼル車）でも使えますか？', a: 'はい。計算式は燃料の種類によらず同じなので、軽油の単価と車の燃費を入力すれば、ディーゼル車の燃料代も同じように計算できます。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
.optional-label { font-size: .75rem; font-weight: var(--fw-normal); color: var(--text-faint); margin-left: 4px; }
.warikan-fields { margin-top: 8px; padding-top: 16px; border-top: 1px dashed var(--border-2); }
.warikan-title { font-size: .9rem; font-weight: var(--fw-bold); color: var(--cat-color); margin-bottom: 12px; }
.warikan-highlight .value { color: var(--cat-color); font-weight: var(--fw-bold); }
</style>

<script>
  import { calcGasCost, calcRoundTripCost, calcMonthlyCost, splitPerPerson } from '../../lib/gasoline.js';

  const $ = (id) => document.getElementById(id);
  const yen = (n) => '¥' + n.toLocaleString('ja-JP');

  function render() {
    const distance = parseFloat($('distance').value);
    const fuelEff  = parseFloat($('fuel-eff').value);
    const gasPrice = parseFloat($('gas-price').value);
    const workdays = parseFloat($('workdays').value);
    const people   = parseInt($('people').value, 10);
    const tollRaw  = parseFloat($('toll').value);
    const toll     = Number.isFinite(tollRaw) && tollRaw > 0 ? tollRaw : 0;

    const oneWay = calcGasCost({ distance, fuelEfficiency: fuelEff, gasPrice });
    const result = $('result');

    if (!oneWay) {
      result.classList.remove('visible');
      window.hideResultShare?.();
      return;
    }
    result.classList.add('visible');

    // 往復・月額は floor 済みの片道を累乗せず、原始量から精確に再計算する。
    const roundTrip = calcRoundTripCost({ distance, fuelEfficiency: fuelEff, gasPrice });
    $('one-way').textContent   = yen(oneWay.cost);
    $('round-trip').textContent = yen(roundTrip);
    $('liters').textContent    = oneWay.liters.toFixed(2) + ' L';

    const monthly = calcMonthlyCost({ distance, fuelEfficiency: fuelEff, gasPrice, workdays });
    const sec = $('monthly-section');
    if (monthly) {
      $('monthly').textContent = yen(monthly);
      sec.style.display = 'block';
    } else {
      sec.style.display = 'none';
    }

    // 割り勘：合計 = 往復ガソリン代 + 高速料金（往復合計）。人数2人以上のときだけ表示。
    const warikanSec = $('warikan-section');
    const total = roundTrip + toll;
    const split = splitPerPerson(total, people);
    if (split && split.people >= 2) {
      $('total-cost').textContent  = yen(total);
      $('per-person').textContent  = yen(split.perPerson);
      $('people-label').textContent = String(split.people);
      warikanSec.style.display = 'block';
    } else {
      warikanSec.style.display = 'none';
    }

    // 結果サマリー：表示中の行だけを DOM から拾って組み立てる（再計算しない）
    const lines = [
      'ガソリン代計算器',
      `片道ガソリン代：${$('one-way').textContent}`,
      `往復ガソリン代：${$('round-trip').textContent}`,
    ];
    if (sec.style.display !== 'none') {
      lines.push(`月額交通費：${$('monthly').textContent}`);
    }
    if (warikanSec.style.display !== 'none') {
      lines.push(`1人あたり（${$('people-label').textContent}人）：${$('per-person').textContent}`);
    }
    window.setResultShare?.(lines.join('\n'));
  }

  ['distance', 'fuel-eff', 'gas-price', 'workdays', 'people', 'toll'].forEach((id) =>
    $(id).addEventListener('input', render)
  );
</script>
