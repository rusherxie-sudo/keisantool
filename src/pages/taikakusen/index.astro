---
import ToolLayout from '../../layouts/ToolLayout.astro';import RelatedTools from '../../components/RelatedTools.astro';import Faq from '../../components/Faq.astro';import ResultShare from '../../components/ResultShare.astro';
const slug='taikakusen',title='対角線計算ツール｜長方形・直方体・テレビ画面インチ',description='長方形の縦横から対角線を計算し、斜辺から辺も逆算。直方体の空間対角線、テレビ・モニターのインチと16:9の幅・高さも無料計算できます。';
const jsonld={'@context':'https://schema.org','@type':'WebApplication',name:'対角線・斜辺計算ツール',description,applicationCategory:'UtilityApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'},featureList:['長方形の対角線と辺を相互計算','直方体の空間対角線','画面インチと幅・高さを相互計算']};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide><div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 対角線</div><h1>対角線・斜辺計算ツール</h1><p>長方形・直方体の対角線と、画面サイズのインチ・実寸をピタゴラスの定理で計算します。</p><div class="chips"><span>√(縦²＋横²)</span><span>空間対角線</span><span>16:9画面</span></div></div>
<div class="calc-card tool-card"><div class="tabs"><button class="tab active" data-mode="rect">長方形</button><button class="tab" data-mode="box">直方体</button><button class="tab" data-mode="screen">画面サイズ</button></div>
<section class="calc-panel panel active" data-panel="rect"><h2>長方形の対角線・辺を相互計算</h2><label>求める値<select id="r-target"><option value="diagonal">対角線</option><option value="width">横</option><option value="height">縦</option></select></label><div class="grid"><label id="r-width-wrap">横<input id="r-width" type="number" value="3" min="0" step="any"></label><label id="r-height-wrap">縦<input id="r-height" type="number" value="4" min="0" step="any"></label><label id="r-diagonal-wrap" hidden>対角線<input id="r-diagonal" type="number" value="5" min="0" step="any"></label><label>単位<select id="r-unit"><option>cm</option><option>mm</option><option>m</option></select></label></div><p class="error" id="r-error" hidden>0より大きい値を入力し、対角線は辺より長くしてください。</p><div class="result" id="r-result"><span>対角線</span><strong id="r-main">5 cm</strong><small id="r-sub"></small></div></section>
<section class="calc-panel panel" data-panel="box"><h2>直方体の空間対角線</h2><div class="grid"><label>横<input id="b-width" value="2" type="number" min="0"></label><label>縦<input id="b-height" value="3" type="number" min="0"></label><label>奥行<input id="b-depth" value="6" type="number" min="0"></label><label>単位<select id="b-unit"><option>cm</option><option>mm</option><option>m</option></select></label></div><p class="error" id="b-error" hidden>3辺に0より大きい値を入力してください。</p><div class="result" id="b-result"><span>空間対角線</span><strong id="b-main">7 cm</strong><small>√(横²＋縦²＋奥行²)</small></div></section>
<section class="calc-panel panel" data-panel="screen"><h2>テレビ・モニターのインチと実寸</h2><label>求める値<select id="s-target"><option value="dimensions">インチから幅・高さ</option><option value="inch">幅・高さからインチ</option></select></label><div class="grid"><label id="s-inch-wrap">対角線（インチ）<input id="s-inch" value="50" type="number" min="0"></label><label id="s-width-wrap" hidden>画面幅（cm）<input id="s-width" value="110.69" type="number" min="0"></label><label id="s-height-wrap" hidden>画面高さ（cm）<input id="s-height" value="62.26" type="number" min="0"></label><label id="s-aspect-wrap">アスペクト比<div><input id="s-aw" value="16" type="number" min="0"><input id="s-ah" value="9" type="number" min="0"></div></label></div><p class="error" id="s-error" hidden>インチまたは画面の幅・高さを正しく入力してください。</p><div class="result" id="s-result"><span>画面実寸</span><strong id="s-main">—</strong><small id="s-sub"></small></div></section></div><ResultShare/><div class="ad-slot"></div>
<section class="howto"><h2>長方形の対角線の求め方</h2><p>対角線dはピタゴラスの定理から<strong>d＝√(横²＋縦²)</strong>です。3cm×4cmなら√(9＋16)＝5cm。対角線と片方の辺が分かる場合は、もう一辺＝√(対角線²−既知の辺²)で逆算します。平方根そのものは<a href="/heihoukon/">平方根・ルート計算</a>で確認できます。</p></section>
<section class="howto"><h2>テレビのインチは画面の対角線</h2><p>1インチ＝2.54cmです。50インチ16:9画面の表示領域は約110.7cm×62.3cmですが、製品の外形寸法にはベゼルやスタンドが加わります。設置可否は必ずメーカー外形寸法で確認してください。</p><div class="disclaimer">※ 計算結果はあくまで参考値です。建築・家具加工・機器設置では実測値、厚み、公差、メーカー仕様をご確認ください。</div></section><RelatedTools current={slug}/><Faq items={[{q:'長方形の対角線の計算式は？',a:'√(横²＋縦²)です。'},{q:'直方体の対角線は？',a:'√(横²＋縦²＋奥行²)です。'},{q:'50インチテレビの幅は？',a:'16:9の表示領域なら約110.7cmです。外形幅は製品ごとに異なります。'},{q:'1インチは何cmですか？',a:'正確に2.54cmです。'},{q:'対角線から縦を逆算できますか？',a:'対角線が横より長ければ√(対角線²−横²)で求められます。'}]}/><div class="ad-slot"></div></ToolLayout>
<style>.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips span{padding:5px 10px;border-radius:999px;background:var(--cat-tint);color:var(--cat-color);font-size:.75rem;font-weight:700}.tool-card{overflow:hidden}.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface-sub)}.tab{padding:15px 5px;border:0;border-bottom:3px solid transparent;background:none;font-weight:700}.tab.active{background:var(--surface);color:var(--cat-color);border-color:var(--cat-color)}.panel{padding:24px}.panel:not(.active){display:none}.panel h2{margin-top:0;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:14px}.grid label{display:flex;flex-direction:column;gap:7px;font-size:.8rem;font-weight:700}.grid label>div{display:grid;grid-template-columns:1fr 1fr;gap:7px}.result{display:flex;flex-direction:column;align-items:center;gap:5px;margin-top:20px;padding:20px;background:var(--cat-tint);border-radius:var(--r-md)}.result strong{font:700 clamp(1.8rem,6vw,2.8rem) var(--font-mono);color:var(--cat-color)}.result small{color:var(--text-muted)}.error{padding:10px;background:var(--danger-bg);color:var(--danger)}@media(max-width:700px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.panel{padding:18px}.grid{grid-template-columns:1fr}.tab{font-size:.74rem}}</style>
<script>import{solveRectangle,solveCuboid,screenFromDiagonal,screenFromDimensions}from'../../lib/taikakusen.js';const $=id=>document.getElementById(id),fmt=n=>Number(n.toPrecision(8)).toLocaleString('ja-JP',{maximumFractionDigits:10});let mode='rect';function rr(){const t=$('r-target').value;$('r-width-wrap').hidden=t==='width';$('r-height-wrap').hidden=t==='height';$('r-diagonal-wrap').hidden=t==='diagonal';const r=solveRectangle({target:t,width:$('r-width').value,height:$('r-height').value,diagonal:$('r-diagonal').value});$('r-error').hidden=!!r;$('r-result').hidden=!r;if(!r)return;const key={diagonal:'diagonal',width:'width',height:'height'}[t],label={diagonal:'対角線',width:'横',height:'縦'}[t],main=`${fmt(r[key])} ${$('r-unit').value}`;$('r-result').querySelector('span').textContent=label;$('r-main').textContent=main;$('r-sub').textContent=`横 ${fmt(r.width)}・縦 ${fmt(r.height)}・対角線 ${fmt(r.diagonal)}`;if(mode==='rect')window.setResultShare?.(`対角線計算\n${main}`)}function rb(){const r=solveCuboid({width:$('b-width').value,height:$('b-height').value,depth:$('b-depth').value});$('b-error').hidden=!!r;$('b-result').hidden=!r;if(r)$('b-main').textContent=`${fmt(r.diagonal)} ${$('b-unit').value}`;}function rs(){const t=$('s-target').value;$('s-inch-wrap').hidden=t==='inch';$('s-width-wrap').hidden=t==='dimensions';$('s-height-wrap').hidden=t==='dimensions';$('s-aspect-wrap').hidden=t==='inch';const r=t==='dimensions'?screenFromDiagonal({diagonalInch:$('s-inch').value,aspectWidth:$('s-aw').value,aspectHeight:$('s-ah').value}):screenFromDimensions({widthCm:$('s-width').value,heightCm:$('s-height').value});$('s-error').hidden=!!r;$('s-result').hidden=!r;if(!r)return;$('s-main').textContent=t==='dimensions'?`${fmt(r.widthCm)} × ${fmt(r.heightCm)} cm`:`${fmt(r.diagonalInch)} インチ`;$('s-sub').textContent=`対角線 ${fmt(r.diagonalCm)}cm`;if(mode==='screen')window.setResultShare?.(`画面サイズ\n${$('s-main').textContent}`)}document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.dataset.panel===mode));({rect:rr,box:rb,screen:rs})[mode]()}));document.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',()=>{rr();rb();rs()}));rr();rb();rs();</script>
