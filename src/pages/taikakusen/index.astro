---
import ToolLayout from '../../layouts/ToolLayout.astro';import RelatedTools from '../../components/RelatedTools.astro';import Faq from '../../components/Faq.astro';import ResultShare from '../../components/ResultShare.astro';
import { screenFromDiagonal, solveRectangle } from '../../lib/taikakusen.js';
const screenRows=[24,27,32,40,43,50,55,65,75].map(diagonalInch=>screenFromDiagonal({diagonalInch}));
const rectRows=[[3,4],[5,12],[6,8],[9,12]].map(([width,height])=>solveRectangle({target:'diagonal',width,height}));
const slug='taikakusen',title='対角線計算ツール｜長方形・直方体・テレビ画面インチ',description='長方形の縦横から対角線を計算し、斜辺から辺も逆算。直方体の空間対角線、テレビ・モニターのインチと16:9の幅・高さも無料計算できます。';
const jsonld={'@context':'https://schema.org','@type':'WebApplication',name:'対角線・斜辺計算ツール',description,applicationCategory:'UtilityApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'},featureList:['長方形の対角線と辺を相互計算','直方体の空間対角線','画面インチと幅・高さを相互計算']};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide><div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 対角線</div><h1>対角線・斜辺計算ツール</h1><p>長方形・直方体の対角線と、画面サイズのインチ・実寸をピタゴラスの定理で計算します。</p><div class="chips"><span>√(縦²＋横²)</span><span>空間対角線</span><span>16:9画面</span></div></div>
<div class="calc-card tool-card"><div class="tabs"><button class="tab active" data-mode="rect">長方形</button><button class="tab" data-mode="box">直方体</button><button class="tab" data-mode="screen">画面サイズ</button></div>
<section class="calc-panel panel active" data-panel="rect"><h2>長方形の対角線・辺を相互計算</h2><label>求める値<select id="r-target"><option value="diagonal">対角線</option><option value="width">横</option><option value="height">縦</option></select></label><div class="grid"><label id="r-width-wrap">横<input id="r-width" type="number" value="3" min="0" step="any"></label><label id="r-height-wrap">縦<input id="r-height" type="number" value="4" min="0" step="any"></label><label id="r-diagonal-wrap" hidden>対角線<input id="r-diagonal" type="number" value="5" min="0" step="any"></label><label>単位<select id="r-unit"><option>cm</option><option>mm</option><option>m</option></select></label></div><p class="error" id="r-error" hidden>0より大きい値を入力し、対角線は辺より長くしてください。</p><figure id="rectangle-figure"><svg viewBox="0 0 340 250" role="img" aria-labelledby="rectangle-title"><title id="rectangle-title">横3・縦4の長方形の対角線は5</title><rect id="rectangle-shape" x="100" y="35" width="120" height="160" fill="var(--cat-tint)" stroke="currentColor" stroke-width="2"/><line id="rectangle-line" x1="100" y1="195" x2="220" y2="35" stroke="var(--cat-color)" stroke-width="3"/><text id="rectangle-width" x="170" y="225" text-anchor="middle">横 3cm</text><text id="rectangle-height" x="170" y="22" text-anchor="middle">縦 4cm</text></svg><figcaption>対角線は向かい合う頂点を結ぶ線です。</figcaption></figure><div class="result" id="r-result"><span>対角線</span><strong id="r-main">5 cm</strong><small id="r-sub"></small></div></section>
<section class="calc-panel panel" data-panel="box"><h2>直方体の空間対角線</h2><div class="grid"><label>横<input id="b-width" value="2" type="number" min="0" step="any"></label><label>縦<input id="b-height" value="3" type="number" min="0" step="any"></label><label>奥行<input id="b-depth" value="6" type="number" min="0" step="any"></label><label>単位<select id="b-unit"><option>cm</option><option>mm</option><option>m</option></select></label></div><p class="error" id="b-error" hidden>3辺に0より大きい値を入力してください。</p><div class="result" id="b-result"><span>空間対角線</span><strong id="b-main">7 cm</strong><small>√(横²＋縦²＋奥行²)</small></div></section>
<section class="calc-panel panel" data-panel="screen"><h2>テレビ・モニターのインチと実寸</h2><label>求める値<select id="s-target"><option value="dimensions">インチから幅・高さ</option><option value="inch">幅・高さからインチ</option></select></label><div class="grid"><label id="s-inch-wrap">対角線（インチ）<input id="s-inch" value="50" type="number" min="0" step="any"></label><label id="s-width-wrap" hidden>画面幅（cm）<input id="s-width" value="110.69" type="number" min="0" step="any"></label><label id="s-height-wrap" hidden>画面高さ（cm）<input id="s-height" value="62.26" type="number" min="0" step="any"></label><label id="s-aspect-wrap">アスペクト比<div><input id="s-aw" value="16" type="number" min="0" step="any"><input id="s-ah" value="9" type="number" min="0" step="any"></div></label></div><p class="error" id="s-error" hidden>インチまたは画面の幅・高さを正しく入力してください。</p><div class="result" id="s-result"><span>画面実寸</span><strong id="s-main">—</strong><small id="s-sub"></small></div></section></div><ResultShare/><div class="ad-slot"></div>
<section class="howto"><h2>長方形の対角線の求め方</h2><p>対角線dはピタゴラスの定理から<strong>d＝√(横²＋縦²)</strong>です。3cm×4cmなら√(9＋16)＝5cm。対角線と片方の辺が分かる場合は、もう一辺＝√(対角線²−既知の辺²)で逆算します。平方根そのものは<a href="/heihoukon/">平方根・ルート計算</a>で確認できます。</p></section>
<section class="howto"><h2>テレビのインチは画面の対角線</h2><p>1インチ＝2.54cmです。50インチ16:9画面の表示領域は約110.7cm×62.3cmですが、製品の外形寸法にはベゼルやスタンドが加わります。設置可否は必ずメーカー外形寸法で確認してください。</p><div class="disclaimer">※ 計算結果はあくまで参考値です。建築・家具加工・機器設置では実測値、厚み、公差、メーカー仕様をご確認ください。</div></section><section class="howto"><h2>長方形の対角線・よく使う計算例</h2><p>表は横にスクロールできます。「この例で計算」で入力欄に反映します。</p><div class="data-table-scroll"><table class="data-table"><thead><tr><th>横</th><th>縦</th><th>対角線</th><th>計算に反映</th></tr></thead><tbody>{rectRows.map(r=><tr><td>{r.width}</td><td>{r.height}</td><td>{r.diagonal}</td><td><button class="preset" type="button" data-rectangle={`${r.width},${r.height}`}>この例で計算</button></td></tr>)}</tbody></table></div><p>縦・横・対角線には同じ単位を使います。横3m・縦4mなら対角線5mです。正方形は1辺×√2で求められ、1辺10cmなら約14.142cmです。</p><p>対角線と既知の辺から逆算する場合は、対角線がその辺より長い必要があります。部屋の広さは<a href="/tsubo-heibei/">縦横から面積・坪数を計算</a>できます。</p></section><section class="howto"><h2>テレビ・モニターのインチ別サイズ早見表（16:9）</h2><p>横にスクロールすると、高さと計算ボタンまで確認できます。</p><div class="data-table-scroll"><table class="data-table"><thead><tr><th>インチ</th><th>表示幅</th><th>表示高さ</th><th>計算に反映</th></tr></thead><tbody>{screenRows.map(r=><tr><td>{r.diagonalInch}インチ</td><td>{r.widthCm.toFixed(1)}cm</td><td>{r.heightCm.toFixed(1)}cm</td><td><button class="preset" type="button" data-screen={r.diagonalInch}>このサイズ</button></td></tr>)}</tbody></table></div><p>表示領域のみの理論値です。外枠・スタンド・設置余白は含みません。製品の外形寸法を確認してください。16:10など別の比率は「画面サイズ」タブで変更できます。</p></section><RelatedTools current={slug}/><Faq items={[{q:'長方形の対角線の計算式は？',a:'√(横²＋縦²)です。'},{q:'直方体の対角線は？',a:'√(横²＋縦²＋奥行²)です。'},{q:'50インチテレビの幅は？',a:'16:9の表示領域なら約110.7cmです。外形幅は製品ごとに異なります。'},{q:'1インチは何cmですか？',a:'正確に2.54cmです。'},{q:'対角線から縦を逆算できますか？',a:'対角線が横より長ければ√(対角線²−横²)で求められます。'}]}/><div class="ad-slot"></div></ToolLayout>
<style>.tool-card input,.tool-card select{display:block;width:100%;min-width:0;min-height:44px;padding:10px 12px;border:1px solid var(--border-input);border-radius:8px;background:var(--surface-sub);color:var(--text);font:inherit}.panel>label{display:block;font-size:.85rem;font-weight:700}.panel>label select{margin-top:7px} .tool-card [hidden]{display:none!important}#rectangle-figure{max-width:420px;margin:16px auto;text-align:center}#rectangle-figure svg{width:100%;height:auto}#rectangle-figure figcaption{font-size:.78rem;color:var(--text-muted)}.preset{padding:8px;border:1px solid var(--cat-color);background:var(--cat-tint);border-radius:6px;color:var(--cat-color);cursor:pointer}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips span{padding:5px 10px;border-radius:999px;background:var(--cat-tint);color:var(--cat-color);font-size:.75rem;font-weight:700}.tool-card{overflow:hidden}.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface-sub)}.tab{padding:15px 5px;border:0;border-bottom:3px solid transparent;background:none;font-weight:700}.tab.active{background:var(--surface);color:var(--cat-color);border-color:var(--cat-color)}.panel{padding:24px}.panel:not(.active){display:none}.panel h2{margin-top:0;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:14px}.grid label{display:flex;flex-direction:column;gap:7px;font-size:.8rem;font-weight:700}.grid label>div{display:grid;grid-template-columns:1fr 1fr;gap:7px}.result{display:flex;flex-direction:column;align-items:center;gap:5px;margin-top:20px;padding:20px;background:var(--cat-tint);border-radius:var(--r-md)}.result strong{font:700 clamp(1.8rem,6vw,2.8rem) var(--font-mono);color:var(--cat-color)}.result small{color:var(--text-muted)}.error{padding:10px;background:var(--danger-bg);color:var(--danger)}@media(max-width:700px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.panel{padding:18px}.grid{grid-template-columns:1fr}.tab{font-size:.74rem}}</style>
<script>
import {solveRectangle,solveCuboid,screenFromDiagonal,screenFromDimensions} from '../../lib/taikakusen.js';
const $=id=>document.getElementById(id),fmt=n=>Number(n.toPrecision(8)).toLocaleString('ja-JP',{maximumFractionDigits:8});
let mode='rect';const tracked=new Set();
function render(user=false){
 let r,main;
 if(mode==='rect'){
  const t=$('r-target').value;
  $('r-width-wrap').hidden=t==='width';$('r-height-wrap').hidden=t==='height';$('r-diagonal-wrap').hidden=t==='diagonal';
  r=solveRectangle({target:t,width:$('r-width').value,height:$('r-height').value,diagonal:$('r-diagonal').value});
  $('r-error').hidden=!!r;$('r-result').hidden=!r;$('rectangle-figure').hidden=!r;
  if(r){const unit=$('r-unit').value;main=`${{diagonal:'対角線',width:'横',height:'縦'}[t]} ${fmt(r[t])} ${unit}`;$('r-result').querySelector('span').textContent={diagonal:'対角線',width:'横',height:'縦'}[t];$('r-main').textContent=`${fmt(r[t])} ${unit}`;$('r-sub').textContent=`横 ${fmt(r.width)}・縦 ${fmt(r.height)}・対角線 ${fmt(r.diagonal)}`;
   const max=Math.max(r.width,r.height),nw=r.width/max,nh=r.height/max,scale=Math.min(230/nw,160/nh),w=nw*scale,h=nh*scale,x=(340-w)/2,y=35;
   for(const [k,v] of Object.entries({x,y,width:w,height:h}))$('rectangle-shape').setAttribute(k,String(v));
   for(const [k,v] of Object.entries({x1:x,y1:y+h,x2:x+w,y2:y}))$('rectangle-line').setAttribute(k,String(v));
   $('rectangle-width').textContent=`横 ${fmt(r.width)}${unit}`;$('rectangle-height').textContent=`縦 ${fmt(r.height)}${unit}`;$('rectangle-title').textContent=`横${fmt(r.width)}、縦${fmt(r.height)}の対角線は${fmt(r.diagonal)}${unit}`;
  }
 }else if(mode==='box'){
  r=solveCuboid({width:$('b-width').value,height:$('b-height').value,depth:$('b-depth').value});$('b-error').hidden=!!r;$('b-result').hidden=!r;
  if(r){main=`空間対角線 ${fmt(r.diagonal)} ${$('b-unit').value}`;$('b-main').textContent=`${fmt(r.diagonal)} ${$('b-unit').value}`;}
 }else{
  const t=$('s-target').value;$('s-inch-wrap').hidden=t==='inch';$('s-width-wrap').hidden=t==='dimensions';$('s-height-wrap').hidden=t==='dimensions';$('s-aspect-wrap').hidden=t==='inch';
  r=t==='dimensions'?screenFromDiagonal({diagonalInch:$('s-inch').value,aspectWidth:$('s-aw').value,aspectHeight:$('s-ah').value}):screenFromDimensions({widthCm:$('s-width').value,heightCm:$('s-height').value});$('s-error').hidden=!!r;$('s-result').hidden=!r;
  if(r){main=t==='dimensions'?`${fmt(r.widthCm)} × ${fmt(r.heightCm)} cm`:`${fmt(r.diagonalInch)} インチ`;$('s-main').textContent=main;$('s-sub').textContent=`対角線 ${fmt(r.diagonalCm)}cm`;}
 }
 if(!r){window.hideResultShare?.();return;}
 window.setResultShare?.(`対角線計算\n${main}`);
 if(user&&!tracked.has(mode)){window.gtag?.('event','diagonal_calculation',{tool_slug:'taikakusen',calculation_mode:mode});tracked.add(mode);}
}
function setMode(next){mode=next;document.querySelectorAll('.tab').forEach(b=>{const active=b.dataset.mode===mode;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.dataset.panel===mode));render();}
document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.mode)));
document.querySelectorAll('.tool-card input,.tool-card select').forEach(e=>e.addEventListener('input',()=>render(true)));
document.querySelectorAll('[data-rectangle]').forEach(b=>b.addEventListener('click',()=>{const [w,h]=b.dataset.rectangle.split(',');$('r-target').value='diagonal';$('r-width').value=w;$('r-height').value=h;setMode('rect');render(true);document.querySelector('.tool-card').scrollIntoView({block:'start'});}));
document.querySelectorAll('[data-screen]').forEach(b=>b.addEventListener('click',()=>{$('s-target').value='dimensions';$('s-inch').value=b.dataset.screen;$('s-aw').value='16';$('s-ah').value='9';setMode('screen');render(true);document.querySelector('.tool-card').scrollIntoView({block:'start'});}));
setMode('rect');
</script>
