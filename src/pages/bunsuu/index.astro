---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ResultShare from '../../components/ResultShare.astro';
import Faq from '../../components/Faq.astro';

const slug = 'bunsuu';
const title = '分数計算・分数電卓｜足し算・引き算・掛け算・割り算';
const description = '分数の足し算・引き算・掛け算・割り算を途中式付きで自動計算。約分、通分、仮分数・帯分数・小数・パーセント表示、小数から分数への変換にも対応した無料の分数電卓です。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '分数計算・分数電卓',
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  featureList: ['分数の四則計算', '通分と約分の途中式', '仮分数と帯分数の変換', '小数とパーセント表示', '小数から分数への変換'],
};
---

<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 分数計算</div>
    <h1>分数計算・分数電卓</h1>
    <p><strong>分数の足し算・引き算・掛け算・割り算</strong>を、通分・約分の途中式付きで計算。帯分数、仮分数、小数にもすぐ変換できます。</p>
  </div>

  <div class="calc-card fraction-card">
    <div class="fraction-tabs" role="group" aria-label="分数計算の種類">
      <button type="button" class="fraction-tab is-active" data-mode="calculate" aria-pressed="true"><span>分数の四則計算</span><small>＋ − × ÷</small></button>
      <button type="button" class="fraction-tab" data-mode="convert" aria-pressed="false"><span>小数→分数</span><small>約分して変換</small></button>
    </div>

    <div class="calc-panel fraction-panel active">
      <section class="fraction-mode" id="calculatePanel">
        <div class="fraction-equation">
          <fieldset class="fraction-entry">
            <legend>分数 A</legend>
            <div class="mixed-fields">
              <div class="form-group whole-field">
                <label for="leftWhole">整数部</label>
                <input type="text" id="leftWhole" inputmode="numeric" placeholder="0" aria-describedby="mixedHint" />
              </div>
              <span class="mixed-plus" aria-hidden="true">＋</span>
              <div class="stacked-fraction">
                <div class="form-group">
                  <label for="leftNumerator">分子</label>
                  <input type="text" id="leftNumerator" inputmode="numeric" value="1" />
                </div>
                <span class="fraction-line" aria-hidden="true"></span>
                <div class="form-group">
                  <label for="leftDenominator">分母</label>
                  <input type="text" id="leftDenominator" inputmode="numeric" value="2" />
                </div>
              </div>
            </div>
          </fieldset>

          <div class="operation-field form-group">
            <label for="fractionOperation">計算</label>
            <select id="fractionOperation">
              <option value="add">＋ 足し算</option>
              <option value="subtract">− 引き算</option>
              <option value="multiply">× 掛け算</option>
              <option value="divide">÷ 割り算</option>
            </select>
          </div>

          <fieldset class="fraction-entry">
            <legend>分数 B</legend>
            <div class="mixed-fields">
              <div class="form-group whole-field">
                <label for="rightWhole">整数部</label>
                <input type="text" id="rightWhole" inputmode="numeric" placeholder="0" aria-describedby="mixedHint" />
              </div>
              <span class="mixed-plus" aria-hidden="true">＋</span>
              <div class="stacked-fraction">
                <div class="form-group">
                  <label for="rightNumerator">分子</label>
                  <input type="text" id="rightNumerator" inputmode="numeric" value="1" />
                </div>
                <span class="fraction-line" aria-hidden="true"></span>
                <div class="form-group">
                  <label for="rightDenominator">分母</label>
                  <input type="text" id="rightDenominator" inputmode="numeric" value="3" />
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <p class="input-hint" id="mixedHint">帯分数は整数部も入力します。例：1と1/2 → 整数部1、分子1、分母2</p>
        <p class="form-error" id="fractionError" hidden>整数を入力し、分母を0以外にしてください。0で割ることはできません。</p>

        <div class="fraction-result" id="fractionResult" aria-live="polite">
          <div class="fraction-result-main">
            <span>答え（約分済み）</span>
            <strong id="resultExact">5/6</strong>
          </div>
          <div class="fraction-result-grid">
            <div><span>帯分数</span><strong id="resultMixed">5/6</strong></div>
            <div><span>小数</span><strong id="resultDecimal">0.833333333333</strong></div>
            <div><span>パーセント</span><strong id="resultPercent">83.3333333333%</strong></div>
          </div>
          <div class="calculation-steps">
            <h2>途中式</h2>
            <ol id="fractionSteps">
              <li>1/2 ＋ 1/3</li>
              <li>3/6 ＋ 2/6</li>
              <li>5/6</li>
            </ol>
          </div>
        </div>

        <div class="quick-values" aria-label="分数計算の入力例">
          <span>例：</span>
          <button type="button" data-example="add">1/2 ＋ 1/3</button>
          <button type="button" data-example="subtract">3/4 − 5/6</button>
          <button type="button" data-example="multiply">2/3 × 9/4</button>
          <button type="button" data-example="mixed">1 1/2 ＋ 2 1/3</button>
        </div>
      </section>

      <section class="fraction-mode" id="convertPanel" hidden>
        <div class="decimal-converter">
          <div class="form-group">
            <label for="decimalValue">分数に直す小数</label>
            <input type="text" id="decimalValue" inputmode="decimal" value="0.125" placeholder="例：0.125" />
          </div>
          <span aria-hidden="true">→</span>
          <div class="convert-answer">
            <small>約分した分数</small>
            <strong id="convertExact">1/8</strong>
          </div>
        </div>
        <p class="form-error" id="convertError" hidden>30桁以内の整数または小数を入力してください。</p>
        <div class="convert-result" id="convertResult" aria-live="polite">
          <div><span>帯分数</span><strong id="convertMixed">1/8</strong></div>
          <div><span>確認用の小数</span><strong id="convertDecimal">0.125</strong></div>
          <div><span>パーセント</span><strong id="convertPercent">12.5%</strong></div>
        </div>
        <div class="quick-values" aria-label="小数から分数への変換例">
          <span>例：</span>
          <button type="button" data-decimal="0.5">0.5</button>
          <button type="button" data-decimal="0.125">0.125</button>
          <button type="button" data-decimal="0.75">0.75</button>
          <button type="button" data-decimal="-1.25">−1.25</button>
        </div>
      </section>
    </div>
  </div>

  <ResultShare />
  <div class="ad-slot"></div>

  <section class="howto">
    <h2>分数の計算方法</h2>
    <div class="formula-cards">
      <div><span>足し算・引き算</span><strong>a/b ± c/d</strong><small>分母を通分して分子を計算</small></div>
      <div><span>掛け算</span><strong>a/b × c/d ＝ ac/bd</strong><small>分子どうし・分母どうしを掛ける</small></div>
      <div><span>割り算</span><strong>a/b ÷ c/d ＝ a/b × d/c</strong><small>右の分数を逆数にして掛ける</small></div>
    </div>
    <p>足し算と引き算では、分母を同じ数にする<strong>通分</strong>が必要です。掛け算は分子どうし・分母どうしを掛け、割り算は割る数の分子と分母を入れ替えた<strong>逆数</strong>を掛けます。最後に分子と分母を最大公約数で割って約分します。</p>
  </section>

  <section class="howto">
    <h2>1/2＋1/3を通分・約分する例</h2>
    <ol class="steps-list">
      <li>2と3の最小公倍数6を共通の分母にする</li>
      <li>1/2＝3/6、1/3＝2/6に通分する</li>
      <li>分子を足して、3/6＋2/6＝5/6</li>
      <li>5と6の最大公約数は1なので、5/6が既約分数</li>
    </ol>
    <p>この分数電卓は、異分母の加減では最小公倍数を使って途中式を表示します。大きな共通分母を使うより、式が短く確認しやすくなります。</p>
  </section>

  <section class="howto">
    <h2>真分数・仮分数・帯分数の違い</h2>
    <div class="term-grid">
      <div><strong>真分数</strong><span>3/4</span><p>分子が分母より小さい分数</p></div>
      <div><strong>仮分数</strong><span>7/3</span><p>分子が分母以上の分数</p></div>
      <div><strong>帯分数</strong><span>2 1/3</span><p>整数と真分数を組み合わせた表し方</p></div>
    </div>
    <p>仮分数7/3は、7÷3＝2あまり1なので、帯分数では<strong>2と1/3</strong>です。帯分数を計算するときは、先に仮分数へ直すと四則計算を一つの方法で処理できます。</p>
  </section>

  <section class="howto">
    <h2>小数を分数に直す方法</h2>
    <p>小数点以下の桁数に合わせて10、100、1000などを分母にします。たとえば0.125は小数第3位まであるため、<strong>0.125＝125/1000＝1/8</strong>です。このツールは入力した十進小数から直接整数比を作るため、浮動小数点の誤差を含めずに約分できます。</p>
    <p>割合を「何％」「増減率」「割引後価格」として計算したい場合は<a href="/wariai/">割合・パーセント計算ツール</a>、場合の数から確率を求める場合は<a href="/kakuritsu/">確率・順列・組み合わせ計算ツール</a>、平均や中央値は<a href="/heikin-chuouchi/">平均値・中央値計算ツール</a>、平方根は<a href="/heihoukon/">平方根・ルート計算機</a>を利用できます。</p>
  </section>

  <section class="howto source-box">
    <h2>学習資料と計算上の注意</h2>
    <ul>
      <li><a href="https://www.mext.go.jp/a_menu/shotou/new-cs/youryou/syo/san.htm" target="_blank" rel="noopener noreferrer">文部科学省「小学校学習指導要領 第2章 第3節 算数」</a>：分数、最大公約数、最小公倍数、通分、約分の学習内容を確認できます。</li>
      <li><a href="https://www.mext.go.jp/component/a_menu/education/micro_detail/__icsFiles/afieldfile/2015/09/29/1235761_006.pdf" target="_blank" rel="noopener noreferrer">文部科学省「分数のたし算とひき算（異分母分数の加減）」</a>：分母を等しくして計算する考え方を確認できます。</li>
    </ul>
    <div class="disclaimer">※ 小数・パーセント表示は指定桁数で打ち切った参考表示です。正確な値は約分済みの分数をご利用ください。計算結果はあくまで参考値です。</div>
  </section>

  <RelatedTools current={slug} />
  <Faq items={[
    { q: '分数の足し算はどう計算しますか？', a: '分母が同じなら分子だけを足します。分母が違う場合は最小公倍数で通分してから分子を足し、最後に約分します。1/2＋1/3は3/6＋2/6＝5/6です。' },
    { q: '分数の掛け算は通分しますか？', a: '掛け算では通分しません。分子どうし、分母どうしを掛けてから約分します。たとえば2/3×9/4＝18/12＝3/2です。' },
    { q: '分数の割り算はなぜ逆数を掛けますか？', a: 'a/bをc/dで割ることは、a/bにd/cを掛けることと同じです。割る数の分子と分母を入れ替え、掛け算として計算します。0を逆数にできないため0では割れません。' },
    { q: '約分とは何ですか？', a: '分子と分母を同じ0以外の整数で割り、値を変えずに数を小さくすることです。最大公約数で割ると一度で既約分数になります。' },
    { q: '帯分数も計算できますか？', a: 'はい。整数部・分子・分母を入力してください。内部で仮分数へ直して計算し、答えを仮分数と帯分数の両方で表示します。' },
    { q: '小数を分数に変換できますか？', a: 'はい。小数→分数タブに0.125のように入力すると、125/1000を約分した1/8を表示します。有限小数を30桁まで正確に変換できます。' },
    { q: '大きな分数でも正確に計算できますか？', a: '整数部分・分子・分母は各100桁まで受け付け、整数演算で正確に計算します。小数表示は確認用に最大12桁まで表示します。' },
  ]} />
  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .fraction-card { overflow: hidden; }
  .fraction-tabs { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--border-2); background: var(--surface-sub); }
  .fraction-tab { display: flex; flex-direction: column; gap: 2px; padding: 14px 10px; border: 0; border-bottom: 3px solid transparent; background: transparent; color: var(--text-muted); cursor: pointer; font-family: var(--font-sans); }
  .fraction-tab span { font-size: .9rem; font-weight: var(--fw-bold); }
  .fraction-tab small { font-size: .68rem; }
  .fraction-tab.is-active { border-bottom-color: var(--cat-color); background: var(--surface); color: var(--cat-color); }
  .fraction-tab:focus-visible { outline: 3px solid var(--cat-tint); outline-offset: -3px; }
  .fraction-panel { padding: 24px; }
  .fraction-mode[hidden], .form-error[hidden], .fraction-result[hidden], .convert-result[hidden] { display: none; }
  .fraction-equation { display: grid; grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr); align-items: center; gap: 14px; }
  .fraction-entry { min-width: 0; margin: 0; padding: 14px; border: 1px solid var(--border-2); border-radius: var(--r-md); background: var(--surface-sub); }
  .fraction-entry legend { padding: 0 7px; color: var(--cat-color); font-size: .75rem; font-weight: var(--fw-bold); }
  .mixed-fields { display: grid; grid-template-columns: minmax(0, .72fr) auto minmax(0, 1fr); align-items: center; gap: 8px; }
  .mixed-plus { margin-top: 22px; color: var(--text-muted); font-weight: var(--fw-bold); }
  .stacked-fraction { display: grid; grid-template-rows: auto 2px auto; gap: 5px; }
  .stacked-fraction .form-group { gap: 3px; }
  .stacked-fraction label, .whole-field label, .operation-field label { font-size: .68rem; }
  .fraction-line { width: 100%; height: 2px; background: var(--text); }
  .operation-field { min-width: 0; }
  .operation-field select { width: 100%; }
  .input-hint { margin: 12px 0 0; color: var(--text-muted); font-size: .7rem; }
  .form-error { margin: 10px 0 0; color: var(--danger); font-size: .76rem; font-weight: var(--fw-bold); }
  .fraction-result { margin-top: 20px; overflow: hidden; border: 1px solid var(--cat-color); border-radius: var(--r-md); background: var(--surface); }
  .fraction-result-main { display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 22px 16px; background: var(--cat-tint); text-align: center; }
  .fraction-result-main span, .fraction-result-grid span { color: var(--text-muted); font-size: .72rem; }
  .fraction-result-main strong { overflow-wrap: anywhere; color: var(--cat-color); font: var(--fw-bold) clamp(2rem, 7vw, 3rem)/1.2 var(--font-mono); }
  .fraction-result-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .fraction-result-grid > div { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 14px; text-align: center; }
  .fraction-result-grid > div + div { border-left: 1px solid var(--border-2); }
  .fraction-result-grid strong { overflow-wrap: anywhere; font: var(--fw-bold) .9rem/1.4 var(--font-mono); }
  .calculation-steps { padding: 14px 18px; border-top: 1px solid var(--border-2); background: var(--surface-sub); }
  .calculation-steps h2 { margin: 0 0 8px; font-size: .78rem; }
  .quick-values { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 14px; }
  .quick-values span { color: var(--text-muted); font-size: .72rem; }
  .quick-values button { padding: 6px 10px; border: 1px solid var(--border-2); border-radius: 999px; background: var(--surface-sub); color: var(--text); cursor: pointer; font: var(--fw-bold) .72rem/1 var(--font-mono); }
  .quick-values button:hover { border-color: var(--cat-color); color: var(--cat-color); }
  .decimal-converter { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: end; gap: 16px; }
  .decimal-converter > span { display: grid; place-items: center; min-height: 48px; color: var(--cat-color); font-size: 1.5rem; font-weight: var(--fw-bold); }
  .convert-answer { display: flex; min-height: 48px; flex-direction: column; justify-content: center; gap: 3px; padding: 8px 14px; border: 1px solid var(--cat-color); border-radius: var(--r-md); background: var(--cat-tint); }
  .convert-answer small { color: var(--text-muted); font-size: .68rem; }
  .convert-answer strong { overflow-wrap: anywhere; color: var(--cat-color); font: var(--fw-bold) 1.3rem/1.3 var(--font-mono); }
  .convert-result { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 16px; overflow: hidden; border: 1px solid var(--border-2); border-radius: var(--r-md); }
  .convert-result div { display: flex; min-width: 0; flex-direction: column; gap: 4px; padding: 14px; text-align: center; }
  .convert-result div + div { border-left: 1px solid var(--border-2); }
  .convert-result span { color: var(--text-muted); font-size: .7rem; }
  .convert-result strong { overflow-wrap: anywhere; font: var(--fw-bold) .9rem/1.4 var(--font-mono); }
  .formula-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; }
  .formula-cards div { display: flex; flex-direction: column; gap: 5px; padding: 15px; border: 1px solid var(--border-2); border-radius: var(--r-md); background: var(--surface-sub); }
  .formula-cards span, .formula-cards small { color: var(--text-muted); font-size: .7rem; }
  .formula-cards strong { color: var(--cat-color); font: var(--fw-bold) .85rem/1.45 var(--font-mono); }
  .steps-list { display: grid; gap: 8px; padding-left: 1.3em; }
  .term-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; }
  .term-grid div { display: flex; flex-direction: column; gap: 6px; padding: 15px; border: 1px solid var(--border-2); border-radius: var(--r-md); background: var(--surface-sub); }
  .term-grid strong { color: var(--cat-color); font-size: .78rem; }
  .term-grid span { font: var(--fw-bold) 1.25rem/1.3 var(--font-mono); }
  .term-grid p { margin: 0; color: var(--text-muted); font-size: .7rem; }
  .source-box ul { display: flex; flex-direction: column; gap: 8px; padding-left: 1.2em; }
  .source-box a, .howto > p a { color: var(--cat-color); font-weight: var(--fw-bold); }
  @media (max-width: 760px) {
    .fraction-panel { padding: 18px; }
    .fraction-equation { grid-template-columns: 1fr; }
    .operation-field { width: 100%; }
    .operation-field select { min-height: 46px; }
    .formula-cards, .term-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .fraction-tab small { display: none; }
    .mixed-fields { grid-template-columns: minmax(0, .8fr) auto minmax(0, 1fr); }
    .fraction-result-grid, .convert-result { grid-template-columns: 1fr; }
    .fraction-result-grid > div + div, .convert-result div + div { border-top: 1px solid var(--border-2); border-left: 0; }
    .decimal-converter { grid-template-columns: 1fr; }
    .decimal-converter > span { min-height: 18px; transform: rotate(90deg); }
  }
</style>

<style is:global>
  #fractionSteps { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin: 0; padding: 0; list-style: none; }
  #fractionSteps li { display: inline-flex; align-items: center; gap: 7px; color: var(--text); font: var(--fw-bold) .78rem/1.4 var(--font-mono); }
  #fractionSteps li:not(:last-child)::after { color: var(--cat-color); content: '→'; }
</style>

<script>
  import { calculateFraction, decimalToFraction } from '../../lib/bunsuu.js';

  const $ = (id) => document.getElementById(id);
  let activeMode = 'calculate';
  const trackedModes = new Set();

  function trackOnce(mode) {
    if (trackedModes.has(mode)) return;
    window.trackCalculatorResult?.(mode);
    trackedModes.add(mode);
  }

  function readFraction(prefix) {
    return {
      whole: $(`${prefix}Whole`).value.trim() || '0',
      numerator: $(`${prefix}Numerator`).value.trim(),
      denominator: $(`${prefix}Denominator`).value.trim(),
    };
  }

  function updateShare(summary) {
    window.updateResultShare?.(summary);
  }

  function renderCalculation() {
    const operation = $('fractionOperation').value;
    const result = calculateFraction({
      left: readFraction('left'),
      right: readFraction('right'),
      operation,
    });
    $('fractionError').hidden = result !== null;
    $('fractionResult').hidden = result === null;
    if (!result) {
      if (activeMode === 'calculate') window.hideResultShare?.();
      return;
    }

    $('resultExact').textContent = result.result.improper;
    $('resultMixed').textContent = result.result.mixed;
    $('resultDecimal').textContent = result.result.decimal;
    $('resultPercent').textContent = result.result.percent;
    $('fractionSteps').replaceChildren(...result.steps.map((step) => {
      const item = document.createElement('li');
      item.textContent = step;
      return item;
    }));
    if (activeMode === 'calculate') {
      updateShare(`分数計算：${result.left.improper} ${result.symbol} ${result.right.improper} ＝ ${result.result.improper}（帯分数 ${result.result.mixed}）`);
    }
    trackOnce(`fraction_${operation}`);
  }

  function renderConversion() {
    const result = decimalToFraction($('decimalValue').value);
    $('convertError').hidden = result !== null;
    $('convertResult').hidden = result === null;
    if (!result) {
      $('convertExact').textContent = '−';
      if (activeMode === 'convert') window.hideResultShare?.();
      return;
    }
    $('convertExact').textContent = result.improper;
    $('convertMixed').textContent = result.mixed;
    $('convertDecimal').textContent = result.decimal;
    $('convertPercent').textContent = result.percent;
    if (activeMode === 'convert') {
      updateShare(`小数から分数：${$('decimalValue').value.trim()} ＝ ${result.improper}`);
    }
    trackOnce('fraction_decimal');
  }

  function switchMode(mode) {
    activeMode = mode;
    document.querySelectorAll('.fraction-tab').forEach((button) => {
      const active = button.dataset.mode === mode;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    $('calculatePanel').hidden = mode !== 'calculate';
    $('convertPanel').hidden = mode !== 'convert';
    if (mode === 'calculate') renderCalculation();
    else renderConversion();
  }

  ['leftWhole', 'leftNumerator', 'leftDenominator', 'rightWhole', 'rightNumerator', 'rightDenominator']
    .forEach((id) => $(id).addEventListener('input', renderCalculation));
  $('fractionOperation').addEventListener('change', renderCalculation);
  $('decimalValue').addEventListener('input', renderConversion);

  document.querySelectorAll('.fraction-tab').forEach((button) => {
    button.addEventListener('click', () => switchMode(button.dataset.mode));
  });

  const examples = {
    add: ['', '1', '2', '', '1', '3', 'add'],
    subtract: ['', '3', '4', '', '5', '6', 'subtract'],
    multiply: ['', '2', '3', '', '9', '4', 'multiply'],
    mixed: ['1', '1', '2', '2', '1', '3', 'add'],
  };
  document.querySelectorAll('[data-example]').forEach((button) => {
    button.addEventListener('click', () => {
      const values = examples[button.dataset.example];
      ['leftWhole', 'leftNumerator', 'leftDenominator', 'rightWhole', 'rightNumerator', 'rightDenominator']
        .forEach((id, index) => { $(id).value = values[index]; });
      $('fractionOperation').value = values[6];
      renderCalculation();
    });
  });
  document.querySelectorAll('[data-decimal]').forEach((button) => {
    button.addEventListener('click', () => {
      $('decimalValue').value = button.dataset.decimal;
      renderConversion();
    });
  });

  renderCalculation();
  renderConversion();
</script>
