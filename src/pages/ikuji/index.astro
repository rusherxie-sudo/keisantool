---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'ikuji';
const title = '育児休業給付金計算器 - 雇用保険の育児休業給付金 | 計算ツール';
const description =
  '雇用保険の育児休業給付金を計算。生後8週間まで67%、それ以降50%を支給。月収と育休期間から日額・月額・総額を一括で計算できる無料ツールです。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '育児休業給付金計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 育児休業給付金</div>
    <h1>育児休業給付金計算器</h1>
    <p>雇用保険の育児休業給付金を計算します。生後8週間までは給与の67%、それ以降は50%を支給。月収と育休期間から日額・月額・総額を一括で計算できます。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="monthly-salary">月間給与（円）</label>
      <input type="number" id="monthly-salary" inputmode="numeric" placeholder="例：300000" />
    </div>

    <div class="form-group">
      <label for="child-birth-date">子供の誕生日</label>
      <input type="date" id="child-birth-date" />
    </div>

    <div class="form-group">
      <label for="start-date">育休開始日</label>
      <input type="date" id="start-date" />
    </div>

    <div class="form-group">
      <label for="end-date">育休終了日</label>
      <input type="date" id="end-date" />
    </div>

    <div class="result-box" id="result-box">
      <div class="result-label">育児休業給付金（総額）</div>
      <div class="result-main" id="result-total">¥0</div>
      <div class="result-rows">
        <div class="result-row"><span class="label">月間給与</span><span class="value" id="row-salary">¥0</span></div>
        <div class="result-row"><span class="label">標準報酬月額</span><span class="value" id="row-base">¥0</span></div>
        <div class="result-row"><span class="label">日額</span><span class="value" id="row-daily">¥0</span></div>
        <div class="result-row"><span class="label">月額</span><span class="value" id="row-monthly">¥0</span></div>
        <div class="result-row"><span class="label">給付日数</span><span class="value" id="row-days">0日</span></div>
        <div class="result-row"><span class="label">支給率</span><span class="value" id="row-rate">0%</span></div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>月間給与、子供の誕生日、育休の開始日と終了日を入力するだけで、育児休業給付金が自動計算されます。生後8週間までは67%、それ以降は50%の支給率が適用されます。</p>
    <h3>育児休業給付金の計算方法</h3>
    <ul>
      <li>日額 = 標準報酬月額 ÷ 30 × 支給率</li>
      <li>生後8週間まで：支給率67%</li>
      <li>生後8週間超：支給率50%</li>
      <li>総額 = 期間ごとの日額 × 日数</li>
    </ul>
    <h3>支給条件</h3>
    <ul>
      <li>雇用保険の被保険者であること</li>
      <li>出産した子を養育するために休業すること</li>
      <li>勤続期間などの要件を満たすこと</li>
      <li>最長支給期間：1年6ヶ月（546日）</li>
    </ul>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。実際の支給額は雇用保険事務組合が決定します。請求は勤務先の担当部署にお問い合わせください。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '育児休業給付金とは何ですか？', a: '育児休業給付金は、雇用保険の被保険者が子供の養育のために育児休業を取得する際に支給される給付金です。' },
    { q: '支給率はどう変わりますか？', a: '子供が生まれてから8週間までは給与の67%が支給され、それ以降は50%が支給されます。' },
    { q: '最長支給期間はどれくらいですか？', a: '育児休業給付金の最長支給期間は1年6ヶ月（546日）です。父母双方が利用可能です。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { calcIkuji } from '../../lib/ikuji.js';

  const $ = (id) => document.getElementById(id);
  const yen = (n) => '¥' + Math.floor(n).toLocaleString('ja-JP');

  function show(box) { box.classList.add('visible'); }
  function hide(box) { box.classList.remove('visible'); window.hideResultShare?.(); }

  function render() {
    const box = $('result-box');
    const salary = $('monthly-salary').value;
    const birthDate = $('child-birth-date').value;
    const startDate = $('start-date').value;
    const endDate = $('end-date').value;
    const result = calcIkuji(salary, startDate, endDate, birthDate);
    
    if (result.premiumBase === 0) return hide(box);
    
    show(box);
    $('result-total').textContent = yen(result.totalAmount);
    $('row-salary').textContent = yen(salary);
    $('row-base').textContent = yen(result.premiumBase);
    $('row-daily').textContent = yen(result.dailyAmount);
    $('row-monthly').textContent = yen(result.monthlyAmount);
    $('row-days').textContent = result.payableDays + '日';
    $('row-rate').textContent = result.rate + '%';

    window.setResultShare?.(
      '育児休業給付金計算器\n月間給与：' + $('row-salary').textContent +
      '\n標準報酬月額：' + $('row-base').textContent +
      '\n日額：' + $('row-daily').textContent +
      '\n月額：' + $('row-monthly').textContent +
      '\n給付日数：' + $('row-days').textContent +
      '\n支給率：' + $('row-rate').textContent +
      '\n総額：' + $('result-total').textContent
    );
  }

  $('monthly-salary').addEventListener('input', render);
  $('child-birth-date').addEventListener('change', render);
  $('start-date').addEventListener('change', render);
  $('end-date').addEventListener('change', render);
</script>