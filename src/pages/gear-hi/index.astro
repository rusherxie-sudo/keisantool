---
import ToolLayout from '../../layouts/ToolLayout.astro';import RelatedTools from '../../components/RelatedTools.astro';import Faq from '../../components/Faq.astro';import ResultShare from '../../components/ResultShare.astro';
const slug='gear-hi',title='ギア比・減速比計算ツール｜歯数・回転数・トルク・自転車',description='駆動歯車と従動歯車の歯数からギア比・減速比、出力回転数と理想トルクを計算。多段ギアと自転車のギア比・速度にも対応します。';const jsonld={'@context':'https://schema.org','@type':'WebApplication',name:'ギア比・減速比計算ツール',description,applicationCategory:'UtilityApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'},featureList:['歯数からギア比を計算','回転数とトルクを計算','多段歯車の総減速比','自転車ギア比と速度']};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide><div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ ギア比</div><h1>ギア比・減速比計算ツール</h1><p>歯数から減速比、回転数、効率を考慮した出力トルクを計算します。</p><div class="chips"><span>歯数比</span><span>rpm</span><span>トルク</span><span>自転車</span></div></div>
<div class="calc-card tool-card"><div class="tabs"><button class="tab active" data-mode="pair">歯車1対</button><button class="tab" data-mode="multi">多段ギア</button><button class="tab" data-mode="bike">自転車</button></div>
<section class="calc-panel panel active" data-panel="pair"><h2>歯数からギア比・回転数・トルク</h2><div class="grid"><label>駆動側歯数<input id="p-drive" value="20" type="number" min="1"></label><label>従動側歯数<input id="p-driven" value="60" type="number" min="1"></label><label>入力回転数（rpm）<input id="p-rpm" value="1500" type="number" min="0"></label><label>入力トルク（N·m）<input id="p-torque" value="2" type="number" min="0"></label><label>伝達効率（%）<input id="p-eff" value="100" type="number" min="0" max="100"></label></div><p class="error" id="p-error" hidden>歯数と値を正しく入力し、効率は0超100%以下にしてください。</p><div class="cards" id="p-result"><div><span>減速比</span><strong id="p-ratio">3 : 1</strong></div><div><span>出力回転数</span><strong id="p-out-rpm">500 rpm</strong></div><div><span>出力トルク</span><strong id="p-out-torque">6 N·m</strong></div></div></section>
<section class="calc-panel panel" data-panel="multi"><h2>多段歯車の総減速比</h2><label>各段の「駆動歯数:従動歯数」<textarea id="m-pairs" rows="4">20:60
15:45</textarea></label><p class="note">1行に1段。例の総減速比は3×3＝9です。</p><p class="error" id="m-error" hidden>各行を「20:60」の形式で入力してください。</p><div class="result" id="m-result"><span>総減速比</span><strong id="m-main">9 : 1</strong></div></section>
<section class="calc-panel panel" data-panel="bike"><h2>自転車のギア比・速度</h2><div class="grid"><label>フロント歯数<input id="b-front" value="50" type="number" min="1"></label><label>リア歯数<input id="b-rear" value="25" type="number" min="1"></label><label>タイヤ周長（m）<input id="b-wheel" value="2.1" type="number" min="0" step="any"></label><label>ケイデンス（rpm）<input id="b-cadence" value="90" type="number" min="0"></label></div><p class="error" id="b-error" hidden>すべて0より大きい値を入力してください。</p><div class="cards" id="b-result"><div><span>ギア比</span><strong id="b-ratio">2</strong></div><div><span>ペダル1回転の距離</span><strong id="b-distance">4.2 m</strong></div><div><span>理論速度</span><strong id="b-speed">22.68 km/h</strong></div></div></section></div><ResultShare/><div class="ad-slot"></div>
<section class="howto"><h2>ギア比・減速比の計算式</h2><p>外歯車1対では<strong>減速比＝従動側歯数÷駆動側歯数</strong>です。20歯が60歯を回すと3:1で、入力1,500rpmは理論上500rpmになります。トルクは理想的に3倍ですが、実機では摩擦損失があるため効率を掛けます。トルク単位や出力との関係は<a href="/toruku/">トルク計算ツール</a>で確認できます。</p></section>
<section class="howto source-box"><h2>適用範囲と根拠</h2><p>このページは単純な外歯車対と各段の比の積を扱います。遊星歯車、内歯車、ウォーム、差動機構は固定要素と回転方向によって式が変わるため対象外です。</p><ul><li><a href="https://www.tetras.uitec.jeed.go.jp/files/kankoubutu/i-109-05.pdf" target="_blank" rel="noopener noreferrer">職業能力開発総合大学校「基本的な機械要素演習」</a>：歯数・回転数・多段減速比・トルク伝達。</li></ul><div class="disclaimer">※ 計算結果はあくまで参考値です。歯面強度、軸強度、バックラッシ、潤滑、効率と安全率は設計仕様で確認してください。</div></section><RelatedTools current={slug}/><Faq items={[{q:'ギア比の計算式は？',a:'外歯車1対では従動側歯数÷駆動側歯数です。'},{q:'20歯と60歯の減速比は？',a:'60÷20＝3なので3:1です。'},{q:'多段ギアの比は？',a:'各段の減速比を掛け合わせます。'},{q:'トルクはギア比だけ増えますか？',a:'理想値では比に比例しますが、実際は伝達効率を掛けます。'},{q:'自転車の速度は正確ですか？',a:'タイヤ周長とケイデンスが一定という理論値で、滑りや変形は含みません。'}]}/><div class="ad-slot"></div></ToolLayout>
<style>.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips span{padding:5px 10px;border-radius:999px;background:var(--cat-tint);color:var(--cat-color);font-size:.75rem;font-weight:700}.tool-card{overflow:hidden}.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface-sub)}.tab{padding:15px;border:0;border-bottom:3px solid transparent;background:none;font-weight:700}.tab.active{background:var(--surface);color:var(--cat-color);border-color:var(--cat-color)}.panel{padding:24px}.panel:not(.active){display:none}.panel h2{margin-top:0;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.grid label{display:flex;flex-direction:column;gap:7px;font-size:.8rem;font-weight:700}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}.cards div,.result{display:flex;flex-direction:column;align-items:center;gap:5px;padding:18px;background:var(--cat-tint);border-radius:var(--r-md)}.cards strong,.result strong{font:700 clamp(1.3rem,4vw,2rem) var(--font-mono);color:var(--cat-color)}.cards span,.note{color:var(--text-muted)}.error{padding:10px;background:var(--danger-bg);color:var(--danger)}textarea{width:100%;margin-top:8px;font-family:var(--font-mono)}@media(max-width:650px){.grid,.cards{grid-template-columns:1fr 1fr}}@media(max-width:480px){.panel{padding:18px}.grid,.cards{grid-template-columns:1fr}.tab{font-size:.75rem}}</style>
<script>import{solveGearPair,compoundGearRatio,solveBicycleGear}from'../../lib/gear-hi.js';const $=id=>document.getElementById(id),fmt=n=>Number(n.toPrecision(8)).toLocaleString('ja-JP',{maximumFractionDigits:10});let mode='pair';function rp(){const r=solveGearPair({driveTeeth:$('p-drive').value,drivenTeeth:$('p-driven').value,inputRpm:$('p-rpm').value,inputTorque:$('p-torque').value,efficiency:$('p-eff').value});$('p-error').hidden=!!r;$('p-result').hidden=!r;if(!r)return;$('p-ratio').textContent=`${fmt(r.ratio)} : 1`;$('p-out-rpm').textContent=`${fmt(r.outputRpm)} rpm`;$('p-out-torque').textContent=`${fmt(r.outputTorque)} N·m`;if(mode==='pair')window.setResultShare?.(`ギア比計算\n減速比 ${fmt(r.ratio)}:1・出力 ${fmt(r.outputRpm)}rpm`)}function rm(){const pairs=$('m-pairs').value.trim().split(/\n+/).map(x=>{const[a,b]=x.split(':');return{drive:a,driven:b}}),r=compoundGearRatio(pairs);$('m-error').hidden=!!r;$('m-result').hidden=!r;if(r)$('m-main').textContent=`${fmt(r)} : 1`;}function rb(){const r=solveBicycleGear({frontTeeth:$('b-front').value,rearTeeth:$('b-rear').value,wheelCircumferenceM:$('b-wheel').value,cadenceRpm:$('b-cadence').value});$('b-error').hidden=!!r;$('b-result').hidden=!r;if(!r)return;$('b-ratio').textContent=fmt(r.ratio);$('b-distance').textContent=`${fmt(r.distancePerCrankM)} m`;$('b-speed').textContent=`${fmt(r.speedKmh)} km/h`;}document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.dataset.panel===mode));({pair:rp,multi:rm,bike:rb})[mode]()}));document.querySelectorAll('input,textarea').forEach(x=>x.addEventListener('input',()=>{rp();rm();rb()}));rp();rm();rb();</script>
