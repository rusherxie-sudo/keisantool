---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';
import { UNITS } from '../../lib/tani.js';

const slug = 'tani';
const title = '単位変換器 - 長さ・重さ・面積・体積・温度・速さを一括変換 | 計算ツール';
const description =
  '長さ・重さ・面積・体積・温度・速さの単位を瞬時に変換できる無料ツール。cm⇔inch、kg⇔lb、坪⇔m²、℃⇔℉など、日常やDIY・料理・海外サイズの換算に。数値を入れるだけで自動計算します。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '単位変換器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};

const categories = [
  { id: 'length', label: '長さ' },
  { id: 'weight', label: '重さ' },
  { id: 'area', label: '面積' },
  { id: 'volume', label: '体積' },
  { id: 'temperature', label: '温度' },
  { id: 'speed', label: '速さ' },
];
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/henkan/">変換・ツール</a> ／ 単位変換</div>
    <h1>単位変換器</h1>
    <p>長さ・重さ・面積・体積・温度・速さの単位を、入力するだけで瞬時に変換します。</p>
  </div>

  <div class="calc-card">
    <div class="calc-tabs" role="tablist">
      {categories.map((c, i) => (
        <button class={`calc-tab${i === 0 ? ' active' : ''}`} data-cat={c.id} type="button">{c.label}</button>
      ))}
    </div>

    <div class="tani-input">
      <div class="form-group">
        <label for="tani-value">数値</label>
        <input type="number" id="tani-value" inputmode="decimal" placeholder="例：100" value="1" />
      </div>
      <div class="form-group">
        <label for="tani-from">単位</label>
        <select id="tani-from"></select>
      </div>
    </div>

    <div class="tani-result-head" id="tani-result-label">変換結果</div>
    <div class="result-grid" id="tani-grid"></div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>上のタブから変換したいカテゴリ（長さ・重さ・面積・体積・温度・速さ）を選び、数値を入力して元になる単位を選ぶだけ。そのカテゴリのすべての単位に換算した結果が一覧で同時に表示されます。ボタンを押す必要はありません。各結果の「コピー」ボタンで数値をクリップボードにコピーできます。</p>
    <ul>
      <li><strong>長さ</strong>：mm・cm・m・km のほか、inch（インチ）・feet（フィート）・yard（ヤード）・mile（マイル）、和の単位「寸・尺・里」に対応。海外通販のサイズ表記や身長換算に便利です（例：1 inch = 2.54 cm）。</li>
      <li><strong>重さ</strong>：mg・g・kg・t に加え、oz（オンス）・lb（ポンド）、和の単位「匁・貫」に対応（1匁 = 3.75 g）。レシピや郵便物の重量換算に。</li>
      <li><strong>面積</strong>：cm²・m²・km²・a（アール）・ha（ヘクタール）と、不動産でよく使う「坪」「畳」に対応。<strong>1坪 ≈ 3.305785 m²</strong>として計算します。畳は地域差があるため、ここでは<strong>中京間（1.6562 m²）</strong>を採用しています（京間・江戸間とは数値が異なります）。不動産表示の1帖＝1.62㎡、縦×横、坪単価まで計算する場合は<a href="/tsubo-heibei/">坪・平米換算ツール</a>をご利用ください。</li>
      <li><strong>体積</strong>：ml・cc・L・m³ に対応。料理（cc とml は同じ）やタンク容量の計算に。</li>
      <li><strong>温度</strong>：摂氏（℃）・華氏（℉）・ケルビン（K）を相互変換します（例：0℃ = 32℉ = 273.15K、100℃ = 212℉）。海外のオーブン温度や天気予報の換算に。</li>
      <li><strong>速さ</strong>：m/s・km/h・mph（マイル毎時）・knot（ノット）に対応（例：100 km/h ≈ 27.78 m/s）。距離と時間から速さを求める場合は<a href="/hayasa/">速さ・距離・時間計算ツール</a>をご利用ください。</li>
    </ul>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。坪・畳・尺貫法などの換算値や端数の扱いにより、実際の値とわずかに異なる場合があります。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: 'どんな単位を変換できますか？', a: '長さ・重さ・面積・体積・温度・速さなどに対応しています。変換元と変換先を選ぶだけで自動換算します。' },
    { q: 'インチやフィートも変換できますか？', a: 'はい。メートル法とヤード・ポンド法（inch・feet・mileなど）の相互変換に対応しています。' },
    { q: '温度（摂氏・華氏）も変換できますか？', a: '摂氏(℃)・華氏(℉)・ケルビン(K)の変換に対応しています。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script define:vars={{ UNITS }}>
  const $ = (id) => document.getElementById(id);
  let currentCat = 'length';

  // categories（タブのラベル）は define:vars では渡していないため JS 側にも保持
  const categories = [
    { id: 'length', label: '長さ' },
    { id: 'weight', label: '重さ' },
    { id: 'area', label: '面積' },
    { id: 'volume', label: '体積' },
    { id: 'temperature', label: '温度' },
    { id: 'speed', label: '速さ' },
  ];

  function fmt(n) {
    if (!Number.isFinite(n)) return '—';
    // 大きすぎ/小さすぎは指数、それ以外は有効桁で整形
    let s;
    if (n !== 0 && (Math.abs(n) >= 1e15 || Math.abs(n) < 1e-9)) {
      s = n.toExponential(6);
    } else {
      s = Number(n.toPrecision(10)).toString();
    }
    // 桁区切り（小数部はそのまま）
    if (/^-?\d+(\.\d+)?$/.test(s)) {
      const [int, dec] = s.split('.');
      const grouped = Number(int).toLocaleString('ja-JP');
      return dec !== undefined ? grouped + '.' + dec : grouped;
    }
    return s;
  }

  function fillSelects() {
    const list = UNITS[currentCat];
    const from = $('tani-from');
    from.innerHTML = '';
    list.forEach((u) => {
      from.appendChild(new Option(u.label, u.id));
    });
    // 既定: 1番目
    from.selectedIndex = 0;
  }

  // ロジックは lib/tani.js と同一（純静的のため最小限を内包）
  function toCelsius(v, f) {
    if (f === 'c') return v;
    if (f === 'f') return (v - 32) * 5 / 9;
    if (f === 'k') return v - 273.15;
    return null;
  }
  function fromCelsius(c, t) {
    if (t === 'c') return c;
    if (t === 'f') return c * 9 / 5 + 32;
    if (t === 'k') return c + 273.15;
    return null;
  }
  function convert(cat, value, fromUnit, toUnit) {
    const list = UNITS[cat];
    if (!list) return null;
    if (value === '' || value === null || value === undefined) return null;
    const n = Number(value);
    if (!Number.isFinite(n)) return null;
    if (cat === 'temperature') {
      const ids = new Set(list.map((u) => u.id));
      if (!ids.has(fromUnit) || !ids.has(toUnit)) return null;
      const c = toCelsius(n, fromUnit);
      return c === null ? null : fromCelsius(c, toUnit);
    }
    const from = list.find((u) => u.id === fromUnit);
    const to = list.find((u) => u.id === toUnit);
    if (!from || !to) return null;
    return (n * from.factor) / to.factor;
  }

  function esc(s) {
    return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  }

  function render() {
    const grid = $('tani-grid');
    const label = $('tani-result-label');
    const rawValue = $('tani-value').value;
    const fromId = $('tani-from').value;
    const list = UNITS[currentCat];
    const fromLabel = (list.find((u) => u.id === fromId) || {}).label || '';

    // 入力が空/非数値なら全カードを「—」表示にする
    const hasInput = rawValue !== '' && Number.isFinite(Number(rawValue));
    label.textContent = hasInput
      ? `${fmt(Number(rawValue))} ${fromLabel} =`
      : '変換結果';

    grid.innerHTML = list
      .map((u) => {
        const r = hasInput ? convert(currentCat, rawValue, fromId, u.id) : null;
        const valText = r === null ? '—' : fmt(r);
        const isFrom = u.id === fromId;
        const copyBtn = r === null
          ? ''
          : `<button type="button" class="result-card__copy" data-copy="${esc(valText)}">コピー</button>`;
        return `<div class="result-card${isFrom ? ' is-from' : ''}">
            <div class="result-card__head"><span class="result-card__label">${esc(u.label)}</span></div>
            <div class="result-card__value">${esc(valText)}</div>
            ${copyBtn}
          </div>`;
      })
      .join('');

    // 結果シェア：入力が有効なときだけ、代表的な単位 2〜3 件を要約
    if (hasInput) {
      const catLabel = (categories.find((c) => c.id === currentCat) || {}).label || '';
      const lines = list
        .filter((u) => u.id !== fromId)
        .slice(0, 3)
        .map((u) => {
          const r = convert(currentCat, rawValue, fromId, u.id);
          return r === null ? null : `${u.label}：${fmt(r)}`;
        })
        .filter(Boolean);
      window.setResultShare?.(
        `単位変換（${catLabel}）\n${fmt(Number(rawValue))} ${fromLabel} =\n${lines.join('\n')}`
      );
    } else {
      window.hideResultShare?.();
    }
  }

  document.querySelectorAll('.calc-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.calc-tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      currentCat = tab.dataset.cat;
      fillSelects();
      render();
    });
  });

  // 結果カードのコピー（イベント委譲：innerHTML 再生成に強い）
  $('tani-grid').addEventListener('click', (e) => {
    const btn = e.target.closest('.result-card__copy');
    if (!btn) return;
    const text = btn.dataset.copy || '';
    navigator.clipboard?.writeText(text).then(() => {
      const orig = btn.textContent;
      btn.classList.add('is-copied');
      btn.textContent = '✓ コピー済み';
      setTimeout(() => {
        btn.classList.remove('is-copied');
        btn.textContent = orig;
      }, 1400);
    });
  });

  ['tani-value', 'tani-from'].forEach((id) => $(id).addEventListener('input', render));

  fillSelects();
  render();
</script>

<style>
  .tani-input {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 0.75rem;
    align-items: end;
    margin-bottom: 20px;
  }
  .tani-input .form-group {
    margin-bottom: 0;
  }
  .tani-input select {
    width: 100%;
  }
  .tani-result-head {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: var(--fw-bold);
    color: color-mix(in srgb, var(--cat-color) 62%, #000);
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }
  @media (max-width: 480px) {
    .tani-input {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- 動的注入カードの .is-from 強調は scoped では効かないため global で -->
<style is:global>
  #tani-grid .result-card.is-from {
    border-color: color-mix(in srgb, var(--cat-color) 45%, transparent);
    background: var(--cat-tint);
  }
</style>
