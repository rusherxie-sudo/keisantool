---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'nenrei';
const title = '年齢計算器 - 生年月日から満年齢・数え年・学年・干支を自動計算 | 計算ツール';
const description =
  '生年月日を入力するだけで、満年齢・数え年・日本の学年（早生まれ対応）・干支を自動で計算する無料ツール。基準日を変えれば過去や未来の年齢も確認できます。誕生日が来たかどうかも正確に判定します。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '年齢計算器',
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ 年齢計算</div>
    <h1>年齢計算器</h1>
    <p>生年月日を入力するだけで、満年齢・数え年・学年・干支をその場で自動計算します。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="birth">生年月日</label>
      <input type="date" id="birth" />
    </div>
    <div class="form-group">
      <label for="ref">基準日（計算の基準とする日。未入力なら本日）</label>
      <input type="date" id="ref" />
    </div>

    <div class="result-box" id="result">
      <div class="result-label">満年齢</div>
      <div class="result-main" id="mannenrei">―</div>
      <div class="result-rows">
        <div class="result-row"><span class="label">数え年</span><span class="value" id="kazoe">―</span></div>
        <div class="result-row"><span class="label">学年（日本）</span><span class="value" id="grade">―</span></div>
        <div class="result-row"><span class="label">干支（十二支）</span><span class="value" id="eto">―</span></div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方と計算方法</h2>
    <p>
      生年月日を選ぶだけで、満年齢・数え年・学年・干支をその場で自動計算します。ボタンを押す必要はありません。基準日を入力すると、その日付時点での年齢を計算できます（未入力の場合は本日が基準になります）。過去の特定日や未来の誕生日時点の年齢を知りたいときに便利です。
    </p>
    <p>
      <strong>満年齢</strong>は、生まれた日を0歳として、誕生日を迎えるごとに1歳ずつ増える、日常で最も使われる数え方です。基準日にその年の誕生日を「迎えているかどうか」を月日で判定するため、誕生日の前日まではまだ加算されません。うるう年の2月29日生まれの方は、平年では3月1日の到来をもって1歳加算されるよう計算しています。
    </p>
    <p>
      <strong>数え年</strong>は、生まれた年を1歳とし、元日（1月1日）を迎えるごとに1歳ずつ増える、昔ながらの数え方です。本ツールでは「基準日の年 − 生まれた年 + 1」で計算しています。厄年や賀寿（還暦・古希など）の年齢は数え年で語られることが多いため、あわせて確認できます。
    </p>
    <p>
      <strong>学年</strong>は、日本の「4月始まり」の制度にもとづいて計算します。同じ学年になるのは「4月2日生まれ〜翌年4月1日生まれ」で、4月1日以前に生まれた方（いわゆる<strong>早生まれ</strong>）は1学年上になります。小学1年生〜高校3年生を表示し、入学前は「未就学」、卒業後は「高校卒業後」と表示します。
    </p>
    <p>
      <strong>干支（十二支）</strong>は、子・丑・寅・卯・辰・巳・午・未・申・酉・戌・亥の12年周期で、生まれた年から判定します。
    </p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。正式な年齢・学年の取り扱いについては、各機関の規定にしたがってください。</div>
  </section>

  <RelatedTools current={slug} />

  <Faq items={[
    { q: '満年齢と数え年の違いは？', a: '満年齢は誕生日ごとに1歳増え、数え年は元日（1月1日）ごとに1歳増えます。本ツールは生年月日から両方を表示します。' },
    { q: '学年も調べられますか？', a: 'はい。生年月日から日本の学年（早生まれも考慮）を判定できます。' },
    { q: '干支（えと）も分かりますか？', a: '生まれ年から干支（十二支）も表示します。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { mannenrei, kazoedoshi, schoolGrade, eto } from '../../lib/nenrei.js';

  const $ = (id) => document.getElementById(id);

  // ローカル日付を ISO（YYYY-MM-DD）に。
  const todayISO = () => {
    const d = new Date();
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  };

  function render() {
    const birth = $('birth').value;
    const ref = $('ref').value || todayISO();
    const box = $('result');

    const age = mannenrei(birth, ref);
    if (age === null) {
      box.classList.remove('visible');
      window.hideResultShare?.();
      return;
    }
    box.classList.add('visible');
    $('mannenrei').textContent = `${age}歳`;

    const birthYear = Number(birth.slice(0, 4));
    const refYear = Number(ref.slice(0, 4));

    const kazoe = kazoedoshi(birthYear, refYear);
    $('kazoe').textContent = kazoe === null ? '―' : `${kazoe}歳`;

    const g = schoolGrade(birth, ref);
    $('grade').textContent = g ? g.label : '―';

    const e = eto(birthYear);
    $('eto').textContent = e ? `${e}年` : '―';

    window.setResultShare?.(
      `年齢計算器\n満年齢：${$('mannenrei').textContent}\n数え年：${$('kazoe').textContent}\n学年（日本）：${$('grade').textContent}\n干支：${$('eto').textContent}`
    );
  }

  $('birth').addEventListener('input', render);
  $('birth').addEventListener('change', render);
  $('ref').addEventListener('input', render);
  $('ref').addEventListener('change', render);
</script>
