---
import ToolLayout from '../../layouts/ToolLayout.astro';import RelatedTools from '../../components/RelatedTools.astro';import Faq from '../../components/Faq.astro';import ResultShare from '../../components/ResultShare.astro';
const slug='netsuryou',title='熱量・比熱計算ツール｜Q=mcΔT・J・cal・kWh換算',description='質量・比熱・温度差から熱量を計算。電力と時間からJ・kJ・cal・kcal・Wh・kWhを求め、熱量・電力・時間の逆算と単位換算もできます。';const jsonld={'@context':'https://schema.org','@type':'WebApplication',name:'熱量・比熱計算ツール',description,applicationCategory:'UtilityApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'},featureList:['Q=mcΔTで熱量計算','電力と時間からエネルギー計算','J・cal・Whを一括換算']};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide><div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 熱量</div><h1>熱量・比熱計算ツール</h1><p>質量×比熱×温度差と、電力×時間の2つの方法で熱量を計算します。</p><div class="chips"><span>Q＝mcΔT</span><span>J・kJ</span><span>cal・kcal</span><span>Wh・kWh</span></div></div>
<div class="calc-card tool-card"><div class="tabs"><button class="tab active" data-mode="heat">質量・比熱</button><button class="tab" data-mode="power">電力・時間</button><button class="tab" data-mode="convert">単位換算</button></div>
<section class="calc-panel panel active" data-panel="heat"><h2>質量・比熱・温度差から熱量</h2><div class="grid"><label>質量<div><input id="h-mass" value="1" type="number" min="0"><select id="h-mass-unit"><option>kg</option><option>g</option></select></div></label><label>比熱<div><input id="h-specific" value="4.18" type="number" min="0"><select id="h-specific-unit"><option value="kJ/kgK">kJ/(kg·K)</option><option value="J/kgK">J/(kg·K)</option><option value="J/gK">J/(g·K)</option></select></div></label><label>温度差（℃またはK）<input id="h-delta" value="20" type="number" min="0"></label></div><p class="error" id="h-error" hidden>すべて0より大きい値を入力してください。</p><div class="result" id="h-result"><span>必要な熱量</span><strong id="h-main">83.6 kJ</strong><small id="h-sub"></small></div></section>
<section class="calc-panel panel" data-panel="power"><h2>熱量・電力・時間を相互計算</h2><label>求める値<select id="p-target"><option value="energy">熱量</option><option value="power">電力</option><option value="time">時間</option></select></label><div class="grid"><label id="p-energy-wrap" hidden>熱量<div><input id="p-energy" value="180" type="number"><select id="p-energy-unit"><option>kJ</option><option>J</option><option>kcal</option><option>kWh</option></select></div></label><label id="p-power-wrap">電力<div><input id="p-power" value="1" type="number"><select id="p-power-unit"><option>kW</option><option>W</option></select></div></label><label id="p-time-wrap">時間<div><input id="p-time" value="3" type="number"><select id="p-time-unit"><option>min</option><option>s</option><option>h</option></select></div></label></div><p class="error" id="p-error" hidden>表示中の2項目に0より大きい値を入力してください。</p><div class="result" id="p-result"><span>熱量</span><strong id="p-main">180 kJ</strong><small id="p-sub"></small></div></section>
<section class="calc-panel panel" data-panel="convert"><h2>熱量単位を一括換算</h2><div class="grid"><label>熱量<input id="c-value" value="1" type="number"></label><label>変換元<select id="c-unit"><option>kJ</option><option>J</option><option>cal</option><option>kcal</option><option>Wh</option><option>kWh</option></select></label></div><div class="values" id="c-values"></div></section></div><ResultShare/><div class="ad-slot"></div>
<section class="howto"><h2>熱量の計算式 Q＝mcΔT</h2><p>物体の温度だけを変える顕熱は、質量m、比熱c、温度差ΔTから<strong>Q＝mcΔT</strong>で求めます。水1kg、比熱4.18kJ/(kg·K)、温度差20Kなら83.6kJです。沸騰・融解・蒸発など相変化中は潜熱が必要で、この式だけでは計算できません。</p></section>
<section class="howto source-box"><h2>電力から熱量と効率の注意</h2><p>1W＝1J/sなので、熱量＝電力×時間です。ただしヒーターの入力電力がすべて対象物に移るわけではなく、容器や周囲への損失があります。電気料金は<a href="/denki-dai/">電気代計算ツール</a>をご利用ください。</p><ul><li><a href="https://www.mext.go.jp/a_menu/shotou/kyoukasho/kentei/000042810/20250528-app_dev04-242.pdf" target="_blank" rel="noopener noreferrer">文部科学省 教科書検定資料「熱とエネルギー」</a>：Q＝mcΔTと熱容量。</li><li><a href="https://unit.aist.go.jp/nmij/library/si-units/" target="_blank" rel="noopener noreferrer">産業技術総合研究所 NMIJ「国際単位系」</a>：J、W、s。</li></ul><div class="disclaimer">※ 計算結果はあくまで参考値です。相変化、熱損失、温度による比熱変化、安全限界は別途考慮してください。</div></section><RelatedTools current={slug}/><Faq items={[{q:'熱量の計算式は？',a:'温度変化だけならQ＝質量×比熱×温度差です。'},{q:'1calは何Jですか？',a:'このツールでは熱化学カロリー1cal＝4.184Jを使用します。'},{q:'1Whは何Jですか？',a:'1W×3600秒なので3,600Jです。'},{q:'水1kgを1℃上げる熱量は？',a:'比熱を4.18kJ/(kg·K)とすると約4.18kJです。'},{q:'沸騰や融解も計算できますか？',a:'このページは顕熱を扱い、相変化の潜熱は含みません。'}]}/><div class="ad-slot"></div></ToolLayout>
<style>.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips span{padding:5px 10px;border-radius:999px;background:var(--cat-tint);color:var(--cat-color);font-size:.75rem;font-weight:700}.tool-card{overflow:hidden}.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface-sub)}.tab{padding:15px 4px;border:0;border-bottom:3px solid transparent;background:none;font-weight:700}.tab.active{background:var(--surface);color:var(--cat-color);border-color:var(--cat-color)}.panel{padding:24px}.panel:not(.active){display:none}.panel h2{margin-top:0;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}.grid label{display:flex;flex-direction:column;gap:7px;font-size:.8rem;font-weight:700}.grid label>div{display:grid;grid-template-columns:1fr 110px;gap:7px}.result{display:flex;flex-direction:column;align-items:center;gap:5px;margin-top:20px;padding:20px;background:var(--cat-tint);border-radius:var(--r-md)}.result strong{font:700 clamp(1.8rem,6vw,2.8rem) var(--font-mono);color:var(--cat-color)}.result small{color:var(--text-muted)}.values{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.values div{display:flex;flex-direction:column;padding:13px;border:1px solid var(--border-2);background:var(--surface-sub);border-radius:var(--r-md)}.values strong{font-family:var(--font-mono);color:var(--cat-color)}.error{padding:10px;background:var(--danger-bg);color:var(--danger)}@media(max-width:650px){.grid,.values{grid-template-columns:1fr 1fr}}@media(max-width:480px){.panel{padding:18px}.grid,.values{grid-template-columns:1fr}.tab{font-size:.72rem}}</style>
<script>import{convertEnergy,solveSensibleHeat,solvePowerHeat}from'../../lib/netsuryou.js';const $=id=>document.getElementById(id),fmt=n=>Number(n.toPrecision(8)).toLocaleString('ja-JP',{maximumFractionDigits:10});let mode='heat';const energyText=j=>j>=1000?`${fmt(j/1000)} kJ`:`${fmt(j)} J`;function rh(){const r=solveSensibleHeat({mass:$('h-mass').value,massUnit:$('h-mass-unit').value,specificHeat:$('h-specific').value,specificHeatUnit:$('h-specific-unit').value,temperatureChange:$('h-delta').value});$('h-error').hidden=!!r;$('h-result').hidden=!r;if(!r)return;$('h-main').textContent=energyText(r.energyJ);$('h-sub').textContent=`${fmt(convertEnergy(r.energyJ,'J','kcal'))} kcal・${fmt(convertEnergy(r.energyJ,'J','Wh'))} Wh`;if(mode==='heat')window.setResultShare?.(`熱量計算\n${$('h-main').textContent}`)}function rp(){const t=$('p-target').value;$('p-energy-wrap').hidden=t==='energy';$('p-power-wrap').hidden=t==='power';$('p-time-wrap').hidden=t==='time';const r=solvePowerHeat({target:t,energy:$('p-energy').value,energyUnit:$('p-energy-unit').value,power:$('p-power').value,powerUnit:$('p-power-unit').value,time:$('p-time').value,timeUnit:$('p-time-unit').value});$('p-error').hidden=!!r;$('p-result').hidden=!r;if(!r)return;const main=t==='energy'?energyText(r.energyJ):t==='power'?`${fmt(r.powerW)} W`:`${fmt(r.timeSec/60)} 分`;$('p-main').textContent=main;$('p-result').querySelector('span').textContent={energy:'熱量',power:'電力',time:'時間'}[t];$('p-sub').textContent=`${fmt(r.energyJ)} J・${fmt(r.powerW)} W・${fmt(r.timeSec)} 秒`;}function rc(){const units=['J','kJ','cal','kcal','Wh','kWh'],v=$('c-value').value,u=$('c-unit').value;$('c-values').innerHTML=units.map(x=>`<div><span>${x}</span><strong>${convertEnergy(v,u,x)===null?'—':fmt(convertEnergy(v,u,x))}</strong></div>`).join('')}document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.dataset.panel===mode));({heat:rh,power:rp,convert:rc})[mode]()}));document.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',()=>{rh();rp();rc()}));rh();rp();rc();</script>
