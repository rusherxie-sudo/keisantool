---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import ShukujitsuYearView from '../../components/ShukujitsuYearView.astro';
import { holidays, renkyuList, calendarMonths, officialHolidayYearLimit } from '../../lib/shukujitsu.js';

// ハブ（/shukujitsu/、今年）と合わせた生成範囲。
const RANGE_YEARS_BACK = 1;
const RANGE_YEARS_FORWARD = 3;

export function getStaticPaths() {
  const nowYear = new Date().getFullYear();
  const paths = [];
  for (let y = nowYear - 1; y <= nowYear + 3; y++) {
    paths.push({ params: { year: String(y) } });
  }
  return paths;
}

const YEAR = Number(Astro.params.year);
const now = new Date();
const isCurrentYear = YEAR === now.getFullYear();

const hols = holidays(YEAR);
const renkyu = renkyuList(YEAR);
const months = calendarMonths(YEAR);
const longestRenkyu = renkyu.reduce((max, r) => (r.length > (max?.length ?? 0) ? r : max), null);
const officialThrough = officialHolidayYearLimit(now);
const isOfficial = officialThrough !== null && YEAR <= officialThrough;

const hasPrev = YEAR - 1 >= now.getFullYear() - RANGE_YEARS_BACK;
const hasNext = YEAR + 1 <= now.getFullYear() + RANGE_YEARS_FORWARD;

// 今年は /shukujitsu/ が正規URL（重複コンテンツ防止のため canonical をハブへ向ける）。
const slug = isCurrentYear ? 'shukujitsu' : `shukujitsu/${YEAR}`;

const eraLabel = `令和${YEAR - 2018}年`;
const title = `${YEAR}年（${eraLabel}）カレンダー｜祝日一覧・連休 | 計算ツール`;
const description = `${YEAR}年（${eraLabel}）の年間カレンダー。祝日一覧、3連休、最長連休を月別に確認できます。${isOfficial ? '内閣府発表済みの日付を掲載。' : '春分・秋分は正式発表前の予測値です。'}無料印刷対応。`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '祝日・連休カレンダー',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current="shukujitsu" jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/shukujitsu/">祝日・連休カレンダー</a> ／ {YEAR}年</div>
    <h1>{YEAR}年（{eraLabel}）の祝日カレンダー</h1>
    <p>
      {YEAR}年の国民の祝日・振替休日・国民の休日を一覧できます。3連休以上の連休もまとめて表示しているので、旅行や帰省、仕事のスケジュール調整の参考にどうぞ。
      {longestRenkyu && <>{YEAR}年最長の連休は<strong>{longestRenkyu.length}連休</strong>（{longestRenkyu.holidayNames.join('・')}）です。</>}
    </p>
  </div>

  <div class:list={{ 'publication-status': true, provisional: !isOfficial }}>
    {isOfficial ? (
      <><strong>正式発表済み</strong><span>{YEAR}年の祝日・休日は内閣府と国立天文台の公表内容にもとづいています。</span></>
    ) : (
      <><strong>{YEAR}年の春分・秋分は予測値です</strong><span>内閣府による正式な祝日一覧は{YEAR - 1}年2月に掲載予定です。固定日と月曜日指定の祝日は現行法、春分・秋分は近似計算で表示しています。</span></>
    )}
  </div>

  <div class="calc-card">
    <ShukujitsuYearView year={YEAR} holidays={hols} renkyu={renkyu} months={months} />
    <nav class="sk-nav">
      {hasPrev ? <a href={`/shukujitsu/${YEAR - 1}/`}>← {YEAR - 1}年</a> : <span />}
      {hasNext ? <a href={`/shukujitsu/${YEAR + 1}/`}>{YEAR + 1}年 →</a> : <span />}
    </nav>
  </div>

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>祝日・振替休日・国民の休日の決まり方</h2>
    <p>
      日本の祝日は「国民の祝日に関する法律」で定められています。元日・憲法記念日など<strong>固定された日付の祝日</strong>のほか、成人の日・海の日・敬老の日・スポーツの日は<strong>「第◯月曜日」（ハッピーマンデー制度）</strong>で決まります。春分の日・秋分の日は天文学上の春分点・秋分点にもとづき、国立天文台が前年2月に正式発表しますが、本ツールは広く使われている近似計算で表示しています。
    </p>
    <ul>
      <li><strong>振替休日</strong>：祝日が日曜日にあたる場合、その後最初の「祝日でない平日」が休日になります。祝日が続く場合は、祝日でない日まで順にずれていきます。</li>
      <li><strong>国民の休日</strong>：前後を祝日にはさまれた平日（祝日ではない日）は、休日になります。</li>
    </ul>
    <p class="source-links"><strong>公式情報：</strong><a href="https://www8.cao.go.jp/chosei/shukujitsu/gaiyou.html" target="_blank" rel="noopener">内閣府「国民の祝日について」</a> ／ <a href="https://eco.mtk.nao.ac.jp/koyomi/yoko/" target="_blank" rel="noopener">国立天文台「暦要項」</a></p>
    <div class="disclaimer">※ 春分の日・秋分の日は近似計算のため、国立天文台の正式発表と異なる場合があります。計算結果はあくまで参考値です。正式な祝日は内閣府の発表をご確認ください。</div>
  </section>

  <RelatedTools current="shukujitsu" />

  <Faq items={[
    { q: `${YEAR}年の連休はいつですか？`, a: longestRenkyu ? `${YEAR}年で最長の連休は${longestRenkyu.length}連休（${longestRenkyu.holidayNames.join('・')}）です。他の3連休以上の期間は上の一覧でご確認いただけます。` : `${YEAR}年に3連休以上の連休はありません。` },
    { q: `${YEAR}年の祝日・休日は何日ありますか？`, a: `${YEAR}年は、このカレンダー上で祝日・休日が${hols.length}日あります。土曜日と重なる祝日は休日数の増加にはつながらないため、実際の休日日数とは区別してご確認ください。` },
    { q: `${YEAR}年の祝日は正式に発表されていますか？`, a: isOfficial ? `${YEAR}年の祝日・休日は正式発表済みです。` : `${YEAR}年の正式な祝日一覧は${YEAR - 1}年2月に内閣府から掲載予定です。春分の日・秋分の日はそれまで予測値として表示しています。` },
    { q: '振替休日とはどんな制度ですか？', a: '祝日が日曜日にあたる場合に、その直後の「祝日でない平日」を休日とする制度です。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .sk-nav {
    max-width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    font-size: .85rem;
    font-weight: var(--fw-bold);
  }
  .sk-nav a { color: var(--cat-color); }
  .sk-nav a:hover { opacity: .75; }
  .howto ul { padding-left: 1.2em; display: flex; flex-direction: column; gap: 6px; }
  .publication-status { display: flex; gap: 10px; align-items: baseline; margin-bottom: 16px; border: 1.5px solid var(--success); border-radius: var(--r-md); background: color-mix(in srgb, var(--success) 7%, var(--surface)); padding: 12px 16px; font-size: .82rem; }
  .publication-status strong { flex: 0 0 auto; color: var(--success); }
  .publication-status span { color: var(--text-muted); }
  .publication-status.provisional { border-color: var(--warning); background: color-mix(in srgb, var(--warning) 9%, var(--surface)); }
  .publication-status.provisional strong { color: var(--warning-text, #8a5a00); }
  .source-links a { color: var(--cat-color); }
  @media (max-width: 560px) { .publication-status { align-items: flex-start; flex-direction: column; gap: 4px; } }
</style>
