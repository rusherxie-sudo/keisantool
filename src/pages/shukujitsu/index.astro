---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import ShukujitsuYearView from '../../components/ShukujitsuYearView.astro';
import { holidays, renkyuList, calendarMonths } from '../../lib/shukujitsu.js';

const slug = 'shukujitsu';

// スポークページ（/shukujitsu/<year>/）の生成範囲と合わせる。
const RANGE_YEARS_BACK = 1;
const RANGE_YEARS_FORWARD = 3;

const YEAR = new Date().getFullYear();
const hols = holidays(YEAR);
const renkyu = renkyuList(YEAR);
const months = calendarMonths(YEAR);
const longestRenkyu = renkyu.reduce((max, r) => (r.length > (max?.length ?? 0) ? r : max), null);

const hasPrev = YEAR - 1 >= YEAR - RANGE_YEARS_BACK;
const hasNext = YEAR + 1 <= YEAR + RANGE_YEARS_FORWARD;

const eraLabel = `令和${YEAR - 2018}年`;
const title = `${YEAR}年（${eraLabel}）カレンダー｜祝日一覧・連休 | 計算ツール`;
const description = `${YEAR}年（${eraLabel}）の年間カレンダー。国民の祝日・振替休日・国民の休日を月別に表示し、祝日一覧、3連休、最長連休もまとめて確認できます。無料印刷対応。`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '祝日・連休カレンダー',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 祝日・連休カレンダー</div>
    <h1>{YEAR}年（{eraLabel}）の祝日カレンダー</h1>
    <p>
      {YEAR}年の国民の祝日・振替休日・国民の休日を一覧できます。3連休以上の連休もまとめて表示しているので、旅行や帰省、仕事のスケジュール調整の参考にどうぞ。
      {longestRenkyu && <>今年最長の連休は<strong>{longestRenkyu.length}連休</strong>（{longestRenkyu.holidayNames.join('・')}）です。</>}
    </p>
  </div>

  <div class="calc-card">
    <ShukujitsuYearView year={YEAR} holidays={hols} renkyu={renkyu} months={months} />
    <nav class="sk-nav">
      {hasPrev ? <a href={`/shukujitsu/${YEAR - 1}/`}>← {YEAR - 1}年</a> : <span />}
      {hasNext ? <a href={`/shukujitsu/${YEAR + 1}/`}>{YEAR + 1}年 →</a> : <span />}
    </nav>
  </div>

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>祝日・振替休日・国民の休日の決まり方</h2>
    <p>
      日本の祝日は「国民の祝日に関する法律」で定められています。元日・憲法記念日など<strong>固定された日付の祝日</strong>のほか、成人の日・海の日・敬老の日・スポーツの日は<strong>「第◯月曜日」（ハッピーマンデー制度）</strong>で決まります。春分の日・秋分の日は天文学上の春分点・秋分点にもとづき、国立天文台が前年2月に正式発表しますが、本ツールは広く使われている近似計算で表示しています。
    </p>
    <ul>
      <li><strong>振替休日</strong>：祝日が日曜日にあたる場合、その後最初の「祝日でない平日」が休日になります。祝日が続く場合は、祝日でない日まで順にずれていきます。</li>
      <li><strong>国民の休日</strong>：前後を祝日にはさまれた平日（祝日ではない日）は、休日になります。たとえば敬老の日と秋分の日が近い年は、その間の日が国民の休日になることがあります。</li>
    </ul>
    <div class="disclaimer">※ 春分の日・秋分の日は近似計算のため、国立天文台の正式発表と異なる場合があります。計算結果はあくまで参考値です。正式な祝日は内閣府の発表をご確認ください。</div>
  </section>

  <RelatedTools current={slug} />

  <Faq items={[
    { q: `${YEAR}年の連休はいつですか？`, a: longestRenkyu ? `${YEAR}年で最長の連休は${longestRenkyu.length}連休（${longestRenkyu.holidayNames.join('・')}）です。他の3連休以上の期間は上の一覧でご確認いただけます。` : `${YEAR}年に3連休以上の連休はありません。` },
    { q: '振替休日とはどんな制度ですか？', a: '祝日が日曜日にあたる場合に、その直後の「祝日でない平日」を休日とする制度です。1973年に導入され、2007年の改正で祝日が続く場合の扱いが明確になりました。' },
    { q: '国民の休日とは何ですか？', a: '祝日と祝日にはさまれた、本来は祝日でない平日を休日とする制度です。「国民の祝日に関する法律」第3条第3項に規定されています。' },
    { q: '春分の日・秋分の日はなぜ日付が決まっていないのですか？', a: '天文学上の春分点・秋分点を太陽が通過する日にもとづくため、年によって日付が変わります。正式な日付は国立天文台が前年2月に官報で発表します。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .sk-nav {
    max-width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    font-size: .85rem;
    font-weight: var(--fw-bold);
  }
  .sk-nav a { color: var(--cat-color); }
  .sk-nav a:hover { opacity: .75; }
  .howto ul { padding-left: 1.2em; display: flex; flex-direction: column; gap: 6px; }
</style>
