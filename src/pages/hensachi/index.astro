---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'hensachi';
const title = '偏差値計算器 - 得点・平均・標準偏差から偏差値を計算 | 計算ツール';
const description =
  '得点・平均点・標準偏差を入力するだけで偏差値計算ができる無料ツール。テストや模試の偏差値をその場で算出し、偏差値から全国順位（上位パーセント・概算順位）も正規分布で目安を求められます。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '偏差値計算器',
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 偏差値計算</div>
    <h1>偏差値計算器</h1>
    <p>得点・平均点・標準偏差を入力するだけで偏差値を瞬時に計算。偏差値から全国順位の目安も求められます。</p>
  </div>

  <div class="calc-card">
    <div class="calc-tabs" role="tablist">
      <button class="calc-tab active" data-tab="dev" type="button">偏差値計算</button>
      <button class="calc-tab" data-tab="list" type="button">得点リストから計算</button>
      <button class="calc-tab" data-tab="rank" type="button">偏差値→順位</button>
    </div>

    <div class="calc-panel active" id="panel-dev">
      <div class="form-group">
        <label for="dev-score">あなたの得点</label>
        <input type="number" id="dev-score" inputmode="decimal" placeholder="例：75" />
      </div>
      <div class="form-group">
        <label for="dev-mean">平均点</label>
        <input type="number" id="dev-mean" inputmode="decimal" placeholder="例：60" />
      </div>
      <div class="form-group">
        <label for="dev-sd">標準偏差</label>
        <input type="number" id="dev-sd" inputmode="decimal" placeholder="例：10" />
      </div>
      <div class="result-box" id="dev-result">
        <div class="result-label">あなたの偏差値</div>
        <div class="result-main" id="dev-value">0.0</div>
      </div>
    </div>

    <div class="calc-panel" id="panel-list">
      <div class="form-group">
        <label for="list-scores">得点リスト（クラス全員などの点数）</label>
        <textarea id="list-scores" rows="5" placeholder="改行・カンマ・スペース区切りで入力&#10;例：40 50 60 70 80"></textarea>
        <p class="list-hint">標準偏差が分からなくても大丈夫。集団全員の得点を貼り付けると、平均・標準偏差・各人の偏差値を自動計算します。</p>
      </div>
      <div class="result-box" id="list-result">
        <div class="result-label">この集団の統計</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">人数</span><span class="value" id="list-count">—</span></div>
          <div class="result-row"><span class="label">平均点</span><span class="value" id="list-mean">—</span></div>
          <div class="result-row"><span class="label">標準偏差（母集団）</span><span class="value" id="list-sd">—</span></div>
        </div>
        <table class="list-table" id="list-table">
          <thead><tr><th>No.</th><th>得点</th><th>偏差値</th></tr></thead>
          <tbody id="list-tbody"></tbody>
        </table>
      </div>
    </div>

    <div class="calc-panel" id="panel-rank">
      <div class="form-group">
        <label for="rank-dev">偏差値</label>
        <input type="number" id="rank-dev" inputmode="decimal" placeholder="例：60" />
      </div>
      <div class="form-group">
        <label for="rank-total">受験者数（任意）</label>
        <input type="number" id="rank-total" inputmode="numeric" placeholder="例：10000" />
      </div>
      <div class="result-box" id="rank-result">
        <div class="result-label">上位パーセント</div>
        <div class="result-main" id="rank-percent">0%</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">概算順位</span><span class="value" id="rank-position">—</span></div>
        </div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>上のタブから計算したい種類を選び、数値を入力すると自動で結果が表示されます。ボタンを押す必要はありません。</p>
    <ul>
      <li><strong>偏差値計算</strong>：自分の得点・テスト全体の平均点・標準偏差を入力すると、偏差値を計算します。</li>
      <li><strong>得点リストから計算</strong>：標準偏差が分からない場合に便利です。クラスや集団全員の得点を貼り付けるだけで、平均点・標準偏差を自動で求め、一人ひとりの偏差値を一覧表示します。区切りは改行・カンマ・スペースのいずれでもかまいません。</li>
      <li><strong>偏差値→順位</strong>：偏差値から全国での上位パーセントを求め、受験者数を入力すれば概算順位の目安も表示します。</li>
    </ul>
    <p>
      <strong>偏差値とは</strong>、テストの得点が集団の中でどの位置にあるかを表す数値です。平均点をちょうど取ると偏差値は50になり、平均より高ければ50超、低ければ50未満となります。計算式は「偏差値 ＝ （得点 − 平均点）÷ 標準偏差 × 10 ＋ 50」です。標準偏差は得点のばらつきの大きさを示す値で、ばらつきが大きいほど同じ得点差でも偏差値の動きは小さくなります。標準偏差が分からない場合は、模試の成績表などに記載されている値を使ってください。
    </p>
    <p>
      <strong>順位の概算について</strong>：得点が正規分布（左右対称の釣鐘型の分布）に従うと仮定すると、偏差値から「上位何パーセントか」を見積もることができます。目安として偏差値50は上位50%、偏差値60は上位およそ15.9%、偏差値70は上位およそ2.3%にあたります。受験者数を入力すると「上位パーセント × 受験者数」から概算の順位を切り上げで算出します。実際の試験の得点分布は完全な正規分布にはならないため、表示される順位はあくまで目安としてご利用ください。
    </p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。順位は正規分布を仮定した概算であり、実際の試験結果とは異なる場合があります。</div>
  </section>

  <RelatedTools current={slug} />

  <Faq items={[
    { q: '偏差値はどう計算しますか？', a: '偏差値＝(得点−平均点)÷標準偏差×10＋50 で求めます。平均なら50、平均より上なら50を超えます。' },
    { q: '標準偏差が分からない場合は？', a: '得点の一覧を入力すれば、本ツールが標準偏差を自動計算して偏差値を出します。' },
    { q: '偏差値から順位の目安は分かりますか？', a: '偏差値から上位何%かの目安も表示します（正規分布を仮定した概算です）。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
  #list-scores {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    padding: 0.6rem 0.7rem;
    background: var(--surface-sub);
    color: var(--text);
    border: 1.5px solid var(--border-input);
    border-radius: var(--r-md);
    resize: vertical;
    transition: border-color var(--ease);
  }
  #list-scores:focus {
    outline: none;
    border-color: var(--cat-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cat-color) 14%, transparent);
  }
  #list-scores::placeholder { color: var(--text-faint); }
  .list-hint {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>

<style is:global>
  /* 得点リストの行は JS の innerHTML で動的生成されるため scoped CSS が効かない
     → is:global + #list-table 前缀でスコープ限定（CLAUDE.md の落とし穴対策）。 */
  #list-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.8rem;
    font-size: 0.95rem;
  }
  #list-table th,
  #list-table td {
    padding: 0.4rem 0.6rem;
    text-align: right;
    border-bottom: 1.5px solid var(--border-2);
  }
  #list-table th:first-child,
  #list-table td:first-child {
    text-align: left;
    color: var(--text-muted);
  }
  #list-table thead th {
    color: var(--text-3);
    font-weight: var(--fw-bold);
    border-bottom: 2px solid var(--border-input);
  }
  #list-table tbody:empty {
    display: none;
  }
</style>

<script>
  import { hensachi, topPercent, estimateRank, statsFromScores, deviationsFromScores } from '../../lib/hensachi.js';

  const $ = (id) => document.getElementById(id);
  const jp = (n) => n.toLocaleString('ja-JP');

  document.querySelectorAll('.calc-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.calc-tab').forEach((t) => t.classList.remove('active'));
      document.querySelectorAll('.calc-panel').forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      $('panel-' + tab.dataset.tab).classList.add('active');
      window.hideResultShare?.();
    });
  });

  function renderDev() {
    const value = hensachi($('dev-score').value, $('dev-mean').value, $('dev-sd').value);
    const box = $('dev-result');
    if (value === null) {
      box.classList.remove('visible');
      window.hideResultShare?.();
      return;
    }
    box.classList.add('visible');
    $('dev-value').textContent = value.toFixed(1);
    window.setResultShare?.('偏差値計算器\n偏差値：' + $('dev-value').textContent);
  }

  function renderRank() {
    const pct = topPercent($('rank-dev').value);
    const box = $('rank-result');
    if (pct === null) {
      box.classList.remove('visible');
      window.hideResultShare?.();
      return;
    }
    box.classList.add('visible');
    $('rank-percent').textContent = '上位 ' + pct.toFixed(2) + '%';
    const rank = estimateRank($('rank-dev').value, $('rank-total').value);
    $('rank-position').textContent = rank === null ? '受験者数を入力' : jp(rank) + ' 位';
    window.setResultShare?.(
      '偏差値計算器\n' + $('rank-percent').textContent + '\n概算順位：' + $('rank-position').textContent
    );
  }

  // 改行・カンマ・スペース（全角含む）区切りのテキストを数値配列に解析する。
  function parseScores(text) {
    return text
      .split(/[\s,、，\n\r]+/)
      .map((t) => t.trim())
      .filter((t) => t !== '');
  }

  function renderList() {
    const box = $('list-result');
    const tbody = $('list-tbody');
    const tokens = parseScores($('list-scores').value);
    const stats = statsFromScores(tokens);
    const devs = deviationsFromScores(tokens);
    if (stats === null || devs === null) {
      box.classList.remove('visible');
      tbody.innerHTML = '';
      window.hideResultShare?.();
      return;
    }
    box.classList.add('visible');
    $('list-count').textContent = jp(stats.count) + ' 人';
    $('list-mean').textContent = (Math.round(stats.mean * 100) / 100).toString() + ' 点';
    $('list-sd').textContent = (Math.round(stats.sd * 100) / 100).toString();
    tbody.innerHTML = tokens
      .map((s, i) => `<tr><td>${i + 1}</td><td>${Number(s)}</td><td>${devs[i].toFixed(1)}</td></tr>`)
      .join('');
    window.setResultShare?.(
      '偏差値計算器\n人数：' + $('list-count').textContent +
      '\n平均点：' + $('list-mean').textContent +
      '\n標準偏差：' + $('list-sd').textContent
    );
  }

  ['dev-score', 'dev-mean', 'dev-sd'].forEach((id) => $(id).addEventListener('input', renderDev));
  ['rank-dev', 'rank-total'].forEach((id) => $(id).addEventListener('input', renderRank));
  $('list-scores').addEventListener('input', renderList);
</script>
