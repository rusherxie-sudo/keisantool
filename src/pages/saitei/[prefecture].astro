---
import ToolLayout from '../../layouts/ToolLayout.astro';
import MinimumWageCalculator from '../../components/MinimumWageCalculator.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';
import { minimumWagePrefectures, calcSaitei, getMinimumWageHistory, getMinimumWageCities } from '../../lib/saitei.js';

export function getStaticPaths() {
  return minimumWagePrefectures().map((info) => ({ params: { prefecture: info.slug }, props: { info } }));
}

const { info } = Astro.props;
const allPrefectures = minimumWagePrefectures();
const sameRegion = allPrefectures.filter((row) => row.region === info.region && row.slug !== info.slug);
const estimate20 = calcSaitei(info.prefecture, 8, 20);
const estimate22 = calcSaitei(info.prefecture, 8, 22);
const wageHistory = getMinimumWageHistory(info.slug);
const cities = getMinimumWageCities(info.slug);
const sixYearIncrease = wageHistory.length ? info.wage - wageHistory[0].wage : null;
const [effectiveYear, effectiveMonth, effectiveDay] = info.effectiveDate.split('-').map(Number);
const effectiveText = `${effectiveYear}年${effectiveMonth}月${effectiveDay}日`;
const guidelineIncrease = ['saitama', 'chiba', 'tokyo', 'kanagawa', 'aichi', 'osaka'].includes(info.slug) ? 54 : 56;
const proposedText = info.proposedWage ? `${info.proposedWage.toLocaleString('ja-JP')}円` : null;
const slug = `saitei/${info.slug}`;
const canonicalUrl = new URL(`/${slug}/`, Astro.site).href;
const title = info.proposedWage
  ? `${info.prefecture}の最低賃金 2026年答申は${proposedText}｜現行${info.wage.toLocaleString('ja-JP')}円・月給計算`
  : wageHistory.length
  ? `${info.prefecture}の最低賃金は${info.wage.toLocaleString('ja-JP')}円【2026年現在】｜推移・月給計算`
  : `${info.prefecture}の最低賃金は${info.wage.toLocaleString('ja-JP')}円【2026年現在】｜月給・時給計算`;
const description = info.proposedWage
  ? `${info.prefecture}の2026年度最低賃金は${proposedText}と地方審議会が答申。現在適用中は時給${info.wage.toLocaleString('ja-JP')}円です。発効前の違いと日給・月給を確認できます。`
  : cities.length
  ? `${info.prefecture}（${cities.join('・')}）の最低賃金は時給${info.wage.toLocaleString('ja-JP')}円。令和2〜7年度の推移、日給・月給の目安、令和8年度の改定状況を確認できます。`
  : `${info.prefecture}の最低賃金は時給${info.wage.toLocaleString('ja-JP')}円（${effectiveText}発効）です。令和8年度は+${guidelineIncrease}円の引上げ目安が答申済み。最終額・発効日は未決定です。`;
const jsonld = { '@context': 'https://schema.org', '@type': 'WebApplication', name: `${info.prefecture}の最低賃金計算`, description, url: canonicalUrl, applicationCategory: 'UtilityApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' } };
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
  { '@type': 'ListItem', position: 2, name: '最低賃金 全国一覧', item: new URL('/saitei/', Astro.site).href },
  { '@type': 'ListItem', position: 3, name: info.prefecture, item: canonicalUrl },
] };
const faqItems = [
  { q: `${info.prefecture}の2026年の最低賃金はいくらですか？`, a: info.proposedWage ? `${info.prefecture}地方最低賃金審議会は令和8年度の改定額を${proposedText}（現行比+${info.proposedIncrease}円）と答申しました。現在適用中の金額は${info.wage.toLocaleString('ja-JP')}円で、新額は決定・発効前には適用されません。` : `現在適用中の${info.prefecture}の地域別最低賃金は、時間額${info.wage.toLocaleString('ja-JP')}円です。令和8年度は中央最低賃金審議会が+${guidelineIncrease}円の引上げ目安を答申しましたが、当サイトで地方答申額をまだ確認できていません。` },
  { q: `${info.prefecture}で1日8時間働く最低日給はいくらですか？`, a: `${info.wage.toLocaleString('ja-JP')}円×8時間で、最低日給の目安は${estimate22.dailyWage.toLocaleString('ja-JP')}円です。休憩時間は労働時間に含めません。` },
  { q: `${info.prefecture}の最低月給はいくらですか？`, a: `1日8時間・月20日なら${estimate20.monthlyWage.toLocaleString('ja-JP')}円、月22日なら${estimate22.monthlyWage.toLocaleString('ja-JP')}円が単純計算の目安です。実際の判定は年間所定労働時間で月給を時間額換算します。` },
  ...(cities.length ? [{ q: `${cities[0]}の最低賃金はいくらですか？`, a: `${cities[0]}を含む${info.prefecture}内では、原則として${info.prefecture}の地域別最低賃金${info.wage.toLocaleString('ja-JP')}円が適用されます。市区町村ごとに別の地域別最低賃金が設定されるものではありません。ただし、対象産業ではより高い特定最低賃金が適用される場合があります。` }] : []),
  ...(wageHistory.length ? [{ q: `${info.prefecture}の最低賃金はどのように推移していますか？`, a: `令和2年度の${wageHistory[0].wage.toLocaleString('ja-JP')}円から令和7年度の${info.wage.toLocaleString('ja-JP')}円へ、6年度分で${sixYearIncrease.toLocaleString('ja-JP')}円上昇しています。年度別の金額はページ内の推移表で確認できます。` }] : []),
];
---

<ToolLayout title={title} description={description} slug={slug} current="saitei" jsonld={jsonld} breadcrumb={breadcrumb} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/saitei/">最低賃金 全国一覧</a> ／ {info.prefecture}</div>
    <h1>{info.prefecture}の最低賃金 2026年｜現行{info.wage.toLocaleString('ja-JP')}円{info.proposedWage && `・答申${proposedText}`}</h1>
    <p>{effectiveText}発効の地域別最低賃金です。日給・月給の目安と、実際の月給が最低賃金以上かを計算できます。</p>
  </div>

  <div class="answer-card">
    <span>{info.prefecture}の地域別最低賃金</span>
    <strong>{info.wage.toLocaleString('ja-JP')}<small>円／時間</small></strong>
    <p>発効日：{effectiveText}</p>
  </div>
  <aside class="status-note">
    {info.proposedWage ? <><strong>令和8年度は{proposedText}（現行比+{info.proposedIncrease}円）と地方答申</strong><p>{info.proposedDate.replaceAll('-', '年').replace(/年(\d{2})年(\d{2})$/, '年$1月$2日')}の地方最低賃金審議会答申です。正式な適用日は都道府県労働局の決定・公示後に確定し、多くは2026年10月以降の発効が見込まれます。決定・発効するまでは、現在適用中の{info.wage.toLocaleString('ja-JP')}円で計算します。<a href={info.proposedSource} target="_blank" rel="nofollow noopener">出典・発表を確認</a></p></> : <><strong>令和8年度は+{guidelineIncrease}円の中央引上げ目安が答申済み</strong><p>2026年7月28日の中央目安です。当サイトで{info.prefecture}の地方答申額を確認できるまでは、現在適用中の確定額だけを表示・計算します。</p></>}
  </aside>

  <div class="calc-card"><MinimumWageCalculator selectedPrefecture={info.prefecture} showPrefectureSelect={false} /></div>
  <ResultShare />
  <div class="ad-slot"></div>

  <section class="howto">
    <h2>{info.prefecture}の最低日給・月給早見表</h2>
    <p>時給{info.wage.toLocaleString('ja-JP')}円、1日8時間で単純計算した目安です。月給制の正式な確認は、上の「月給をチェック」で年間所定労働時間を入力してください。</p>
    <div class="data-table-wrap"><div class="data-table-scroll"><table class="data-table estimate-table">
      <thead><tr><th>働き方</th><th>最低賃金の目安</th><th>計算式</th></tr></thead>
      <tbody>
        <tr><th scope="row">1日（8時間）</th><td class="num">{estimate22.dailyWage.toLocaleString('ja-JP')}円</td><td>{info.wage.toLocaleString('ja-JP')}円×8時間</td></tr>
        <tr><th scope="row">月20日</th><td class="num">{estimate20.monthlyWage.toLocaleString('ja-JP')}円</td><td>日給×20日</td></tr>
        <tr><th scope="row">月22日</th><td class="num">{estimate22.monthlyWage.toLocaleString('ja-JP')}円</td><td>日給×22日</td></tr>
        <tr><th scope="row">年額（月22日）</th><td class="num">{estimate22.yearlyWage.toLocaleString('ja-JP')}円</td><td>月額×12か月</td></tr>
      </tbody>
    </table></div></div>
  </section>

  {cities.length > 0 && <section class="howto city-scope">
    <h2>{cities[0]}・{cities[1]}・{cities[2]}の最低賃金</h2>
    <p><strong>{cities.join('、')}</strong>を含む{info.prefecture}内では、原則として同じ地域別最低賃金<strong>{info.wage.toLocaleString('ja-JP')}円</strong>が適用されます。市区町村ごとに別の地域別最低賃金があるわけではありません。</p>
    <p>ただし、勤務する事業場の産業が特定最低賃金の対象で、地域別最低賃金より高い場合は特定最低賃金が適用されます。派遣労働者は派遣先の事業場がある地域を基準に確認します。</p>
  </section>}

  {wageHistory.length > 0 && <section class="howto">
    <h2>{info.prefecture}の最低賃金推移｜令和2〜7年度</h2>
    <p>{info.prefecture}の最低賃金は、令和2年度の<strong>{wageHistory[0].wage.toLocaleString('ja-JP')}円</strong>から令和7年度の<strong>{info.wage.toLocaleString('ja-JP')}円</strong>へ、6年度分で<strong>{sixYearIncrease.toLocaleString('ja-JP')}円</strong>上昇しました。</p>
    <div class="data-table-wrap"><div class="data-table-scroll"><table class="data-table history-table">
      <thead><tr><th>年度</th><th>時間額</th><th>前年度比</th></tr></thead>
      <tbody>{wageHistory.map((row, index) => <tr>
        <th scope="row">令和{row.fiscalYear - 2018}年度（{row.fiscalYear}年度）</th>
        <td class="num"><strong>{row.wage.toLocaleString('ja-JP')}円</strong></td>
        <td class="num">{index === 0 ? '―' : `+${(row.wage - wageHistory[index - 1].wage).toLocaleString('ja-JP')}円`}</td>
      </tr>)}</tbody>
    </table></div></div>
    <p class="history-note">※ 年度別の地域別最低賃金額です。発効日は年度・都道府県により異なります。</p>
  </section>}

  <section class="howto">
    <h2>{info.prefecture}で最低賃金を確認するときの注意</h2>
    <ul>
      <li>最低賃金は原則としてパート、アルバイト、高校生を含むすべての労働者に適用されます。</li>
      <li>派遣労働者は派遣先である{info.prefecture}の最低賃金が基準です。</li>
      <li>通勤手当、家族手当、賞与、時間外・休日・深夜の割増賃金などは比較対象から除きます。</li>
      <li>特定の産業では、地域別最低賃金より高い「特定最低賃金」が適用される場合があります。</li>
    </ul>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。個別の適用関係は都道府県労働局または労働基準監督署に確認してください。</div>
  </section>

  <section class="howto region-links">
    <h2>{info.region}の最低賃金</h2>
    <div>{sameRegion.map((row) => <a href={`/saitei/${row.slug}/`}>{row.prefecture} {row.wage.toLocaleString('ja-JP')}円</a>)}</div>
    <p><a class="hub-link" href="/saitei/">全国47都道府県の最低賃金一覧を見る →</a></p>
  </section>

  <section class="howto sources">
    <h2>公式情報</h2>
    <ul>
      <li><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudoukijun/minimumichiran/index.html" target="_blank" rel="nofollow noopener">厚生労働省「地域別最低賃金の全国一覧」</a></li>
      <li><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudoukijun/chingin/newpage_43899.html" target="_blank" rel="nofollow noopener">厚生労働省「最低賃金額以上かどうかを確認する方法」</a></li>
      <li><a href="https://www.mhlw.go.jp/stf/newpage_74920.html" target="_blank" rel="nofollow noopener">厚生労働省「令和8年度地域別最低賃金額改定の目安について」</a></li>
      <li><a href="https://saiteichingin.mhlw.go.jp/table/page_list_past.html" target="_blank" rel="nofollow noopener">厚生労働省「地域別最低賃金の全国一覧（過去5年分）」</a></li>
    </ul>
  </section>

  <RelatedTools current="saitei" />
  <Faq items={faqItems} />
  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .answer-card { margin-bottom: 14px; padding: 22px; border: 1.5px solid var(--cat-color); border-radius: var(--r-md); background: var(--cat-tint); }
  .answer-card > span { display: block; color: var(--text-muted); font-size: .8rem; font-weight: var(--fw-bold); }
  .answer-card strong { display: block; margin: 4px 0; color: var(--cat-color); font-size: 2.2rem; }
  .answer-card small { margin-left: 5px; font-size: .9rem; }
  .answer-card p { margin: 0; }
  .status-note { margin-bottom: 20px; padding: 14px 16px; border-left: 4px solid var(--warning); border-radius: var(--r-sm); background: var(--warning-bg); }
  .status-note strong { color: var(--warning-text); }
  .status-note p { margin: 4px 0 0; font-size: .8rem; line-height: 1.65; }
  .estimate-table { min-width: 560px; }
  .history-table { min-width: 520px; }
  .estimate-table th[scope="row"] { text-align: left; }
  .history-table th[scope="row"] { text-align: left; }
  .history-note { color: var(--text-muted); font-size: .76rem; }
  .region-links > div { display: flex; flex-wrap: wrap; gap: 8px; }
  .region-links a, .sources a, .hub-link { color: var(--cat-color); text-decoration: underline; text-underline-offset: 2px; }
  .region-links > div a { padding: 8px 10px; border: 1px solid var(--border-2); border-radius: var(--r-sm); background: var(--surface-sub); text-decoration: none; }
</style>
