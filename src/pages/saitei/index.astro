---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'saitei';
const title = '最低賃金計算器 - 47都道府県別最低賃金 | 計算ツール';
const description =
  '日本全国47都道府県の最低賃金を検索・計算。地域ごとの最低時給から日給・月給・年給を一括で算出できる無料ツールです。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '最低賃金計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};

const prefectures = [
  '東京都', '大阪府', '神奈川県', '京都府', '愛知県', '福岡県', '埼玉県', '千葉県',
  '兵庫県', '北海道', '茨城県', '栃木県', '群馬県', '静岡県', '三重県', '奈良県',
  '和歌山県', '鳥取県', '島根県', '岡山県', '広島県', '山口県', '徳島県', '香川県',
  '愛媛県', '高知県', '福島県', '山形県', '宮城県', '秋田県', '岩手県', '青森県',
  '長野県', '山梨県', '富山県', '石川県', '福井県', '佐賀県', '長崎県', '熊本県',
  '大分県', '宮崎県', '鹿児島県', '沖縄県', '新潟県', '岐阜県', '滋賀県',
];
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 最低賃金</div>
    <h1>最低賃金計算器</h1>
    <p>日本全国47都道府県の最低賃金を検索・計算します。地域ごとの最低時給から日給・月給・年給を一括で算出できます。2025年度の最低賃金データを使用しています。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="prefecture">都道府県</label>
      <select id="prefecture">
        {prefectures.map((p) => <option value={p}>{p}</option>)}
      </select>
    </div>

    <div class="form-group">
      <label for="hours-per-day">1日の労働時間（時間）</label>
      <input type="number" id="hours-per-day" inputmode="numeric" placeholder="例：8" value="8" />
    </div>

    <div class="form-group">
      <label for="days-per-month">月の労働日数（日）</label>
      <input type="number" id="days-per-month" inputmode="numeric" placeholder="例：22" value="22" />
    </div>

    <div class="result-box" id="result-box">
      <div class="result-label">最低時給</div>
      <div class="result-main" id="result-hourly">¥0</div>
      <div class="result-rows">
        <div class="result-row"><span class="label">都道府県</span><span class="value" id="row-prefecture">-</span></div>
        <div class="result-row"><span class="label">日給</span><span class="value" id="row-daily">¥0</span></div>
        <div class="result-row"><span class="label">月給</span><span class="value" id="row-monthly">¥0</span></div>
        <div class="result-row"><span class="label">年給</span><span class="value" id="row-yearly">¥0</span></div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>都道府県を選択し、労働時間と労働日数を入力するだけで、最低賃金が自動計算されます。時給、日給、月給、年給が一括で表示されます。</p>
    <h3>最低賃金の計算方法</h3>
    <ul>
      <li>日給 = 最低時給 × 1日の労働時間</li>
      <li>月給 = 日給 × 月の労働日数</li>
      <li>年給 = 月給 × 12</li>
    </ul>
    <h3>2025年度の最低賃金の特徴</h3>
    <ul>
      <li>全国平均最低時給：約1062円</li>
      <li>最高：東京都 1251円</li>
      <li>最低：鳥取県・島根県・秋田県・岩手県・青森県 946円</li>
    </ul>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。実際の最低賃金は地域の労働基準監督署が定めるものです。最新情報は厚生労働省のホームページで確認してください。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '最低賃金とは何ですか？', a: '最低賃金は、使用者が労働者に支払う最低限の賃金です。地域ごとに異なり、都道府県ごとに設定されています。' },
    { q: '最低賃金はいつ更新されますか？', a: '最低賃金は原則として毎年4月に更新されます。経済状況などにより変更される場合があります。' },
    { q: '全国で最低賃金が一番高い地域はどこですか？', a: '2025年度現在、最低時給が一番高い地域は東京都の1251円です。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { calcSaitei } from '../../lib/saitei.js';

  const $ = (id) => document.getElementById(id);
  const yen = (n) => '¥' + Math.floor(n).toLocaleString('ja-JP');

  function show(box) { box.classList.add('visible'); }
  function hide(box) { box.classList.remove('visible'); window.hideResultShare?.(); }

  function render() {
    const box = $('result-box');
    const prefecture = $('prefecture').value;
    const hoursPerDay = $('hours-per-day').value || 8;
    const daysPerMonth = $('days-per-month').value || 22;
    const result = calcSaitei(prefecture, hoursPerDay, daysPerMonth);
    
    if (!result.prefecture) return hide(box);
    
    show(box);
    $('result-hourly').textContent = yen(result.hourlyWage);
    $('row-prefecture').textContent = result.prefecture;
    $('row-daily').textContent = yen(result.dailyWage);
    $('row-monthly').textContent = yen(result.monthlyWage);
    $('row-yearly').textContent = yen(result.yearlyWage);

    window.setResultShare?.(
      '最低賃金計算器\n都道府県：' + result.prefecture +
      '\n最低時給：' + $('result-hourly').textContent +
      '\n日給：' + $('row-daily').textContent +
      '\n月給：' + $('row-monthly').textContent +
      '\n年給：' + $('row-yearly').textContent
    );
  }

  $('prefecture').addEventListener('change', render);
  $('hours-per-day').addEventListener('input', render);
  $('days-per-month').addEventListener('input', render);

  render();
</script>