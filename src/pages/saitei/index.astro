---
import ToolLayout from '../../layouts/ToolLayout.astro';
import MinimumWageCalculator from '../../components/MinimumWageCalculator.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';
import { NATIONAL_WEIGHTED_AVERAGE, NATIONAL_WEIGHTED_AVERAGE_2026, WAGE_REVIEWED, WAGE_SOURCE_2026, NATIONAL_WAGE_HISTORY, minimumWagePrefectures } from '../../lib/saitei.js';
import { japanDateParts } from '../../lib/japanDate.js';

const slug = 'saitei';
const today = japanDateParts();
const asOfDate = `${today.year}-${String(today.month).padStart(2, '0')}-${String(today.day).padStart(2, '0')}`;
const prefectures = minimumWagePrefectures(asOfDate);
const pending = prefectures.filter(row => !row.isRevisionEffective);
const title = '最低賃金 2026年｜全国一覧・発効日と日給・月給計算';
const description = `2026年（令和8年度）の47都道府県別最低賃金と発効日を公式全国一覧で確認。現在適用中の金額と改定後の金額を分けて掲載し、日給・月給・月給の時間額換算を計算できます。`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: '最低賃金計算・全国一覧',
  description, applicationCategory: 'UtilityApplication', operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
const faqItems = [
  { q: '2026年の最低賃金はいくらですか？', a: `現在適用中の地域別最低賃金は、最高${Math.max(...prefectures.map(r=>r.wage)).toLocaleString('ja-JP')}円から最低${Math.min(...prefectures.map(r=>r.wage)).toLocaleString('ja-JP')}円まで都道府県ごとに異なります。令和8年度は47都道府県の改正額と発効日を厚生労働省の全国一覧で確認済みです。新額は各発効日から適用されます。` },
  { q: '月給が最低賃金以上か計算する方法は？', a: '最低賃金の対象になる月給を12倍し、年間所定労働日数と1日の所定労働時間の積で割って時間額に換算します。通勤手当、家族手当、賞与、時間外・休日・深夜の割増賃金などは対象月給から除きます。' },
  { q: '2026年の最低賃金はいつから変わりますか？', a: '令和8年度の改正額と発効日は47都道府県について公表済みです。発効日は2026年10月1日から12月2日まで地域によって異なります。発効前は旧額、当日以降は新額を用います。' },
  { q: 'アルバイトや高校生にも最低賃金は適用されますか？', a: '原則として雇用形態や年齢にかかわらず、都道府県内で働くすべての労働者に適用されます。特定産業では地域別最低賃金より高い特定最低賃金が適用される場合があります。' },
];
---

<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 最低賃金</div>
    <h1>最低賃金 2026年｜全国47都道府県一覧・計算</h1><p>静的一覧の基準日：{asOfDate}。発効日以降の金額は各改正欄と計算器で確認してください。</p>
    <p>現在適用中の地域別最低賃金を調べ、日給・月給の目安や、実際の月給が最低賃金以上かを計算できます。</p>
  </div>

  <aside class="status-note" aria-label="令和8年度改定状況">
    <strong>47都道府県の改正額・発効日を公式全国一覧で確認済み</strong>
    <p>公式資料確認日：{WAGE_REVIEWED}。基準日{asOfDate}では{47 - pending.length}都道府県で新額が発効済みです。{pending.length > 0 && `未発効の${pending.map(row => row.prefecture).join('・')}は、それぞれの発効日まで旧額を表示します。`}計算器は日本時間の利用日で切り替えます。</p>
  </aside>

  <div class="calc-card"><MinimumWageCalculator /></div>
  <ResultShare />
  <div class="ad-slot"></div>

  <section class="howto">
    <h2>2026年現在の最低賃金 全国一覧</h2>
    <p>令和8年度改定後の全国加重平均は<strong>{NATIONAL_WEIGHTED_AVERAGE_2026.toLocaleString('ja-JP')}円</strong>です。これは47都道府県の改定後の集計で、各地域には別々の発効日があります。令和7年度の全国加重平均は{NATIONAL_WEIGHTED_AVERAGE.toLocaleString('ja-JP')}円です。</p>
    <div class="data-table-wrap"><div class="data-table-scroll">
      <table class="data-table wage-table">
        <thead><tr><th>都道府県</th><th>現在適用中</th><th>令和8年度の状況</th><th>現行額の発効日</th></tr></thead>
        <tbody>{prefectures.map((row) => {
          const [y, m, d] = row.effectiveDate.split('-').map(Number);
          const increase = ['saitama', 'chiba', 'tokyo', 'kanagawa', 'aichi', 'osaka'].includes(row.slug) ? 54 : 56;
          const revisionDate = row.revisionEffectiveDate
            ? row.revisionEffectiveDate.split('-').map(Number)
            : null;
          const revisionLabel = row.isRevisionEffective
            ? '改正額・適用中'
            : row.revisionStatus === 'decided'
            ? `改正決定・${revisionDate[1]}月${revisionDate[2]}日発効`
            : row.revisionStatus === 'answered' && revisionDate
            ? `地方答申・${revisionDate[1]}月${revisionDate[2]}日予定`
            : '地方答申・未発効';
          return <tr><th scope="row"><a href={`/saitei/${row.slug}/`}>{row.prefecture}</a></th><td class="num"><strong>{row.wage.toLocaleString('ja-JP')}円</strong></td><td class="num">{row.proposedWage ? <><strong>{row.proposedWage.toLocaleString('ja-JP')}円</strong><small>（{revisionLabel}）</small></> : <>+{increase}円（中央目安）</>}</td><td>{y}年{m}月{d}日</td></tr>;
        })}</tbody>
      </table>
    </div></div>
  </section>

  <section class="howto">
    <h2>月給が最低賃金以上か確認する計算方法</h2>
    <div class="formula">時間額 ＝（最低賃金の対象になる月給 × 12か月）÷（年間所定労働日数 × 1日の所定労働時間）</div>
    <p>厚生労働省の例では、対象月給18万円、年間250日、1日8時間の場合、18万円×12÷（250×8）＝<strong>1,080円</strong>です。この時間額と勤務地の最低賃金を比較します。</p>
    <h3>月給から除く賃金</h3>
    <ul>
      <li>精皆勤手当、通勤手当、家族手当</li>
      <li>臨時に支払われる賃金、1か月を超える期間ごとの賞与など</li>
      <li>時間外、休日、深夜労働の割増賃金部分</li>
    </ul>
    <p>派遣労働者は派遣元の所在地ではなく、派遣先の地域の最低賃金が基準です。産業によっては、地域別最低賃金より高い特定最低賃金が適用されます。</p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。個別の賃金項目や特定最低賃金の適用は、都道府県労働局または労働基準監督署に確認してください。</div>
  </section>

  <section class="howto">
    <h2>全国最低賃金の推移｜令和2〜7年度</h2>
    <p>全国加重平均は令和2年度の902円から令和7年度の1,121円へ、6年度分で219円上昇しました。都道府県別の推移は、一覧の地域名から各ページで確認できます。</p>
    <div class="data-table-wrap"><div class="data-table-scroll"><table class="data-table history-table">
      <thead><tr><th>年度</th><th>全国加重平均</th><th>前年度比</th></tr></thead>
      <tbody>{NATIONAL_WAGE_HISTORY.map((row, index) => <tr>
        <th scope="row">令和{row.fiscalYear - 2018}年度</th>
        <td class="num"><strong>{row.wage.toLocaleString('ja-JP')}円</strong></td>
        <td class="num">{index === 0 ? '―' : `+${row.wage - NATIONAL_WAGE_HISTORY[index - 1].wage}円`}</td>
      </tr>)}</tbody>
    </table></div></div>
  </section>

  <section class="howto sources">
    <h2>出典・改定状況</h2><p>公式全国一覧の確認日：{WAGE_REVIEWED}。</p>
    <ul>
      <li><a href={WAGE_SOURCE_2026} target="_blank" rel="noopener">厚生労働省「令和8年度地域別最低賃金全国一覧」金額・発効日</a></li>
      <li><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudoukijun/minimumichiran/index.html" target="_blank" rel="nofollow noopener">厚生労働省「地域別最低賃金の全国一覧」</a></li>
      <li><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudoukijun/chingin/newpage_43899.html" target="_blank" rel="nofollow noopener">厚生労働省「最低賃金額以上かどうかを確認する方法」</a></li>
      <li><a href="https://www.mhlw.go.jp/stf/newpage_74920.html" target="_blank" rel="nofollow noopener">厚生労働省「令和8年度地域別最低賃金額改定の目安について」（2026年7月28日）</a></li>
      <li><a href="https://saiteichingin.mhlw.go.jp/table/page_list_past.html" target="_blank" rel="nofollow noopener">厚生労働省「地域別最低賃金の全国一覧（過去5年分）」</a></li>
    </ul>
  </section>

  <RelatedTools current={slug} />
  <RelatedArticles toolSlug={slug} />
  <Faq items={faqItems} />
  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .status-note { margin-bottom: 20px; padding: 16px 18px; border-left: 4px solid var(--warning); border-radius: var(--r-sm); background: var(--warning-bg); }
  .status-note strong { color: var(--warning-text); }
  .status-note p { margin: 5px 0 0; font-size: .84rem; line-height: 1.7; }
  .wage-table { min-width: 650px; }
  .history-table { min-width: 480px; }
  .wage-table th[scope="row"] { text-align: left; }
  .history-table th[scope="row"] { text-align: left; }
  .wage-table a, .sources a { color: var(--cat-color); text-decoration: underline; text-underline-offset: 2px; }
  .formula { margin: 16px 0; padding: 16px; border-radius: var(--r-sm); color: var(--cat-color); background: var(--cat-tint); text-align: center; font-weight: var(--fw-bold); }
</style>
