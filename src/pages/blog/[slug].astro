---
import { getCollection, render } from 'astro:content';
import ToolLayout from '../../layouts/ToolLayout.astro';
import Faq from '../../components/Faq.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import RelatedToolsArticle from '../../components/RelatedToolsArticle.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getBlogCategory, getBlogCategoryColor } from '../../data/blog.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { id: slug, data, body } = post;
const { Content } = await render(post);
const cat = getBlogCategory(data.category);
const themeColor = getBlogCategoryColor(data.category);
const pageSlug = `blog/${slug}`;
const canonical = new URL(`/blog/${slug}/`, Astro.site).href;

const pubDate = new Date(data.pubDate);
const updatedDate = data.updatedDate ? new Date(data.updatedDate) : null;

function extractHeadings(markdown) {
  const lines = markdown.split('\n');
  const headings = [];
  let inCodeBlock = false;
  for (const line of lines) {
    if (line.trim().startsWith('```')) {
      inCodeBlock = !inCodeBlock;
      continue;
    }
    if (inCodeBlock) continue;
    const match = line.match(/^(#{2,4})\s+(.+)$/);
    if (match) {
      const depth = match[1].length;
      const text = match[2].trim().replace(/`([^`]+)`/g, '$1');
      const slug = text
        .toLowerCase()
        .replace(/[ぁ-んァ-ン一-龥々ーa-z0-9]/g, (m) => m)
        .replace(/\s+/g, '-')
        .replace(/[^\wぁ-んァ-ン一-龥々ー-]/g, '')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
      headings.push({ depth, text, slug: slug || text });
    }
  }
  return headings;
}

const headings = extractHeadings(body);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: { '@type': data.author === '計算ツール編集部' ? 'Organization' : 'Person', name: data.author },
  publisher: {
    '@type': 'Organization',
    name: '計算ツール',
    logo: { '@type': 'ImageObject', url: new URL('/og.png', Astro.site).href },
  },
  mainEntityOfPage: canonical,
  image: data.ogImage ? new URL(data.ogImage, Astro.site).href : new URL('/og.png', Astro.site).href,
  keywords: data.tags.join(', '),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'ブログ', item: new URL('/blog/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: cat?.name || data.category, item: new URL(`/blog/category/${data.category}/`, Astro.site).href },
    { '@type': 'ListItem', position: 4, name: data.title, item: canonical },
  ],
};

const themeStyle = `--cat-color:${themeColor.accent};--cat-tint:${themeColor.tint}`;
---
<ToolLayout title={`${data.title} | 計算ツール`} description={data.description} slug={pageSlug} current={data.category} jsonld={jsonld} breadcrumb={breadcrumb}>
  <article class="blog-article" style={themeStyle}>
    <div class="page-hero">
      <div class="crumb">
        <a href="/">ホーム</a> ／
        <a href="/blog/">ブログ</a> ／
        <a href={`/blog/category/${data.category}/`}>{cat?.name || data.category}</a> ／
        記事
      </div>
      <div class="blog-article__cats">
        {cat && (
          <span class="blog-article__cat">
            <span aria-hidden="true">{cat.icon}</span>{cat.name}
          </span>
        )}
      </div>
      <h1>{data.title}</h1>
      <p class="blog-article__desc">{data.description}</p>
      <AuthorBox name={data.author} date={pubDate} updatedDate={updatedDate} />
    </div>

    <div class="blog-article__card">
      {headings.length > 0 && <TableOfContents headings={headings} />}

      <div class="blog-article__body">
        <Content />
      </div>

      {data.tags.length > 0 && (
        <div class="blog-article__tags">
          <span class="blog-article__tags-label">タグ:</span>
          {data.tags.map((t) => (
            <span class="blog-article__tag">#{t}</span>
          ))}
        </div>
      )}

      <div class="blog-article__share">
        <ShareButtons title={data.title} url={canonical} />
      </div>

      <div class="blog-article__disclaimer">
        <strong>※</strong> 当サイトの情報は参考値であり、正確性を保証するものではありません。実際の手続きや判断は、税理士・社会保険労務士などの専門家、または役所の公式情報をご確認ください。
      </div>

      {data.sources.length > 0 && (
        <section class="blog-article__sources" aria-label="情報の出典">
          <h2>情報の出典</h2>
          <ul>
            {data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a></li>)}
          </ul>
        </section>
      )}
    </div>

    {data.relatedTools.length > 0 && (
      <RelatedToolsArticle slugs={data.relatedTools} />
    )}

    {data.faq.length > 0 && (
      <Faq items={data.faq} title="よくある質問" />
    )}

    <RelatedPosts current={slug} category={data.category} count={3} />
  </article>
</ToolLayout>

<style is:global>
  .blog-article { max-width: 880px; margin: 0 auto; }
  .blog-article__cats {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .blog-article__cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: var(--cat-tint);
    color: color-mix(in srgb, var(--cat-color) 62%, #000);
    font-size: .78rem;
    font-weight: var(--fw-bold);
    border-radius: var(--r-pill);
  }
  .blog-article__desc {
    font-size: .95rem;
    color: var(--text-3);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 20px !important;
  }
  .blog-article__card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--r-3xl);
    padding: 28px 24px;
    box-shadow: var(--shadow-card);
    margin-bottom: 24px;
  }
  @media (min-width: 681px) {
    .blog-article__card { padding: 36px 40px; }
  }

  .blog-article__body {
    color: var(--text);
    font-size: .95rem;
    line-height: 1.9;
  }
  .blog-article__body h2 {
    font-size: 1.25rem;
    font-weight: var(--fw-black);
    color: var(--text);
    margin: 36px 0 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--border-2);
    display: flex;
    align-items: center;
    gap: 10px;
    scroll-margin-top: 88px;
  }
  .blog-article__body h2::before {
    content: '';
    width: 6px;
    height: 1.2em;
    background: var(--cat-color);
    border-radius: 3px;
    flex: none;
  }
  .blog-article__body h3 {
    font-size: 1.08rem;
    font-weight: var(--fw-bold);
    color: var(--text);
    margin: 28px 0 12px;
    scroll-margin-top: 88px;
  }
  .blog-article__body h4 {
    font-size: 1rem;
    font-weight: var(--fw-bold);
    color: var(--text);
    margin: 20px 0 10px;
    scroll-margin-top: 88px;
  }
  .blog-article__body p {
    margin: 0 0 16px;
    color: var(--text-2);
  }
  .blog-article__body strong {
    color: var(--text);
    font-weight: var(--fw-bold);
  }
  .blog-article__body ul,
  .blog-article__body ol {
    margin: 0 0 18px;
    padding-left: 22px;
  }
  .blog-article__body li {
    margin-bottom: 8px;
    color: var(--text-2);
    line-height: 1.8;
  }
  .blog-article__body a {
    color: var(--cat-color);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-article__body a:hover {
    text-decoration-thickness: 2px;
  }
  .blog-article__body code {
    font-family: var(--font-mono);
    font-size: .88em;
    background: var(--surface-sub);
    padding: 2px 6px;
    border-radius: 6px;
    color: color-mix(in srgb, var(--cat-color) 70%, #000);
  }
  .blog-article__body pre {
    background: #0f172a;
    color: #e2e8f0;
    padding: 16px 20px;
    border-radius: var(--r-lg);
    overflow-x: auto;
    margin: 16px 0 20px;
    font-size: .88rem;
    line-height: 1.6;
  }
  .blog-article__body pre code {
    background: none;
    padding: 0;
    color: inherit;
  }
  .blog-article__body blockquote {
    border-left: 4px solid var(--cat-color);
    background: var(--cat-tint);
    padding: 14px 18px;
    margin: 18px 0;
    border-radius: 0 var(--r-md) var(--r-md) 0;
    color: var(--text-2);
  }
  .blog-article__sources {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .blog-article__sources h2 { font-size: 1rem; margin: 0 0 10px; }
  .blog-article__sources ul { margin: 0; padding-left: 20px; }
  .blog-article__body table {
    width: 100%;
    border-collapse: collapse;
    margin: 18px 0 22px;
    font-size: .9rem;
  }
  .blog-article__body th {
    background: var(--cat-tint);
    color: color-mix(in srgb, var(--cat-color) 62%, #000);
    padding: 12px 16px;
    text-align: left;
    font-weight: var(--fw-bold);
    border: 1px solid var(--border);
  }
  .blog-article__body td {
    padding: 12px 16px;
    border: 1px solid var(--border);
    color: var(--text-2);
  }
  .blog-article__body tr:nth-child(even) td {
    background: var(--surface-sub);
  }

  .blog-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1.5px solid var(--border-2);
  }
  .blog-article__tags-label {
    font-size: .8rem;
    font-weight: var(--fw-bold);
    color: var(--text-muted);
    flex: none;
  }
  .blog-article__tag {
    font-size: .8rem;
    color: var(--text-3);
    background: var(--surface-sub);
    padding: 5px 12px;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
  }

  .blog-article__share {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1.5px solid var(--border-2);
  }

  .blog-article__disclaimer {
    margin-top: 24px;
    padding: 16px 20px;
    background: var(--warning-bg);
    border: 1.5px solid var(--warning);
    border-radius: var(--r-lg);
    color: var(--warning-text2);
    font-size: .84rem;
    line-height: 1.7;
  }
  .blog-article__disclaimer strong {
    color: var(--warning-text2);
  }
</style>
