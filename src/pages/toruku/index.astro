---
import ToolLayout from '../../layouts/ToolLayout.astro';import RelatedTools from '../../components/RelatedTools.astro';import Faq from '../../components/Faq.astro';import ResultShare from '../../components/ResultShare.astro';
const slug='toruku',title='トルク計算・単位換算｜力×距離・モーター出力と回転数',description='力と腕の長さからトルクを計算。N·m・kgf·m・N·cm・lbf·ft換算、モーター出力・回転数・トルクの相互計算にも対応します。';
const jsonld={'@context':'https://schema.org','@type':'WebApplication',name:'トルク計算・単位換算ツール',description,applicationCategory:'UtilityApplication',operatingSystem:'Web',offers:{'@type':'Offer',price:'0',priceCurrency:'JPY'},featureList:['力と腕の長さからトルク計算','トルク単位換算','出力・回転数・トルクの相互計算']};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide><div class="page-hero"><div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ トルク計算</div><h1>トルク計算・単位換算ツール</h1><p>力×回転中心からの距離、またはモーター出力と回転数からトルクを計算します。</p><div class="chips"><span>N·m・kgf·m</span><span>T＝F×r</span><span>出力・rpm</span></div></div>
<div class="calc-card tool-card"><div class="tabs"><button class="tab active" data-mode="lever">力・腕の長さ</button><button class="tab" data-mode="motor">モーター</button><button class="tab" data-mode="convert">単位換算</button></div>
<section class="calc-panel panel active" data-panel="lever"><h2>力・腕の長さ・トルクを相互計算</h2><label>求める値<select id="l-target"><option value="torque">トルク</option><option value="force">力</option><option value="radius">腕の長さ</option></select></label><div class="grid"><label id="l-torque-wrap" hidden>トルク<div><input id="l-torque" value="50" type="number"><select id="l-torque-unit"><option value="N-m">N·m</option><option value="kgf-m">kgf·m</option></select></div></label><label id="l-force-wrap">力<div><input id="l-force" value="100" type="number"><select id="l-force-unit"><option>N</option><option>kN</option><option>kgf</option></select></div></label><label id="l-radius-wrap">回転中心からの距離<div><input id="l-radius" value="0.5" type="number"><select id="l-radius-unit"><option>m</option><option>cm</option><option>mm</option></select></div></label></div><p id="l-error" class="error" hidden>表示中の2項目に0より大きい数値を入力してください。</p><div id="l-result" class="result"><span>トルク</span><strong id="l-main">50 N·m</strong><small id="l-sub"></small></div></section>
<section class="calc-panel panel" data-panel="motor"><h2>出力・回転数・トルクを相互計算</h2><label>求める値<select id="m-target"><option value="torque">トルク</option><option value="power">出力</option><option value="rpm">回転数</option></select></label><div class="grid"><label id="m-torque-wrap" hidden>トルク（N·m）<input id="m-torque" value="6.3662" type="number"></label><label id="m-power-wrap">出力<div><input id="m-power" value="1" type="number"><select id="m-power-unit"><option value="kW">kW</option><option value="W">W</option></select></div></label><label id="m-rpm-wrap">回転数（rpm）<input id="m-rpm" value="1500" type="number"></label></div><p id="m-error" class="error" hidden>表示中の2項目に0より大きい数値を入力してください。</p><div id="m-result" class="result"><span>トルク</span><strong id="m-main">—</strong><small id="m-sub"></small></div><p class="note">損失を含まない軸出力の理論関係です。モーター選定では効率、始動・加速トルク、使用率を別途確認してください。</p></section>
<section class="calc-panel panel" data-panel="convert"><h2>トルク単位を一括換算</h2><div class="grid"><label>トルク<input id="c-value" value="1" type="number"></label><label>変換元<select id="c-unit"><option value="N-m">N·m</option><option value="N-cm">N·cm</option><option value="kgf-m">kgf·m</option><option value="kgf-cm">kgf·cm</option><option value="lbf-ft">lbf·ft</option></select></label></div><div class="values" id="c-values"></div></section></div><ResultShare/><div class="ad-slot"></div>
<section class="howto"><h2>トルクの計算式 T＝F×r</h2><p>トルクは力Fと、回転中心から力の作用線までの垂直距離rの積です。100Nを0.5mの位置で直角に加えると50N·mです。斜めに加える場合は垂直成分を使う必要があります。</p><div class="formula"><div><strong>T＝F×r</strong><span>トルク</span></div><div><strong>F＝T÷r</strong><span>力</span></div><div><strong>r＝T÷F</strong><span>腕の長さ</span></div></div></section>
<section class="howto"><h2>モーターのトルク・出力・回転数</h2><p>角速度ω＝2πn÷60より、出力P＝T×ωです。1kW・1,500rpmなら約6.366N·mになります。これは定常時の理論関係で、減速機の効率や加速に必要なトルクは含みません。歯数から減速比、出力回転数、効率を考慮した出力トルクを求める場合は<a href="/gear-hi/">ギア比・減速比計算ツール</a>を利用できます。</p><ul><li>ボルトの締付トルクは材質、径、強度区分、摩擦、潤滑で変わります。メーカー規定値に従ってください。</li><li>直線方向の力と変位、ばねの合成を求める場合は<a href="/bane-teisuu/">ばね定数・荷重計算ツール</a>を利用できます。</li><li>kgf系は旧仕様との照合用です。設計ではSIのN·mを基本にしてください。</li><li>電力や電気料金は<a href="/denki-dai/">電気代・消費電力計算</a>、抵抗と電流は<a href="/teikou/">オームの法則計算</a>で確認できます。</li></ul></section>
<section class="howto source-box"><h2>計算根拠</h2><ul><li><a href="https://koushien.jst.go.jp/koushien/pastexam/2014/files/4-4.A-jitsugi03.pdf" target="_blank" rel="noopener noreferrer">JST「科学の甲子園 実技競技解説」</a>：力×距離とN·m。</li><li><a href="https://www.nmri.go.jp/archives/eng/khirata/list/others/design2007.pdf" target="_blank" rel="noopener noreferrer">海上技術安全研究所「強度設計」</a>：回転数・トルク・動力の関係。</li></ul><div class="disclaimer">※ 計算結果はあくまで参考値です。機械・車両・締結部の設計や整備は、メーカー仕様と安全率を専門家が確認してください。</div></section><RelatedTools current={slug}/><Faq items={[{q:'トルクの計算式は？',a:'力が腕に直角ならT＝F×rです。'},{q:'1kgf·mは何N·mですか？',a:'標準重力加速度を用いると9.80665N·mです。'},{q:'kWとrpmからトルクを求めるには？',a:'T＝P×60÷(2πn)で求めます。PはW、nはrpmです。'},{q:'締付トルクも計算できますか？',a:'一般式だけでは安全に決められません。メーカー規定値を使ってください。'},{q:'N·mとN/mは同じですか？',a:'違います。N·mはトルク、N/mは単位長さ当たりの力などを表します。'}]}/><div class="ad-slot"></div></ToolLayout>
<style>.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.chips span{padding:5px 10px;border-radius:999px;background:var(--cat-tint);color:var(--cat-color);font-size:.75rem;font-weight:700}.tool-card{overflow:hidden}.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface-sub)}.tab{padding:15px 4px;border:0;border-bottom:3px solid transparent;background:none;font-weight:700}.tab.active{background:var(--surface);color:var(--cat-color);border-color:var(--cat-color)}.panel{padding:24px}.panel:not(.active){display:none}.panel h2{margin-top:0;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}.grid label{display:flex;flex-direction:column;gap:7px;font-size:.8rem;font-weight:700}.grid label>div{display:grid;grid-template-columns:1fr 90px;gap:7px}.grid input,.grid select{min-width:0;width:100%}.result{display:flex;flex-direction:column;align-items:center;gap:5px;margin-top:20px;padding:20px;background:var(--cat-tint);border-radius:var(--r-md)}.result strong{font:700 clamp(1.8rem,6vw,2.8rem) var(--font-mono);color:var(--cat-color)}.note,.result small{color:var(--text-muted)}.error{padding:10px;background:var(--danger-bg);color:var(--danger)}.values,.formula{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.values div,.formula div{display:flex;flex-direction:column;padding:13px;border:1px solid var(--border-2);background:var(--surface-sub);border-radius:var(--r-md)}.values strong,.formula strong{font-family:var(--font-mono);color:var(--cat-color)}@media(max-width:650px){.grid,.values,.formula{grid-template-columns:1fr 1fr}}@media(max-width:480px){.panel{padding:18px}.grid,.values,.formula{grid-template-columns:1fr}.tab{font-size:.72rem}}</style>
<script>import{convertTorque,solveLeverTorque,solveMotorTorque}from'../../lib/toruku.js';const $=id=>document.getElementById(id),fmt=n=>Number(n.toPrecision(8)).toLocaleString('ja-JP',{maximumFractionDigits:12});let mode='lever';function rl(){const t=$('l-target').value;$('l-torque-wrap').hidden=t==='torque';$('l-force-wrap').hidden=t==='force';$('l-radius-wrap').hidden=t==='radius';const r=solveLeverTorque({target:t,torque:$('l-torque').value,torqueUnit:$('l-torque-unit').value,force:$('l-force').value,forceUnit:$('l-force-unit').value,radius:$('l-radius').value,radiusUnit:$('l-radius-unit').value});$('l-error').hidden=!!r;$('l-result').hidden=!r;if(!r)return;const main=t==='torque'?`${fmt(r.torqueNm)} N·m`:t==='force'?`${fmt(r.forceN)} N`:`${fmt(r.radiusM)} m`;$('l-main').textContent=main;$('l-result').querySelector('span').textContent={torque:'トルク',force:'力',radius:'腕の長さ'}[t];$('l-sub').textContent=`${fmt(r.torqueNm/9.80665)} kgf·m・${fmt(r.forceN)} N・${fmt(r.radiusM*100)} cm`;if(mode==='lever')window.setResultShare?.(`トルク計算\n${main}`)}function rm(){const t=$('m-target').value;$('m-torque-wrap').hidden=t==='torque';$('m-power-wrap').hidden=t==='power';$('m-rpm-wrap').hidden=t==='rpm';const r=solveMotorTorque({target:t,torque:$('m-torque').value,power:$('m-power').value,powerUnit:$('m-power-unit').value,rpm:$('m-rpm').value});$('m-error').hidden=!!r;$('m-result').hidden=!r;if(!r)return;const main=t==='torque'?`${fmt(r.torqueNm)} N·m`:t==='power'?`${fmt(r.powerW/1000)} kW`:`${fmt(r.rpm)} rpm`;$('m-main').textContent=main;$('m-result').querySelector('span').textContent={torque:'トルク',power:'出力',rpm:'回転数'}[t];$('m-sub').textContent=`${fmt(r.torqueNm)} N·m・${fmt(r.powerW)} W・${fmt(r.rpm)} rpm`;if(mode==='motor')window.setResultShare?.(`モータートルク計算\n${main}`)}function rc(){const units=['N-m','N-cm','kgf-m','kgf-cm','lbf-ft'],labels={'N-m':'N·m','N-cm':'N·cm','kgf-m':'kgf·m','kgf-cm':'kgf·cm','lbf-ft':'lbf·ft'},v=$('c-value').value,u=$('c-unit').value;$('c-values').innerHTML=units.map(x=>`<div><span>${labels[x]}</span><strong>${convertTorque(v,u,x)===null?'—':fmt(convertTorque(v,u,x))}</strong></div>`).join('')}document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.dataset.panel===mode));({lever:rl,motor:rm,convert:rc})[mode]()}));document.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',()=>{rl();rm();rc()}));rl();rm();rc();</script>
