---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';
import { TIMEZONES } from '../../lib/jisa.js';

const slug = 'jisa';
const title = '時差計算器 — 世界の都市との時差をリアルタイム表示 | 計算ツール';
const description =
  '東京と世界25都市の時差を、現在時刻とともにリアルタイムで表示する無料ツール。ニューヨーク・ロンドン・ハワイ・バンコクなど主要都市に対応。夏時間（サマータイム）も自動反映。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '時差計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};

const defaultTz1 = 'Asia/Tokyo';
const defaultTz2 = 'America/New_York';
---

<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ 時差計算</div>
    <h1>時差計算器</h1>
    <p>2つの都市を選ぶと、現在時刻と時差をリアルタイムで表示します。夏時間（サマータイム）も自動で反映されます。</p>
  </div>

  <div class="calc-card jisa-card">
    <div class="jisa-pickers">
      <div class="jisa-pick">
        <label class="jisa-label" for="tz1">地域 1</label>
        <select id="tz1" class="jisa-select">
          {TIMEZONES.map((tz) => (
            <option value={tz.id} selected={tz.id === defaultTz1}>{tz.label}</option>
          ))}
        </select>
      </div>
      <button id="swap" class="swap-btn" title="入れ替え">⇄</button>
      <div class="jisa-pick">
        <label class="jisa-label" for="tz2">地域 2</label>
        <select id="tz2" class="jisa-select">
          {TIMEZONES.map((tz) => (
            <option value={tz.id} selected={tz.id === defaultTz2}>{tz.label}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="result-grid jisa-results">
      <div class="result-card jisa-result jisa-result--1">
        <div class="result-card__head">
          <span class="result-card__swatch jisa-swatch1"></span>
          <span class="result-card__label" id="cardLabel1">地域 1</span>
        </div>
        <div class="jisa-time" id="time1">--:--:--</div>
        <div class="jisa-date" id="date1">----/--/--</div>
      </div>

      <div class="result-card jisa-result jisa-result--2">
        <div class="result-card__head">
          <span class="result-card__swatch jisa-swatch2"></span>
          <span class="result-card__label" id="cardLabel2">地域 2</span>
        </div>
        <div class="jisa-time" id="time2">--:--:--</div>
        <div class="jisa-date" id="date2">----/--/--</div>
      </div>
    </div>

    <div class="jisa-diffbar">
      <span class="jisa-diff" id="diff">--</span>
      <span class="jisa-diff-label">時差</span>
    </div>

    <div class="jisa-summary" id="summary"></div>
  </div>

  <div class="calc-card convert-card">
    <h2 class="convert-title">日時を指定して変換</h2>
    <p class="convert-desc">日時を入力すると、その瞬間が上で選んだ2つの地域では何時になるかを表示します。「日本の明日9時はニューヨークでは何時？」もこれで分かります。</p>
    <div class="convert-input-row">
      <label class="jisa-label" for="convDt">基準の日時（<span id="convBaseLabel">地域 1</span>）</label>
      <input type="datetime-local" id="convDt" class="conv-input" />
    </div>
    <div class="convert-results">
      <div class="convert-result">
        <div class="convert-region" id="convLabel1">地域 1</div>
        <div class="convert-when" id="conv1">--</div>
      </div>
      <div class="convert-result">
        <div class="convert-region" id="convLabel2">地域 2</div>
        <div class="convert-when" id="conv2">--</div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <p>上の2つのドロップダウンから都市を選ぶと、それぞれの現在時刻と時差が自動的に表示されます。時刻は1秒ごとに更新されます。</p>
    <ul>
      <li><strong>⇄ ボタン</strong>：2つの都市を入れ替えます。</li>
      <li><strong>夏時間（サマータイム）</strong>：各国の現地ルールに従い、自動で反映されます。</li>
      <li><strong>インドなど30分・45分刻みの時差</strong>：小数点の時差も正確に表示します。</li>
    </ul>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。重要な用途には各国の公式情報をご確認ください。</div>
  </section>

  <RelatedTools current={slug} />

  <Faq items={[
    { q: '時差はどう計算しますか？', a: '2つの都市のタイムゾーンの差から計算します。本ツールは現在時刻と時差をリアルタイムで表示し、サマータイム（夏時間）も自動反映します。' },
    { q: '任意の日時で変換できますか？', a: 'はい。基準の日時を入力すると、相手の都市では何時になるかを表示します（夏時間も考慮）。' },
    { q: 'サマータイムは考慮されますか？', a: 'はい。各都市の夏時間の有無を自動判定して計算します。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
.jisa-card { max-width: 540px; padding: 24px; }

/* 都市セレクタ行 */
.jisa-pickers {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 12px;
  align-items: end;
  margin-bottom: 18px;
}
.jisa-pick { display: flex; flex-direction: column; gap: 6px; }
.jisa-label { font-size: .78rem; font-weight: var(--fw-bold); color: var(--text-muted); }
.jisa-select {
  width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid var(--border-input);
  border-radius: var(--r-md); font-size: .9rem; font-family: var(--font-sans);
  color: var(--text); background: var(--surface); cursor: pointer;
}
.jisa-select:focus { outline: none; border-color: var(--cat-color); }
.swap-btn {
  background: var(--cat-tint); border: 1px solid var(--border-input);
  border-radius: var(--r-pill); width: 44px; height: 44px; font-size: 1.1rem;
  cursor: pointer; color: var(--cat-color); transition: background var(--ease), color var(--ease);
  margin-bottom: 2px;
  display: flex; align-items: center; justify-content: center; flex: none;
}
.swap-btn:hover { background: var(--cat-color); color: #fff; }

/* 結果カード（E：多結果並べ） */
.jisa-result { align-items: flex-start; }
.jisa-result .result-card__label { color: var(--text); }
.jisa-swatch1 { background: var(--cat-color); border-color: var(--cat-color); }
.jisa-swatch2 { background: var(--cat-life); border-color: var(--cat-life); }
.jisa-time {
  font-family: var(--font-mono); font-size: 2rem; font-weight: var(--fw-bold);
  color: var(--text); line-height: 1;
}
.jisa-date { font-size: .8rem; color: var(--text-muted); }

/* 時差バー */
.jisa-diffbar {
  display: flex; align-items: baseline; justify-content: center; gap: 8px;
  margin-top: 16px;
}
.jisa-diff {
  font-family: var(--font-mono); font-size: 1.6rem; font-weight: var(--fw-bold);
  color: var(--cat-color); line-height: 1;
}
.jisa-diff-label { font-size: .72rem; color: var(--text-muted); }
.jisa-summary {
  margin-top: 14px; padding-top: 16px; border-top: 1px solid var(--border-2);
  font-size: .84rem; color: var(--text-muted); text-align: center;
  min-height: 1.4em;
}
@media (max-width: 480px) {
  .jisa-pickers { grid-template-columns: 1fr; }
  .swap-btn { justify-self: center; margin: 2px 0; }
  .jisa-time { font-size: 1.7rem; }
}

.convert-card { max-width: 540px; padding: 24px; margin-top: 20px; }
.convert-title { font-size: 1.05rem; font-weight: var(--fw-bold); color: var(--text); margin: 0 0 6px; }
.convert-desc { font-size: .82rem; color: var(--text-muted); margin: 0 0 16px; line-height: 1.6; }
.convert-input-row { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
.conv-input {
  width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid var(--border-input);
  border-radius: var(--r-md); font-size: .95rem; font-family: var(--font-mono);
  color: var(--text); background: var(--surface);
}
.conv-input:focus { outline: none; border-color: var(--cat-color); }
.convert-results { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.convert-result {
  background: var(--surface-sub); border: 1px solid var(--border-2);
  border-radius: var(--r-md); padding: 14px; text-align: center;
}
.convert-region { font-size: .76rem; font-weight: var(--fw-bold); color: var(--text-muted); margin-bottom: 8px; }
.convert-when { font-family: var(--font-mono); font-size: 1rem; font-weight: var(--fw-bold); color: var(--text); line-height: 1.4; }
@media (max-width: 420px) {
  .convert-results { grid-template-columns: 1fr; }
}
</style>

<script>
  import { TIMEZONES, getDiffHours, formatDiff, convertWallClock } from '../../lib/jisa.js';

  const $ = (id) => document.getElementById(id);
  const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
  const labelOf = (id) => TIMEZONES.find((t) => t.id === id)?.label ?? id;

  function formatTime(tzId) {
    const now = new Date();
    const opts = { timeZone: tzId, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
    return new Intl.DateTimeFormat('ja-JP', opts).format(now);
  }

  function formatDate(tzId) {
    const now = new Date();
    const opts = { timeZone: tzId, year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short' };
    const parts = new Intl.DateTimeFormat('ja-JP', opts).formatToParts(now);
    const p = Object.fromEntries(parts.map((x) => [x.type, x.value]));
    const weekday = WEEKDAYS[new Date(now.toLocaleString('en-US', { timeZone: tzId })).getDay()];
    return `${p.year}/${p.month}/${p.day}（${weekday}）`;
  }

  function update() {
    const tz1 = $('tz1').value;
    const tz2 = $('tz2').value;
    const now = new Date();

    $('time1').textContent = formatTime(tz1);
    $('date1').textContent = formatDate(tz1);
    $('time2').textContent = formatTime(tz2);
    $('date2').textContent = formatDate(tz2);

    const diff = getDiffHours(tz1, tz2, now);
    const absDiff = Math.abs(diff);
    const h = Math.floor(absDiff);
    const m = Math.round((absDiff - h) * 60);
    $('diff').textContent = m === 0 ? `${diff >= 0 ? '+' : '-'}${h}h` : `${diff >= 0 ? '+' : '-'}${h}h${m}m`;

    const label1 = TIMEZONES.find((t) => t.id === tz1)?.label ?? tz1;
    const label2 = TIMEZONES.find((t) => t.id === tz2)?.label ?? tz2;
    $('cardLabel1').textContent = label1;
    $('cardLabel2').textContent = label2;
    if (diff === 0) {
      $('summary').textContent = `${label1} と ${label2} は同じ時刻です。`;
    } else {
      const direction = diff > 0 ? `${label1} は ${label2} より${formatDiff(diff)}` : `${label1} は ${label2} より${formatDiff(diff)}`;
      $('summary').textContent = direction;
    }

    // 結果シェア：DOM に表示済みの時刻・時差を要約（毎秒の update でも内容を更新）
    window.setResultShare?.(
      `時差計算\n${label1}：${$('time1').textContent}\n${label2}：${$('time2').textContent}\n時差：${$('diff').textContent}`
    );
  }

  // ===== 任意の日時を変換 =====
  function pad(n) { return String(n).padStart(2, '0'); }

  function fmtWhen(tzId, wall) {
    const w = WeekdayHelper(tzId, wall);
    return `${wall.year}/${pad(wall.month)}/${pad(wall.day)}（${w}） ${pad(wall.hour)}:${pad(wall.minute)}`;
  }

  // 変換後の壁時計成分から曜日を求める。
  function WeekdayHelper(tzId, wall) {
    // UTC として日付オブジェクトを作り getUTCDay で曜日を得る（壁時計成分そのものの曜日）。
    const d = new Date(Date.UTC(wall.year, wall.month - 1, wall.day, wall.hour, wall.minute));
    return WEEKDAYS[d.getUTCDay()];
  }

  function setDefaultDt() {
    // 基準地域（tz1）の現在の壁時計時刻を datetime-local に入れる。
    const tz1 = $('tz1').value;
    const opts = { timeZone: tz1, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false };
    const parts = new Intl.DateTimeFormat('en-US', opts).formatToParts(new Date());
    const p = Object.fromEntries(parts.map((x) => [x.type, x.value]));
    let hh = p.hour === '24' ? '00' : p.hour;
    $('convDt').value = `${p.year}-${p.month}-${p.day}T${hh}:${p.minute}`;
  }

  function updateConvert() {
    const tz1 = $('tz1').value;
    const tz2 = $('tz2').value;
    $('convBaseLabel').textContent = labelOf(tz1);
    $('convLabel1').textContent = labelOf(tz1);
    $('convLabel2').textContent = labelOf(tz2);

    const v = $('convDt').value;
    if (!v) { $('conv1').textContent = '--'; $('conv2').textContent = '--'; return; }
    const [datePart, timePart] = v.split('T');
    const [year, month, day] = datePart.split('-').map(Number);
    const [hour, minute] = timePart.split(':').map(Number);
    const wall = { year, month, day, hour, minute };

    // 地域1 は入力そのもの（基準）。地域2 は変換。
    $('conv1').textContent = fmtWhen(tz1, wall);
    const w2 = convertWallClock(tz1, tz2, wall);
    $('conv2').textContent = fmtWhen(tz2, w2);
  }

  $('tz1').addEventListener('change', () => { update(); updateConvert(); });
  $('tz2').addEventListener('change', () => { update(); updateConvert(); });
  $('convDt').addEventListener('input', updateConvert);
  $('swap').addEventListener('click', () => {
    const tmp = $('tz1').value;
    $('tz1').value = $('tz2').value;
    $('tz2').value = tmp;
    update();
    updateConvert();
  });

  update();
  setInterval(update, 1000);
  setDefaultDt();
  updateConvert();
</script>
