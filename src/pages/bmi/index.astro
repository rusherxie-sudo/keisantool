---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'bmi';
const title = 'BMI計算ツール｜女性・男性の標準体重・肥満度・体脂肪率';
const description =
  '身長・体重からBMI、肥満度、BMI22の標準体重を無料計算。年齢を入力すると、厚生労働省「日本人の食事摂取基準（2025年版）」の年齢別目標BMI・目標体重範囲と、女性・男性別の推定体脂肪率も表示します。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'BMI計算ツール（女性・男性）',
  description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/kenko/">健康・身体</a> ／ BMI計算</div>
    <h1>BMI計算ツール（女性・男性）</h1>
    <p>身長・体重からBMI、肥満度、標準体重を自動計算。年齢別の目標BMI・目標体重範囲と、女性・男性別の推定体脂肪率も確認できます。</p>
  </div>

  <div class="calc-card">
    <div class="calc-panel active" id="panel-bmi">
      <div class="form-group">
        <label for="bmi-height">身長（cm）</label>
        <input type="number" id="bmi-height" inputmode="decimal" placeholder="例：160" />
      </div>
      <div class="form-group">
        <label for="bmi-weight">体重（kg）</label>
        <input type="number" id="bmi-weight" inputmode="decimal" placeholder="例：55" />
      </div>
      <div class="form-group">
        <label for="bmi-age">年齢（歳）<span class="optional">任意</span></label>
        <input type="number" id="bmi-age" inputmode="numeric" min="1" max="120" placeholder="例：30" />
      </div>
      <div class="radio-group">
        <input type="radio" name="bmi-gender" id="bmi-female" value="female" checked />
        <label for="bmi-female">女性</label>
        <input type="radio" name="bmi-gender" id="bmi-male" value="male" />
        <label for="bmi-male">男性</label>
      </div>

      <div class="result-box" id="bmi-result">
        <div class="result-label">あなたのBMI</div>
        <div class="result-main" id="bmi-value">0.0</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">判定</span><span class="value" id="bmi-category">−</span></div>
          <div class="result-row"><span class="label">標準体重（BMI22）</span><span class="value green" id="bmi-standard">−</span></div>
          <div class="result-row"><span class="label">体脂肪率（推定）</span><span class="value red" id="bmi-bodyfat">−</span></div>
        </div>

        <div class="target-block" id="bmi-target-block">
          <div class="target-title">年齢別の目標BMI・体重（2025年版）</div>
          <div class="target-rows">
            <div class="result-row"><span class="label">目標BMI</span><span class="value" id="bmi-target-bmi">年齢を入力</span></div>
            <div class="result-row"><span class="label">目標体重範囲</span><span class="value" id="bmi-target-range">年齢を入力</span></div>
            <div class="result-row"><span class="label">標準体重（BMI22）</span><span class="value green" id="bmi-target-standard">−</span></div>
          </div>
          <p class="age-note" id="bmi-age-note">18歳以上は年齢を入力すると、厚生労働省の年齢別目標を表示します。</p>
          <div class="target-diff" id="bmi-target-diff">標準体重まであと − kg</div>
        </div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>BMIの計算方法と肥満度の基準値</h2>
    <p>
      BMI（ボディマス指数）は、体重と身長から算出する肥満度の国際的な指標です。計算式は
      <strong>BMI＝体重(kg)÷(身長(m)×身長(m))</strong>。身長はcmではなくm（メートル）に直して計算するため、本ツールでは入力されたcmを自動で100で割って算出します。
    </p>
    <p>
      日本肥満学会の基準では、成人のBMIを次のように判定します。BMI22を基準にした体重は「標準体重」と呼ばれ、<strong>標準体重＝身長(m)×身長(m)×22</strong>で計算します。
    </p>
    <ul>
      <li><strong>18.5未満</strong>：低体重（やせ）</li>
      <li><strong>18.5〜25未満</strong>：普通体重</li>
      <li><strong>25〜30未満</strong>：肥満（1度）</li>
      <li><strong>30〜35未満</strong>：肥満（2度）</li>
      <li><strong>35〜40未満</strong>：肥満（3度）</li>
      <li><strong>40以上</strong>：肥満（4度）</li>
    </ul>
    <h2>年齢別の目標BMI（2025年版）</h2>
    <p>
      厚生労働省「日本人の食事摂取基準（2025年版）」では、成人が目標とするBMIの範囲を年齢別に示しています。男女共通の範囲で、肥満度の判定区分とは目的が異なります。
    </p>
    <table class="bmi-table">
      <thead><tr><th>年齢</th><th>目標BMI</th></tr></thead>
      <tbody>
        <tr><td>18〜49歳</td><td>18.5〜24.9</td></tr>
        <tr><td>50〜64歳</td><td>20.0〜24.9</td></tr>
        <tr><td>65歳以上</td><td>21.5〜24.9</td></tr>
      </tbody>
    </table>
    <p>18歳未満は成長段階にあり、成人用BMIだけでは適切に判定できないため、本ツールでは年齢別目標と推定体脂肪率を表示しません。</p>
    <h2>女性・男性の推定体脂肪率について</h2>
    <p>
      体脂肪率は成人向けのDeurenberg式による概算値です。<strong>体脂肪率＝1.2×BMI＋0.23×年齢−5.4−10.8×性別係数（男性=1・女性=0）</strong>で求めます。原論文では推定誤差が示されており、肥満者では高めに推定される傾向もあるため、体組成計の実測値とは差が出ます。
    </p>
    <p class="sources">
      出典：<a href="https://kennet.mhlw.go.jp/information/information/dictionary/metabolic/ym-002" target="_blank" rel="noopener noreferrer">厚生労働省 e-ヘルスネット「BMI」</a>、
      <a href="https://kennet.mhlw.go.jp/information/information/food/e-02-009.html" target="_blank" rel="noopener noreferrer">厚生労働省「適正体重を維持しよう」</a>、
      <a href="https://pubmed.ncbi.nlm.nih.gov/2043597/" target="_blank" rel="noopener noreferrer">Deurenberg et al. (1991)</a>
    </p>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。健康状態の判断・診断は医療機関にご相談ください。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: 'BMIの計算式は？', a: 'BMI＝体重(kg)÷(身長(m)×身長(m))で求めます。例えば170cm・65kgなら約22.5です。' },
    { q: '標準体重はBMIいくつですか？', a: '標準体重はBMI22を基準に、身長(m)×身長(m)×22で計算します。年齢別の目標BMI範囲とは意味が異なります。' },
    { q: '女性と男性でBMIの計算方法は違いますか？', a: 'BMIの計算式と成人の肥満度判定は女性・男性で共通です。本ツールの推定体脂肪率は性別係数を使うため結果が異なります。' },
    { q: '年齢によって目標BMIは変わりますか？', a: '厚生労働省の2025年版基準では、18〜49歳は18.5〜24.9、50〜64歳は20.0〜24.9、65歳以上は21.5〜24.9が目標範囲です。' },
    { q: '子どものBMIも判定できますか？', a: '18歳未満は成長段階にあり、成人用BMIだけでは適切に判定できません。本ツールでは成人向けの年齢別目標と推定体脂肪率を表示しません。' },
    { q: '体脂肪率も計算できますか？', a: '18歳以上はBMI・年齢・性別からDeurenberg式による推定値を表示します。実測値ではなく参考値です。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .target-block {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed color-mix(in srgb, var(--cat-color) 22%, transparent);
  }
  .target-title {
    font-weight: var(--fw-bold);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--text-3);
  }
  .optional {
    margin-left: 0.45rem;
    font-size: 0.75rem;
    font-weight: var(--fw-normal);
    color: var(--text-3);
  }
  .age-note {
    margin: 0.65rem 0 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-3);
  }
  .target-diff {
    margin-top: 0.75rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-md);
    background: var(--surface-sub);
    font-weight: var(--fw-bold);
    text-align: center;
    color: var(--text);
  }
  .target-diff.lose { background: var(--danger-bg); color: var(--danger); }
  .target-diff.gain { background: var(--cat-tint); color: color-mix(in srgb, var(--cat-color) 62%, #000); }
  .target-diff.ok   { background: color-mix(in srgb, var(--success) 12%, var(--surface)); color: var(--success); }
  .bmi-table { width: 100%; border-collapse: collapse; margin: 0.75rem 0 1rem; }
  .bmi-table th, .bmi-table td { padding: 0.65rem; border: 1px solid var(--border); text-align: center; }
  .bmi-table th { background: var(--surface-sub); }
  .sources { font-size: 0.85rem; color: var(--text-3); }
</style>

<script>
  import { calcBmi, bmiCategory, standardWeight, bodyFatPercent, ageTargetBmi, ageTargetWeightRange, weightDiff } from '../../lib/bmi.js';

  const $ = (id) => document.getElementById(id);
  const gender = () =>
    document.querySelector('input[name="bmi-gender"]:checked').value;

  function shareSummary() {
    return [
      'BMI計算ツール',
      'BMI：' + $('bmi-value').textContent,
      '判定：' + $('bmi-category').textContent,
      '標準体重：' + $('bmi-standard').textContent,
      '体脂肪率：' + $('bmi-bodyfat').textContent,
    ].join('\n');
  }

  function render() {
    const bmi = calcBmi($('bmi-height').value, $('bmi-weight').value);
    const box = $('bmi-result');

    if (bmi === null) {
      box.classList.remove('visible');
      window.hideResultShare?.();
      return;
    }
    box.classList.add('visible');

    $('bmi-value').textContent = bmi.toFixed(1);
    const ageValue = $('bmi-age').value;
    const age = ageValue === '' ? null : Number(ageValue);
    const isChild = Number.isFinite(age) && age < 18;
    $('bmi-category').textContent = isChild ? '成人基準の対象外' : (bmiCategory(bmi) ?? '−');

    const std = standardWeight($('bmi-height').value);
    $('bmi-standard').textContent = std === null ? '−' : std.toFixed(1) + ' kg';

    const fat = bodyFatPercent(bmi, ageValue, gender());
    $('bmi-bodyfat').textContent = isChild ? '成人のみ' : (fat === null ? '年齢を入力' : fat.toFixed(1) + ' %');

    // 厚生労働省「日本人の食事摂取基準（2025年版）」の年齢別目標
    const target = ageTargetBmi(ageValue);
    const range = ageTargetWeightRange($('bmi-height').value, ageValue);
    const diffEl = $('bmi-target-diff');
    $('bmi-target-standard').textContent = std === null ? '−' : std.toFixed(1) + ' kg';

    if (target && range) {
      $('bmi-target-bmi').textContent = target.min.toFixed(1) + ' 〜 ' + target.max.toFixed(1) + '（' + target.label + '）';
      $('bmi-target-range').textContent = range.min.toFixed(1) + ' 〜 ' + range.max.toFixed(1) + ' kg';
      $('bmi-age-note').textContent = '厚生労働省「日本人の食事摂取基準（2025年版）」の男女共通目標です。';
    } else if (isChild) {
      $('bmi-target-bmi').textContent = '成人基準の対象外';
      $('bmi-target-range').textContent = '成人基準の対象外';
      $('bmi-age-note').textContent = '18歳未満は成長段階のため、成人用BMIだけでは適切に判定できません。';
    } else {
      $('bmi-target-bmi').textContent = '年齢を入力';
      $('bmi-target-range').textContent = '年齢を入力';
      $('bmi-age-note').textContent = '18歳以上は年齢を入力すると、厚生労働省の年齢別目標を表示します。';
    }

    const diff = weightDiff($('bmi-weight').value, std);
    if (diff === null) {
      diffEl.textContent = '標準体重まであと − kg';
      diffEl.className = 'target-diff';
    } else if (diff > 0) {
      diffEl.textContent = '標準体重まであと −' + diff.toFixed(1) + ' kg（減量）';
      diffEl.className = 'target-diff lose';
    } else if (diff < 0) {
      diffEl.textContent = '標準体重まであと +' + Math.abs(diff).toFixed(1) + ' kg（増量）';
      diffEl.className = 'target-diff gain';
    } else {
      diffEl.textContent = 'ちょうど標準体重です';
      diffEl.className = 'target-diff ok';
    }

    window.setResultShare?.(shareSummary());
  }

  ['bmi-height', 'bmi-weight', 'bmi-age'].forEach((id) =>
    $(id).addEventListener('input', render)
  );
  document
    .querySelectorAll('input[name="bmi-gender"]')
    .forEach((r) => r.addEventListener('change', render));
</script>
