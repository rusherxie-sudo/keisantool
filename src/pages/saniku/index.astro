---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'saniku';
const title = '産休・育休計算器 — 休業期間・出産手当金・育児休業給付金を自動計算 | 計算ツール';
const description =
  '出産予定日から産前・産後休業と育休終了日を自動計算。標準報酬と休業前賃金を分けて出産手当金・育児休業給付金・2025年新設の出生後休業支援給付金の概算も確認できる無料ツール。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '産休・育休計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---

<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 産休・育休計算</div>
    <h1>産休・育休計算器</h1>
    <p>出産予定日から産休・育休の期間を計算し、出産手当金・育児休業給付金の概算額もわかります。</p>
  </div>

  <div class="calc-card">
    <div class="calc-tabs" role="tablist">
      <button class="calc-tab active" data-tab="schedule" type="button">休業期間</button>
      <button class="calc-tab" data-tab="kyuufu" type="button">給付金計算</button>
    </div>

    <!-- 休業期間タブ -->
    <div class="calc-panel active" id="panel-schedule">
      <div class="field-group">
        <div class="field-group__title"><span class="field-group__title-text">出産予定日と妊娠区分</span></div>
        <div class="field-grid">
          <div class="field">
            <label class="field__label" for="due-date">出産予定日</label>
            <div class="field__box">
              <input type="date" id="due-date" />
            </div>
          </div>
          <div class="field">
            <span class="field__label">妊娠区分</span>
            <div class="radio-group">
              <input type="radio" name="multiple" id="single" value="single" checked />
              <label for="single">単胎（1人）</label>
              <input type="radio" name="multiple" id="multiple" value="multiple" />
              <label for="multiple">多胎（双子以上）</label>
            </div>
          </div>
        </div>
      </div>

      <div class="result-box" id="schedule-result">
        <div class="result-label">産休・育休スケジュール</div>
        <div class="result-rows">
          <div class="result-row">
            <span class="label">産前休業開始日</span>
            <span class="value date-val" id="sanzen-start">—</span>
          </div>
          <div class="result-row">
            <span class="label">出産予定日</span>
            <span class="value date-val" id="due-disp">—</span>
          </div>
          <div class="result-row">
            <span class="label">産後休業終了日</span>
            <span class="value date-val" id="sango-end">—</span>
          </div>
        </div>
        <div class="ikukyu-section">
          <div class="ikukyu-label">育休終了日（育休期間を選択）</div>
          <div class="radio-group" style="margin-bottom:8px">
            <input type="radio" name="ikukyu-ext" id="iku0" value="0" checked />
            <label for="iku0">1歳まで</label>
            <input type="radio" name="ikukyu-ext" id="iku6" value="6" />
            <label for="iku6">1歳6ヶ月まで</label>
            <input type="radio" name="ikukyu-ext" id="iku12" value="12" />
            <label for="iku12">2歳まで</label>
          </div>
          <div class="result-row">
            <span class="label">育休終了日（予定）</span>
            <span class="value date-val" id="ikukyu-end">—</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 給付金タブ -->
    <div class="calc-panel" id="panel-kyuufu">
      <div class="field-group">
        <div class="field-group__title"><span class="field-group__title-text">給付金の計算条件</span></div>
        <div class="field-grid">
          <div class="field">
            <label class="field__label" for="monthly-wage">平均標準報酬月額（出産手当金用）</label>
            <div class="field__box">
              <input type="number" id="monthly-wage" inputmode="numeric" placeholder="例：300000" min="0" />
              <span class="field__suffix">円</span>
            </div>
            <span class="field__hint">出産手当金用：支給開始日前12か月の標準報酬月額の平均。給与の額面そのものではありません</span>
          </div>
          <div class="field">
            <label class="field__label" for="leave-monthly-wage">休業前6か月の平均賃金月額（育休給付用）</label>
            <div class="field__box"><input type="number" id="leave-monthly-wage" min="1" inputmode="numeric" placeholder="例：300000" /><span class="field__suffix">円</span></div>
            <span class="field__hint">賞与を除く額面賃金の6か月合計÷6。標準報酬とは別に入力</span>
          </div>
          <div class="field">
            <label class="field__label" for="ikukyu-days">育休給付の支給日数合計</label>
            <div class="field__box">
              <input type="number" id="ikukyu-days" inputmode="numeric" placeholder="例：300" min="1" step="1" max="730" />
              <span class="field__suffix">日</span>
            </div>
            <span class="field__hint">暦日数ではなく各支給単位期間の日数を合算。通常1期間30日、最終期間は日割り</span>
          </div>
        </div>
        <label class="shien-check field--full">
          <input type="checkbox" id="shien-toggle" />
          <span>出生後休業支援給付金の資格・対象期間を公式資料で確認済み（13%を試算）</span>
        </label>
        <div class="form-group">
          <label for="shien-days">出生後休業支援給付の対象日数（加算する場合のみ）</label>
          <input id="shien-days" type="number" min="14" max="28" step="1" value="28" />
        </div>
        <p>無給で、最初の180支給日を67%、残りを50%と仮定する簡易比較です。暦上の180日境界を自動判定する計算ではありません。出生時育児休業給付の取得済日数、分割取得、途中の限度額改定は反映しません。給与が出る場合の30日分は<a href="/ikuji/">育児休業給付金計算器</a>へ。</p>
        <p id="benefit-error" role="status"></p>
      </div>

      <div class="result-box" id="kyuufu-result">
        <div class="result-label">給付金の概算</div>
        <div class="result-rows">
          <div class="result-row">
            <span class="label">標準報酬日額（出産手当金用）</span>
            <span class="value" id="daily-amount">¥0</span>
          </div>
          <div class="result-row">
            <span class="label">出産手当金（単胎・予定日出産・98日無給）</span>
            <span class="value" id="shussan-teate">¥0</span>
          </div>
        </div>
        <div class="result-rows" style="margin-top:12px;padding-top:12px;border-top:1.5px solid color-mix(in srgb, var(--cat-color) 18%, transparent)">
          <div class="result-row">
            <span class="label">育休給付金（最初180日 67%）</span>
            <span class="value" id="ikukyu-first">¥0</span>
          </div>
          <div class="result-row">
            <span class="label">育休給付金（181日目以降 50%）</span>
            <span class="value" id="ikukyu-rest">¥0</span>
          </div>
          <div class="result-row" style="padding-top:8px;border-top:1px dashed color-mix(in srgb, var(--cat-color) 28%, transparent);margin-top:4px">
            <span class="label" style="font-weight:600;color:var(--navy)">育児休業給付金 合計</span>
            <span class="value" id="ikukyu-total">¥0</span>
          </div>
          <div class="result-row" id="shien-row" style="display:none">
            <span class="label">出生後休業支援給付金（13%・最大28日）</span>
            <span class="value green" id="shien-amount">¥0</span>
          </div>
          <div class="result-row" style="padding-top:8px;border-top:1px dashed color-mix(in srgb, var(--cat-color) 28%, transparent);margin-top:4px">
            <span class="label" style="font-weight:600;color:var(--navy)">出産手当金＋育休給付＋対象の支援給付</span>
            <span class="value" id="grand-total">¥0</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>使い方</h2>
    <ul>
      <li><strong>休業期間タブ</strong>：出産予定日を入力すると、産前・産後休業の開始/終了日と育休終了日を自動表示します。産前休業は予定日を含む42日（多胎98日）です。産後と育休終了日は予定日に出産した場合を表示します。育休終了日は1歳/1歳6ヶ月/2歳から選べます。延長には保育所に入れない等の要件があり、この計算で延長資格は判断できません。休業終了日と雇用保険給付の支給終了日は必ずしも一致しません。</li>
      <li><strong>給付金計算タブ</strong>：出産手当金用の平均標準報酬月額と、育休給付用の平均賃金月額を別々に入力します。</li>
    </ul>
    <p>
      <strong>出産手当金：</strong>健康保険から支給。支給開始前12か月の平均標準報酬月額÷30（10円未満四捨五入）×2/3（1円未満四捨五入）で日額を求めます。本試算は加入12か月以上・単胎・予定日に出産・98日無給の場合です。加入12か月未満、多胎、予定日との差、休業中の給与調整は対象外です。<br />
      <strong>育児休業給付金：</strong>雇用保険から支給。休業開始時賃金日額（休業前6ヶ月の賃金÷180＝月額一定なら月給÷30）の67%が最初の180日、以降50%が支給されます。賃金日額は令和8年8月改定の3,061〜16,540円を適用します。この画面では支給日数と暦日数の違いや180日目をまたぐ期間を再現せず、支給率ごとに合算して切り捨てるため、実際の支給額とは差が出ます。正確な期間別金額は支給決定通知書で確認してください。<br />
      <strong>出生後休業支援給付金（2025年4月新設）：</strong>対象期間内に14日以上の休業などの条件を満たすと、最大28日分の賃金日額13%が加算されます。配偶者に関する要件と例外もあるため、<a href="https://www.mhlw.go.jp/stf/syussyougo_kanishindan_00001.html" target="_blank" rel="noopener noreferrer">厚生労働省の資格確認</a>で確かめてください。チェックだけで受給資格を確定するものではありません。
    </p>
    <h2>確認資料</h2>
    <p>2026年10月10日、日数の数え方・出産手当金の端数処理・育休給付率と限度額を確認しました。</p>
    <ul>
      <li><a href="https://www.kyoukaikenpo.or.jp/benefit/childbirth/001/" target="_blank" rel="noopener noreferrer">協会けんぽ：出産手当金（平均17万円→日額3,780円の算例）</a></li>
      <li><a href="https://www.mhlw.go.jp/content/11600000/001461102.pdf" target="_blank" rel="noopener noreferrer">厚生労働省：育児休業等給付の内容と支給申請手続</a></li>
      <li><a href="https://www.bosei-navi.mhlw.go.jp/senmon/senmon24.html" target="_blank" rel="noopener noreferrer">厚生労働省：育児休業の期間</a></li>
    </ul>
    <div class="disclaimer">※ 計算結果はあくまで参考値です。実際の給付額は加入している健康保険組合・ハローワークの審査、標準報酬月額の等級、賃金日額の上下限により異なります。詳細は職場の担当部署または各機関にお問い合わせください。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '産休はいつからいつまでですか？', a: '出産予定日の6週間前（多胎は14週間前）から産後8週間までが基本です。本ツールは出産予定日から期間を自動表示します。' },
    { q: '出産手当金・育休給付金はいくらですか？', a: '出産手当金は標準報酬日額の2/3、育児休業給付金は休業開始時賃金日額をもとに計算します。2025年4月の新制度（出生後休業支援給付など）にも対応しています。' },
    { q: '計算結果は正確ですか？', a: '標準報酬や上限額により変わるため目安です。正確な額は勤務先・健康保険組合・ハローワークにご確認ください。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
.ikukyu-section {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1.5px solid color-mix(in srgb, var(--cat-color) 18%, transparent);
}
.ikukyu-label {
  font-size: .78rem;
  font-weight: var(--fw-bold);
  color: var(--text-muted);
  margin-bottom: 10px;
}
.date-val {
  font-family: var(--font-mono);
  font-size: .95rem;
}
.shien-check {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 12px;
  margin-bottom: 4px;
  background: var(--cat-tint);
  border-radius: var(--r-md);
  font-size: .82rem;
  color: var(--text);
  cursor: pointer;
  line-height: 1.5;
}
.shien-check input { margin-top: 2px; flex-shrink: 0; }
</style>

<script>
  import {
    calcSanzenStart,
    calcSangoEnd,
    calcIkukyuEnd,
    calcShussanTeate,
    calcIkukyuKyuufu,
    calcShusseigoShien,
    dailyWageFromMonthly,
  } from '../../lib/saniku.js';

  const $ = (id) => document.getElementById(id);
  const yen = (n) => '¥' + n.toLocaleString('ja-JP');
  const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
  let hasTrackedSchedule = false;
  let hasTrackedBenefit = false;

  function fmtDate(iso) {
    if (!iso) return '—';
    const [y, m, d] = iso.split('-').map(Number);
    const wd = WEEKDAYS[new Date(Date.UTC(y, m - 1, d, 12)).getDay()];
    return `${y}年${m}月${d}日（${wd}）`;
  }

  // --- 休業期間タブ ---
  function renderSchedule() {
    const dueDate = $('due-date').value;
    const isMultiple = document.querySelector('input[name="multiple"]:checked').value === 'multiple';
    const extMonths = parseInt(document.querySelector('input[name="ikukyu-ext"]:checked').value, 10);

    const sanzenStart = calcSanzenStart(dueDate, isMultiple);
    const sangoEnd    = calcSangoEnd(dueDate);
    const ikukyuEnd   = calcIkukyuEnd(dueDate, extMonths);

    const box = $('schedule-result');
    if (!sanzenStart) { box.classList.remove('visible'); window.hideResultShare?.(); return; }
    box.classList.add('visible');
    if (!hasTrackedSchedule) {
      window.trackCalculatorResult?.('leave_schedule');
      hasTrackedSchedule = true;
    }

    $('sanzen-start').textContent = fmtDate(sanzenStart);
    $('due-disp').textContent     = fmtDate(dueDate);
    $('sango-end').textContent    = fmtDate(sangoEnd);
    $('ikukyu-end').textContent   = fmtDate(ikukyuEnd);
    window.setResultShare?.(
      `産休・育休計算器\n産前休業開始日：${$('sanzen-start').textContent}\n産後休業終了日：${$('sango-end').textContent}\n育休終了日（予定）：${$('ikukyu-end').textContent}`
    );
  }

  $('due-date').addEventListener('change', renderSchedule);
  document.querySelectorAll('input[name="multiple"]').forEach((r) => r.addEventListener('change', renderSchedule));
  document.querySelectorAll('input[name="ikukyu-ext"]').forEach((r) => r.addEventListener('change', renderSchedule));

  // --- 給付金タブ ---
  function renderKyuufu() {
    const monthlyWage = parseFloat($('monthly-wage').value);
    const inputDays = Number($('ikukyu-days').value);
    const leaveMonthlyWage = Number($('leave-monthly-wage').value);
    const shienDays = Number($('shien-days').value);
    const shienOn = $('shien-toggle').checked;

    const box = $('kyuufu-result');
    if (!Number.isFinite(monthlyWage) || monthlyWage <= 0 || !Number.isFinite(leaveMonthlyWage) || leaveMonthlyWage <= 0 || !Number.isInteger(inputDays) || inputDays < 1 || inputDays > 730 || (shienOn && (!Number.isInteger(shienDays) || shienDays < 14 || shienDays > 28 || shienDays > inputDays))) {
      $('benefit-error').textContent = '2種類の月額と整数の支給日数を入力してください。支援給付は14〜28日、かつ育休給付日数以内です。';
      box.classList.remove('visible');
      window.hideResultShare?.();
      return;
    }

    $('benefit-error').textContent = '';
    const standardDaily = Math.round(monthlyWage / 30 / 10) * 10;
    const dailyAmount = dailyWageFromMonthly(leaveMonthlyWage);
    const teate = calcShussanTeate(standardDaily, 98);
    const kyuufu = calcIkukyuKyuufu(dailyAmount, inputDays);
    const shien = shienOn ? calcShusseigoShien(dailyAmount, shienDays) : null;
    const grandTotal = (teate ?? 0) + (kyuufu?.total ?? 0) + (shien?.amount ?? 0);

    box.classList.add('visible');
    if (!hasTrackedBenefit) {
      window.trackCalculatorResult?.('benefit_estimate');
      hasTrackedBenefit = true;
    }
    $('daily-amount').textContent = yen(standardDaily);
    $('shussan-teate').textContent = yen(teate ?? 0);
    $('ikukyu-first').textContent  = yen(kyuufu?.first ?? 0);
    $('ikukyu-rest').textContent   = yen(kyuufu?.rest ?? 0);
    $('ikukyu-total').textContent  = yen(kyuufu?.total ?? 0);
    $('shien-row').style.display = shienOn ? 'flex' : 'none';
    $('shien-amount').textContent = yen(shien?.amount ?? 0);
    $('grand-total').textContent = yen(grandTotal);
    window.setResultShare?.(
      `産休・育休計算器\n出産手当金＋育休給付＋対象の支援給付：${$('grand-total').textContent}\n出産手当金（単胎・予定日出産・98日無給）：${$('shussan-teate').textContent}\n育児休業給付金 合計：${$('ikukyu-total').textContent}`
    );
  }

  ['monthly-wage', 'leave-monthly-wage', 'ikukyu-days', 'shien-days'].forEach((id) => $(id).addEventListener('input', renderKyuufu));
  $('shien-toggle').addEventListener('change', renderKyuufu);

  // タブ切り替え
  document.querySelectorAll('.calc-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.calc-tab').forEach((t) => t.classList.remove('active'));
      document.querySelectorAll('.calc-panel').forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      $('panel-' + tab.dataset.tab).classList.add('active');
      window.hideResultShare?.();
    });
  });
</script>
