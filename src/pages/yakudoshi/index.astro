---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';
import { yakudoshiTable } from '../../lib/yakudoshi.js';

const slug = 'yakudoshi';
const title =
  '厄年早見表【2026年・令和8年】男女別チェッカー | 計算ツール';
const description =
  '2026年（令和8年）の厄年早見表。生年月日から厄年（前厄・本厄・後厄）を自動判定するチェッカー付き。男性・女性それぞれの厄年を和暦×西暦×数え年の早見表で一覧。大厄や次の厄年まであと何年かもひと目でわかる無料ツールです。';

// 早見表は「今年」を固定値で SSR（純HTML）生成する。
const TABLE_YEAR = 2026; // 令和8年
const maleTable = yakudoshiTable(TABLE_YEAR, 'male');
const femaleTable = yakudoshiTable(TABLE_YEAR, 'female');

// 西暦 → 和暦（元号＋年）に変換する。
function toWareki(year) {
  if (year >= 2019) return `令和${year - 2018 === 1 ? '元' : year - 2018}年`;
  if (year >= 1989) return `平成${year - 1988 === 1 ? '元' : year - 1988}年`;
  if (year >= 1926) return `昭和${year - 1925 === 1 ? '元' : year - 1925}年`;
  if (year >= 1912) return `大正${year - 1911 === 1 ? '元' : year - 1911}年`;
  return `明治${year - 1867 === 1 ? '元' : year - 1867}年`;
}
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '厄年チェッカー',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld} wide>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/seikatsu/">生活・日常</a> ／ 厄年チェッカー</div>
    <h1>厄年早見表＆厄年チェッカー（2026年・令和8年）</h1>
    <p>生まれた年（西暦）と性別を選ぶだけで、今年が前厄・本厄・後厄のどれに当たるかを自動で判定します。下の<strong>厄年早見表</strong>では、和暦×西暦×数え年で男女別の厄年をまとめて確認できます。</p>
  </div>

  <div class="calc-card">
    <div class="calc-panel active">
      <div class="form-group">
        <label for="birth-year">生まれた年（西暦）</label>
        <input type="number" id="birth-year" inputmode="numeric" placeholder="例：1985" />
      </div>
      <div class="radio-group">
        <input type="radio" name="gender" id="g-male" value="male" checked />
        <label for="g-male">男性</label>
        <input type="radio" name="gender" id="g-female" value="female" />
        <label for="g-female">女性</label>
      </div>

      <div class="result-box" id="result">
        <div class="result-label" id="kazoe-label">数え年</div>
        <div class="result-main" id="judge-main">該当なし</div>
        <div class="result-rows">
          <div class="result-row"><span class="label">数え年</span><span class="value" id="kazoe-val">―</span></div>
          <div class="result-row"><span class="label">本厄（数え年）</span><span class="value" id="honyaku-val">―</span></div>
          <div class="result-row"><span class="label">次の前厄まで</span><span class="value" id="next-val">―</span></div>
        </div>
      </div>

      <div class="yaku-list" id="yaku-list" hidden>
        <div class="yaku-list-title" id="yaku-list-title">厄年一覧（数え年）</div>
        <div class="yaku-rows" id="yaku-rows"></div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="haymitable">
    <h2>厄年早見表（2026年・令和8年）｜和暦×西暦×数え年</h2>
    <p class="hayimi-note">
      2026年（令和8年）に前厄・本厄・後厄に当たる方の生まれた年を、和暦・西暦・数え年でまとめた早見表です。<strong class="taiyaku-mark">赤色の行は大厄</strong>（男性42歳・女性33歳）です。
    </p>

    <h3 class="hayimi-h3">男性の厄年早見表（2026年）</h3>
    <div class="data-table-wrap">
      <div class="data-table-scroll">
        <table class="data-table" id="hayimi-male">
          <thead>
            <tr><th>区分</th><th>数え年</th><th>生まれた年（和暦）</th><th>生まれた年（西暦）</th></tr>
          </thead>
          <tbody>
            {maleTable.map((r) => (
              <tr data-gender="male" data-kazoe={r.kazoedoshi} class={r.isTaiyaku ? 'is-taiyaku' : ''}>
                <td>{r.kind}{r.isTaiyaku && <span class="data-table__badge yaku-badge--taiyaku">大厄</span>}</td>
                <td class="num">{r.kazoedoshi}歳</td>
                <td class="num--sub">{toWareki(r.birthYear)}</td>
                <td class="num">{r.birthYear}年</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <h3 class="hayimi-h3">女性の厄年早見表（2026年）</h3>
    <div class="data-table-wrap">
      <div class="data-table-scroll">
        <table class="data-table" id="hayimi-female">
          <thead>
            <tr><th>区分</th><th>数え年</th><th>生まれた年（和暦）</th><th>生まれた年（西暦）</th></tr>
          </thead>
          <tbody>
            {femaleTable.map((r) => (
              <tr data-gender="female" data-kazoe={r.kazoedoshi} class={r.isTaiyaku ? 'is-taiyaku' : ''}>
                <td>{r.kind}{r.isTaiyaku && <span class="data-table__badge yaku-badge--taiyaku">大厄</span>}</td>
                <td class="num">{r.kazoedoshi}歳</td>
                <td class="num--sub">{toWareki(r.birthYear)}</td>
                <td class="num">{r.birthYear}年</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="hayimi-note">※ 早見表の数え年は「2026 − 生まれた年 + 1」で算出した参考値です。誕生日前の方は実際の数え年と1歳ずれる場合があります。</p>
  </section>

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>厄年チェッカーの使い方と厄年の基礎知識</h2>
    <p>
      生まれた年（西暦）を入力し、性別を選ぶと、今年が<strong>前厄・本厄・後厄</strong>のどれに当たるかを自動で判定します。ボタンを押す必要はなく、入力するとすぐに結果が表示されます。和暦しかわからない場合は、昭和は「年＋1925」、平成は「年＋1988」、令和は「年＋2018」で西暦に換算してから入力してください（例：昭和60年＝1985年）。
    </p>
    <p>
      <strong>厄年とは</strong>、人生のなかで災いが起こりやすいとされる年齢のことで、平安時代から伝わる風習です。厄年は満年齢ではなく<strong>数え年</strong>で数えます。数え年は「生まれた時を1歳とし、元旦（正月）を迎えるごとに1歳加える」数え方で、本ツールでは簡易的に「今年 − 生まれた年 ＋ 1」で計算しています（誕生日前の方は実際の数え年と1歳ずれる場合があります）。
    </p>
    <p>
      <strong>男女で厄年は異なります。</strong>男性の厄年（本厄・数え年）は<strong>25歳・42歳・61歳</strong>で、特に42歳は「死に」に通じるとされる<strong>大厄</strong>です。女性の厄年（本厄・数え年）は<strong>19歳・33歳・37歳・61歳</strong>で、33歳は「散々」に通じる<strong>大厄</strong>とされます。それぞれ本厄の前年が<strong>前厄</strong>、翌年が<strong>後厄</strong>で、合わせて3年間が厄年の期間です。
    </p>
    <p>
      <strong>厄年の過ごし方</strong>として、多くの人は年の初めに神社やお寺で厄払い・厄除けの祈祷を受けます。新しいことを始めるのを控える、健康に気をつける、無理をしないといった心構えで過ごすとよいとされます。とはいえ厄年はあくまで風習であり、過度に恐れる必要はありません。体調や生活を見直すきっかけとして前向きにとらえましょう。
    </p>
    <div class="disclaimer">※ 厄年の数え方や該当年齢は地域・神社・宗派によって異なる場合があります。本ツールの判定は一般的な数え年に基づく参考値です。正式な厄年や厄払いについては、お近くの神社・お寺にご確認ください。</div>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[
    { q: '厄年は何歳ですか？', a: '数え年で、男性は25・42・61歳、女性は19・33・37・61歳が本厄とされます（特に男性42・女性33は大厄）。その前後の年が前厄・後厄です。' },
    { q: '厄年は数え年と満年齢どちらで数えますか？', a: '一般に数え年で数えます（生まれた年を1歳とし、元日ごとに1歳加算）。本ツールは数え年で判定します。' },
    { q: '厄年は気にすべきですか？', a: '厄年は文化的な慣習で、科学的根拠を保証するものではありません。参考程度にご利用ください。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<!-- innerHTML で注入される要素（#yaku-rows の .yaku-item / #judge-main の .taiyaku-badge）は
     scoped style が効かないため global + id 前缀で定義（CLAUDE.md の罠） -->
<style is:global>
  #yaku-rows .yaku-item{display:flex;justify-content:space-between;align-items:baseline;padding:10px 14px;border:1.5px solid var(--border-2);border-radius:var(--r-md);font-size:.84rem;background:var(--surface-sub)}
  #yaku-rows .yaku-item .ages{font-family:var(--font-mono);font-weight:var(--fw-bold);color:var(--text)}
  #yaku-rows .yaku-item .tag{font-size:.7rem;color:var(--danger);font-weight:var(--fw-bold)}
  #judge-main .taiyaku-badge{display:inline-block;margin-left:8px;font-size:.55em;vertical-align:middle;background:var(--danger);color:#fff;padding:2px 10px;border-radius:var(--r-pill);font-family:var(--font-sans);font-weight:var(--fw-bold)}
</style>

<style>
  .yaku-list{max-width:480px;margin:16px auto 0}
  .yaku-list-title{font-size:.78rem;color:var(--text-muted);font-weight:var(--fw-bold);margin-bottom:8px}
  .yaku-rows{display:flex;flex-direction:column;gap:6px}
  .judge-honyaku{color:var(--danger)!important}
  .judge-maeyaku,.judge-atoyaku{color:var(--text)!important}
  .judge-none{color:var(--text-muted)!important}

  /* 厄年早見表（表本体は global.css の .data-table を使用） */
  .haymitable{margin-top:32px}
  .hayimi-h3{font-size:1rem;margin:22px 0 8px;color:var(--text)}
  .hayimi-note{font-size:.82rem;color:var(--text-muted);margin:6px 0}
  .taiyaku-mark{color:var(--danger)}
  /* 大厄（本厄）行の赤強調＋大厄バッジの色（global の中立トーンに上書き） */
  .data-table tr.is-taiyaku td{color:var(--danger)}
  .data-table tr.is-taiyaku .num{color:var(--danger)}
  .yaku-badge--taiyaku{margin-left:6px;background:var(--danger);color:#fff;vertical-align:middle}
</style>

<script>
  import { checkYakudoshi, yakudoshiList, nextYaku } from '../../lib/yakudoshi.js';

  const $ = (id) => document.getElementById(id);
  const CURRENT_YEAR = new Date().getFullYear();

  const STATUS_LABEL = {
    maeyaku: '前厄',
    honyaku: '本厄',
    atoyaku: '後厄',
    none: '該当なし',
  };

  function gender() {
    return document.querySelector('input[name="gender"]:checked').value;
  }

  // 早見表の命中行（ユーザーの性別×数え年に一致する行）に .is-hit を付与。
  function clearHit() {
    document
      .querySelectorAll('.data-table tr.is-hit')
      .forEach((tr) => tr.classList.remove('is-hit'));
  }
  function markHit(g, kazoe) {
    clearHit();
    if (!Number.isFinite(kazoe)) return;
    document
      .querySelectorAll(
        '.data-table tr[data-gender="' + g + '"][data-kazoe="' + kazoe + '"]'
      )
      .forEach((tr) => tr.classList.add('is-hit'));
  }

  function render() {
    const raw = $('birth-year').value;
    const box = $('result');
    const listWrap = $('yaku-list');
    const year = Number(raw);

    if (!raw || !Number.isFinite(year) || year < 1900 || year > CURRENT_YEAR) {
      box.classList.remove('visible');
      listWrap.hidden = true;
      clearHit();
      window.hideResultShare?.();
      return;
    }

    const g = gender();
    const r = checkYakudoshi(year, g, CURRENT_YEAR);

    box.classList.add('visible');

    // 早見表で該当する数え年の行をハイライト（CURRENT_YEAR 基準）。
    markHit(g, CURRENT_YEAR - year + 1);

    // メイン判定
    const main = $('judge-main');
    const label = STATUS_LABEL[r.status] || '該当なし';
    main.className = 'result-main judge-' + r.status;
    if (r.status === 'none') {
      main.innerHTML = '今年は厄年ではありません';
    } else {
      const badge =
        r.status === 'honyaku' && r.taiyaku
          ? '<span class="taiyaku-badge">大厄</span>'
          : '';
      main.innerHTML = '今年は<strong>' + label + '</strong>です' + badge;
    }

    $('kazoe-val').textContent = r.kazoe + '歳';
    $('honyaku-val').textContent = r.honyaku ? r.honyaku + '歳' : '―';

    const nx = nextYaku(year, g, CURRENT_YEAR);
    if (nx) {
      $('next-val').textContent =
        nx.yearsToMaeyaku === 0
          ? '今年（前厄）'
          : 'あと' + nx.yearsToMaeyaku + '年（' + nx.nextMaeyakuAge + '歳の前厄）';
    } else {
      $('next-val').textContent = 'すべての厄年を経過';
    }

    // 厄年一覧
    const list = yakudoshiList(g);
    $('yaku-rows').innerHTML = list
      .map((y) => {
        const tag = y.taiyaku ? '<span class="tag">大厄</span>' : '';
        return (
          '<div class="yaku-item"><span>前厄 ' +
          y.maeyaku +
          '・本厄 ' +
          y.honyaku +
          '・後厄 ' +
          y.atoyaku +
          '</span><span class="ages">' +
          tag +
          '</span></div>'
        );
      })
      .join('');
    $('yaku-list-title').textContent =
      (g === 'female' ? '女性' : '男性') + 'の厄年一覧（数え年）';
    listWrap.hidden = false;

    // 結果シェア用サマリー（描画済み DOM の textContent から組み立てる）
    window.setResultShare?.(
      '厄年チェッカー\n' +
        '判定：' + $('judge-main').textContent.trim() + '\n' +
        '数え年：' + $('kazoe-val').textContent + '\n' +
        '本厄（数え年）：' + $('honyaku-val').textContent + '\n' +
        '次の前厄まで：' + $('next-val').textContent
    );
  }

  $('birth-year').addEventListener('input', render);
  document
    .querySelectorAll('input[name="gender"]')
    .forEach((r) => r.addEventListener('change', render));
</script>
