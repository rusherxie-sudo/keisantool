---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Faq from '../../components/Faq.astro';
import ResultShare from '../../components/ResultShare.astro';

const slug = 'shakaihoken';
const title = '社会保険料計算器 - 健康保険・厚生年金・雇用保険 | 計算ツール';
const description =
  '社会保険料の月額目安を計算。全国平均の健康保険料率、厚生年金、雇用保険、介護保険をまとめて確認できる無料ツールです。';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '社会保険料計算器',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current={slug} jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/category/zeikin/">税金・お金</a> ／ 社会保険料</div>
    <h1>社会保険料計算器</h1>
    <p>社会保険料の月額目安を計算します。健康保険は全国平均料率を使うため、加入支部の実額とは異なります。</p>
  </div>

  <div class="calc-card">
    <div class="form-group">
      <label for="monthly-salary">報酬月額（通勤手当等を含む・円）</label>
      <input type="number" id="monthly-salary" inputmode="numeric" placeholder="例：300000" />
    </div>
    <div class="form-group">
      <label for="age">年齢</label>
      <input type="number" id="age" min="16" max="69" inputmode="numeric" placeholder="例：30" />
    </div>

    <p>16〜69歳の被用者保険加入者向け。年齢と報酬を入力してください。</p>
    <div class="result-box" id="result-box">
      <div class="result-label">社会保険料合計（月額）</div>
      <div class="result-main" id="result-total">¥0</div>
      <div class="result-rows">
        <div class="result-row"><span class="label">厚生年金の標準報酬月額</span><span class="value" id="row-base">¥0</span></div>
        <div class="result-row"><span class="label">健康保険の標準報酬月額</span><span class="value" id="row-health-base">¥0</span></div>
        <div class="result-row"><span class="label">健康保険料（4.95%）</span><span class="value" id="row-health">¥0</span></div>
        <div class="result-row"><span class="label">厚生年金保険料（9.15%）</span><span class="value" id="row-pension">¥0</span></div>
        <div class="result-row"><span class="label">雇用保険料（一般事業 0.5%）</span><span class="value" id="row-employment">¥0</span></div>
        <div class="result-row"><span class="label">子ども・子育て支援金（本人負担0.115%）</span><span class="value" id="row-childcare">¥0</span></div>
        <div class="result-row"><span class="label">介護保険料（40〜64歳・本人負担0.81%）</span><span class="value" id="row-nursing">¥0</span></div>
        <div class="result-row"><span class="label">現在の月額 × 12（参考）</span><span class="value" id="row-yearly">¥0</span></div>
      </div>
    </div>
  </div>

  <ResultShare />

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>2026年度・4月分以降の本人負担を試算</h2>
    <p>加入済みの会社員等を対象に、報酬月額から等級を推定します。健康保険は協会けんぽの全国平均9.90%の半分、厚生年金は9.15%、一般事業の雇用保険は賃金の0.5%、子ども・子育て支援金は0.115%で計算します。40〜64歳には介護保険0.81%を加えます。支部・健康保険組合・業種が違えば料率も変わります。</p>
    <h3>健康保険と年金では上限が違います</h3>
    <p>健康保険は58,000〜1,390,000円、厚生年金は88,000〜650,000円の標準報酬月額を使います。報酬295,000円なら両方300,000円、700,000円なら健康保険710,000円・厚生年金650,000円です。実際の等級は定時決定・随時改定などで決まるため、毎月の支給額と一致するとは限りません。</p>
    <h3>月30万円・30歳の例</h3>
    <p>健康保険14,850円＋厚生年金27,450円＋雇用保険1,500円＋支援金345円＝44,145円。40歳なら介護保険2,430円を加え46,575円です。</p>
    <p>円未満は概算上切り捨てます。実務では控除時の端数処理や労使の特約で差が出ます。賞与、育休中の免除、任意継続、70歳以上は対象外です。65〜69歳の市区町村の介護保険料も含みません。「月額×12」は2026年1〜12月の実際の合計ではありません。</p>
    <h3>出典・確認範囲</h3>
    <p>2026年10月10日に等級・適用月・料率を照合：<a href="https://www.kyoukaikenpo.or.jp/g7/cat330/sb3150/">協会けんぽ保険料額表</a>、<a href="https://www.kyoukaikenpo.or.jp/assets/R8_44oita.pdf">等級表（大分支部・PDF。支部料率は本概算と異なる）</a>、<a href="https://www.mhlw.go.jp/content/001692566.pdf">厚生労働省・2026年度雇用保険料率</a>。</p>
    <p>給与全体の目安は<a href="/kyuyo/">手取り計算</a>、退職後は<a href="/kokuho/">国保料計算</a>で比較できます。</p>
  </section>

  <RelatedTools current={slug} />

  <RelatedArticles toolSlug={slug} />

  <Faq items={[{ q: '加入できるかも判定できますか？', a: '加入資格の判定は行いません。既に加入する方の保険料目安です。勤務時間・契約期間・事業所等の条件は勤務先で確認してください。' }, { q: '年齢で何が変わりますか？', a: '40〜64歳は健康保険と合わせて徴収する介護保険を加算します。65歳以降の自治体の介護保険料は別途必要です。' }]} />

  <div class="ad-slot"></div>
</ToolLayout>

<script>
  import { calcShakaihoken } from '../../lib/shakaihoken.js';

  const $ = (id) => document.getElementById(id);
  const yen = (n) => '¥' + Math.floor(n).toLocaleString('ja-JP');

  function show(box) { box.classList.add('visible'); }
  function hide(box) { box.classList.remove('visible'); window.hideResultShare?.(); }

  function render() {
    const box = $('result-box');
    const salary = $('monthly-salary').value;
    const age = $('age').value;
    
    if (age === '' || Number(age) < 16 || Number(age) > 69) return hide(box);
    const result = calcShakaihoken(salary, age);
    
    if (result.premiumBase === 0) return hide(box);
    
    show(box);
    $('result-total').textContent = yen(result.total);
    $('row-base').textContent = yen(result.pensionPremiumBase);
    $('row-health-base').textContent = yen(result.healthPremiumBase);
    $('row-health').textContent = yen(result.health);
    $('row-pension').textContent = yen(result.pension);
    $('row-employment').textContent = yen(result.employment);
    $('row-childcare').textContent = yen(result.childcare);
    $('row-nursing').textContent = yen(result.nursing);
    $('row-yearly').textContent = yen(result.yearlyTotal);

    window.setResultShare?.(
      '社会保険料計算器\n社会保険料合計：' + $('result-total').textContent +
      '\n健康保険：' + $('row-health').textContent +
      '\n厚生年金：' + $('row-pension').textContent +
      '\n雇用保険：' + $('row-employment').textContent +
      '\n子ども・子育て支援金：' + $('row-childcare').textContent +
      '\n介護保険：' + $('row-nursing').textContent
    );
  }

  ['monthly-salary', 'age'].forEach((id) => $(id).addEventListener('input', render));
</script>
