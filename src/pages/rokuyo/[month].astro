---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Faq from '../../components/Faq.astro';
import RokuyoCalendarGrid from '../../components/RokuyoCalendarGrid.astro';
import { rokuyoMonthTable, rokuyoDesc, toKyureki } from '../../lib/rokuyo.js';
import { PUBLISHED_ROKUYO_YEARS } from '../../lib/publishedRoutes.js';
import { japanDateParts } from '../../lib/japanDate.js';

export function getStaticPaths() {
  const paths = [];
  for (const y of PUBLISHED_ROKUYO_YEARS) {
    for (let m = 1; m <= 12; m++) {
      paths.push({ params: { month: `${y}-${String(m).padStart(2, '0')}` } });
    }
  }
  return paths;
}

const [yStr, mStr] = Astro.params.month.split('-');
const YEAR = Number(yStr);
const MONTH = Number(mStr);
const MONTH_LABEL = `${YEAR}年${MONTH}月`;

const japanToday = japanDateParts();
const isCurrentMonth = YEAR === japanToday.year && MONTH === japanToday.month;

const rows = rokuyoMonthTable(YEAR, MONTH);
const taianDays = rows.filter((r) => r.rokuyo === '大安').map((r) => `${r.day}日`);
const butsumetsuDays = rows.filter((r) => r.rokuyo === '仏滅').map((r) => `${r.day}日`);
const weekdays = ['日', '月', '火', '水', '木', '金', '土'];
const taianRows = rows.filter((row) => row.rokuyo === '大安').map((row) => ({
  ...row, weekday: new Date(Date.UTC(YEAR, MONTH - 1, row.day)).getUTCDay(),
}));
const weekendTaian = taianRows.filter((row) => row.weekday === 0 || row.weekday === 6);
const firstLunar = toKyureki(YEAR, MONTH, 1);
const lastLunar = toKyureki(YEAR, MONTH, rows.length);

let prevYear = YEAR, prevMonth = MONTH - 1;
if (prevMonth < 1) { prevMonth = 12; prevYear -= 1; }
let nextYear = YEAR, nextMonth = MONTH + 1;
if (nextMonth > 12) { nextMonth = 1; nextYear += 1; }
const hasPrev = PUBLISHED_ROKUYO_YEARS.includes(prevYear);
const hasNext = PUBLISHED_ROKUYO_YEARS.includes(nextYear);

const ROKUYO_ORDER = ['先勝', '友引', '先負', '仏滅', '大安', '赤口'];
const monthLinks = Array.from({ length: 12 }, (_, index) => {
  const month = index + 1;
  const currentYearMonth = YEAR === japanToday.year && month === japanToday.month;
  return {
    month,
    href: currentYearMonth ? '/rokuyo/' : `/rokuyo/${YEAR}-${String(month).padStart(2, '0')}/`,
  };
});

// 今月は /rokuyo/ が正規URL（重複コンテンツ防止のため canonical をハブへ向ける）。
const slug = isCurrentMonth ? 'rokuyo' : `rokuyo/${Astro.params.month}`;

const title = `${MONTH_LABEL}の六曜カレンダー｜大安・仏滅の日一覧 | 計算ツール`;
const description = `${MONTH_LABEL}の六曜カレンダー。大安は${taianDays.join('・')}、仏滅は${butsumetsuDays.join('・')}です。先勝・友引・先負・赤口も日別に一覧でき、結婚式や入籍、引っ越しの日取り選びに無料で使えます。`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '六曜カレンダー',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};
---
<ToolLayout title={title} description={description} slug={slug} current="rokuyo" jsonld={jsonld}>
  <div class="page-hero">
    <div class="crumb"><a href="/">ホーム</a> ／ <a href="/rokuyo/">六曜カレンダー</a> ／ {MONTH_LABEL}</div>
    <h1>{MONTH_LABEL}の六曜カレンダー（大安・仏滅）</h1>
    <p>{MONTH_LABEL}の大安は<strong>{taianDays.join('・')}</strong>、仏滅は<strong>{butsumetsuDays.join('・')}</strong>です。六曜を日別に一覧できます。</p>
  </div>

  <div class="calc-card">
    <RokuyoCalendarGrid year={YEAR} month={MONTH} rows={rows} />
    <nav class="rk-nav">
      {hasPrev ? <a href={`/rokuyo/${prevYear}-${String(prevMonth).padStart(2, '0')}/`}>← {prevYear}年{prevMonth}月</a> : <span />}
      {hasNext ? <a href={`/rokuyo/${nextYear}-${String(nextMonth).padStart(2, '0')}/`}>{nextYear}年{nextMonth}月 →</a> : <span />}
    </nav>
    <nav class="rk-month-nav" aria-label={`${YEAR}年の月別六曜カレンダー`}>
      <span class="rk-month-nav-title">{YEAR}年の月別カレンダー</span>
      <div class="rk-month-links">
        {monthLinks.map((item) => (
          item.month === MONTH
            ? <span class="is-current" aria-current="page">{item.month}月</span>
            : <a href={item.href}>{item.month}月</a>
        ))}
      </div>
    </nav>
  </div>

  <div class="ad-slot"></div>

  <section class="howto">
    <h2>{MONTH_LABEL}の大安・仏滅はいつ？</h2>
    <p><strong>大安は{taianDays.join('・')}</strong>、<strong>仏滅は{butsumetsuDays.join('・')}</strong>です。大安は祝い事の日取りとして好まれ、仏滅は祝い事を避ける慣習がありますが、いずれも文化的な目安です。</p>
    <h2>六曜とは？大安・仏滅の意味</h2>
    <p>
      六曜（ろくよう）は、暦に記される吉凶の目安のひとつで、<strong>先勝・友引・先負・仏滅・大安・赤口</strong>の6種類が、旧暦の月と日をもとにおおむね6日周期で巡ります。冠婚葬祭や契約ごとの日取りを選ぶときの、文化的な慣習として使われています。
    </p>
    <ul>
      {ROKUYO_ORDER.map((name) => (
        <li><strong>{name}</strong>：{rokuyoDesc(name)}</li>
      ))}
    </ul>
    <p>
      なかでも<strong>大安</strong>は「万事に良い」とされ結婚式などの祝い事に好まれ、逆に<strong>仏滅</strong>は「万事に凶」とされ祝い事は避けられる傾向があります。ただし六曜は江戸時代以降に広まった暦注であり、地域や宗派、時代によって解釈が異なることもあります。
    </p>
    <div class="disclaimer">※ 六曜は文化的な慣習・参考情報であり、科学的根拠を保証するものではありません。重要な日取りは、ご家族やご親族、式場・寺社などともご相談のうえお決めください。計算結果はあくまで参考値です。</div>
  </section>

  <section class="howto">
    <h2>{MONTH_LABEL}の大安を曜日から選ぶ</h2>
    <p>日取りの相談では、六曜だけでなく曜日も並べると予定を比較しやすくなります。{MONTH_LABEL}の大安{taianRows.length}日のうち、土曜・日曜に当たるのは<strong>{weekendTaian.length > 0 ? weekendTaian.map((row) => `${row.day}日（${weekdays[row.weekday]}）`).join('・') : 'ありません'}</strong>。祝日、施設の休館日、勤務先の休業日は別の条件です。</p>
    <div class="data-table-wrap"><div class="data-table-scroll"><table class="data-table">
      <thead><tr><th>大安の日付</th><th>曜日</th><th>予定を決める前の確認</th></tr></thead>
      <tbody>{taianRows.map((row) => <tr><td>{MONTH}月{row.day}日</td><td>{weekdays[row.weekday]}曜日</td><td>{row.weekday === 0 || row.weekday === 6 ? '土日でも施設・窓口の営業を確認' : '仕事・学校や参列者の予定を確認'}</td></tr>)}</tbody>
    </table></div></div>
    <h3>結婚式・入籍・引っ越しは、それぞれの条件で確認</h3>
    <p>結婚式なら会場と参列者の都合、入籍なら自治体の受付方法、引っ越しなら搬入可能な時間や契約日を先に整理します。大安であっても窓口が開くとは限りません。休日受付と通常窓口では確認できる内容が異なる場合もあるため、手続き先へ事前に確認してください。</p>
    <p>六曜を気にするかどうかには個人差があります。本人と家族の希望を聞いたうえで候補日を数日残し、料金や予約状況を比べると、ひとつの表示だけに予定を縛られずに選べます。必要な移動日数の確認には<a href="/nissu/">日数計算器</a>、国民の祝日の確認には<a href="/shukujitsu/">祝日カレンダー</a>が使えます。</p>
    <h2>六曜が月の途中で順番どおりに見えない理由</h2>
    <p>本カレンダーは旧暦の月と日の和を6で割った余りに、六曜を対応させて算出しています。現在のカレンダーの月日をそのまま足す計算ではありません。{MONTH_LABEL}1日は旧暦{firstLunar.isLeap ? '閏' : ''}{firstLunar.month}月{firstLunar.day}日、末日の{rows.length}日は旧暦{lastLunar.isLeap ? '閏' : ''}{lastLunar.month}月{lastLunar.day}日として扱っています。</p>
    <p>旧暦の月が変わると起点も変わるため、表示はいつも単純な6日間の繰り返しになるとは限りません。前日から1つずつ進めるだけで月全体を埋めると、月の途中からずれることがあります。月をまたぐ予定では、前月末・翌月初もリンク先で確認してください。</p>
    <h3>計算上の暦と、地域の慣習を区別する</h3>
    <p>旧暦換算には天文暦に基づく計算ライブラリを使っています。日付境界や旧暦の扱いによって資料との差が生じる場合があるため、式場や寺社が使う暦に合わせたいときは、年月日を指定して相手先にも確認してください。六曜の解釈は科学的な予測ではなく、暦に関する文化的慣習です。仏滅という表示が、病気・事故などの発生を予告するわけではありません。</p>
  </section>

  <RelatedTools current="rokuyo" />

  <Faq items={[
    { q: `${MONTH_LABEL}の大安はいつですか？`, a: taianDays.length > 0 ? `${MONTH_LABEL}の大安は${taianDays.join('・')}です。` : `${MONTH_LABEL}は大安がありません。` },
    { q: `${MONTH_LABEL}の仏滅はいつですか？`, a: butsumetsuDays.length > 0 ? `${MONTH_LABEL}の仏滅は${butsumetsuDays.join('・')}です。` : `${MONTH_LABEL}は仏滅がありません。` },
    { q: '大安とはどんな日ですか？', a: '六曜のなかで「万事に良い」とされる日で、結婚式や入籍、開業など祝い事の日取りに好まれます。' },
    { q: '仏滅とはどんな日ですか？なぜ避けられますか？', a: '六曜のなかで「万事に凶」とされる日です。「仏も滅するほど縁起が悪い」との語呂合わせから、結婚式など祝い事は避けられる傾向がありますが、科学的根拠はなく文化的な慣習です。' },
  ]} />

  <div class="ad-slot"></div>
</ToolLayout>

<style>
  .rk-nav {
    max-width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    font-size: .85rem;
    font-weight: var(--fw-bold);
  }
  .rk-nav a { color: var(--cat-color); }
  .rk-nav a:hover { opacity: .75; }
  .rk-month-nav { margin-top: 18px; padding-top: 16px; border-top: 1.5px solid var(--border-2); }
  .rk-month-nav-title { display: block; margin-bottom: 10px; font-size: .78rem; font-weight: var(--fw-bold); color: var(--text-muted); }
  .rk-month-links { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
  .rk-month-links a, .rk-month-links span { padding: 7px 4px; border-radius: var(--r-sm); text-align: center; font-size: .78rem; font-weight: var(--fw-bold); }
  .rk-month-links a { color: var(--cat-color); background: var(--surface-sub); }
  .rk-month-links a:hover { background: var(--cat-tint); }
  .rk-month-links .is-current { color: #fff; background: var(--cat-color); }
  @media (max-width: 420px) { .rk-month-links { grid-template-columns: repeat(4, 1fr); } }
  .howto ul { padding-left: 1.2em; display: flex; flex-direction: column; gap: 6px; }
</style>
